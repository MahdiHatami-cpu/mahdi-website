+// The loading screen shown while the site opens.
+//
+// It is injected into the built page by build-site.ts, not into the client's own
+// index.html (that template also serves the Node server). Everything is inline: no
+// extra request, so it paints from the first bytes of the HTML, before the 755 KB app
+// bundle or any stylesheet has arrived. That is the point: on a slow or flaky
+// connection the bundle can take a long time, or never arrive, and a blank page gives
+// the player nothing to go on.
+//
+// What it does
+//  - shows at once: a patch of hexagonal territory being claimed cell by cell (the game is
+//    about taking ground, and its home page backdrop is a hex grid), the name, and a status
+//    line;
+//  - downloads the files the game needs apart from the maps (window.CF_PRELOAD, listed at
+//    build time by preload-list.ts: the code, atlases, sprites, fonts, language files and the
+//    home picture) and shows a bar of the bytes that really arrived. A file that stalls or ends
+//    short is fetched again; if one cannot be had the page is reloaded, then the failure panel;
+//  - only when the app has started (the entry bundle defines <play-page>), every one of those
+//    files is here and the page's own resources and fonts have loaded, does it say "Everything
+//    is OK", and then it opens like an iris onto the home page while the home page's picture
+//    settles in (class cf-reveal on <html>, see art.ts). The maps are not waited for;
+//  - has a backdrop picture (wide, or tall on a phone held upright) that fades in once it has
+//    downloaded; without it the screen is plain navy and works the same;
+//  - says so when loading is slow;
+//  - if the app still has not started, or a script/stylesheet fails to load, reloads the
+//    page by itself, up to three times (a stalled connection usually works on a retry);
+//  - after that, shows a clear message and a Reload button;
+//  - carries a small link to the host's own site (CREDIT_URL). It is plain HTML, so it works
+//    while the game is still loading and after loading has failed.
+//
+// Text is English or Persian, picked from the browser language.
+
+import type { ArtUrls } from "./art";
+import { insertAtHeadStart } from "./head";
+import type { Preload } from "./preload-list";
+
+// Timings are read from window.CF_LOADING when present, so tests can shorten them.
+const SCRIPT_BODY = String.raw`  var el = document.getElementById("cf-loading");
+  if (!el) return;
+  // slowMs: no byte has arrived for this long. retryMs: the app has not started by then.
+  // stallMs/fileTries: one file's download gives up after no data for stallMs, and is tried again
+  // up to fileTries times; a file that still cannot be had is skipped (the game fetches it itself
+  // when it needs it). startConcurrency/concurrency: downloads at once while the app is still
+  // starting, and after, so the app's own files are not crowded out. waitMs: the longest to wait
+  // for the files once the app is up; after that the player is let in and the rest keeps
+  // downloading in the background. lateMs: everything is here but the browser has not yet said the
+  // page and its fonts are done; stop waiting for that after lateMs.
+  var cfg = { slowMs: 12000, retryMs: 30000, maxRetries: 3, failedRetryMs: 1500, okMs: 900, leaveMs: 1400,
+              startConcurrency: 2, concurrency: 6, stallMs: 8000, fileTries: 3, waitMs: 20000, lateMs: 3000 };
+  var o = window.CF_LOADING;
+  if (o) for (var k in o) cfg[k] = o[k];
+
+  var fa = /^fa/i.test(navigator.language || "");
+  var T = fa
+    ? {
+        loading: "در حال بارگذاری بازی…",
+        starting: "در حال راه‌اندازی…",
+        detail: "{pct}٪ · {a} از {b} مگابایت",
+        ok: "همه چیز اوکی شد ✓",
+        partial: "آماده است ✓ (بقیه فایل‌ها هنگام بازی بارگذاری می‌شوند)",
+        slow: "هنوز در حال بارگذاری است. اتصال شما کند به نظر می‌رسد…",
+        retrying: "بارگذاری کامل نشد. تلاش دوباره ({n} از {max})…",
+        failTitle: "بازی بارگذاری نشد",
+        failBody: "اتصال اینترنت خود را بررسی کنید. اگر VPN روشن است آن را خاموش کنید، و اگر خاموش است روشن کردنش ممکن است کمک کند. سپس دوباره تلاش کنید.",
+        reload: "بارگذاری مجدد",
+        credit: "میزبانی توسط"
+      }
+    : {
+        loading: "Loading the game…",
+        starting: "Starting…",
+        detail: "{pct}% · {a} of {b} MB",
+        ok: "Everything is OK ✓",
+        partial: "Ready ✓ (the rest keeps loading while you play)",
+        slow: "Still loading. Your connection seems slow…",
+        retrying: "Loading did not finish. Trying again ({n} of {max})…",
+        failTitle: "The game could not load",
+        failBody: "Check your internet connection. If a VPN is on, try turning it off; if it is off, turning one on may help. Then try again.",
+        reload: "Reload",
+        credit: "Hosted by"
+      };
+  if (fa) { el.setAttribute("lang", "fa"); el.setAttribute("dir", "rtl"); }
+
+  var msg = document.getElementById("cf-msg");
+  var bar = document.getElementById("cf-bar");
+  var fill = document.getElementById("cf-bar-fill");
+  var detail = document.getElementById("cf-detail");
+  var fail = document.getElementById("cf-fail");
+  function num(n, digits) {
+    try { return n.toLocaleString(fa ? "fa-IR" : "en-US", { maximumFractionDigits: digits || 0 }); }
+    catch (e) { return String(Math.round(n * 10) / 10); }
+  }
+  document.getElementById("cf-fail-title").textContent = T.failTitle;
+  document.getElementById("cf-fail-body").textContent = T.failBody;
+  var btn = document.getElementById("cf-reload");
+  btn.textContent = T.reload;
+  document.getElementById("cf-credit-lead").textContent = T.credit;
+  btn.onclick = function () {
+    try { sessionStorage.removeItem("cf-load-tries"); } catch (e) {}
+    location.reload();
+  };
+  msg.textContent = T.loading;
+
+  // The backdrop: a picture that fades in once it has arrived. It is decoration, so a failure
+  // to load it is ignored and nothing waits for it.
+  var art = window.CF_ART;
+  if (art) {
+    var portrait = window.matchMedia && matchMedia("(orientation: portrait)").matches;
+    var src = portrait ? art.tall : art.wide;
+    var img = new Image();
+    img.onload = function () {
+      el.style.setProperty("--cf-bg", 'url("' + src + '")');
+      el.classList.add("cf-bg-on");
+    };
+    img.src = src;
+  }
+
+  var tries = 0;
+  try { tries = Number(sessionStorage.getItem("cf-load-tries") || "0") || 0; } catch (e) {}
+  var finished = false;
+  var retrying = false;
+  var timers = [];
+  function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
+
+  // --- what has to be on the device before the game opens ---------------------------------
+  // The page lists the files the game needs apart from the maps (CF_PRELOAD, made at build time).
+  // They are downloaded here and counted by the bytes that really arrived, so the bar tells the
+  // truth. A file that stops (no data for stallMs) or ends short is fetched again. Once they are
+  // here the browser has them cached, so the game does not wait for them again.
+  var pre = window.CF_PRELOAD;
+  var base = pre && pre.base ? pre.base : "";
+  var list = [];
+  if (pre && pre.files && window.fetch && window.Promise) {
+    var portraitNow = window.matchMedia && matchMedia("(orientation: portrait)").matches;
+    for (var li = 0; li < pre.files.length; li++) {
+      var tag = pre.files[li][2]; // "w" / "t": a picture for wide / tall screens only
+      if ((tag === "w" && portraitNow) || (tag === "t" && !portraitNow)) continue;
+      list.push(pre.files[li]);
+    }
+  }
+  var part = [];
+  var total = 0;
+  for (var pi = 0; pi < list.length; pi++) { part.push(0); total += list[pi][1]; }
+  var filesDone = list.length === 0;
+  var settled = 0; // files finished, one way or the other
+  var skipped = 0; // ...of which could not be had
+  var started = 0; // download workers running
+  var partialOpen = false; // let in before every file was here
+  var appUp = false;
+  var pageLoaded = document.readyState === "complete";
+  var settling = false;
+  var lateArmed = false;
+  var slowShown = false;
+  var lastMove = Date.now();
+  var nextFile = 0;
+  var paintQueued = false;
+
+  function paint() {
+    if (!list.length) return;
+    var got = 0;
+    for (var i = 0; i < part.length; i++) got += part[i];
+    var pct = Math.floor((got * 100) / total);
+    if (!finished) pct = Math.min(pct, 99); // 100 is kept for the moment everything is OK
+    fill.style.width = pct + "%";
+    bar.setAttribute("aria-valuenow", String(pct));
+    detail.textContent = T.detail.replace("{pct}", num(pct))
+      .replace("{a}", num(got / 1048576, 1)).replace("{b}", num(total / 1048576, 1));
+  }
+  function schedulePaint() {
+    if (paintQueued) return;
+    paintQueued = true;
+    setTimeout(function () { paintQueued = false; paint(); }, 120);
+  }
+  function moved() {
+    lastMove = Date.now();
+    if (slowShown && !finished && !retrying) {
+      slowShown = false;
+      msg.textContent = filesDone ? T.starting : T.loading;
+    }
+    schedulePaint();
+  }
+  if (list.length) {
+    bar.hidden = false;
+    detail.hidden = false;
+    paint();
+  }
+
+  // One file, whole: read to the end and counted by what arrived. Short of the listed size means
+  // the connection ended early, which is a failure just like an error.
+  function fetchFile(i, attempt) {
+    var url = base + list[i][0];
+    var size = list[i][1];
+    var ctl = window.AbortController ? new AbortController() : null;
+    var timer = 0;
+    function arm() {
+      clearTimeout(timer);
+      if (ctl) timer = setTimeout(function () { ctl.abort(); }, cfg.stallMs);
+    }
+    arm();
+    return fetch(url, { signal: ctl ? ctl.signal : undefined, credentials: "omit", mode: "cors" })
+      .then(function (res) {
+        if (!res.ok || !res.body || !res.body.getReader) throw new Error("status " + res.status);
+        var reader = res.body.getReader();
+        var got = 0;
+        function read() {
+          return reader.read().then(function (r) {
+            if (r.done) return got;
+            got += r.value.length;
+            part[i] = got;
+            arm();
+            moved();
+            return read();
+          });
+        }
+        return read();
+      })
+      .then(function (got) {
+        clearTimeout(timer);
+        if (got < size) throw new Error("short");
+        part[i] = size;
+        moved();
+      })
+      .catch(function (err) {
+        clearTimeout(timer);
+        part[i] = 0;
+        if (attempt + 1 >= cfg.fileTries) throw err;
+        return new Promise(function (go) { setTimeout(go, Math.min(4000, 400 * (attempt + 1))); })
+          .then(function () { return fetchFile(i, attempt + 1); });
+      });
+  }
