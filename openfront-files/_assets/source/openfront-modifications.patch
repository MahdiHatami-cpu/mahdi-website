@@ -0,0 +1,29 @@
+// The /users/@me answer: what the client's account screens read (UserMeResponseSchema in
+// packages/shared/src/ApiSchemas.ts, which scripts/accounts-smoke.ts parses this against).
+//
+// Only what this site has is filled in. Stats, cosmetics, friends, clans and the store belong
+// to OpenFront's own closed-source API, so those parts are empty rather than invented.
+
+import type { Account } from "./store";
+
+export function userMeResponse(account: Account): unknown {
+  return {
+    user: {
+      email: account.email,
+      ...(account.googleSub !== null ? { google: { email: account.googleEmail ?? account.email } } : {}),
+    },
+    steamLicence: false,
+    noticesSeen: [],
+    pendingMessages: [],
+    player: {
+      publicId: account.publicId,
+      // No ads run on this site for anyone.
+      adfree: true,
+      canCreatePublicLobbies: false,
+      flares: [],
+      achievements: { singleplayerMap: [], player: [] },
+      friends: [],
+      subscription: null,
+    },
+  };
+}
diff --git a/cloudflare/src/accounts/store.ts b/cloudflare/src/accounts/store.ts
new file mode 100644
index 0000000..95006a3
--- /dev/null
+++ b/cloudflare/src/accounts/store.ts
@@ -0,0 +1,333 @@
+// D1 access for accounts (schema: migrations/0002_accounts.sql).
+//
+// Unlike the lobby history (db.ts), nothing here is best-effort: a sign-in either happened
+// or it did not, so failures throw and the caller answers with an error.
+
+import { randomToken, sha256Hex } from "./crypto";
+
+export interface Account {
+  id: string;
+  publicId: string;
+  email: string;
+  googleSub: string | null;
+  /** The address of the linked Google account, which may differ from `email`. */
+  googleEmail: string | null;
+  createdAt: number;
+  lastLoginAt: number;
+}
+
+interface AccountRow {
+  id: string;
+  public_id: string;
+  email: string;
+  google_sub: string | null;
+  google_email: string | null;
+  created_at: number;
+  last_login_at: number;
+}
+
+const ACCOUNT_COLUMNS =
+  "a.id, a.public_id, a.email, a.google_sub, a.google_email, a.created_at, a.last_login_at";
+
+function toAccount(r: AccountRow): Account {
+  return {
+    id: r.id,
+    publicId: r.public_id,
+    email: r.email,
+    googleSub: r.google_sub,
+    googleEmail: r.google_email,
+    createdAt: r.created_at,
+    lastLoginAt: r.last_login_at,
+  };
+}
+
+/** 10 characters, no look-alikes (0/O, 1/I/L): what other players see of an account. */
+function newPublicId(): string {
+  const alphabet = "23456789ABCDEFGHJKMNPQRSTUVWXYZ";
+  const bytes = crypto.getRandomValues(new Uint8Array(10));
+  return Array.from(bytes, (b) => alphabet[b % alphabet.length]).join("");
+}
+
+export const SESSION_MS = 60 * 24 * 60 * 60 * 1000;
+export const LOGIN_LINK_MS = 15 * 60 * 1000;
+
+export class AccountStore {
+  constructor(private readonly db: D1Database) {}
+
+  async byId(id: string): Promise<Account | null> {
+    const row = await this.db
+      .prepare(`SELECT ${ACCOUNT_COLUMNS} FROM accounts a WHERE a.id = ?1`)
+      .bind(id)
+      .first<AccountRow>();
+    return row === null ? null : toAccount(row);
+  }
+
+  private async byEmail(email: string): Promise<Account | null> {
+    const row = await this.db
+      .prepare(`SELECT ${ACCOUNT_COLUMNS} FROM accounts a WHERE a.email = ?1`)
+      .bind(email)
+      .first<AccountRow>();
+    return row === null ? null : toAccount(row);
+  }
+
+  private async byGoogleSub(sub: string): Promise<Account | null> {
+    const row = await this.db
+      .prepare(
+        `SELECT ${ACCOUNT_COLUMNS} FROM accounts a WHERE a.google_sub = ?1`,
+      )
+      .bind(sub)
+      .first<AccountRow>();
+    return row === null ? null : toAccount(row);
+  }
+
+  private async create(
+    email: string,
+    googleSub: string | null,
+    googleEmail: string | null,
+    now: number,
+  ): Promise<Account> {
+    const id = crypto.randomUUID();
+    // The public id is random over 31^10 values; a clash is not expected, but it is
+    // cheap to retry rather than fail a sign-in.
+    for (let attempt = 0; attempt < 5; attempt++) {
+      const publicId = newPublicId();
+      try {
+        await this.db
+          .prepare(
+            `INSERT INTO accounts (id, public_id, email, google_sub, google_email, created_at, last_login_at)
+             VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?6)`,
+          )
+          .bind(id, publicId, email, googleSub, googleEmail, now)
+          .run();
+        return {
+          id,
+          publicId,
+          email,
+          googleSub,
+          googleEmail,
+          createdAt: now,
+          lastLoginAt: now,
+        };
+      } catch (e) {
+        // Someone signed up with this address a moment ago (two tabs): use theirs.
+        const existing = await this.byEmail(email);
+        if (existing !== null) return existing;
+        if (attempt === 4) throw e;
+      }
+    }
+    throw new Error("could not create an account");
+  }
+
+  /** The account for a verified email address, made if there is none yet. */
+  async signInWithEmail(email: string, now: number): Promise<Account> {
+    const found = await this.byEmail(email);
+    if (found !== null) return found;
+    return this.create(email, null, null, now);
+  }
+
+  /**
+   * The account for a Google identity. Google's stable id wins; failing that, the same
+   * verified address as an existing account is the same person, and Google is attached to
+   * it. Otherwise a new account.
+   */
+  async signInWithGoogle(
+    sub: string,
+    email: string,
+    now: number,
+  ): Promise<Account> {
+    const bySub = await this.byGoogleSub(sub);
+    if (bySub !== null) return bySub;
+
+    const byMail = await this.byEmail(email);
+    if (byMail !== null) {
+      if (byMail.googleSub !== null) {
+        // That address already belongs to a different Google identity. Do not hand its
+        // account to someone else on the strength of a matching address.
+        throw new Error("email belongs to another Google identity");
+      }
+      await this.db
+        .prepare(`UPDATE accounts SET google_sub = ?2, google_email = ?3 WHERE id = ?1`)
+        .bind(byMail.id, sub, email)
+        .run();
+      return { ...byMail, googleSub: sub, googleEmail: email };
+    }
+    return this.create(email, sub, email, now);
+  }
+
+  /**
+   * Attaches a Google identity to a signed-in account (the "Link Google" button).
+   * "already_linked" covers both refusals: this account already has a Google identity, or
+   * this Google identity belongs to another account.
+   */
+  async linkGoogle(
+    accountId: string,
+    sub: string,
+    email: string,
+  ): Promise<"linked" | "already_linked"> {
+    const account = await this.byId(accountId);
+    if (account === null) return "already_linked";
+    if (account.googleSub !== null) return "already_linked";
+    const owner = await this.byGoogleSub(sub);
+    if (owner !== null && owner.id !== accountId) return "already_linked";
+    try {
+      await this.db
+        .prepare(
+          `UPDATE accounts SET google_sub = ?2, google_email = ?3
+            WHERE id = ?1 AND google_sub IS NULL`,
+        )
+        .bind(accountId, sub, email)
+        .run();
+    } catch {
+      return "already_linked"; // lost a race to another account for the same identity
+    }
+    return "linked";
+  }
+
+  /** Starts a session for the account; returns the secret to put in the cookie. */
+  async createSession(accountId: string, now: number): Promise<string> {
+    const token = randomToken(32);
+    const hash = await sha256Hex(token);
+    await this.db.batch([
+      this.db
+        .prepare(
+          `INSERT INTO sessions (token_hash, account_id, created_at, expires_at)
+           VALUES (?1, ?2, ?3, ?4)`,
+        )
+        .bind(hash, accountId, now, now + SESSION_MS),
+      this.db
+        .prepare(`UPDATE accounts SET last_login_at = ?2 WHERE id = ?1`)
+        .bind(accountId, now),
+    ]);
+    // Housekeeping on roughly one sign-in in twenty, so the tables stay small without a
+    // scheduled job: dead sessions, and login links nobody can use any more.
+    if (Math.random() < 0.05) {
+      await this.db.batch([
+        this.db.prepare(`DELETE FROM sessions WHERE expires_at < ?1`).bind(now),
+        this.db
+          .prepare(`DELETE FROM login_tokens WHERE created_at < ?1`)
+          .bind(now - 24 * 60 * 60 * 1000),
+      ]);
+    }
+    return token;
+  }
+
+  /** The account a session cookie belongs to, if the session is alive. */
+  async accountForSession(token: string, now: number): Promise<Account | null> {
+    const hash = await sha256Hex(token);
+    const row = await this.db
+      .prepare(
+        `SELECT ${ACCOUNT_COLUMNS}
+           FROM sessions s JOIN accounts a ON a.id = s.account_id
+          WHERE s.token_hash = ?1 AND s.expires_at > ?2`,
+      )
+      .bind(hash, now)
+      .first<AccountRow>();
+    return row === null ? null : toAccount(row);
+  }
+
+  async endSession(token: string): Promise<void> {
+    await this.db
+      .prepare(`DELETE FROM sessions WHERE token_hash = ?1`)
+      .bind(await sha256Hex(token))
+      .run();
+  }
+
+  async endAllSessions(accountId: string): Promise<void> {
+    await this.db
+      .prepare(`DELETE FROM sessions WHERE account_id = ?1`)
+      .bind(accountId)
+      .run();
+  }
+
+  async deleteAccount(accountId: string): Promise<void> {
+    // Explicit rather than relying on foreign keys being enforced for this connection.
+    await this.db.batch([
+      this.db.prepare(`DELETE FROM sessions WHERE account_id = ?1`).bind(accountId),
+      this.db.prepare(`DELETE FROM accounts WHERE id = ?1`).bind(accountId),
+    ]);
+  }
+
+  // ------------------------------------------------------------ login links
+
+  /** Links requested since `since` for this address and from this network. */
+  async recentLinkCounts(
+    email: string,
+    ipHash: string,
+    since: number,
+  ): Promise<{ email: number; ip: number }> {
+    const row = await this.db
+      .prepare(
+        `SELECT
+           COUNT(CASE WHEN email = ?1 THEN 1 END)   AS by_email,
+           COUNT(CASE WHEN ip_hash = ?2 THEN 1 END) AS by_ip
+           FROM login_tokens WHERE created_at > ?3`,
+      )
+      .bind(email, ipHash, since)
+      .first<{ by_email: number; by_ip: number }>();
+    return { email: row?.by_email ?? 0, ip: row?.by_ip ?? 0 };
+  }
+
+  /** Links requested by anyone since `since`: the whole site's use of the mail allowance. */
+  async countLinksSince(since: number): Promise<number> {
+    const row = await this.db
+      .prepare(`SELECT COUNT(*) AS n FROM login_tokens WHERE created_at > ?1`)
+      .bind(since)
+      .first<{ n: number }>();
+    return row?.n ?? 0;
+  }
+
+  async createLoginLink(
+    email: string,
+    ipHash: string,
+    now: number,
+  ): Promise<string> {
+    const token = randomToken(32);
+    await this.db
+      .prepare(
+        `INSERT INTO login_tokens (token_hash, email, ip_hash, created_at, expires_at)
+         VALUES (?1, ?2, ?3, ?4, ?5)`,
+      )
+      .bind(await sha256Hex(token), email, ipHash, now, now + LOGIN_LINK_MS)
+      .run();
+    return token;
+  }
+
+  /** Forget a link whose email could not be sent, so it does not count against the limits. */
+  async dropLoginLink(token: string): Promise<void> {
+    await this.db
+      .prepare(`DELETE FROM login_tokens WHERE token_hash = ?1`)
+      .bind(await sha256Hex(token))
+      .run();
+  }
+
+  /**
+   * Uses a link up. Exactly one caller can win: the UPDATE only matches a link not yet
+   * used, so two requests with the same token cannot both sign in.
+   */
+  async useLoginLink(
+    token: string,
+    now: number,
+  ): Promise<
+    { ok: true; email: string } | { ok: false; code: "consumed" | "expired" | "invalid" }
+  > {
+    const hash = await sha256Hex(token);
+    const row = await this.db
+      .prepare(
+        `SELECT email, expires_at, used_at FROM login_tokens WHERE token_hash = ?1`,
+      )
+      .bind(hash)
+      .first<{ email: string; expires_at: number; used_at: number | null }>();
+    if (row === null) return { ok: false, code: "invalid" };
+    if (row.used_at !== null) return { ok: false, code: "consumed" };
+    if (row.expires_at <= now) return { ok: false, code: "expired" };
+
+    const res = await this.db
+      .prepare(
+        `UPDATE login_tokens SET used_at = ?2 WHERE token_hash = ?1 AND used_at IS NULL`,
+      )
+      .bind(hash, now)
+      .run();
+    if ((res.meta.changes ?? 0) !== 1) return { ok: false, code: "consumed" };
+    return { ok: true, email: row.email };
+  }
+}
diff --git a/cloudflare/src/accounts/token.ts b/cloudflare/src/accounts/token.ts
new file mode 100644
index 0000000..d349b51
--- /dev/null
+++ b/cloudflare/src/accounts/token.ts
@@ -0,0 +1,33 @@
+// What a game server accepts as "who is this player": a guest's own random id (as before
+// accounts existed) or a token this site signed for a signed-in account.
+
+import { PersistentIdSchema } from "@openfront/shared/WireSchemas";
+import type { Env } from "../env";
+import { b64uToUuid, verifyJwt } from "./crypto";
+import { identityForHost } from "./identity";
+
+/**
+ * The persistent id a join or create_game token stands for, or null if it is neither a
+ * UUID nor a valid, unexpired token from this site. `host` is the host the request arrived
+ * on, which fixes the issuer and audience a token must carry.
+ *
+ * A signed-in player's persistent id is their account id (the token's `sub`), so their games
+ * follow them from device to device.
+ */
+export async function resolvePlayToken(
+  env: Env,
+  host: string,
+  token: string,
+): Promise<string | null> {
+  if (PersistentIdSchema.safeParse(token).success) return token;
+  if (!env.JWT_SECRET) return null;
+  const site = identityForHost(host);
+  const claims = await verifyJwt(
+    token,
+    env.JWT_SECRET,
+    { iss: site.apiOrigin, aud: site.audience },
+    Math.floor(Date.now() / 1000),
+  );
+  if (claims === null) return null;
+  return b64uToUuid(claims.sub);
+}
diff --git a/cloudflare/src/db.ts b/cloudflare/src/db.ts
new file mode 100644
index 0000000..08ec814
--- /dev/null
+++ b/cloudflare/src/db.ts
@@ -0,0 +1,189 @@
+// D1 access for public matchmaking (schema: migrations/0001_init.sql).
+//
+// Every write is fire-and-forget and swallows its own failure. The database is a
+// record of what happened, not part of running a game: a D1 outage, a missing
+// binding, or the Free plan's daily row limit (queries then error until 00:00
+// UTC) must never stall a lobby or drop a player.
+
+import type { Game, GameResult } from "./Game";
+import { type LeaderRow, playerKey, playerResults } from "./leaderboard";
+
+export type LobbyKind = "ffa" | "team";
+
+export interface RecentLobby {
+  gameId: string;
+  kind: LobbyKind;
+  map: string;
+  mode: string;
+  maxPlayers: number | null;
+  createdAt: number;
+  startedAt: number | null;
+  endedAt: number | null;
+  status: "open" | "started" | "finished" | "abandoned";
+  playersPeak: number;
+  turns: number | null;
+  winner: string | null;
+}
+
+interface LobbyRow {
+  game_id: string;
+  kind: LobbyKind;
+  game_map: string;
+  game_mode: string;
+  max_players: number | null;
+  created_at: number;
+  started_at: number | null;
+  ended_at: number | null;
+  status: RecentLobby["status"];
+  players_peak: number;
+  turns: number | null;
+  winner: string | null;
+}
+
+/** Adds one finished game to a player's row (?1 key, ?2 name, ?3 win 0/1, ?4 time). */
+export const UPSERT_RESULT_SQL = `INSERT INTO player_stats (player_key, name, games, wins, updated_at)
+   VALUES (?1, ?2, 1, ?3, ?4)
+   ON CONFLICT(player_key) DO UPDATE SET
+     name = excluded.name,
+     games = games + 1,
+     wins = wins + excluded.wins,
+     updated_at = excluded.updated_at`;
+
+export class LobbyDb {
+  constructor(private readonly db: D1Database | undefined) {}
+
+  get enabled(): boolean {
+    return this.db !== undefined;
+  }
+
+  private fire(
+    label: string,
+    work: (db: D1Database) => Promise<unknown>,
+  ): void {
+    const db = this.db;
+    if (db === undefined) return;
+    work(db).catch((e: unknown) =>
+      console.warn(
+        JSON.stringify({ msg: "d1 write failed", label, error: String(e) }),
+      ),
+    );
+  }
+
+  recordCreated(game: Game, kind: LobbyKind): void {
+    this.fire("created", (db) =>
+      db
+        .prepare(
+          `INSERT OR IGNORE INTO lobbies
+             (game_id, kind, game_map, game_mode, max_players, created_at, status)
+           VALUES (?1, ?2, ?3, ?4, ?5, ?6, 'open')`,
+        )
+        .bind(
+          game.id,
+          kind,
+          game.gameConfig.gameMap,
+          game.gameConfig.gameMode,
+          game.gameConfig.maxPlayers ?? null,
+          game.createdAt,
+        )
+        .run(),
+    );
+  }
+
+  recordStarted(game: Game): void {
+    this.fire("started", (db) =>
+      db
+        .prepare(
+          `UPDATE lobbies
+              SET status = 'started', started_at = ?2, starts_at = ?3, players_peak = ?4
+            WHERE game_id = ?1`,
+        )
+        .bind(game.id, Date.now(), game.startsAtMs ?? null, game.numClients())
+        .run(),
+    );
+  }
+
+  recordEnded(game: Game, result: GameResult): void {
+    this.fire("ended", (db) =>
+      db
+        .prepare(
+          `UPDATE lobbies
+              SET status = CASE WHEN started_at IS NULL THEN 'abandoned' ELSE 'finished' END,
+                  ended_at = ?2, players_peak = ?3, turns = ?4, winner = ?5
+            WHERE game_id = ?1`,
+        )
+        .bind(
+          game.id,
+          Date.now(),
+          result.peakPlayers,
+          result.turns,
+          result.winnerKey,
+        )
+        .run(),
+    );
+  }
+
+  /** Adds a finished public game to the leaderboard (src/leaderboard.ts decides whether it counts). */
+  recordResults(result: GameResult): void {
+    const players = playerResults(result);
+    if (players.length === 0) return;
+    this.fire("results", async (db) => {
+      const now = Date.now();
+      const statements = await Promise.all(
+        players.map(async (p) =>
+          db
+            .prepare(UPSERT_RESULT_SQL)
+            .bind(await playerKey(p.persistentID), p.name, p.won ? 1 : 0, now),
+        ),
+      );
+      // D1 runs at most 100 statements in one batch.
+      for (let i = 0; i < statements.length; i += 100) {
+        await db.batch(statements.slice(i, i + 100));
+      }
+    });
+  }
+
+  /** Most wins first (fewest games breaking a tie). Throws if D1 is unavailable. */
+  async leaderboard(limit: number, offset: number): Promise<LeaderRow[]> {
+    if (this.db === undefined) throw new Error("D1 is not configured");
+    const { results } = await this.db
+      .prepare(
+        `SELECT player_key AS key, name, games, wins
+           FROM player_stats
+          WHERE wins > 0
+          ORDER BY wins DESC, games ASC, updated_at ASC
+          LIMIT ?1 OFFSET ?2`,
+      )
+      .bind(limit, offset)
+      .all<LeaderRow>();
+    return results;
+  }
+
+  /** Newest first. Throws if D1 is unavailable; callers turn that into a 503. */
+  async recent(limit: number): Promise<RecentLobby[]> {
+    if (this.db === undefined) throw new Error("D1 is not configured");
+    const { results } = await this.db
+      .prepare(
+        `SELECT game_id, kind, game_map, game_mode, max_players, created_at,
+                started_at, ended_at, status, players_peak, turns, winner
+           FROM lobbies
+          ORDER BY created_at DESC
+          LIMIT ?1`,
+      )
+      .bind(limit)
+      .all<LobbyRow>();
+    return results.map((r) => ({
+      gameId: r.game_id,
+      kind: r.kind,
+      map: r.game_map,
+      mode: r.game_mode,
+      maxPlayers: r.max_players,
+      createdAt: r.created_at,
+      startedAt: r.started_at,
+      endedAt: r.ended_at,
+      status: r.status,
+      playersPeak: r.players_peak,
+      turns: r.turns,
+      winner: r.winner,
+    }));
+  }
+}
