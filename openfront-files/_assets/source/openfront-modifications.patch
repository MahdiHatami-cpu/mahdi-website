+++ b/map-generator/python/build_iran.py
@@ -0,0 +1,196 @@
+"""Builds the Iran map: elevation tiles -> image.png, 31 provinces as nations -> info.json,
+then the (verified) generator port -> resources/maps/iran/*.
+
+Data: AWS Terrain Tiles (terrarium encoding, public dataset built from SRTM and GEBCO), z=7.
+"""
+import json, math, os, sys, tempfile, time, urllib.request
+from concurrent.futures import ThreadPoolExecutor
+import numpy as np
+from PIL import Image, ImageDraw, ImageFont
+from scipy import ndimage as ndi
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+REPO = os.path.abspath(os.path.join(HERE, "..", ".."))  # the game repository
+TILES = os.path.join(tempfile.gettempdir(), "openfront-terrain-tiles")  # download cache
+Z = 7
+N = 256 * 2 ** Z  # world size in pixels at this zoom
+
+LON0, LON1 = 43.4, 63.9
+LAT0, LAT1 = 24.6, 40.2  # south, north
+
+
+def px(lon):
+    return (lon + 180) / 360 * N
+
+
+def py(lat):
+    s = math.sin(math.radians(lat))
+    return (0.5 - math.log((1 + s) / (1 - s)) / (4 * math.pi)) * N
+
+
+def lon_of(x):
+    return x / N * 360 - 180
+
+
+def lat_of(y):
+    return math.degrees(math.atan(math.sinh(math.pi * (1 - 2 * y / N))))
+
+
+X0, X1 = int(px(LON0)), int(px(LON1))
+Y0, Y1 = int(py(LAT1)), int(py(LAT0))
+W, H = (X1 - X0) // 4 * 4, (Y1 - Y0) // 4 * 4
+X1, Y1 = X0 + W, Y0 + H
+
+
+def fetch(tx, ty):
+    path = os.path.join(TILES, f"{tx}_{ty}.png")
+    if not os.path.exists(path):
+        url = f"https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{Z}/{tx}/{ty}.png"
+        for attempt in range(5):
+            try:
+                with urllib.request.urlopen(url, timeout=60) as r:
+                    data = r.read()
+                open(path, "wb").write(data)
+                break
+            except Exception as e:  # network is unreliable here: retry
+                if attempt == 4:
+                    raise
+                time.sleep(2 * (attempt + 1))
+    return tx, ty
+
+
+def elevation():
+    os.makedirs(TILES, exist_ok=True)
+    txs = range(X0 // 256, (X1 - 1) // 256 + 1)
+    tys = range(Y0 // 256, (Y1 - 1) // 256 + 1)
+    jobs = [(tx, ty) for tx in txs for ty in tys]
+    with ThreadPoolExecutor(8) as ex:
+        list(ex.map(lambda j: fetch(*j), jobs))
+    mosaic = np.zeros((len(tys) * 256, len(txs) * 256, 3), np.uint8)
+    for tx, ty in jobs:
+        t = np.asarray(Image.open(os.path.join(TILES, f"{tx}_{ty}.png")).convert("RGB"))
+        mosaic[(ty - tys[0]) * 256:(ty - tys[0] + 1) * 256, (tx - txs[0]) * 256:(tx - txs[0] + 1) * 256] = t
+    sub = mosaic[Y0 - tys[0] * 256:Y1 - tys[0] * 256, X0 - txs[0] * 256:X1 - txs[0] * 256].astype(np.float32)
+    return sub[..., 0] * 256 + sub[..., 1] + sub[..., 2] / 256 - 32768
+
+
+# 31 provinces: English name, approximate centre (lat, lon). Names are English on purpose.
+PROVINCES = [
+    ("Tehran", 35.55, 51.40), ("Alborz", 35.95, 50.75), ("East Azerbaijan", 37.90, 46.70),
+    ("West Azerbaijan", 37.00, 45.10), ("Ardabil", 38.50, 48.20), ("Gilan", 37.30, 49.40),
+    ("Mazandaran", 36.40, 52.60), ("Golestan", 37.20, 54.80), ("North Khorasan", 37.50, 57.30),
+    ("Razavi Khorasan", 35.50, 59.20), ("South Khorasan", 32.60, 59.50), ("Semnan", 35.30, 54.50),
+    ("Qom", 34.60, 50.90), ("Qazvin", 36.10, 49.80), ("Zanjan", 36.60, 48.50),
+    ("Hamadan", 34.80, 48.50), ("Kurdistan", 35.50, 46.90), ("Kermanshah", 34.40, 46.90),
+    ("Ilam", 33.40, 46.60), ("Lorestan", 33.50, 48.50), ("Markazi", 34.30, 49.70),
+    ("Isfahan", 33.00, 52.50), ("Chaharmahal and Bakhtiari", 32.20, 50.60),
+    ("Kohgiluyeh and Boyer-Ahmad", 30.80, 50.90), ("Khuzestan", 31.50, 49.00),
+    ("Bushehr", 28.90, 51.20), ("Fars", 29.50, 53.00), ("Hormozgan", 27.50, 56.00),
+    ("Kerman", 30.00, 57.50), ("Yazd", 31.90, 54.40), ("Sistan and Baluchestan", 28.50, 60.80),
+]
+assert len(PROVINCES) == 31 and len({p[0] for p in PROVINCES}) == 31
+
+
+def build_image():
+    elev = elevation()
+    ys, xs = np.mgrid[Y0:Y1, X0:X1]
+    lon = xs / N * 360 - 180
+    lat = np.degrees(np.arctan(np.sinh(np.pi * (1 - 2 * ys / N))))
+    water = elev < -1.0
+    caspian = (lon >= 46.3) & (lon <= 56.0) & (lat >= 36.0)  # its surface is ~ -27 m, its shore plains just above
+    water = np.where(caspian, elev < -27.5, water)
+    # Lake Urmia (flat at ~1270 m)
+    box = (lon >= 44.9) & (lon <= 45.8) & (lat >= 37.0) & (lat <= 38.3)
+    urmia = box & (np.abs(elev - 1272) < 8)
+    urmia = ndi.binary_fill_holes(ndi.binary_closing(urmia, iterations=4)) & box  # one solid lake, not a ring
+    water |= urmia
+    mag = np.clip((elev - 200) / 110, 0, 30)
+    blue = np.rint(140 + 2 * mag).astype(np.uint8)
+    img = np.zeros((H, W, 4), np.uint8)
+    img[..., 0], img[..., 1], img[..., 2], img[..., 3] = 100, 170, blue, 255
+    img[water] = (20, 60, 106, 255)
+    return img, elev, water
+
+
+def main():
+    t0 = time.time()
+    img, elev, water = build_image()
+    print(f"image {W}x{H} = {W * H / 1e6:.2f} M px, water {water.mean() * 100:.0f}%, elevation {elev.min():.0f}..{elev.max():.0f} m ({time.time() - t0:.0f}s)")
+    src = os.path.join(REPO, "map-generator/assets/maps/iran")
+    out = os.path.join(REPO, "resources/maps/iran")
+    os.makedirs(src, exist_ok=True)
+    os.makedirs(out, exist_ok=True)
+    Image.fromarray(img, "RGBA").save(os.path.join(src, "image.png"), optimize=True)
+
+    sys.path.insert(0, HERE)
+    import mapgen
+    res = mapgen.generate(os.path.join(src, "image.png"))
+    land = np.frombuffer(res["map"]["data"], np.uint8).reshape(H, W)
+    is_land = (land & 0x80) != 0
+    shore = (land & 0x40) != 0
+    print(f"generated: land tiles {res['map']['num_land_tiles']:,} (4x {res['map4x']['num_land_tiles']:,}, 16x {res['map16x']['num_land_tiles']:,})")
+
+    # nations: pixel of each province centre, moved to the nearest inland land tile
+    inland = is_land & ~shore
+    dist, (iy, ix) = ndi.distance_transform_edt(~inland, return_indices=True)
+    nations, moved = [], []
+    for name, la, lo in PROVINCES:
+        x, y = int(round(px(lo) - X0)), int(round(py(la) - Y0))
+        x, y = min(max(x, 0), W - 1), min(max(y, 0), H - 1)
+        if not inland[y, x]:
+            moved.append((name, round(float(dist[y, x]))))
+            x, y = int(ix[y, x]), int(iy[y, x])
+        nations.append({"coordinates": [x, y], "flag": "ir", "name": name})
+    if moved:
+        print("moved onto land:", moved)
+
+    info = {
+        "$schema": "../../../info.schema.json",
+        "id": "Iran",
+        "name": "Iran",
+        "translation_key": "map.iran",
+        "categories": ["featured", "countries", "asia"],
+        "featured_rank": 7,
+        "location": {"lat": 32.4, "lon": 53.7},
+        "author": "hatami-mahdi.ir",
+        "description": "Iran with its 31 provinces as nations, from the Caspian Sea in the north to the Persian Gulf and the Gulf of Oman in the south.",
+        "themes": ["asia"],
+        "nations": nations,
+    }
+    json.dump(info, open(os.path.join(src, "info.json"), "w", encoding="utf-8"), indent=2, ensure_ascii=False)
+
+    manifest = {k: v for k, v in info.items() if k not in ("$schema", "author", "description", "location")}
+    for name in ("map", "map4x", "map16x"):
+        manifest[name] = {"width": res[name]["width"], "height": res[name]["height"], "num_land_tiles": res[name]["num_land_tiles"]}
+    json.dump(manifest, open(os.path.join(out, "manifest.json"), "w", encoding="utf-8"), indent=2, ensure_ascii=False, sort_keys=True)
+    for name in ("map", "map4x", "map16x"):
+        open(os.path.join(out, f"{name}.bin"), "wb").write(res[name]["data"])
+    res["thumbnail"].save(os.path.join(out, "thumbnail.webp"), "WEBP", quality=45, method=4)
+
+    # preview for a human check: land by magnitude, water by depth, nations as red dots with names
+    b = np.frombuffer(res["map"]["data"], np.uint8).reshape(H, W)
+    mag = (b & 0x1F).astype(np.float32)
+    pv = np.zeros((H, W, 3), np.uint8)
+    L = (b & 0x80) != 0
+    t = np.clip(mag / 30, 0, 1)[..., None]
+    pv[L] = (np.array([190, 215, 140]) * (1 - t) + np.array([250, 250, 250]) * np.clip(t * 1.4 - 0.1, 0, 1)).astype(np.uint8)[L] if False else 0
+    green, brown, white = np.array([172, 208, 124]), np.array([205, 180, 130]), np.array([245, 245, 245])
+    f = (mag / 30)[..., None]
+    land_col = np.where(f < 0.33, green + (brown - green) * (f / 0.33), brown + (white - brown) * np.clip((f - 0.33) / 0.67, 0, 1))
+    pv[L] = land_col[L].astype(np.uint8)
+    wd = np.clip(mag[~L] / 14, 0, 1)[:, None]
+    pv[~L] = (np.array([120, 180, 230]) * (1 - wd) + np.array([30, 80, 150]) * wd).astype(np.uint8)
+    im = Image.fromarray(pv, "RGB")
+    d = ImageDraw.Draw(im)
+    for n in nations:
+        x, y = n["coordinates"]
+        d.ellipse([x - 5, y - 5, x + 5, y + 5], fill=(220, 30, 30), outline=(255, 255, 255))
+        d.text((x + 8, y - 6), n["name"], fill=(0, 0, 0))
+    preview = os.path.join(tempfile.gettempdir(), "iran-preview.png")
+    im.save(preview)
+    print(f"preview: {preview}")
+    print(f"done in {time.time() - t0:.0f}s")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/map-generator/python/mapgen.py b/map-generator/python/mapgen.py
