+++ b/cloudflare/scripts/third-party.ts
@@ -0,0 +1,198 @@
+// Takes OpenFront's own advertising, analytics and anti-adblock stack out of the page.
+//
+// The page the game ships is built for openfront.io's business: it loads CrazyGames' SDK,
+// Google Ads and Analytics under openfront.io's account ids, the Playwire/RAMP ad network
+// (which pulls in around thirty more hosts), Amazon and Google ad tags, Cloudflare Web
+// Analytics under openfront.io's token, and "AdShield", an anti-adblock tag that tries
+// html-load.cc, then jsDelivr and githack mirrors, then a WebSocket. On top of that the
+// client itself injects the Admiral ad-recovery script from a rotating, disguised domain
+// whenever `window.adsEnabled` is true, which is true for everyone without an ad-free account.
+//
+// None of it belongs on a private copy:
+//  - it reports every visitor to someone else's ad and analytics accounts;
+//  - on a connection that blocks those hosts (html-load.cc is filtered in Iran: it resolves
+//    to the 10.10.34.34 block address and a connect hangs ~21 s) each one stalls the page;
+//  - anti-adblock tooling may put walls and pop-ups over the game.
+//
+// What is left is the loading screen, the game, and Cloudflare Turnstile, which the client
+// needs to join a game.
+
+import { insertAtHeadStart } from "./head";
+
+/** Script hosts the built page may still load. */
+export const ALLOWED_SCRIPT_HOSTS = ["challenges.cloudflare.com"];
+
+/** Turns the ads off for the client: it reads `window.adsEnabled` wherever it would show or load one. */
+const ADS_OFF_SCRIPT = `<script id="cf-ads-off">
+  // This deployment shows no ads. The client sets window.adsEnabled from the account
+  // response (true for everyone without an ad-free account) and loads the Admiral
+  // ad-recovery script when it is true; a fixed false, which ignores that assignment,
+  // keeps all of it off.
+  Object.defineProperty(window, "adsEnabled", {
+    get: function () { return false; },
+    set: function () {},
+    configurable: false
+  });
+</script>
+`;
+
+/**
+ * The client looks for OpenFront's closed-source account API at `https://api.<audience>`.
+ * Most of what it asks of it (stats, cosmetics, friends, clans, the store, matchmaking) does
+ * not exist here, so those calls have to fail, and fail fast: a failure is only as quick as
+ * the lookup or round trip behind it (11 s measured on a slow resolver on the machine this was
+ * built on), and whatever waits for the call stalls with it. This answers them with the same
+ * network error at once, without leaving the browser. Only that one origin is touched.
+ *
+ * The one call that is answered here regardless is `GET /leaderboard/ranked` (see src/leaderboard.ts),
+ * redirected to the page's own origin.
+ *
+ * With `accounts` on, the calls this site's own account API does serve go through: signing in
+ * and out, and the profile. The token request is made only when the browser holds the
+ * `of_signed_in` cookie the API sets at sign-in, so a visitor who never signed in costs
+ * nothing, exactly as before accounts existed.
+ */
+export function noAccountApiScript(origin: string, accounts: boolean): string {
+  const literal = JSON.stringify(origin).replace(/</g, "\\u003c");
+  return `<script id="cf-no-account-api">
+  (function () {
+    var origin = ${literal};
+    var accounts = ${accounts ? "true" : "false"};
+    var realFetch = window.fetch;
+    if (typeof realFetch !== "function") return;
+    function served(path) {
+      if (!accounts) return false;
+      if (/^\\/auth\\/refresh(\\?|$)/.test(path)) {
+        return /(?:^|;\\s*)of_signed_in=1(?:;|$)/.test(document.cookie);
+      }
+      return (
+        /^\\/auth\\/(login\\/|link\\/google(\\?|$)|magic-link(\\?|$)|logout(\\?|$)|revoke(\\?|$))/.test(path) ||
+        /^\\/users\\/@me(\\?|$)/.test(path)
+      );
+    }
+    window.fetch = function (input, init) {
+      var url = typeof input === "string" ? input : input && input.url;
+      if (typeof url === "string" && url.indexOf(origin + "/") === 0) {
+        var path = url.slice(origin.length);
+        // The leaderboard is this site's own (the Worker answers it from its database), so the
+        // call goes to the page's origin instead of the account API's address, which has no server.
+        if (/^\\/leaderboard\\/ranked(\\?|$)/.test(path)) {
+          var target = location.origin + path;
+          return typeof input === "string"
+            ? realFetch.call(this, target, init)
+            : realFetch.call(this, new Request(target, input));
+        }
+        if (!served(path)) return Promise.reject(new TypeError("Failed to fetch"));
+      }
+      return realFetch.apply(this, arguments);
+    };
+  })();
+</script>
+`;
+}
+
+export interface StripOptions {
+  /** `https://api.<site host>`; leave out when the page talks to a local API. */
+  accountApiOrigin?: string;
+  /** This site runs its own sign-in (src/accounts/): let those calls through the guard. */
+  accounts?: boolean;
+  /** The host the site's own files are loaded from when built with CDN_BASE (e.g. cdn.jsdelivr.net). */
+  cdnHost?: string;
+}
+
+function once(html: string, re: RegExp, what: string): RegExpExecArray {
+  const m = re.exec(html);
+  if (!m) {
+    throw new Error(
+      `third-party strip: could not find ${what} in the rendered page. The upstream template ` +
+        "changed; update scripts/third-party.ts so the ad stack is still removed.",
+    );
+  }
+  return m;
+}
+
+/** Removes the ad, analytics and anti-adblock scripts from a rendered page. */
+export function stripThirdParty(
+  html: string,
+  options: StripOptions = {},
+): string {
+  if (html.includes('id="cf-ads-off"')) return html; // already done
+
+  // 1. The AdShield anti-adblock tag (an inline, obfuscated script with a fixed id).
+  const adshield = once(
+    html,
+    /<script id="HgWESkOz"[^>]*>[\s\S]*?<\/script>/,
+    "the AdShield tag (<script id=HgWESkOz>)",
+  );
+  let out = html.replace(
+    adshield[0],
+    "<!-- anti-adblock tag removed: see scripts/third-party.ts -->",
+  );
+
+  // 2. Every "load a third-party script" call in the template goes through one helper
+  //    (CrazyGames, both gtag tags, Cloudflare Web Analytics, RAMP). Making it do nothing
+  //    removes them all, and any added later.
+  const helper = once(
+    out,
+    /window\.__loadThirdPartyScript\s*=\s*function\s*\(\s*src\s*,\s*attrs\s*\)\s*\{/,
+    "the __loadThirdPartyScript helper",
+  );
+  out = out.replace(
+    helper[0],
+    `${helper[0]}\n        return; // none are loaded on this deployment (scripts/third-party.ts)`,
+  );
+
+  // 3. The client's own runtime ad loading (Admiral, promos, in-game ad), and the account
+  //    API that does not exist here.
+  const origin = options.accountApiOrigin;
+  return insertAtHeadStart(
+    out,
+    ADS_OFF_SCRIPT +
+      (origin ? noAccountApiScript(origin, options.accounts === true) : ""),
+  );
+}
+
+/**
+ * Throws when a rendered page would still load something from a host that is not allowed,
+ * or when a step of stripThirdParty is missing. Run on the final page so a template change
+ * upstream cannot quietly bring the ad stack back.
+ */
+export function assertNoThirdParty(
+  html: string,
+  options: StripOptions = {},
+): void {
+  const problems: string[] = [];
+  const masked = html.replace(/<!--[\s\S]*?-->/g, (c) => " ".repeat(c.length));
+
+  // Only tags the browser fetches by itself count. A <link rel="canonical"> or an <a href>
+  // is not a request.
+  const FETCHED_REL =
+    /\brel\s*=\s*["']?(?:stylesheet|preload|modulepreload|prefetch|preconnect|dns-prefetch|icon|apple-touch-icon|manifest)\b/i;
+  for (const tagMatch of masked.matchAll(/<(script|link|img|iframe)\b[^>]*>/gi)) {
+    const tag = tagMatch[1].toLowerCase();
+    const text = tagMatch[0];
+    if (tag === "link" && !FETCHED_REL.test(text)) continue;
+    const attr = /\b(?:src|href)\s*=\s*["']((?:https?:)?\/\/[^"']+)["']/i.exec(text);
+    if (!attr) continue;
+    let host: string;
+    try {
+      host = new URL(attr[1].startsWith("//") ? `https:${attr[1]}` : attr[1]).host;
+    } catch {
+      continue;
+    }
+    if (host === options.cdnHost) continue; // the site's own files, on the CDN
+    if (!ALLOWED_SCRIPT_HOSTS.includes(host)) problems.push(`${tag} loads ${attr[1]}`);
+  }
+  if (masked.includes('id="HgWESkOz"')) problems.push("the AdShield tag is still present");
+  if (!masked.includes('id="cf-ads-off"')) problems.push("the ads-off script is missing");
+  if (options.accountApiOrigin && !masked.includes('id="cf-no-account-api"'))
+    problems.push("the account-API guard is missing");
+  if (!/__loadThirdPartyScript\s*=\s*function\s*\(\s*src\s*,\s*attrs\s*\)\s*\{\s*return;/.test(masked))
+    problems.push("the third-party script helper is not disabled");
+
+  if (problems.length) {
+    throw new Error(
+      "the built page would still load third-party code:\n  - " + problems.join("\n  - "),
+    );
+  }
+}
diff --git a/cloudflare/scripts/tigris-sync.mjs b/cloudflare/scripts/tigris-sync.mjs
new file mode 100644
index 0000000..16a5087
--- /dev/null
+++ b/cloudflare/scripts/tigris-sync.mjs
@@ -0,0 +1,112 @@
+// Uploads the site's files (static/assets, static/_assets) to a Tigris bucket.
+//
+//   TIGRIS_KEY=... TIGRIS_SECRET=... TIGRIS_BUCKET=openfront-files node scripts/tigris-sync.mjs
+//
+// Every file name carries a content hash, so a key that already exists with the same size is
+// skipped; the upload is resumable and a re-run after a new build only sends what is new.
+// Objects get the right Content-Type (browsers refuse a script served as octet-stream) and a
+// one-year immutable Cache-Control. The bucket itself is created and made public by its
+// owner in the Tigris dashboard; this only writes objects. Credentials come from the
+// environment and are never written anywhere. Needs @aws-sdk/client-s3 (install it next to
+// this script or point NODE_PATH at a folder that has it).
+
+import dns from "node:dns";
+import fs from "node:fs";
+import https from "node:https";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { NodeHttpHandler } from "@smithy/node-http-handler";
+import { S3Client, PutObjectCommand, HeadObjectCommand } from "@aws-sdk/client-s3";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const staticDir = path.resolve(here, "../../static");
+const bucket = process.env.TIGRIS_BUCKET;
+const concurrency = Number(process.env.CONCURRENCY ?? 4);
+if (!bucket || !process.env.TIGRIS_KEY || !process.env.TIGRIS_SECRET) {
+  console.error("set TIGRIS_BUCKET, TIGRIS_KEY and TIGRIS_SECRET");
+  process.exit(2);
+}
+// t3.storage.dev has several addresses and, from the network this was built on, one of them
+// (144.24.176.132) never answers. TIGRIS_IP=<address> pins the API host to one that does
+// (the owner's router resolved it to 92.5.184.207, which answers in 0.4 s).
+const pin = process.env.TIGRIS_IP;
+const lookup = (host, opts, cb) => {
+  if (pin && host.endsWith("t3.storage.dev")) {
+    return opts && opts.all ? cb(null, [{ address: pin, family: 4 }]) : cb(null, pin, 4);
+  }
+  return dns.lookup(host, opts, cb);
+};
+const s3 = new S3Client({
+  region: "auto",
+  endpoint: "https://t3.storage.dev",
+  credentials: { accessKeyId: process.env.TIGRIS_KEY, secretAccessKey: process.env.TIGRIS_SECRET },
+  requestHandler: new NodeHttpHandler({
+    httpsAgent: new https.Agent({ lookup, keepAlive: true }),
+    connectionTimeout: 15000,
+    requestTimeout: 120000,
+  }),
+});
+
+const TYPES = {
+  ".js": "text/javascript; charset=utf-8", ".mjs": "text/javascript; charset=utf-8",
+  ".css": "text/css; charset=utf-8", ".json": "application/json", ".bin": "application/octet-stream",
+  ".webp": "image/webp", ".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif",
+  ".svg": "image/svg+xml", ".ico": "image/x-icon", ".ttf": "font/ttf", ".otf": "font/otf", ".woff": "font/woff",
+  ".woff2": "font/woff2", ".mp3": "audio/mpeg", ".ogg": "audio/ogg", ".wav": "audio/wav", ".webm": "video/webm",
+  ".mp4": "video/mp4", ".md": "text/plain; charset=utf-8", ".txt": "text/plain; charset=utf-8", ".wasm": "application/wasm",
+  ".map": "application/json",
+};
+const typeOf = (name) => TYPES[path.extname(name).toLowerCase()] ?? "application/octet-stream";
+
+function walk(dir, base = dir) {
+  if (!fs.existsSync(dir)) return [];
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name);
+    return e.isDirectory() ? walk(full, base) : [full];
+  });
+}
+
+const files = [...walk(path.join(staticDir, "assets")), ...walk(path.join(staticDir, "_assets"))];
+const keyOf = (full) => path.relative(staticDir, full).split(path.sep).join("/");
+let done = 0, skipped = 0, sent = 0, failed = 0, bytes = 0;
+const t0 = Date.now();
+const queue = files.slice();
+
+async function exists(key, size) {
+  try {
+    const r = await s3.send(new HeadObjectCommand({ Bucket: bucket, Key: key }));
+    return r.ContentLength === size;
+  } catch (e) {
+    if (e.$metadata?.httpStatusCode === 404 || e.name === "NotFound") return false;
+    throw e;
+  }
+}
+
+async function lane() {
+  while (queue.length) {
+    const full = queue.shift();
+    const key = keyOf(full);
+    const size = fs.statSync(full).size;
+    for (let attempt = 1; attempt <= 4; attempt++) {
+      try {
+        if (await exists(key, size)) { skipped++; break; }
+        await s3.send(new PutObjectCommand({
+          Bucket: bucket, Key: key, Body: fs.readFileSync(full), ContentType: typeOf(key),
+          CacheControl: "public, max-age=31536000, immutable",
+        }));
+        sent++; bytes += size;
+        break;
+      } catch (e) {
+        if (attempt === 4) { failed++; console.log(`FAILED ${key}: ${e.name} ${e.message}`); }
+        else await new Promise((r) => setTimeout(r, 1000 * attempt));
+      }
+    }
+    done++;
+    if (done % 50 === 0 || done === files.length) {
+      console.log(`${done}/${files.length}  sent ${sent} (${(bytes / 1048576).toFixed(1)} MB)  skipped ${skipped}  failed ${failed}  ${((Date.now() - t0) / 1000).toFixed(0)}s`);
+    }
+  }
+}
+await Promise.all(Array.from({ length: concurrency }, lane));
+console.log(failed ? `\nUPLOAD INCOMPLETE: ${failed} file(s) failed; run again` : `\nUPLOAD COMPLETE: ${files.length} files in bucket ${bucket}`);
+process.exit(failed ? 1 : 0);
diff --git a/cloudflare/scripts/typecheck.mjs b/cloudflare/scripts/typecheck.mjs
new file mode 100644
index 0000000..fb8d150
--- /dev/null
+++ b/cloudflare/scripts/typecheck.mjs
@@ -0,0 +1,31 @@
+// Typechecks cloudflare/src against the Workers runtime types.
+//
+// The shared packages are written for ES2022 + a hand-declared TextDecoder
+// (packages/engine-api/globals.d.ts), so against @cloudflare/workers-types a
+// couple of their lines report a typing mismatch that is not a runtime problem
+// (workerd's TextDecoder accepts `{ fatal: true }`). Those live outside this
+// folder and are the repo's own typecheck's job; here only errors in
+// cloudflare/ fail the check.
+import { spawnSync } from "node:child_process";
+
+const result = spawnSync("npx tsc --noEmit -p .", {
+  encoding: "utf8",
+  shell: true,
+});
+const lines = `${result.stdout}${result.stderr}`
+  .split(/\r?\n/)
+  .filter((l) => /error TS\d+/.test(l));
+
+const ours = lines.filter((l) => !l.startsWith("../"));
+const foreign = lines.length - ours.length;
+
+if (foreign > 0) {
+  console.log(
+    `(ignored ${foreign} typing mismatch(es) in ../packages — see this file)`,
+  );
+}
+if (ours.length > 0) {
+  console.error(ours.join("\n"));
+  process.exit(1);
+}
+console.log("typecheck ok");
diff --git a/cloudflare/src/Game.ts b/cloudflare/src/Game.ts
new file mode 100644
index 0000000..9c7721a
--- /dev/null
+++ b/cloudflare/src/Game.ts
@@ -0,0 +1,800 @@
+// One game's server-side state: the lobby, the start sequence and the turn loop.
+//
+// This is the relay half of src/server/GameServer.ts, rewritten without Node
+// (no `ws`, no winston, no timers of its own): the host object drives it through
+// secondTick() and endTurn(). The simulation itself runs on every client; all this
+// does is order intents into numbered turns and hand them to everyone.
+//
+// Deliberately NOT ported (see cloudflare/README.md): desync detection, the replay
+// archive, account/cosmetics lookups, name anonymisation, pools and ranked teams.
+
+import {
+  Difficulty,
+  GameMapSize,
+  GameMapType,
+  GameMode,
+  GameType,
+} from "@openfront/engine-api/game/GameTypes";
+import type {
+  ClientID,
+  GameConfig,
+  GameID,
+  StampedIntent,
+  Turn,
+} from "@openfront/engine-api/Schemas";
+import { CloseCode, CloseReason } from "@openfront/shared/CloseCodes";
+import {
+  type ClientMessage,
+  type GameInfo,
+  type PublicGameInfo,
+  type PublicGameType,
+  type ServerMessage,
+  WireGameStartInfoSchema,
+  type WireGameStartInfo,
+} from "@openfront/shared/WireSchemas";
+import {
+  createGameWireContext,
+  encodeServerMessage,
+} from "@openfront/shared/ZbinWire";
+import type { ZbContext } from "@openfront/zbin";
+import { applyGameConfigPatch } from "../../src/server/ConfigPatch";
+import {
+  authorizeIntent,
+  type IntentActor,
+  type IntentOutcome,
+} from "../../src/server/IntentAuthorization";
+
+const WS_OPEN = 1;
+
+export const TURN_INTERVAL_MS = 100;
+// Lobby -> prestart message -> this pause -> start, so slow clients can load.
+const PRESTART_DELAY_MS = 2_000;
+// A join landing this soon after start meant to play: tell them they missed it.
+const LATE_JOIN_GRACE_MS = 5_000;
+// No ping for this long closes the socket (the client reconnects with `rejoin`).
+const STALE_PING_MS = 60_000;
+// No ping for this long marks the player disconnected inside the simulation.
+const SIM_DISCONNECT_MS = 30_000;
+const MAX_GAME_DURATION_MS = 3 * 60 * 60 * 1000;
+const EMPTY_LOBBY_TTL_MS = 10 * 60 * 1000;
+const EMPTY_GAME_TIMEOUT_MS = 10 * 60 * 1000;
+// After the winner vote settles, players get this long to read the result
+// before the game is torn down underneath them.
+const POST_WIN_LINGER_MS = 60_000;
+// Cheap abuse guard: more messages than this in one second are dropped.
+const MAX_MESSAGES_PER_SECOND = 200;
+
+const KICK_REASON_LOBBY_CREATOR = "kick_reason.lobby_creator";
+const KICK_REASON_HOST_LEFT = "kick_reason.host_left";
+const KICK_REASON_INVALID_MESSAGE = "kick_reason.invalid_message";
+
+export type JoinResult = "joined" | "rejected" | "started" | "kicked" | "ended";
+export type Phase = "lobby" | "active" | "finished";
+
+export interface GameHooks {
+  /** The first player joined (not called for a game nobody ever enters). */
+  onOpened?(game: Game): void;
+  onStarted?(game: Game): void;
+  onEnded?(game: Game, result: GameResult): void;
+}
+
+export interface GameResult {
+  winnerKey: string | null;
+  players: number;
+  peakPlayers: number;
+  turns: number;
+  startedAt: number | null;
+  /** The humans who were in the game when it started (the leaderboard credits them). */
+  roster: { clientID: ClientID; persistentID: string; username: string }[];
+}
+
+export interface GameOptions {
+  id: GameID;
+  createdAt: number;
+  config: Partial<GameConfig> | undefined;
+  creatorPersistentID?: string;
+  startsAt?: number;
+  publicGameType?: PublicGameType;
+  hooks?: GameHooks;
+}
+
+const DEFAULT_CONFIG: GameConfig = {
+  donateGold: false,
+  donateTroops: false,
+  gameMap: GameMapType.World,
+  gameType: GameType.Private,
+  gameMapSize: GameMapSize.Normal,
+  difficulty: Difficulty.Easy,
+  nations: "default",
+  infiniteGold: false,
+  infiniteTroops: false,
+  instantBuild: false,
+  randomSpawn: false,
+  gameMode: GameMode.FFA,
+  bots: 400,
+  disabledUnits: [],
+};
+
+/** Same stripping as src/server sanitizeConfigForWire: secrets never go to clients. */
+function sanitizeConfig(config: GameConfig): GameConfig {
+  const { allowedPublicIds, nameRevealPublicIds, pool, ...rest } = config;
+  void allowedPublicIds;
+  void nameRevealPublicIds;
+  void pool;
+  return rest;
+}
+
+export class Conn {
+  lastPing = Date.now();
+  simDisconnected = false;
+  private windowStart = 0;
+  private windowCount = 0;
+
+  constructor(
+    readonly clientID: ClientID,
+    readonly persistentID: string,
+    public username: string,
+    public clanTag: string | null,
+    public ws: WebSocket | null,
+    public spectator: boolean,
+  ) {}
+
+  get open(): boolean {
+    return this.ws !== null && this.ws.readyState === WS_OPEN;
+  }
+
+  send(bytes: Uint8Array): void {
+    if (this.ws !== null && this.ws.readyState === WS_OPEN) this.ws.send(bytes);
+  }
+
+  /** True when this message is within the per-second budget. */
+  allow(now: number): boolean {
+    if (now - this.windowStart >= 1000) {
+      this.windowStart = now;
+      this.windowCount = 0;
+    }
+    return ++this.windowCount <= MAX_MESSAGES_PER_SECOND;
+  }
+}
+
+export class Game {
+  readonly id: GameID;
+  readonly createdAt: number;
+  readonly gameConfig: GameConfig;
+  readonly publicGameType: PublicGameType | undefined;
+  stage: "lobby" | "prestart" | "started" = "lobby";
+  ended = false;
+  /** Seeded from the roster at start; client frames decode against it. */
+  zbinCtx: ZbContext | undefined;
+
+  private readonly hooks: GameHooks;
+  private readonly creatorPersistentID: string | undefined;
+  private lobbyCreatorID: ClientID | undefined;
+  private startsAt: number | undefined;
+  private readonly conns = new Map<ClientID, Conn>();
+  private readonly byPersistent = new Map<string, ClientID>();
+  private readonly kicked = new Set<string>();
+  private turns: Turn[] = [];
+  private intents: StampedIntent[] = [];
+  private paused = false;
+  private startAt = 0;
+  private startTime: number | null = null;
+  private gameStartInfo: WireGameStartInfo | undefined;
+  private roster: GameResult["roster"] = [];
+  private readonly groupToken = crypto.randomUUID();
+  private lastPingUpdate = Date.now();
+  private emptySince: number | null = null;
+  private readonly winnerVotes = new Map<string, Set<ClientID>>();
+  private winnerKey: string | null = null;
+  private winnerSettledAt: number | null = null;
+  private peakPlayers = 0;
+  private opened = false;
+
+  constructor(opts: GameOptions) {
+    this.id = opts.id;
+    this.createdAt = opts.createdAt;
+    this.gameConfig = { ...DEFAULT_CONFIG, ...opts.config };
+    this.creatorPersistentID = opts.creatorPersistentID;
+    this.startsAt = opts.startsAt;
+    this.publicGameType = opts.publicGameType;
+    this.hooks = opts.hooks ?? {};
+  }
+
+  // ---------------------------------------------------------------- queries
+
+  isPublic(): boolean {
+    return this.gameConfig.gameType === GameType.Public;
+  }
+
+  hasStarted(): boolean {
+    return this.stage !== "lobby";
+  }
+
+  numClients(): number {
+    return this.activeConns().length;
+  }
+
+  private activeConns(): Conn[] {
+    return [...this.conns.values()].filter((c) => c.open);
+  }
+
+  private playerCount(): number {
+    return this.activeConns().filter((c) => !c.spectator).length;
+  }
+
+  private reachedMaxPlayers(): boolean {
+    // Only scheduled public lobbies start early by filling up; a private lobby
+    // at its cap just turns further players away.
+    return (
+      this.isPublic() &&
+      !!this.gameConfig.maxPlayers &&
+      this.playerCount() >= this.gameConfig.maxPlayers
+    );
+  }
+
+  /** When the lobby countdown ends (unix ms); undefined until it is scheduled. */
+  get startsAtMs(): number | undefined {
+    return this.startsAt;
+  }
+
+  setStartsAt(startsAt: number | undefined): void {
+    this.startsAt = startsAt;
+  }
+
+  /** Still accepting players and counting down (or waiting for a countdown). */
+  isOpenLobby(now: number): boolean {
+    if (this.ended || this.stage !== "lobby") return false;
+    if (this.startsAt !== undefined && now >= this.startsAt) return false;
+    return !this.reachedMaxPlayers();
+  }
+
+  /** The entry the public lobby browser lists for this game. */
+  publicInfo(): PublicGameInfo | undefined {
+    if (this.publicGameType === undefined) return undefined;
+    return {
+      gameID: this.id,
+      numClients: this.numClients(),
+      startsAt: this.startsAt,
+      gameConfig: sanitizeConfig(this.gameConfig),
+      publicGameType: this.publicGameType,
+    };
+  }
+
+  /** Whether anyone has ever joined. */
+  get wasOpened(): boolean {
+    return this.opened;
+  }
+
+  private notePlayers(): void {
+    this.peakPlayers = Math.max(this.peakPlayers, this.playerCount());
+    if (!this.opened && this.peakPlayers > 0) {
+      this.opened = true;
+      this.hooks.onOpened?.(this);
+    }
+  }
+
+  gameInfo(): GameInfo {
+    return {
+      gameID: this.id,
+      clients: this.activeConns().map((c) => ({
+        clientID: c.clientID,
+        username: c.username,
+        clanTag: c.clanTag,
+        spectator: c.spectator ? true : undefined,
+      })),
+      lobbyCreatorClientID: this.lobbyCreatorID,
+      gameConfig: sanitizeConfig(this.gameConfig),
+      startsAt: this.startsAt,
+      serverTime: Date.now(),
+      publicGameType: this.publicGameType,
+    };
+  }
+
+  /** A pure read of the lifecycle; secondTick() acts on it. */
+  phase(now: number): Phase {
+    if (this.ended) return "finished";
+    if (now > this.createdAt + MAX_GAME_DURATION_MS) return "finished";
+
+    const beforeStart =
+      this.startsAt !== undefined ? now < this.startsAt : true;
+    if (this.stage === "lobby" && beforeStart && !this.reachedMaxPlayers()) {
+      // An abandoned lobby (nobody ever connected, or everyone left) is reaped.
+      if (
+        this.numClients() === 0 &&
+        now > this.createdAt + EMPTY_LOBBY_TTL_MS
+      ) {
+        return "finished";
+      }
+      return "lobby";
+    }
+    if (
+      this.winnerSettledAt !== null &&
+      now > this.winnerSettledAt + POST_WIN_LINGER_MS
+    ) {
+      return "finished";
+    }
+    if (this.numClients() > 0) return "active";
+
+    // Nobody connected: give a committed start a moment for clients to appear,
+    // then reap.
+    const warmupFrom = this.startsAt ?? this.startTime ?? this.createdAt;
+    if (now > warmupFrom + 30_000 && now > this.lastPingUpdate + 20_000) {
+      return "finished";
+    }
+    if (
+      this.hasStarted() &&
+      this.emptySince !== null &&
+      now > this.emptySince + EMPTY_GAME_TIMEOUT_MS
+    ) {
+      return "finished";
+    }
+    return "active";
+  }
+
+  // ---------------------------------------------------------------- joining
+
+  join(conn: Conn): JoinResult {
+    if (this.ended) return "ended";
+    if (this.kicked.has(conn.persistentID)) return "kicked";
+
+    // The player list is frozen at start, so a latecomer can only watch.
+    if (this.stage === "started") {
+      if (conn.ws !== null && this.rejoin(conn.ws, conn.persistentID, 0)) {
+        return "joined";
+      }
+      if (
+        !conn.spectator &&
+        Date.now() - (this.startTime ?? 0) < LATE_JOIN_GRACE_MS
+      ) {
+        this.sendTo(conn, { type: "error", error: "game-started" });
+        return "started";
+      }
+      conn.spectator = true;
+    }
+
+    if (
+      !conn.spectator &&
+      this.gameConfig.maxPlayers &&
+      this.playerCount() >= this.gameConfig.maxPlayers
+    ) {
+      this.sendTo(conn, { type: "error", error: "full-lobby" });
+      return "rejected";
+    }
+
+    this.conns.set(conn.clientID, conn);
+    this.byPersistent.set(conn.persistentID, conn.clientID);
+    if (conn.persistentID === this.creatorPersistentID) {
+      this.lobbyCreatorID = conn.clientID;
+    }
+    conn.lastPing = Date.now();
+    this.lastPingUpdate = Date.now();
+    this.setSimDisconnected(conn, false);
+    this.notePlayers();
+
+    if (this.stage === "started") this.sendStart(conn, 0);
+    else this.broadcastLobbyInfo();
+    return "joined";
+  }
+
+  /** Reattach a known player (page refresh, dropped link). */
+  rejoin(
+    ws: WebSocket,
+    persistentID: string,
+    lastTurn: number,
+    identity?: { username: string; clanTag: string | null },
+  ): boolean {
+    if (this.ended) return false;
+    const clientID = this.byPersistent.get(persistentID);
+    const conn = clientID !== undefined ? this.conns.get(clientID) : undefined;
+    if (conn === undefined) return false;
+
+    const old = conn.ws;
+    conn.ws = ws;
+    if (old !== null && old !== ws) {
+      try {
+        old.close(CloseCode.Normal, "replaced");
+      } catch {
+        // already closed
+      }
+    }
+    if (identity !== undefined && this.stage === "lobby") {
+      conn.username = identity.username;
+      conn.clanTag = identity.clanTag;
+    }
+    conn.lastPing = Date.now();
+    this.lastPingUpdate = Date.now();
+    this.setSimDisconnected(conn, false);
+
+    if (this.stage === "started") this.sendStart(conn, lastTurn);
+    else this.broadcastLobbyInfo();
+    return true;
+  }
+
+  connFor(clientID: ClientID): Conn | undefined {
+    return this.conns.get(clientID);
+  }
+
+  connForPersistent(persistentID: string): Conn | undefined {
+    const clientID = this.byPersistent.get(persistentID);
+    return clientID === undefined ? undefined : this.conns.get(clientID);
+  }
+
+  handleDisconnect(conn: Conn, ws: WebSocket): void {
+    // A stale socket closing after a rejoin must not unseat the new one.
+    if (conn.ws !== ws) return;
+    conn.ws = null;
+    this.checkWinnerAfterElectorateShrink();
+
+    // After start the seat is kept for a reconnect.
+    if (this.hasStarted()) return;
+
+    this.conns.delete(conn.clientID);
+    this.byPersistent.delete(conn.persistentID);
+    // Without its host a private lobby can never start: close it.
+    if (!this.isPublic() && conn.persistentID === this.creatorPersistentID) {
+      for (const c of this.activeConns())
+        this.kickClient(c.clientID, KICK_REASON_HOST_LEFT);
+      this.end();
+      return;
+    }
+    this.broadcastLobbyInfo();
+  }
+
+  // ------------------------------------------------------------- messages
+
+  /** A decoded frame from a seated client. */
+  handleMessage(conn: Conn, msg: ClientMessage, now: number): void {
+    if (!conn.allow(now)) return;
+    switch (msg.type) {
+      case "rejoin":
+        if (this.stage === "started" && conn.ws !== null) {
+          this.sendStart(conn, msg.lastTurn);
+        }
+        return;
+      case "intent": {
+        // Watchers never act in the simulation.
+        if (conn.spectator) return;
+        const outcome = this.handleIntent(msg.intent, {
+          clientID: conn.clientID,
+          isLobbyCreator: conn.clientID === this.lobbyCreatorID,
+          isAdmin: false,
+          isAdminBot: false,
+        });
+        if (outcome.status !== 200) {
+          console.warn(
+            JSON.stringify({
+              msg: "intent rejected",
+              type: msg.intent.type,
+              clientID: conn.clientID,
+              gameID: this.id,
+              reason: outcome.error,
+            }),
+          );
+        }
+        return;
+      }
+      case "ping":
+        conn.lastPing = now;
+        this.lastPingUpdate = now;
+        this.sendTo(conn, { type: "pong", sentAt: msg.sentAt });
+        return;
+      case "spectate":
+        // Lobby only: once started the player list is frozen.
+        if (this.stage === "lobby") {
+          conn.spectator = msg.spectator;
+          this.broadcastLobbyInfo();
+        }
+        return;
+      case "winner":
+        this.handleWinner(conn, msg.winner);
+        return;
+      default:
+        // hash / live_stats / report / log: nothing to do without desync
+        // detection or an archive.
+        return;
+    }
+  }
+
+  kickForInvalidMessage(conn: Conn): void {
+    this.kickClient(conn.clientID, KICK_REASON_INVALID_MESSAGE);
+  }
+
+  private handleIntent(
+    intent: Parameters<typeof authorizeIntent>[0],
+    actor: IntentActor,
+  ): IntentOutcome {
+    const denied = authorizeIntent(intent, actor, {
+      isPublic: this.isPublic(),
+      isListed: false,
+      isQueued: false,
+      hasStarted: this.hasStarted(),
+    });
+    if (denied !== null) return denied;
+
+    const stamped = { ...intent, clientID: actor.clientID } as StampedIntent;
+    switch (stamped.type) {
+      case "kick_player": {
+        const target = stamped.targetClientID;
+        if (target === undefined) {
+          return { status: 404, error: "no matching player to kick" };
+        }
+        if (target === actor.clientID) {
+          return { status: 400, error: "cannot kick yourself" };
+        }
+        this.kickClient(target, KICK_REASON_LOBBY_CREATOR);
+        return { status: 200 };
+      }
+      case "update_game_config":
+        applyGameConfigPatch(this.gameConfig, stamped.config);
+        this.broadcastLobbyInfo();
+        return { status: 200 };
+      case "toggle_game_start_timer":
+        if (this.startsAt !== undefined) {
+          this.startsAt = undefined;
+        } else {
+          this.startsAt = Date.now() + (this.gameConfig.startDelay ?? 0) * 1000;
+        }
+        this.broadcastLobbyInfo();
+        return { status: 200 };
+      case "toggle_pause":
+        // Pausing: flush the intent into a turn before the pause short-circuits
+        // endTurn(). Unpausing: clear the flag first so the next turn runs.
+        if (stamped.paused) {
+          this.intents.push(stamped);
+          this.endTurn();
+          this.paused = true;
+        } else {
+          this.paused = false;
+          this.intents.push(stamped);
+          this.endTurn();
+        }
+        return { status: 200 };
+      default:
+        if (!this.paused) this.intents.push(stamped);
+        return { status: 200 };
+    }
+  }
+
+  private kickClient(clientID: ClientID, reason: string): void {
+    const c = this.conns.get(clientID);
+    if (c === undefined) return;
+    this.kicked.add(c.persistentID);
+    this.sendTo(c, { type: "error", error: reason });
+    const ws = c.ws;
+    this.conns.delete(clientID);
+    this.byPersistent.delete(c.persistentID);
+    c.ws = null;
+    try {
+      ws?.close(CloseCode.Normal, reason);
+    } catch {
+      // already closed
+    }
+  }
+
+  // ------------------------------------------------------------ the winner
+
+  private voters(): Conn[] {
+    return this.activeConns().filter((c) => !c.spectator);
+  }
+
+  private handleWinner(conn: Conn, winner: unknown): void {
+    if (this.stage !== "started" || this.ended || this.winnerKey !== null)
+      return;
+    if (conn.spectator) return;
+    // One vote per player, keyed by who they say won.
+    for (const set of this.winnerVotes.values()) set.delete(conn.clientID);
+    const key = JSON.stringify(winner ?? null);
+    const set = this.winnerVotes.get(key) ?? new Set<ClientID>();
+    set.add(conn.clientID);
+    this.winnerVotes.set(key, set);
+    this.tallyWinner();
+  }
+
+  private checkWinnerAfterElectorateShrink(): void {
+    if (this.stage === "started" && !this.ended && this.winnerKey === null) {
+      this.tallyWinner();
+    }
+  }
+
+  private tallyWinner(): void {
+    const eligible = new Set(this.voters().map((c) => c.clientID));
+    // A 1v1 loser often disconnects before voting: count only still-present voters.
+    const needed = Math.floor(eligible.size / 2) + 1;
+    for (const [key, set] of this.winnerVotes) {
+      let n = 0;
+      for (const id of set) if (eligible.has(id)) n++;
+      if (n >= needed && n > 0) {
+        this.winnerKey = key;
+        this.winnerSettledAt = Date.now();
+        return;
+      }
+    }
+  }
+
+  // ----------------------------------------------------------- the loop
+
+  /** Called once a second by the host. */
+  secondTick(now: number): void {
+    if (this.ended) return;
+    this.pruneStale(now);
+    this.emptySince = this.numClients() === 0 ? (this.emptySince ?? now) : null;
+
+    const phase = this.phase(now);
+    if (phase === "finished") {
+      this.end();
+      return;
+    }
+    if (this.stage === "lobby" && phase === "active") {
+      // Never start a game nobody is connected to.
+      if (this.numClients() === 0) return;
+      this.prestart();
+      this.startAt = now + PRESTART_DELAY_MS;
+    } else if (this.stage === "prestart" && now >= this.startAt) {
+      // Held, not cancelled: a socket that just closed is often reconnecting.
+      if (this.numClients() > 0) this.start();
+    }
+    if (this.stage !== "started") this.broadcastLobbyInfo();
+  }
+
+  /** Called every TURN_INTERVAL_MS by the host once the game has started. */
+  endTurn(): void {
+    if (this.paused || this.ended || this.stage !== "started") return;
+    const turn: Turn = { turnNumber: this.turns.length, intents: this.intents };
+    this.turns.push(turn);
+    this.intents = [];
+    this.checkDisconnectedStatus();
+    this.broadcast({ type: "turn", turn });
+  }
+
+  private pruneStale(now: number): void {
+    for (const c of this.activeConns()) {
+      if (now - c.lastPing > STALE_PING_MS) {
+        // Not a normal close: the seat is kept, so a client whose pings were
+        // lost on a stuck link is meant to come back.
+        c.ws?.close(CloseCode.TryAgainLater, CloseReason.NoHeartbeat);
+      }
+    }
+    this.checkWinnerAfterElectorateShrink();
+  }
+
+  private prestart(): void {
+    this.stage = "prestart";
+    this.broadcast({
+      type: "prestart",
+      gameMap: this.gameConfig.gameMap,
+      gameMapSize: this.gameConfig.gameMapSize,
+    });
+  }
+
+  private start(): void {
+    if (this.stage === "started" || this.ended) return;
+    const players = this.activeConns().filter((c) => !c.spectator);
+    const parsed = WireGameStartInfoSchema.safeParse({
+      gameID: this.id,
+      lobbyCreatedAt: this.createdAt,
+      config: sanitizeConfig(this.gameConfig),
+      players: players.map((c) => ({
+        username: c.username,
+        clanTag: c.clanTag,
+        clientID: c.clientID,
+        isLobbyCreator: this.lobbyCreatorID === c.clientID,
+      })),
+    });
+    if (!parsed.success) {
+      console.error(
+        JSON.stringify({
+          msg: "bad game start info",
+          gameID: this.id,
+          error: String(parsed.error),
+        }),
+      );
+      this.end();
+      return;
+    }
+    this.gameStartInfo = parsed.data;
+    this.roster = players.map((c) => ({
+      clientID: c.clientID,
+      persistentID: c.persistentID,
+      username: c.username,
+    }));
+    // Seed the clientID dictionary from the same players array, in the same
+    // order, that every client receives in the start message.
+    this.zbinCtx = createGameWireContext(parsed.data.players);
+    this.stage = "started";
+    this.startTime = Date.now();
+    this.lastPingUpdate = Date.now();
+    for (const c of this.activeConns()) this.sendStart(c, 0);
+    this.hooks.onStarted?.(this);
+  }
+
+  private sendStart(conn: Conn, lastTurn: number): void {
+    if (this.gameStartInfo === undefined) return;
+    this.sendTo(conn, {
+      type: "start",
+      turns: this.turns.slice(lastTurn),
+      gameStartInfo: this.gameStartInfo,
+      lobbyCreatedAt: this.createdAt,
+      myClientID: conn.clientID,
+      groupToken: this.groupToken,
+    });
+  }
+
+  private checkDisconnectedStatus(): void {
+    if (this.turns.length % 5 !== 0) return;
+    const now = Date.now();
+    for (const c of this.conns.values()) {
+      const stale = now - c.lastPing > SIM_DISCONNECT_MS;
+      if (!c.simDisconnected && stale) this.setSimDisconnected(c, true);
+      else if (c.simDisconnected && !stale) this.setSimDisconnected(c, false);
+    }
+  }
+
+  private setSimDisconnected(conn: Conn, isDisconnected: boolean): void {
+    conn.simDisconnected = isDisconnected;
+    // Only a player's status reaches the simulation: a spectator has no entry
+    // in gameStartInfo.players, so an intent naming one refers to nobody.
+    if (conn.spectator) return;
+    this.intents.push({
+      type: "mark_disconnected",
+      clientID: conn.clientID,
+      isDisconnected,
+    } as StampedIntent);
+  }
+
+  end(): void {
+    if (this.ended) return;
+    this.ended = true;
+    const result: GameResult = {
+      winnerKey: this.winnerKey,
+      players: this.gameStartInfo?.players.length ?? 0,
+      peakPlayers: this.peakPlayers,
+      turns: this.turns.length,
+      startedAt: this.startTime,
+      roster: this.roster,
+    };
+    for (const c of this.conns.values()) {
+      try {
+        c.ws?.close(CloseCode.Normal, "game ended");
+      } catch {
+        // already closed
+      }
+      c.ws = null;
+    }
+    this.hooks.onEnded?.(this, result);
+  }
+
+  // ------------------------------------------------------------ sending
+
+  private broadcastLobbyInfo(): void {
+    if (this.stage === "started" || this.ended) return;
+    const lobby = this.gameInfo();
+    for (const c of this.activeConns()) {
+      this.sendTo(c, {
+        type: "lobby_info",
+        lobby,
+        myClientID: c.clientID,
+        groupToken: this.groupToken,
+      });
+    }
+  }
+
+  private broadcast(msg: ServerMessage): void {
+    const bytes = encodeServerMessage(msg, this.zbinCtx);
+    for (const c of this.conns.values()) c.send(bytes);
+  }
+
+  private sendTo(conn: Conn, msg: ServerMessage): void {
+    try {
+      conn.send(encodeServerMessage(msg, this.zbinCtx));
+    } catch (e) {
+      console.error(
+        JSON.stringify({
+          msg: "send failed",
+          gameID: this.id,
+          clientID: conn.clientID,
+          error: String(e),
+        }),
+      );
+    }
+  }
+}
