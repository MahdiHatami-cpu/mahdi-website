+const float TO_SIGMA = 255.0 / 36.0;
+// Second octave: rotated and at the golden ratio of the first one's scale, so
+// the repeat of either layer is hidden by the other.
+const mat2 ROT = mat2(0.8, 0.6, -0.6, 0.8);
