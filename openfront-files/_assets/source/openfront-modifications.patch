+// Inserting markup at the very start of a rendered page's <head>.
+
+/** Inserts `snippet` just before </head> (ignoring a "</head>" inside an HTML comment). */
+export function insertBeforeHeadEnd(html: string, snippet: string): string {
+  const masked = html.replace(/<!--[\s\S]*?-->/g, (c) => " ".repeat(c.length));
+  const end = masked.search(/<\/head\s*>/i);
+  if (end < 0) throw new Error("could not find </head> in the rendered page");
+  return html.slice(0, end) + snippet + html.slice(end);
+}
+
+/**
+ * Inserts `snippet` at the start of <head>, right after the charset <meta> when there is
+ * one (browsers look for the charset in the first 1024 bytes, and a snippet can be several
+ * KB), ignoring any "<head>" that appears inside an HTML comment.
+ *
+ * Why the start: an inline script cannot run while a stylesheet before it is still loading,
+ * and nothing after a blocked request in <head> is guaranteed to run soon. Whatever must
+ * work on a bad connection (the loading screen) or must happen before the page's own code
+ * (switching the ads off) goes here, ahead of every <link> and <script src>.
+ */
+export function insertAtHeadStart(html: string, snippet: string): string {
+  const masked = html.replace(/<!--[\s\S]*?-->/g, (c) => " ".repeat(c.length));
+  const head = /<head(\s[^>]*)?>/i.exec(masked);
+  if (!head) throw new Error("could not find <head> in the rendered page");
+  let at = head.index + head[0].length;
+
+  const charset = /^\s*<meta\s+charset\s*=[^>]*>/i.exec(masked.slice(at));
+  if (charset) at += charset[0].length;
+
+  return html.slice(0, at) + "\n" + snippet + html.slice(at);
+}
