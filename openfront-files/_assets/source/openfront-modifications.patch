index 0000000..e6e1a53
--- /dev/null
+++ b/cloudflare/src/GameHost.ts
@@ -0,0 +1,646 @@
+// The Worker-index object (/w0, /w1, ...): the Cloudflare counterpart of one
+// src/server/Worker.ts process plus its share of the master's lobby scheduling.
+// It owns every game of its shard, the game WebSocket, the lobby-list WebSocket,
+// the small HTTP API the client calls, and the timers that drive the games.
+//
+// All games of a shard share this one object on purpose: Durable Object duration
+// is billed per object, so N concurrent games here cost what one would.
+//
+// Staying inside the Free plan (13,000 GB-s of duration a day) shapes the design:
+//  - Game sockets are ordinary sockets: while anyone is playing, the object stays
+//    in memory and runs the turn timer. That is real usage.
+//  - Lobby-list sockets use the Hibernation API. A homepage tab left open does not
+//    keep the object awake; an alarm at each countdown boundary refreshes the list.
+//  - The timer stops by itself when no game has a player, so the object can
+//    hibernate even while public lobbies sit empty in the queue.
+//
+// State is in memory, like the Node server: if the object is evicted or a new
+// version is deployed, games in flight are lost.
+
+import type { GameID } from "@openfront/engine-api/Schemas";
+import { isValidGameID } from "@openfront/engine-api/Schemas";
+import { simpleHash } from "@openfront/engine-lib/Util";
+import { CloseCode, CloseReason } from "@openfront/shared/CloseCodes";
+import { generateGameID, generateID } from "@openfront/shared/SharedUtil";
+import { type ClientMessage } from "@openfront/shared/WireSchemas";
+import {
+  CreateGameInputSchema,
+  isPrivateGameInput,
+} from "@openfront/shared/WorkerSchemas";
+import {
+  decodeClientMessage,
+  encodeServerMessage,
+} from "@openfront/shared/ZbinWire";
+import { DurableObject } from "cloudflare:workers";
+import { z } from "zod";
+import { censorPlayer } from "../../src/server/Censor";
+import { resolvePlayToken } from "./accounts/token";
+import { LobbyDb } from "./db";
+import { type Env, numWorkers } from "./env";
+import { Conn, Game, type GameOptions, TURN_INTERVAL_MS } from "./Game";
+import { Playlist } from "./Playlist";
+import { PublicLobbies } from "./PublicLobbies";
+
+const LOBBIES_TAG = "lobbies";
+
+interface Session {
+  ws: WebSocket;
+  conn: Conn | null;
+  game: Game | null;
+  /** The host the socket was opened on: a signed-in player's token is checked against it. */
+  host: string;
+  /** A sign-in token is being checked; frames that arrive meanwhile are dropped. */
+  joining: boolean;
+}
+
+function json(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { "content-type": "application/json" },
+  });
+}
+
+function safeClose(ws: WebSocket, code: number, reason: string): void {
+  try {
+    ws.close(code, reason);
+  } catch {
+    // already closed
+  }
+}
+
+export class GameHost extends DurableObject<Env> {
+  private readonly games = new Map<GameID, Game>();
+  private timer: ReturnType<typeof setInterval> | undefined;
+  private tickCount = 0;
+  private workerIndex = 0;
+  private readonly lobbyDb: LobbyDb;
+  private readonly publicLobbies: PublicLobbies | null;
+  /** The build id clients must carry; see loadCommit(). */
+  private commit: string;
+  private readonly playlist: Playlist;
+
+  constructor(ctx: DurableObjectState, env: Env) {
+    super(ctx, env);
+    this.commit = env.GIT_COMMIT;
+    // Operational breadcrumb: every line is a cold start, and all in-memory
+    // state (games, the lobby queue) starts empty again.
+    console.log(JSON.stringify({ msg: "GameHost started", id: ctx.id.name }));
+    // Resolved before the object handles a single request or socket event.
+    void ctx.blockConcurrencyWhile(async () => {
+      this.commit = await this.loadCommit();
+      await this.loadMaps();
+    });
+    // Named ids carry their shard (`w3`), which is also how an alarm that wakes
+    // the object with no request knows who it is.
+    const named = /^w(\d+)$/.exec(ctx.id.name ?? "");
+    if (named !== null) this.workerIndex = Number(named[1]);
+
+    this.lobbyDb = new LobbyDb(env.DB);
+    this.playlist = new Playlist();
+    const lobbyMs =
+      Math.max(5, Number(env.PUBLIC_LOBBY_SECONDS ?? "60") || 60) * 1000;
+    this.publicLobbies =
+      env.PUBLIC_LOBBIES === "0"
+        ? null
+        : new PublicLobbies(
+            {
+              game: (id) => this.games.get(id),
+              games: () => this.games.values(),
+              createGame: (opts) => this.createGame(opts),
+            },
+            this.playlist,
+            this.lobbyDb,
+            {
+              lobbyMs,
+              letter: env.INSTANCE_LETTER || "a",
+              shards: numWorkers(env),
+              shard: () => this.workerIndex,
+            },
+            () => this.commit,
+          );
+  }
+
+  /** A game by id, including a public lobby this instance has not created yet. */
+  private findGame(id: GameID): Game | undefined {
+    return this.games.get(id) ?? this.publicLobbies?.resolve(id, Date.now());
+  }
+
+  /**
+   * The build id of the page this deployment serves, so the version check can
+   * never drift from the client it is checking. The page and this Worker ship in
+   * one deploy, and the id is written next to the page by scripts/build-site.ts.
+   * Without the assets (an API-only deploy) the GIT_COMMIT var stands in.
+   */
+  private async loadCommit(): Promise<string> {
+    const assets = this.env.ASSETS;
+    if (assets !== undefined) {
+      try {
+        const res = await assets.fetch("https://assets.invalid/commit.txt");
+        if (res.ok) {
+          const text = (await res.text()).trim();
+          if (text.length > 0 && text.length <= 64) return text;
+        }
+      } catch (e) {
+        console.warn(
+          JSON.stringify({ msg: "commit.txt unreadable", error: String(e) }),
+        );
+      }
+    }
+    return this.env.GIT_COMMIT;
+  }
+
+  /**
+   * The maps this deployment actually ships (maps.json, written by
+   * scripts/build-site.ts next to the page), so public lobbies never deal a map
+   * whose files are not there. Absent (an API-only deploy, an older build) it keeps
+   * the full list.
+   */
+  private async loadMaps(): Promise<void> {
+    const assets = this.env.ASSETS;
+    if (assets === undefined) return;
+    try {
+      const res = await assets.fetch("https://assets.invalid/maps.json");
+      if (!res.ok) return;
+      const body = (await res.json()) as { maps?: unknown };
+      if (Array.isArray(body.maps)) {
+        this.playlist.setAllowed(
+          body.maps.filter((m): m is string => typeof m === "string"),
+        );
+      }
+    } catch (e) {
+      console.warn(
+        JSON.stringify({ msg: "maps.json unreadable", error: String(e) }),
+      );
+    }
+  }
+
+  override async fetch(request: Request): Promise<Response> {
+    const hinted = request.headers.get("x-worker-index");
+    if (hinted !== null) this.workerIndex = Number(hinted);
+    const path =
+      request.headers.get("x-worker-path") ?? new URL(request.url).pathname;
+
+    if (request.headers.get("Upgrade")?.toLowerCase() === "websocket") {
+      if (path === "/" || path === "") {
+        return this.acceptGameSocket(new URL(request.url).host);
+      }
+      if (path === "/lobbies") return this.acceptLobbySocket();
+      return new Response("Not found", { status: 404 });
+    }
+    return this.handleHttp(request, path);
+  }
+
+  // ------------------------------------------------------------------ HTTP
+
+  private async handleHttp(request: Request, path: string): Promise<Response> {
+    const method = request.method;
+
+    if (method === "GET" && path === "/api/health") {
+      return json({
+        status: "ok",
+        games: this.games.size,
+        d1: this.lobbyDb.enabled,
+      });
+    }
+
+    if (method === "POST" && path === "/api/create_game") {
+      return this.createPrivateGame(request);
+    }
+
+    // What the lobby browser would show right now, for anything that is not a
+    // WebSocket (status pages, health probes).
+    if (method === "GET" && path === "/api/public_games") {
+      if (this.publicLobbies === null)
+        return json({ error: "Public lobbies are off" }, 404);
+      const now = Date.now();
+      this.publicLobbies.maintain(now);
+      return json({ serverTime: now, games: this.publicLobbies.snapshot(now) });
+    }
+
+    // History from D1: what was scheduled, started and finished.
+    if (method === "GET" && path === "/api/lobbies/recent") {
+      const limit = Math.min(
+        100,
+        Math.max(
+          1,
+          Number(new URL(request.url).searchParams.get("limit") ?? "20") || 20,
+        ),
+      );
+      try {
+        return json({ lobbies: await this.lobbyDb.recent(limit) });
+      } catch (e) {
+        return json({ error: String(e) }, 503);
+      }
+    }
+
+    let m = /^\/api\/game\/([^/]+)\/exists$/.exec(path);
+    if (method === "GET" && m !== null) {
+      return json({ exists: this.findGame(m[1]!) !== undefined });
+    }
+
+    m = /^\/api\/game\/([^/]+)$/.exec(path);
+    if (method === "GET" && m !== null) {
+      const game = this.findGame(m[1]!);
+      if (game === undefined) return json({ error: "Game not found" }, 404);
+      return json(game.gameInfo());
+    }
+
+    m = /^\/api\/singleplayer\/([^/]+)\/heartbeat$/.exec(path);
+    if (method === "POST" && m !== null) {
+      if (!isValidGameID(m[1]!)) return json({ error: "Invalid game ID" }, 400);
+      return new Response(null, { status: 204 });
+    }
+
+    return json({ error: "Not found" }, 404);
+  }
+
+  private async createPrivateGame(request: Request): Promise<Response> {
+    // Identify the creator from their token. Never accept a persistent id directly.
+    const auth = request.headers.get("authorization");
+    if (auth === null || !auth.startsWith("Bearer ")) {
+      return json(
+        { error: "Authorization header required to create a game" },
+        400,
+      );
+    }
+    // A guest's own id, or a signed-in player's token (their account id then).
+    const creatorId = await resolvePlayToken(
+      this.env,
+      new URL(request.url).host,
+      auth.substring("Bearer ".length),
+    );
+    if (creatorId === null) {
+      return json({ error: "Invalid creator token" }, 401);
+    }
+
+    let body: unknown = {};
+    const text = await request.text();
+    if (text.length > 0) {
+      try {
+        body = JSON.parse(text);
+      } catch {
+        return json({ error: "Invalid JSON" }, 400);
+      }
+    }
+    const parsed = CreateGameInputSchema.safeParse(body);
+    if (!parsed.success) {
+      return json({ error: z.prettifyError(parsed.error) }, 400);
+    }
+    // Only private games are created here; public ones are scheduled by the
+    // host itself, and singleplayer games run in the browser.
+    if (!isPrivateGameInput(parsed.data)) {
+      return json(
+        { error: "Only private games can be created via this endpoint" },
+        400,
+      );
+    }
+
+    const id = this.mintGameId();
+    if (id === null) return json({ error: "Could not allocate game id" }, 500);
+    const game = this.createGame({
+      id,
+      createdAt: Date.now(),
+      config: parsed.data,
+      creatorPersistentID: creatorId,
+    });
+    console.log(
+      JSON.stringify({
+        msg: "private game created",
+        gameID: id,
+        worker: this.workerIndex,
+      }),
+    );
+    return json({
+      ...game.gameInfo(),
+      workerIndex: this.workerIndex,
+      workerPath: `w${this.workerIndex}`,
+    });
+  }
+
+  /** An id whose hash routes back to this shard (the client derives /w<n> from it). */
+  private mintGameId(): GameID | null {
+    const shards = numWorkers(this.env);
+    for (let i = 0; i < shards * 100; i++) {
+      const id = generateGameID(this.env.INSTANCE_LETTER || "a");
+      if (simpleHash(id) % shards === this.workerIndex && !this.games.has(id)) {
+        return id;
+      }
+    }
+    return null;
+  }
+
+  private createGame(opts: GameOptions): Game {
+    const game = new Game(opts);
+    this.games.set(opts.id, game);
+    return game;
+  }
+
+  // ------------------------------------------------------- game WebSocket
+
+  private acceptGameSocket(host: string): Response {
+    const pair = new WebSocketPair();
+    const [client, server] = Object.values(pair) as [WebSocket, WebSocket];
+    server.accept();
+    // Frames are zbin binary. Newer compatibility dates deliver binary messages
+    // as Blob by default, and `new Uint8Array(blob)` is silently empty.
+    server.binaryType = "arraybuffer";
+    const session: Session = {
+      ws: server,
+      conn: null,
+      game: null,
+      host,
+      joining: false,
+    };
+
+    server.addEventListener("message", (event) => {
+      try {
+        this.onMessage(session, event.data);
+      } catch (e) {
+        console.error(
+          JSON.stringify({ msg: "message handler failed", error: String(e) }),
+        );
+        safeClose(server, CloseCode.InternalError, CloseReason.InternalError);
+      }
+    });
+    const onGone = () => {
+      if (session.game !== null && session.conn !== null) {
+        session.game.handleDisconnect(session.conn, server);
+      }
+    };
+    server.addEventListener("close", onGone);
+    server.addEventListener("error", onGone);
+
+    return new Response(null, { status: 101, webSocket: client });
+  }
+
+  private onMessage(s: Session, data: string | ArrayBuffer): void {
+    // Every frame is zbin binary; text is never valid.
+    if (typeof data === "string") {
+      safeClose(s.ws, CloseCode.BadRequest, CloseReason.InvalidMessage);
+      return;
+    }
+    const bytes = new Uint8Array(data);
+    const now = Date.now();
+
+    // A sign-in token is still being checked: the client waits for the answer to its
+    // join before it sends anything else, so whatever arrives now is stray.
+    if (s.joining) return;
+
+    if (s.conn !== null && s.game !== null) {
+      let msg: ClientMessage;
+      try {
+        msg = decodeClientMessage(bytes, s.game.zbinCtx);
+      } catch {
+        s.game.kickForInvalidMessage(s.conn);
+        return;
+      }
+      s.game.handleMessage(s.conn, msg, now);
+      return;
+    }
+    this.onFirstMessage(s, bytes);
+  }
+
+  /** The first meaningful frame must be join or rejoin; it names the game. */
+  private onFirstMessage(s: Session, bytes: Uint8Array): void {
+    let msg: ClientMessage;
+    try {
+      // Nothing before join carries a dictionary-mapped id, so no context.
+      msg = decodeClientMessage(bytes, undefined);
+    } catch (e) {
+      console.warn(
+        JSON.stringify({
+          msg: "undecodable first frame",
+          length: bytes.length,
+          error: String(e),
+        }),
+      );
+      s.ws.send(
+        encodeServerMessage({ type: "error", error: String(e) }, undefined),
+      );
+      safeClose(s.ws, CloseCode.BadRequest, CloseReason.InvalidMessage);
+      return;
+    }
+    if (msg.type === "ping") return;
+    if (msg.type !== "join" && msg.type !== "rejoin") return;
+
+    if (simpleHash(msg.gameID) % numWorkers(this.env) !== this.workerIndex) {
+      safeClose(s.ws, CloseCode.WrongWorker, CloseReason.WrongWorker);
+      return;
+    }
+
+    // The simulation only stays deterministic when every client runs identical
+    // code, so a bundle from another commit is told to refresh.
+    if (msg.gitCommit !== this.commit && msg.gitCommit !== "desktop") {
+      s.ws.send(
+        encodeServerMessage(
+          {
+            type: "error",
+            error: "version_mismatch",
+            gitCommit: this.commit,
+          },
+          undefined,
+        ),
+      );
+      safeClose(s.ws, CloseCode.Normal, "Version mismatch");
+      return;
+    }
+
+    // The token is a guest's own random id, or one this site signed for an account. A guest
+    // id answers at once; a signed token needs a signature check, which is asynchronous.
+    const joinMsg = msg;
+    const checked = resolvePlayToken(this.env, s.host, joinMsg.token);
+    s.joining = true;
+    void checked.then(
+      (persistentID) => {
+        s.joining = false;
+        if (persistentID === null) {
+          safeClose(s.ws, CloseCode.InternalError, CloseReason.InvalidToken);
+          return;
+        }
+        // The socket may have closed while the token was being checked (1 = open).
+        if (s.ws.readyState !== 1) return;
+        this.joinWithIdentity(s, joinMsg, persistentID);
+      },
+      () => {
+        s.joining = false;
+        safeClose(s.ws, CloseCode.InternalError, CloseReason.InvalidToken);
+      },
+    );
+  }
+
+  /** The join or rejoin of a player whose token has been checked. */
+  private joinWithIdentity(
+    s: Session,
+    msg: Extract<ClientMessage, { type: "join" | "rejoin" }>,
+    persistentID: string,
+  ): void {
+    const game = this.findGame(msg.gameID);
+
+    if (msg.type === "rejoin") {
+      if (game !== undefined && game.rejoin(s.ws, persistentID, msg.lastTurn)) {
+        this.attach(s, game, game.connForPersistent(persistentID) ?? null);
+      } else {
+        safeClose(s.ws, CloseCode.GameNotFound, CloseReason.GameNotFound);
+      }
+      return;
+    }
+
+    if (game === undefined) {
+      safeClose(s.ws, CloseCode.GameNotFound, CloseReason.GameNotFound);
+      return;
+    }
+
+    const { username, clanTag } = censorPlayer(
+      msg.username,
+      msg.clanTag ?? null,
+    );
+
+    // A refresh before the game starts: reattach under the screened name.
+    if (game.rejoin(s.ws, persistentID, 0, { username, clanTag })) {
+      this.attach(s, game, game.connForPersistent(persistentID) ?? null);
+      return;
+    }
+
+    const conn = new Conn(
+      generateID(),
+      persistentID,
+      username,
+      clanTag,
+      s.ws,
+      msg.spectator === true,
+    );
+    switch (game.join(conn)) {
+      case "joined":
+        this.attach(s, game, conn);
+        return;
+      case "kicked":
+        safeClose(s.ws, CloseCode.GameClosed, CloseReason.CannotJoin);
+        return;
+      case "ended":
+        safeClose(s.ws, CloseCode.GameNotFound, CloseReason.GameEnded);
+        return;
+      case "rejected":
+        safeClose(s.ws, CloseCode.LobbyFull, CloseReason.LobbyFull);
+        return;
+      case "started":
+        safeClose(s.ws, CloseCode.GameStarted, CloseReason.GameStarted);
+        return;
+    }
+  }
+
+  private attach(s: Session, game: Game, conn: Conn | null): void {
+    s.game = game;
+    s.conn = conn;
+    // Someone is in a game, so the timers have work to do.
+    this.ensureLoop();
+  }
+
+  // ----------------------------------------------- lobby-list WebSocket
+
+  private acceptLobbySocket(): Response {
+    const pair = new WebSocketPair();
+    const [client, server] = Object.values(pair) as [WebSocket, WebSocket];
+    // Hibernation API: the object may be evicted while this stays connected.
+    this.ctx.acceptWebSocket(server, [LOBBIES_TAG]);
+
+    if (this.publicLobbies !== null) {
+      const now = Date.now();
+      this.publicLobbies.maintain(now);
+      server.send(this.publicLobbies.fullFrame(now));
+      this.armAlarm();
+    }
+    return new Response(null, { status: 101, webSocket: client });
+  }
+
+  // The lobby socket is broadcast-only: nothing a browser sends on it matters.
+  override async webSocketMessage(): Promise<void> {}
+
+  override async webSocketClose(ws: WebSocket, code: number): Promise<void> {
+    // Complete the close handshake; 1005/1006 are reserved and cannot be sent.
+    safeClose(ws, code === 1005 || code === 1006 ? CloseCode.Normal : code, "");
+  }
+
+  override async webSocketError(ws: WebSocket): Promise<void> {
+    safeClose(ws, CloseCode.Normal, "");
+  }
+
+  /** Wakes an otherwise idle object to keep the lobby list fresh. */
+  override async alarm(): Promise<void> {
+    this.publicTick(Date.now());
+    // While the timer runs it does this every second; only an idle object needs
+    // the alarm, and only while someone is watching the list.
+    if (
+      this.timer === undefined &&
+      this.ctx.getWebSockets(LOBBIES_TAG).length > 0
+    ) {
+      this.armAlarm();
+    }
+  }
+
+  /**
+   * Wake exactly when the head lobby's countdown ends, which is the only moment
+   * the list changes while nobody is playing (player counts need a player, and a
+   * player keeps the object awake on its own).
+   */
+  private armAlarm(): void {
+    const lobbies = this.publicLobbies;
+    if (lobbies === null) return;
+    const now = Date.now();
+    // A little past the boundary, so the new slot has certainly begun.
+    void this.ctx.storage.setAlarm(lobbies.nextBoundary(now) + 100);
+  }
+
+  /** Restock the queue and tell the browsers about any change. */
+  private publicTick(now: number): void {
+    const lobbies = this.publicLobbies;
+    if (lobbies === null) return;
+    const watchers = this.ctx.getWebSockets(LOBBIES_TAG);
+    // Nobody is looking and nobody is playing: let the queue lapse.
+    if (watchers.length === 0 && !lobbies.hasPlayers()) return;
+
+    lobbies.maintain(now);
+    for (const frame of lobbies.diffFrames(now)) {
+      for (const ws of watchers) {
+        try {
+          ws.send(frame);
+        } catch {
+          // a socket that is mid-close; its close event cleans up
+        }
+      }
+    }
+  }
+
+  // ----------------------------------------------------------------- timers
+
+  private ensureLoop(): void {
+    if (this.timer !== undefined) return;
+    this.timer = setInterval(() => this.tick(), TURN_INTERVAL_MS);
+  }
+
+  private tick(): void {
+    this.tickCount++;
+    for (const game of this.games.values()) {
+      if (game.stage === "started") game.endTurn();
+    }
+    // Lifecycle (prestart/start, lobby info, reaping) once a second.
+    if (this.tickCount % 10 !== 0) return;
+    const now = Date.now();
+    for (const [id, game] of this.games) {
+      game.secondTick(now);
+      if (game.ended) this.games.delete(id);
+    }
+    this.publicTick(now);
+
+    // Stop when nothing needs the timer, so the object can hibernate. A lobby
+    // that is only waiting in the queue does not.
+    const busy = [...this.games.values()].some(
+      (g) => g.stage !== "lobby" || g.numClients() > 0,
+    );
+    if (!busy && this.timer !== undefined) {
+      clearInterval(this.timer);
+      this.timer = undefined;
+      // Keep the list fresh through the alarm instead.
+      if (this.ctx.getWebSockets(LOBBIES_TAG).length > 0) this.armAlarm();
+    }
+  }
+}
diff --git a/cloudflare/src/Playlist.ts b/cloudflare/src/Playlist.ts
new file mode 100644
index 0000000..d195696
--- /dev/null
+++ b/cloudflare/src/Playlist.ts
@@ -0,0 +1,110 @@
+// Config for the scheduled public lobbies.
+//
+// A deliberately small stand-in for src/server/MapPlaylist.ts, which weights maps
+// from the closed API and sizes lobbies from each map's land area (reading map
+// files the Worker does not have).
+//
+// It is a pure function of (type, slot): the same slot always yields the same map
+// and settings. Maps are dealt once per round in a seeded random order, so a map
+// does not repeat until the whole list has been played, and a Durable Object that
+// was evicted and restarted still agrees with the lobby list its clients are
+// looking at.
+
+import {
+  Difficulty,
+  GameMapSize,
+  GameMode,
+  GameType,
+  listedMaps,
+  type MapInfo,
+} from "@openfront/engine-api/game/GameTypes";
+import type { GameConfig } from "@openfront/engine-api/Schemas";
+import { hashString, mulberry32, permutation } from "./seed";
+
+export type ScheduledType = "ffa" | "team";
+
+// Every team count below divides this, so teams are always even.
+const MAX_PLAYERS = 40;
+const TEAM_COUNTS = [2, 4, 5];
+
+const byId = (a: MapInfo, b: MapInfo) =>
+  a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
+
+export class Playlist {
+  // A stable order, so the seeded permutation means the same thing everywhere.
+  private maps: readonly MapInfo[] = [...listedMaps].sort(byId);
+  private readonly rounds = new Map<string, number[]>();
+
+  /**
+   * Offer only these maps (their ids). A deployment ships whichever maps fit its
+   * upload budget (scripts/build-site.ts); dealing one that was not deployed would
+   * start a game whose map cannot load. An empty or unknown list changes nothing.
+   */
+  setAllowed(ids: readonly string[]): void {
+    const allowed = new Set(ids);
+    const maps = listedMaps.filter((m) => allowed.has(m.id)).sort(byId);
+    if (maps.length === 0) return;
+    this.maps = maps;
+    this.rounds.clear();
+  }
+
+  configFor(type: ScheduledType, slot: number): GameConfig {
+    const map = this.mapFor(type, slot);
+    const mode = type === "ffa" ? GameMode.FFA : GameMode.Team;
+    // Every third FFA lobby is a compact map: fewer bots, a quicker game.
+    const isCompact = type === "ffa" && slot % 3 === 0 ? true : undefined;
+
+    let playerTeams: number | undefined;
+    let maxPlayers = MAX_PLAYERS;
+    if (type === "team") {
+      const preferred = map.specialTeamCount;
+      playerTeams =
+        preferred !== undefined && preferred >= 2 && preferred <= 8
+          ? preferred
+          : TEAM_COUNTS[
+              Math.floor(
+                mulberry32(hashString(`${type}:teams:${slot}`))() *
+                  TEAM_COUNTS.length,
+              )
+            ]!;
+      maxPlayers = Math.floor(MAX_PLAYERS / playerTeams) * playerTeams;
+    }
+
+    return {
+      donateGold: mode === GameMode.Team,
+      donateTroops: mode === GameMode.Team,
+      gameMap: map.type,
+      maxPlayers,
+      gameType: GameType.Public,
+      gameMapSize: isCompact ? GameMapSize.Compact : GameMapSize.Normal,
+      publicGameModifiers: { isCompact },
+      difficulty: Difficulty.Medium,
+      infiniteGold: false,
+      infiniteTroops: false,
+      instantBuild: false,
+      randomSpawn: false,
+      nations: mode === GameMode.Team ? "disabled" : "default",
+      gameMode: mode,
+      playerTeams,
+      bots: isCompact ? 100 : 400,
+      disabledUnits: [],
+      disableClanTags: mode === GameMode.FFA ? true : undefined,
+      // The win threshold sinks after 30 minutes, so FFA games always end.
+      overtime: mode === GameMode.FFA ? { enabled: true } : undefined,
+    } satisfies GameConfig;
+  }
+
+  private mapFor(type: ScheduledType, slot: number): MapInfo {
+    const n = this.maps.length;
+    const round = Math.floor(slot / n);
+    const key = `${type}:${round}`;
+    let order = this.rounds.get(key);
+    if (order === undefined) {
+      order = permutation(n, hashString(`${type}:round:${round}`));
+      // Only the current round matters; keep the cache from growing.
+      if (this.rounds.size > 8) this.rounds.clear();
+      this.rounds.set(key, order);
+    }
+    return this.maps[order[slot % n]!]!;
+  }
+}
diff --git a/cloudflare/src/PublicLobbies.ts b/cloudflare/src/PublicLobbies.ts
new file mode 100644
index 0000000..09c7ea6
--- /dev/null
+++ b/cloudflare/src/PublicLobbies.ts
@@ -0,0 +1,266 @@
+// Public matchmaking: a queue of scheduled lobbies per game type, the head one on
+// a countdown, described to the lobby browser in the frames it already decodes.
+//
+// This is the Cloudflare counterpart of MasterLobbyService (which schedules) plus
+// the lobby half of the master's broadcast.
+//
+// Lobbies are a pure function of the clock, not of anything remembered. Time is cut
+// into slots of `lobbyMs`; for each type, slot s has exactly one lobby whose id, map
+// and settings derive from (type, s), and which starts at the end of its slot. The
+// lobby for the slot in progress is the head (it has a countdown) and the next
+// slot's is queued behind it.
+//
+// Why: a Durable Object with only hibernating lobby-list sockets is evicted within
+// seconds, and everything in memory goes with it. A queue kept in memory therefore
+// vanished under the browser's feet, so the lobby a player clicked no longer existed.
+// Here a fresh instance recomputes the very same lobbies, a join to one that has not
+// been instantiated yet creates it on demand, and nothing is written to storage.
+
+import type { GameID } from "@openfront/engine-api/Schemas";
+import { simpleHash } from "@openfront/engine-lib/Util";
+import type {
+  PublicGameInfo,
+  PublicGameType,
+  PublicLobbyMessage,
+} from "@openfront/shared/WireSchemas";
+import { encodeLobbyMessage } from "@openfront/shared/ZbinWire";
+import type { LobbyDb } from "./db";
+import type { Game, GameOptions } from "./Game";
+import type { Playlist, ScheduledType } from "./Playlist";
+import { hashString, mulberry32 } from "./seed";
+
+export const PUBLIC_TYPES: readonly ScheduledType[] = ["ffa", "team"];
+
+// The alphabet generateGameID uses (no look-alike characters).
+const ID_ALPHABET =
+  "123456789abcdefghijkmnopqrstuvwxyzABCDEFGHJKLMNPQRSTUVWXYZ";
+
+export interface LobbyHost {
+  game(id: GameID): Game | undefined;
+  games(): Iterable<Game>;
+  createGame(opts: GameOptions): Game;
+}
+
+export interface LobbyConfig {
+  lobbyMs: number;
+  /** First character of every id; the cluster's instance letter. */
+  letter: string;
+  shards: number;
+  shard: () => number;
+}
+
+export class PublicLobbies {
+  /** Lobbies that have started or ended in this instance: never created again. */
+  private readonly consumed = new Set<GameID>();
+  private readonly ids = new Map<string, GameID>();
+  private lastFull = "";
+  private lastCounts = "";
+
+  constructor(
+    private readonly host: LobbyHost,
+    private readonly playlist: Playlist,
+    private readonly db: LobbyDb,
+    private readonly cfg: LobbyConfig,
+    private readonly gitCommit: () => string,
+  ) {}
+
+  slotAt(now: number): number {
+    return Math.floor(now / this.cfg.lobbyMs);
+  }
+
+  /** When the head lobby's countdown ends: the list next changes then. */
+  nextBoundary(now: number): number {
+    return (this.slotAt(now) + 1) * this.cfg.lobbyMs;
+  }
+
+  /** The id of (type, slot): the same everywhere, and routed to this shard. */
+  private idFor(type: ScheduledType, slot: number): GameID {
+    const key = `${type}:${slot}`;
+    const cached = this.ids.get(key);
+    if (cached !== undefined) return cached;
+    const { shards } = this.cfg;
+    const shard = this.cfg.shard();
+    let id = "";
+    // A game id hashes to the shard that hosts it (the client derives /w<n> from
+    // it), so keep drawing, deterministically, until the id lands on ours.
+    for (let k = 0; k <= shards * 100; k++) {
+      const rng = mulberry32(hashString(`${key}:${k}`));
+      id = this.cfg.letter;
+      for (let i = 0; i < 9; i++) {
+        id += ID_ALPHABET[Math.floor(rng() * ID_ALPHABET.length)];
+      }
+      if (simpleHash(id) % shards === shard) break;
+    }
+    if (this.ids.size > 64) this.ids.clear();
+    this.ids.set(key, id);
+    return id;
+  }
+
+  /** The lobby for (type, slot), created if this instance has not seen it yet. */
+  private lobby(
+    type: ScheduledType,
+    slot: number,
+    now: number,
+  ): Game | undefined {
+    const id = this.idFor(type, slot);
+    const existing = this.host.game(id);
+    if (existing !== undefined) return existing;
+    const startsAt = (slot + 1) * this.cfg.lobbyMs;
+    // Past its start time, or already played out: it is gone, not to be recreated.
+    if (now >= startsAt || this.consumed.has(id)) return undefined;
+    return this.host.createGame({
+      id,
+      createdAt: slot * this.cfg.lobbyMs,
+      config: this.playlist.configFor(type, slot),
+      publicGameType: type,
+      // Only the head counts down; the one behind it gets its countdown when its
+      // own slot begins.
+      startsAt: slot === this.slotAt(now) ? startsAt : undefined,
+      hooks: {
+        // A lobby is only recorded once someone is in it: most slots see no one,
+        // and each row would spend the Free plan's daily D1 write allowance.
+        onOpened: (g) => this.db.recordCreated(g, type),
+        onStarted: (g) => {
+          this.consumed.add(g.id);
+          this.db.recordStarted(g);
+        },
+        onEnded: (g, result) => {
+          this.consumed.add(g.id);
+          if (g.wasOpened) {
+            this.db.recordEnded(g, result);
+            this.db.recordResults(result);
+          }
+        },
+      },
+    });
+  }
+
+  /**
+   * The game for a public lobby id, if it is one of the lobbies on offer right now
+   * (this slot's or the next); creates it when this instance has not yet.
+   */
+  resolve(id: GameID, now: number): Game | undefined {
+    const existing = this.host.game(id);
+    if (existing !== undefined) return existing;
+    const slot = this.slotAt(now);
+    for (const type of PUBLIC_TYPES) {
+      for (const s of [slot, slot + 1]) {
+        if (this.idFor(type, s) === id) return this.lobby(type, s, now);
+      }
+    }
+    return undefined;
+  }
+
+  /** True while any public game has someone connected to it. */
+  hasPlayers(): boolean {
+    for (const g of this.host.games()) {
+      if (g.publicGameType !== undefined && g.numClients() > 0) return true;
+    }
+    return false;
+  }
+
+  /** Make sure the lobbies on offer exist, and retire the ones that ran out. */
+  maintain(now: number): void {
+    const slot = this.slotAt(now);
+    for (const type of PUBLIC_TYPES) {
+      // A countdown that ran out with nobody inside is dead weight: close it.
+      for (const g of this.host.games()) {
+        if (
+          g.publicGameType === type &&
+          g.stage === "lobby" &&
+          !g.ended &&
+          g.startsAtMs !== undefined &&
+          now >= g.startsAtMs &&
+          g.numClients() === 0
+        ) {
+          g.end();
+        }
+      }
+      for (const s of [slot, slot + 1]) this.lobby(type, s, now);
+      // The queued lobby becomes the head when its slot begins.
+      const head = this.host.game(this.idFor(type, slot));
+      if (head !== undefined && head.startsAtMs === undefined) {
+        head.setStartsAt((slot + 1) * this.cfg.lobbyMs);
+      }
+    }
+  }
+
+  /** What is on offer: this slot's lobby (counting down), then the next one. */
+  snapshot(now: number): Partial<Record<PublicGameType, PublicGameInfo[]>> {
+    const slot = this.slotAt(now);
+    const games: Partial<Record<PublicGameType, PublicGameInfo[]>> = {};
+    for (const type of PUBLIC_TYPES) {
+      const list: PublicGameInfo[] = [];
+      for (const s of [slot, slot + 1]) {
+        const g = this.host.game(this.idFor(type, s));
+        if (g === undefined || !g.isOpenLobby(now)) continue;
+        const info = g.publicInfo();
+        if (info !== undefined) list.push(info);
+      }
+      games[type] = list;
+    }
+    return games;
+  }
+
+  private fullMessage(now: number): PublicLobbyMessage {
+    return {
+      type: "full",
+      serverTime: now,
+      games: this.snapshot(now),
+      gitCommit: this.gitCommit(),
+      active: true,
+    };
+  }
+
+  /** The complete picture, for a browser that just connected. */
+  fullFrame(now: number): Uint8Array {
+    const frame = this.fullMessage(now);
+    this.lastFull = this.signature(frame);
+    this.lastCounts = this.countsOf(frame);
+    return encodeLobbyMessage(frame);
+  }
+
+  /** What changed since the last frame we handed out (possibly nothing). */
+  diffFrames(now: number): Uint8Array[] {
+    const full = this.fullMessage(now);
+    const frames: Uint8Array[] = [];
+    const signature = this.signature(full);
+    const counts = this.countsOf(full);
+    if (signature !== this.lastFull) {
+      // A new set of lobbies or a new countdown: send everything.
+      frames.push(encodeLobbyMessage(full));
+    } else if (counts !== this.lastCounts) {
+      frames.push(
+        encodeLobbyMessage({
+          type: "counts",
+          serverTime: now,
+          counts: JSON.parse(counts) as Record<string, number>,
+        }),
+      );
+    }
+    this.lastFull = signature;
+    this.lastCounts = counts;
+    return frames;
+  }
+
+  /** Everything except player counts, which travel in their own frame. */
+  private signature(msg: PublicLobbyMessage): string {
+    if (msg.type !== "full") return "";
+    const parts: string[] = [];
+    for (const [type, list] of Object.entries(msg.games)) {
+      for (const g of list ?? []) {
+        parts.push(`${type}:${g.gameID}:${g.startsAt ?? ""}`);
+      }
+    }
+    return parts.join("|");
+  }
+
+  private countsOf(msg: PublicLobbyMessage): string {
+    if (msg.type !== "full") return "{}";
+    const counts: Record<string, number> = {};
+    for (const list of Object.values(msg.games)) {
+      for (const g of list ?? []) counts[g.gameID] = g.numClients;
+    }
+    return JSON.stringify(counts);
+  }
+}
diff --git a/cloudflare/src/accounts/api.ts b/cloudflare/src/accounts/api.ts
new file mode 100644
index 0000000..86aebcf
--- /dev/null
+++ b/cloudflare/src/accounts/api.ts
@@ -0,0 +1,573 @@
+// The account API the client talks to (its `getApiBase()`): sign in with Google or an
+// emailed link, stay signed in, read the profile, sign out, delete the account.
+//
+// It answers at `https://api.<site host>` (a second hostname for this same Worker) and, in
+// `wrangler dev`, on the page's own origin. Everything else the closed-source API does
+// (stats, cosmetics, friends, clans, the store) is not here; the page blocks those calls
+// before they leave the browser (scripts/third-party.ts).
+//
+// How a signed-in player is represented:
+//  - `of_session`: a random secret in an HttpOnly cookie on the API host. Its SHA-256 is the
+//    only thing stored (sessions table). It can only be used to ask for a token.
+//  - the token (JWT, HS256, one hour): what the client sends to games and to /users/@me. Its
+//    `sub` is the account id, which is the player's persistent id in a game.
+//  - `of_signed_in=1`: a plain cookie on the *site* host that says "a session exists", so the
+//    page only asks for a token when there is a session to ask about. It carries no secret.
+
+import type { Env } from "../env";
+import {
+  b64uToBytes,
+  b64uToUuid,
+  bytesToB64u,
+  hmacB64u,
+  hmacVerify,
+  randomToken,
+  sha256Hex,
+  signJwt,
+  uuidToB64u,
+  verifyJwt,
+} from "./crypto";
+import { googleAuthorizeUrl, googleConfigured, googleIdentity } from "./google";
+import { identityForHost, type SiteIdentity } from "./identity";
+import { mailConfigured, sendLoginEmail } from "./mail";
+import { userMeResponse } from "./profile";
+import { type Account, AccountStore, SESSION_MS } from "./store";
+
+export const TOKEN_SECONDS = 3600;
+
+const SESSION_COOKIE = "of_session";
+const HINT_COOKIE = "of_signed_in";
+const OAUTH_COOKIE = "of_oauth";
+
+const HOUR_MS = 60 * 60 * 1000;
+const DAY_MS = 24 * HOUR_MS;
+/** Emailed links one address may ask for per hour, and one network. */
+const LINKS_PER_EMAIL = 5;
+const LINKS_PER_IP = 15;
+
+export function isAccountPath(pathname: string): boolean {
+  return pathname.startsWith("/auth/") || pathname === "/users/@me";
+}
+
+// ---------------------------------------------------------------- responses
+
+function json(body: unknown, status = 200, extra?: Headers): Response {
+  const headers = new Headers(extra);
+  headers.set("content-type", "application/json");
+  headers.set("cache-control", "no-store");
+  return new Response(JSON.stringify(body), { status, headers });
+}
+
+function redirect(location: string, cookies?: Headers): Response {
+  const headers = new Headers(cookies);
+  headers.set("location", location);
+  headers.set("cache-control", "no-store");
+  return new Response(null, { status: 302, headers });
+}
+
+function withCors(res: Response, origin: string | null): Response {
+  if (origin === null) return res;
+  const out = new Response(res.body, res);
+  out.headers.set("access-control-allow-origin", origin);
+  out.headers.set("access-control-allow-credentials", "true");
+  out.headers.append("vary", "Origin");
+  return out;
+}
+
+// ------------------------------------------------------------------ cookies
+
+function readCookie(request: Request, name: string): string | null {
+  const header = request.headers.get("cookie");
+  if (header === null) return null;
+  for (const part of header.split(";")) {
+    const eq = part.indexOf("=");
+    if (eq < 0) continue;
+    if (part.slice(0, eq).trim() === name) return part.slice(eq + 1).trim();
+  }
+  return null;
+}
+
+function cookie(
+  name: string,
+  value: string,
+  id: SiteIdentity,
+  opts: { maxAge: number; httpOnly: boolean; path: string; domain?: string },
+): string {
+  const parts = [
+    `${name}=${value}`,
+    `Path=${opts.path}`,
+    `Max-Age=${opts.maxAge}`,
+    "SameSite=Lax",
+  ];
+  if (opts.httpOnly) parts.push("HttpOnly");
+  if (!id.local) parts.push("Secure");
+  if (opts.domain !== undefined && !id.local) parts.push(`Domain=${opts.domain}`);
+  return parts.join("; ");
+}
+
+/** The two cookies of a signed-in browser (value null clears them). */
+function sessionCookies(id: SiteIdentity, session: string | null): Headers {
+  const h = new Headers();
+  const on = session !== null;
+  h.append(
+    "set-cookie",
+    cookie(SESSION_COOKIE, session ?? "", id, {
+      maxAge: on ? SESSION_MS / 1000 : 0,
+      httpOnly: true,
+      path: "/",
+    }),
+  );
+  h.append(
+    "set-cookie",
+    cookie(HINT_COOKIE, on ? "1" : "", id, {
+      maxAge: on ? SESSION_MS / 1000 : 0,
+      httpOnly: false,
+      path: "/",
+      domain: id.audience,
+    }),
+  );
+  return h;
+}
+
+// ---------------------------------------------------------------- redirects
+
+/**
+ * The page to send the browser back to after a sign-in, from the `redirect_uri` the client
+ * supplies (its own address). Only this site's own pages qualify, so the API cannot be used
+ * to bounce people to another site.
+ */
+function returnAddress(raw: string | null, id: SiteIdentity): string | null {
+  if (raw === null || raw.length > 1000) return null;
+  let u: URL;
+  try {
+    u = new URL(raw);
+  } catch {
+    return null;
+  }
+  if (u.origin !== id.siteOrigin) return null;
+  return u.origin + u.pathname + u.search + u.hash;
+}
+
+function withHash(address: string, hash: string): string {
+  const u = new URL(address);
+  u.hash = hash;
+  return u.toString();
+}
+
+/** The account screen, showing why a sign-in did not complete (see LoginResult.ts). */
+function loginFailed(address: string, why: string): Response {
+  return redirect(withHash(address, `modal=account&login=${why}`));
+}
+
+// ------------------------------------------------------------------ the API
+
+interface Context {
+  request: Request;
+  env: Env;
+  url: URL;
+  id: SiteIdentity;
+  store: AccountStore;
+  secret: string;
+  now: number;
+}
+
+/** Null when this request is not for the account API (the caller then serves the page). */
+export async function handleAccountRequest(
+  request: Request,
+  env: Env,
+): Promise<Response | null> {
+  const url = new URL(request.url);
+  if (!isAccountPath(url.pathname)) return null;
+  const id = identityForHost(url.host);
+  if (!id.isApiHost) return null;
+
+  const origin = request.headers.get("origin");
+  const allowed = origin !== null && origin === id.siteOrigin ? origin : null;
+
+  if (request.method === "OPTIONS") {
+    if (allowed === null) return new Response(null, { status: 403 });
+    return withCors(
+      new Response(null, {
+        status: 204,
+        headers: {
+          "access-control-allow-methods": "GET, POST, DELETE, OPTIONS",
+          "access-control-allow-headers": "authorization, content-type",
+          "access-control-max-age": "600",
+        },
+      }),
+      allowed,
+    );
+  }
+
+  if (env.DB === undefined || !env.JWT_SECRET) {
+    return withCors(json({ error: "accounts are not set up on this site" }, 503), allowed);
+  }
+
+  const ctx: Context = {
+    request,
+    env,
+    url,
+    id,
+    store: new AccountStore(env.DB),
+    secret: env.JWT_SECRET,
+    now: Date.now(),
+  };
+
+  try {
+    const res = await route(ctx, allowed);
+    return withCors(res, allowed);
+  } catch (e) {
+    console.error(
+      JSON.stringify({ msg: "account request failed", path: url.pathname, error: String(e) }),
+    );
+    return withCors(json({ error: "internal error" }, 500), allowed);
+  }
+}
+
+async function route(ctx: Context, allowedOrigin: string | null): Promise<Response> {
+  const { request, url } = ctx;
+  const where = `${request.method} ${url.pathname}`;
+
+  // Requests that act on the cookie must come from the site's own page: a form on some
+  // other site must not be able to sign this browser out, or send mail in its name.
+  const fromSite = allowedOrigin !== null;
+  const needSite = (): Response | null =>
+    fromSite ? null : json({ error: "forbidden origin" }, 403);
+  // The two GETs the page makes with fetch(): they sign this browser in or start a link, so
+  // they must not be reachable by a plain link or redirect from some other site, which would
+  // sign a visitor in to the sender's account. Browsers say how a request was made; a
+  // navigation is refused. (Tools that send no such header, like curl, are not browsers.)
+  const notNavigation = (): Response | null =>
+    request.headers.get("sec-fetch-mode") === "navigate"
+      ? json({ error: "not available by navigation" }, 403)
+      : null;
+
+  switch (where) {
+    case "POST /auth/refresh":
+      return needSite() ?? refresh(ctx);
+    case "POST /auth/logout":
+      return needSite() ?? logout(ctx);
+    case "POST /auth/revoke":
+      return needSite() ?? revoke(ctx);
+    case "POST /auth/magic-link":
+      return needSite() ?? magicLink(ctx);
+    case "GET /auth/login/token":
+      // Fetched by the page after the emailed link is opened. A same-origin fetch (local
+      // dev) sends no Origin at all, which is fine: the link's secret is the credential.
+      if (request.headers.get("origin") !== null && !fromSite) {
+        return json({ error: "forbidden origin" }, 403);
+      }
+      return notNavigation() ?? tokenLogin(ctx);
+    case "GET /auth/login/google":
+      return googleStart(ctx);
+    case "GET /auth/link/google":
+      // A fetch that carries the player's token; same rule on Origin as the login link.
+      if (request.headers.get("origin") !== null && !fromSite) {
+        return json({ error: "forbidden origin" }, 403);
+      }
+      return notNavigation() ?? googleLinkStart(ctx);
+    case "GET /auth/callback/google":
+      return googleCallback(ctx);
+    case "GET /users/@me":
+      return me(ctx);
+    case "DELETE /users/@me":
+      return needSite() ?? deleteMe(ctx);
+  }
+
+  // Sign in with Discord or Steam: not offered here. The page hides the buttons; a stray
+  // visit goes back to the site with a plain "could not sign in".
+  if (
+    request.method === "GET" &&
+    (url.pathname === "/auth/login/discord" || url.pathname === "/auth/login/steam")
+  ) {
+    const back = returnAddress(url.searchParams.get("redirect_uri"), ctx.id);
+    if (back !== null) return loginFailed(back, "error");
+  }
+  return json({ error: "not found" }, 404);
+}
+
+// ------------------------------------------------------------------ tokens
+
+async function issueToken(
+  ctx: Context,
+  accountId: string,
+  provider: string,
+): Promise<string> {
+  const iat = Math.floor(ctx.now / 1000);
+  return signJwt(
+    {
+      jti: crypto.randomUUID(),
+      sub: uuidToB64u(accountId),
+      iat,
+      exp: iat + TOKEN_SECONDS,
+      iss: ctx.id.apiOrigin,
+      aud: ctx.id.audience,
+      provider,
+    },
+    ctx.secret,
+  );
+}
+
+function bearer(request: Request): string | null {
+  const h = request.headers.get("authorization");
+  return h !== null && h.startsWith("Bearer ") ? h.slice("Bearer ".length) : null;
+}
+
+// ---------------------------------------------------------------- sessions
+
+async function refresh(ctx: Context): Promise<Response> {
+  const session = readCookie(ctx.request, SESSION_COOKIE);
+  // Nobody is signed in here. Not a 401: the client treats a 401 as "your session died" and
+  // forgets the guest id it plays under, which a visitor who never signed in must keep.
+  if (session === null) return new Response(null, { status: 204 });
+
+  const account = await ctx.store.accountForSession(session, ctx.now);
+  if (account === null) {
+    return json({ error: "session expired" }, 401, sessionCookies(ctx.id, null));
+  }
+  const jwt = await issueToken(
+    ctx,
+    account.id,
+    account.googleSub !== null ? "google" : "email",
+  );
+  return json({ jwt, expiresIn: TOKEN_SECONDS });
+}
+
+async function logout(ctx: Context): Promise<Response> {
+  const session = readCookie(ctx.request, SESSION_COOKIE);
+  if (session !== null) await ctx.store.endSession(session);
+  return json({ ok: true }, 200, sessionCookies(ctx.id, null));
+}
+
+async function revoke(ctx: Context): Promise<Response> {
+  const session = readCookie(ctx.request, SESSION_COOKIE);
+  const account =
+    session === null ? null : await ctx.store.accountForSession(session, ctx.now);
+  if (account !== null) await ctx.store.endAllSessions(account.id);
+  return json({ ok: true }, 200, sessionCookies(ctx.id, null));
+}
+
+/** The account a valid, unexpired token from this site belongs to (it may have been deleted since). */
+async function accountForBearer(ctx: Context): Promise<Account | null> {
+  const token = bearer(ctx.request);
+  if (token === null) return null;
+  const claims = await verifyJwt(
+    token,
+    ctx.secret,
+    { iss: ctx.id.apiOrigin, aud: ctx.id.audience },
+    Math.floor(ctx.now / 1000),
+  );
+  if (claims === null) return null;
+  const accountId = b64uToUuid(claims.sub);
+  return accountId === null ? null : ctx.store.byId(accountId);
+}
+
+async function me(ctx: Context): Promise<Response> {
+  const account = await accountForBearer(ctx);
+  if (account === null) return json({ error: "unauthorized" }, 401);
+  return json(userMeResponse(account));
+}
+
+async function deleteMe(ctx: Context): Promise<Response> {
+  const session = readCookie(ctx.request, SESSION_COOKIE);
+  const account =
+    session === null ? null : await ctx.store.accountForSession(session, ctx.now);
+  if (account === null) {
+    return json({ error: "not signed in" }, 401, sessionCookies(ctx.id, null));
+  }
+  await ctx.store.deleteAccount(account.id);
+  return new Response(null, {
+    status: 204,
+    headers: sessionCookies(ctx.id, null),
+  });
+}
+
+// ---------------------------------------------------------- the emailed link
+
+function validEmail(raw: unknown): string | null {
+  if (typeof raw !== "string") return null;
+  const email = raw.trim().toLowerCase();
+  if (email.length < 3 || email.length > 254) return null;
+  // Deliberately plain: the real test of an address is that the mail arrives.
+  if (!/^[^\s@<>()[\]\\,;:"]+@[^\s@<>()[\]\\,;:"]+\.[^\s@<>()[\]\\,;:"]+$/.test(email)) {
+    return null;
+  }
+  return email;
+}
+
+async function magicLink(ctx: Context): Promise<Response> {
+  let body: { email?: unknown; redirectDomain?: unknown };
+  try {
+    body = (await ctx.request.json()) as typeof body;
+  } catch {
+    return json({ error: "invalid body" }, 400);
+  }
+  const email = validEmail(body.email);
+  if (email === null) return json({ error: "invalid email" }, 400);
+
+  // The link in the email points at the page named here, so it has to be this site's own.
+  const domain =
+    typeof body.redirectDomain === "string"
+      ? body.redirectDomain.replace(/\/+$/, "")
+      : "";
+  if (domain !== ctx.id.siteOrigin) return json({ error: "invalid redirectDomain" }, 400);
+
+  if (!mailConfigured(ctx.env)) {
+    return json({ error: "email sign-in is not set up on this site" }, 503);
+  }
+
+  // Limits, so the form cannot be used to flood someone's inbox or to use up the mail allowance.
+  const ip = ctx.request.headers.get("cf-connecting-ip") ?? "unknown";
+  const ipHash = await sha256Hex(`${ctx.secret}|ip|${ip}`);
+  const recent = await ctx.store.recentLinkCounts(email, ipHash, ctx.now - HOUR_MS);
+  if (recent.email >= LINKS_PER_EMAIL || recent.ip >= LINKS_PER_IP) {
+    return json({ error: "too many requests" }, 429);
+  }
+  const cap = Number(ctx.env.MAIL_DAILY_CAP ?? "250") || 250;
+  if ((await ctx.store.countLinksSince(ctx.now - DAY_MS)) >= cap) {
+    return json({ error: "email sign-in is busy, try again later" }, 429);
+  }
+
+  const token = await ctx.store.createLoginLink(email, ipHash, ctx.now);
+  const link = `${ctx.id.siteOrigin}/#token-login?token-login=${token}`;
+  const sent = await sendLoginEmail(ctx.env, email, link);
+  if (sent !== "sent") {
+    await ctx.store.dropLoginLink(token);
+    return json({ error: "could not send the email" }, 502);
+  }
+  return json({ ok: true });
+}
+
+async function tokenLogin(ctx: Context): Promise<Response> {
+  const token = ctx.url.searchParams.get("login-token") ?? "";
+  if (token.length === 0 || token.length > 200) {
+    return json({ code: "invalid" }, 400);
+  }
+  const used = await ctx.store.useLoginLink(token, ctx.now);
+  if (!used.ok) return json({ code: used.code }, 400);
+
+  const account = await ctx.store.signInWithEmail(used.email, ctx.now);
+  const session = await ctx.store.createSession(account.id, ctx.now);
+  return json({ email: account.email }, 200, sessionCookies(ctx.id, session));
+}
+
+// ------------------------------------------------------------------- Google
+
+const STATE_MS = 10 * 60 * 1000;
+/** Marks a `state` that is signing in rather than linking to an account. */
+const NOT_LINKING = "-";
+
+/**
+ * Sends the browser to Google. `state` ties the answer to this sign-in: it is signed, it
+ * expires, it names the page to return to and (for linking) the account, and the browser
+ * that started it holds the matching cookie.
+ */
+async function googleRedirectUrl(
+  ctx: Context,
+  back: string,
+  linkAccountId: string | null,
+): Promise<{ url: string; cookies: Headers }> {
+  const nonce = randomToken(16);
+  const link = linkAccountId === null ? NOT_LINKING : uuidToB64u(linkAccountId);
+  const payload = `${nonce}.${Math.floor((ctx.now + STATE_MS) / 1000)}.${bytesToB64u(new TextEncoder().encode(back))}.${link}`;
+  const state = `${payload}.${await hmacB64u(ctx.secret, `oauth-state:${payload}`)}`;
+  const cookies = new Headers();
+  cookies.append(
+    "set-cookie",
+    cookie(OAUTH_COOKIE, nonce, ctx.id, {
+      maxAge: STATE_MS / 1000,
+      httpOnly: true,
+      path: "/auth",
+    }),
+  );
+  return {
+    url: googleAuthorizeUrl(ctx.env, `${ctx.id.apiOrigin}/auth/callback/google`, state),
+    cookies,
+  };
+}
+
+async function googleStart(ctx: Context): Promise<Response> {
+  const back = returnAddress(ctx.url.searchParams.get("redirect_uri"), ctx.id);
+  if (back === null) return json({ error: "invalid redirect_uri" }, 400);
+  if (!googleConfigured(ctx.env)) return loginFailed(back, "error");
+  const { url, cookies } = await googleRedirectUrl(ctx, back, null);
+  return redirect(url, cookies);
+}
+
+/** "Link Google" on the account screen: the same trip to Google, for the signed-in account. */
+async function googleLinkStart(ctx: Context): Promise<Response> {
+  const account = await accountForBearer(ctx);
+  if (account === null) return json({ error: "unauthorized" }, 401);
+  const back = returnAddress(ctx.url.searchParams.get("redirect_uri"), ctx.id);
+  if (back === null) return json({ error: "invalid redirect_uri" }, 400);
+  if (!googleConfigured(ctx.env)) {
+    return json({ error: "Google sign-in is not set up on this site" }, 503);
+  }
+  const { url, cookies } = await googleRedirectUrl(ctx, back, account.id);
+  return json({ url }, 200, cookies);
+}
+
+async function googleCallback(ctx: Context): Promise<Response> {
+  const clearState = new Headers();
+  clearState.append(
+    "set-cookie",
+    cookie(OAUTH_COOKIE, "", ctx.id, { maxAge: 0, httpOnly: true, path: "/auth" }),
+  );
+  const home = `${ctx.id.siteOrigin}/`;
+
+  // Check `state` before trusting anything in it, the address to return to included.
+  const parts = (ctx.url.searchParams.get("state") ?? "").split(".");
+  if (parts.length !== 5) return redirect(withHash(home, "modal=account&login=error"), clearState);
+  const [nonce, exp, backB64, link, sig] = parts as [string, string, string, string, string];
+  const payload = `${nonce}.${exp}.${backB64}.${link}`;
+  const cookieNonce = readCookie(ctx.request, OAUTH_COOKIE);
+  const valid =
+    cookieNonce !== null &&
+    cookieNonce === nonce &&
+    Number(exp) * 1000 > ctx.now &&
+    (await hmacVerify(ctx.secret, `oauth-state:${payload}`, sig));
+  const backBytes = valid ? b64uToBytes(backB64) : null;
+  const back =
+    backBytes === null
+      ? null
+      : returnAddress(new TextDecoder().decode(backBytes), ctx.id);
+  if (back === null) return redirect(withHash(home, "modal=account&login=error"), clearState);
+
+  // Linking an account that is already signed in, or signing in?
+  const linkId = link === NOT_LINKING ? null : b64uToUuid(link);
+  const linking = link !== NOT_LINKING;
+  if (linking && linkId === null) return redirect(withHash(back, "modal=account&link=error"), clearState);
+
+  // The person closed Google's page or refused: back where they were, with nothing to report.
+  const code = ctx.url.searchParams.get("code");
+  if (ctx.url.searchParams.get("error") !== null || code === null) {
+    return redirect(back, clearState);
+  }
+
+  const who = await googleIdentity(
+    ctx.env,
+    code,
+    `${ctx.id.apiOrigin}/auth/callback/google`,
+  );
+
+  if (linking) {
+    if (who === null || linkId === null) {
+      return redirect(withHash(back, "modal=account&link=error"), clearState);
+    }
+    const result = await ctx.store.linkGoogle(linkId, who.sub, who.email);
+    const outcome = result === "linked" ? "google" : "already_linked";
+    return redirect(withHash(back, `modal=account&link=${outcome}`), clearState);
+  }
+
+  if (who === null) return loginFailed(back, "error");
+  let accountId: string;
+  try {
+    accountId = (await ctx.store.signInWithGoogle(who.sub, who.email, ctx.now)).id;
+  } catch {
+    return loginFailed(back, "email_exists");
+  }
+  const session = await ctx.store.createSession(accountId, ctx.now);
+  const headers = sessionCookies(ctx.id, session);
+  for (const c of clearState.getSetCookie()) headers.append("set-cookie", c);
+  return redirect(back, headers);
+}
diff --git a/cloudflare/src/accounts/crypto.ts b/cloudflare/src/accounts/crypto.ts
new file mode 100644
index 0000000..5e98cc5
--- /dev/null
+++ b/cloudflare/src/accounts/crypto.ts
@@ -0,0 +1,172 @@
+// Small crypto helpers for accounts, on the Web Crypto API (available in every Worker
+// without a compatibility flag): random tokens, SHA-256, and HS256 JSON Web Tokens.
+//
+// The tokens this site issues are signed with one secret (JWT_SECRET) that only the Worker
+// holds, so HS256 is enough: the party that checks a token is the party that made it.
+
+const encoder = new TextEncoder();
+
+export function bytesToB64u(bytes: Uint8Array): string {
+  let s = "";
+  for (const b of bytes) s += String.fromCharCode(b);
+  return btoa(s).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
+}
+
+/** Null for text that is not base64url. */
+export function b64uToBytes(text: string): Uint8Array | null {
+  if (!/^[A-Za-z0-9_-]*$/.test(text)) return null;
+  const std = text.replace(/-/g, "+").replace(/_/g, "/");
+  try {
+    const bin = atob(std + "=".repeat((4 - (std.length % 4)) % 4));
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+    return out;
+  } catch {
+    return null;
+  }
+}
+
+function textToB64u(text: string): string {
+  return bytesToB64u(encoder.encode(text));
+}
+
+/** `n` random bytes as base64url text: a secret that cannot be guessed. */
+export function randomToken(n = 32): string {
+  return bytesToB64u(crypto.getRandomValues(new Uint8Array(n)));
+}
+
+export async function sha256Hex(text: string): Promise<string> {
+  const digest = await crypto.subtle.digest("SHA-256", encoder.encode(text));
+  return Array.from(new Uint8Array(digest), (b) =>
+    b.toString(16).padStart(2, "0"),
+  ).join("");
+}
+
+/** A UUID in the 22-character form the client expects in a token's `sub`. */
+export function uuidToB64u(uuid: string): string {
+  const hex = uuid.replace(/-/g, "");
+  const bytes = new Uint8Array(16);
+  for (let i = 0; i < 16; i++) {
+    bytes[i] = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
+  }
+  return bytesToB64u(bytes);
+}
+
+/** Null when the text is not a base64url UUID. */
+export function b64uToUuid(text: string): string | null {
+  const bytes = b64uToBytes(text);
+  if (bytes === null || bytes.length !== 16) return null;
+  const hex = Array.from(bytes, (b) => b.toString(16).padStart(2, "0")).join("");
+  return [
+    hex.slice(0, 8),
+    hex.slice(8, 12),
+    hex.slice(12, 16),
+    hex.slice(16, 20),
+    hex.slice(20),
+  ].join("-");
+}
+
+function hmacKey(secret: string): Promise<CryptoKey> {
+  return crypto.subtle.importKey(
+    "raw",
+    encoder.encode(secret),
+    { name: "HMAC", hash: "SHA-256" },
+    false,
+    ["sign", "verify"],
+  );
+}
+
+/** HMAC-SHA256 of `message`, base64url. */
+export async function hmacB64u(secret: string, message: string): Promise<string> {
+  const sig = await crypto.subtle.sign(
+    "HMAC",
+    await hmacKey(secret),
+    encoder.encode(message),
+  );
+  return bytesToB64u(new Uint8Array(sig));
+}
+
+/** Constant-time check of a signature made by hmacB64u. */
+export async function hmacVerify(
+  secret: string,
+  message: string,
+  signature: string,
+): Promise<boolean> {
+  const sig = b64uToBytes(signature);
+  if (sig === null) return false;
+  return crypto.subtle.verify(
+    "HMAC",
+    await hmacKey(secret),
+    sig,
+    encoder.encode(message),
+  );
+}
+
+/** What a token says, as far as this site uses it (the client's TokenPayloadSchema). */
+export interface TokenClaims {
+  jti: string;
+  /** The account id as a base64url UUID (22 characters). */
+  sub: string;
+  iat: number;
+  exp: number;
+  iss: string;
+  aud: string;
+  provider?: string;
+}
+
+export async function signJwt(
+  claims: TokenClaims,
+  secret: string,
+): Promise<string> {
+  const input = `${textToB64u(JSON.stringify({ alg: "HS256", typ: "JWT" }))}.${textToB64u(JSON.stringify(claims))}`;
+  return `${input}.${await hmacB64u(secret, input)}`;
+}
+
+/**
+ * The claims of a token this site signed, or null: wrong shape, wrong algorithm, bad
+ * signature, expired, or issued by or for some other site. The algorithm is fixed here,
+ * never read from the token, so a token cannot choose how it is checked.
+ */
+export async function verifyJwt(
+  token: string,
+  secret: string,
+  expect: { iss: string; aud: string },
+  nowSeconds: number,
+): Promise<TokenClaims | null> {
+  const parts = token.split(".");
+  if (parts.length !== 3) return null;
+  const [header, payload, signature] = parts as [string, string, string];
+
+  const headerBytes = b64uToBytes(header);
+  const payloadBytes = b64uToBytes(payload);
+  if (headerBytes === null || payloadBytes === null) return null;
+  let head: unknown;
+  let body: unknown;
+  try {
+    const decoder = new TextDecoder();
+    head = JSON.parse(decoder.decode(headerBytes));
+    body = JSON.parse(decoder.decode(payloadBytes));
+  } catch {
+    return null;
+  }
+  if (typeof head !== "object" || head === null) return null;
+  if ((head as { alg?: unknown }).alg !== "HS256") return null;
+
+  if (!(await hmacVerify(secret, `${header}.${payload}`, signature))) return null;
+
+  if (typeof body !== "object" || body === null) return null;
+  const c = body as Partial<TokenClaims>;
+  if (
+    typeof c.jti !== "string" ||
+    typeof c.sub !== "string" ||
+    typeof c.iat !== "number" ||
+    typeof c.exp !== "number" ||
+    typeof c.iss !== "string" ||
+    typeof c.aud !== "string"
+  ) {
+    return null;
+  }
+  if (c.exp <= nowSeconds) return null;
+  if (c.iss !== expect.iss || c.aud !== expect.aud) return null;
+  return c as TokenClaims;
+}
diff --git a/cloudflare/src/accounts/google.ts b/cloudflare/src/accounts/google.ts
new file mode 100644
index 0000000..f672ab8
--- /dev/null
+++ b/cloudflare/src/accounts/google.ts
@@ -0,0 +1,85 @@
+// "Sign in with Google": the OAuth authorization-code flow, done by this Worker.
+//
+//   1. /auth/login/google sends the browser to Google with a signed `state`.
+//   2. Google sends it back to /auth/callback/google with a one-time `code`.
+//   3. The Worker trades the code (plus its client secret) for an access token, and asks
+//      Google who that is. The answer arrives over TLS from Google's own endpoint in reply
+//      to our request, so it needs no further signature check.
+
+import type { Env } from "../env";
+
+const AUTH_URL = "https://accounts.google.com/o/oauth2/v2/auth";
+const TOKEN_URL = "https://oauth2.googleapis.com/token";
+const USERINFO_URL = "https://openidconnect.googleapis.com/v1/userinfo";
+
+export function googleConfigured(env: Env): boolean {
+  return Boolean(env.GOOGLE_CLIENT_ID) && Boolean(env.GOOGLE_CLIENT_SECRET);
+}
+
+export function googleAuthorizeUrl(
+  env: Env,
+  redirectUri: string,
+  state: string,
+): string {
+  const url = new URL(env.GOOGLE_AUTH_URL || AUTH_URL);
+  url.searchParams.set("client_id", env.GOOGLE_CLIENT_ID!);
+  url.searchParams.set("redirect_uri", redirectUri);
+  url.searchParams.set("response_type", "code");
+  url.searchParams.set("scope", "openid email");
+  url.searchParams.set("state", state);
+  // Always show the account picker: a shared computer should not sign in silently.
+  url.searchParams.set("prompt", "select_account");
+  return url.toString();
+}
+
+export interface GoogleIdentity {
+  sub: string;
+  email: string;
+}
+
+/** The person behind an authorization code, or null if Google refuses or the address is unverified. */
+export async function googleIdentity(
+  env: Env,
+  code: string,
+  redirectUri: string,
+): Promise<GoogleIdentity | null> {
+  try {
+    const tokenRes = await fetch(env.GOOGLE_TOKEN_URL || TOKEN_URL, {
+      method: "POST",
+      headers: { "content-type": "application/x-www-form-urlencoded" },
+      body: new URLSearchParams({
+        code,
+        client_id: env.GOOGLE_CLIENT_ID!,
+        client_secret: env.GOOGLE_CLIENT_SECRET!,
+        redirect_uri: redirectUri,
+        grant_type: "authorization_code",
+      }),
+    });
+    if (!tokenRes.ok) return null;
+    const token = (await tokenRes.json()) as { access_token?: unknown };
+    if (typeof token.access_token !== "string") return null;
+
+    const infoRes = await fetch(env.GOOGLE_USERINFO_URL || USERINFO_URL, {
+      headers: { authorization: `Bearer ${token.access_token}` },
+    });
+    if (!infoRes.ok) return null;
+    const info = (await infoRes.json()) as {
+      sub?: unknown;
+      email?: unknown;
+      email_verified?: unknown;
+    };
+    if (
+      typeof info.sub !== "string" ||
+      typeof info.email !== "string" ||
+      info.email_verified !== true
+    ) {
+      return null;
+    }
+    return { sub: info.sub, email: info.email.trim().toLowerCase() };
+  } catch (e) {
+    console.warn(
+      JSON.stringify({ msg: "google sign-in failed", error: String(e) }),
+    );
+    return null;
+  }
+}
diff --git a/cloudflare/src/accounts/identity.ts b/cloudflare/src/accounts/identity.ts
new file mode 100644
index 0000000..4e3569f
--- /dev/null
+++ b/cloudflare/src/accounts/identity.ts
@@ -0,0 +1,53 @@
+// Which addresses the account system uses, worked out from the host a request arrived on.
+//
+// The client looks for the account API at `https://api.<site host>` and rejects a token
+// whose issuer is anything else, or whose audience is not the site host (Auth.ts). Locally
+// (`wrangler dev`) it uses the page's own origin and skips the audience check. Deriving all
+// of that from the request's host means no setting has to agree with the page build.
+
+export interface SiteIdentity {
+  /** The page players open: where the client's code runs, and the only origin allowed to call the API. */
+  siteOrigin: string;
+  /** Where the account API answers; the `iss` of every token. */
+  apiOrigin: string;
+  /** The `aud` of every token. */
+  audience: string;
+  /** Whether this request arrived at the account API's own address (or a local dev server). */
+  isApiHost: boolean;
+  /** `wrangler dev`: plain http, and the API shares the page's origin. */
+  local: boolean;
+}
+
+function isLocalHost(hostname: string): boolean {
+  return (
+    hostname === "localhost" ||
+    hostname === "127.0.0.1" ||
+    hostname === "[::1]"
+  );
+}
+
+/** `host` as in a URL's `host`: name plus port, when there is one. */
+export function identityForHost(host: string): SiteIdentity {
+  const hostname = host.replace(/:\d+$/, "").toLowerCase();
+
+  if (isLocalHost(hostname)) {
+    const origin = `http://${host.toLowerCase()}`;
+    return {
+      siteOrigin: origin,
+      apiOrigin: origin,
+      audience: "localhost",
+      isApiHost: true,
+      local: true,
+    };
+  }
+
+  const isApiHost = hostname.startsWith("api.");
+  const siteHost = isApiHost ? hostname.slice("api.".length) : hostname;
+  return {
+    siteOrigin: `https://${siteHost}`,
+    apiOrigin: `https://api.${siteHost}`,
+    audience: siteHost,
+    isApiHost,
+    local: false,
+  };
+}
diff --git a/cloudflare/src/accounts/mail.ts b/cloudflare/src/accounts/mail.ts
new file mode 100644
index 0000000..413de20
--- /dev/null
+++ b/cloudflare/src/accounts/mail.ts
@@ -0,0 +1,85 @@
+// The sign-in email, sent through Brevo's transactional API (free tier: a few hundred mails
+// a day, which src/accounts/api.ts keeps the site inside of). Cloudflare's own email sending
+// needs the paid Workers plan, so it is not used.
+
+import type { Env } from "../env";
+
+const DEFAULT_URL = "https://api.brevo.com/v3/smtp/email";
+
+export type MailResult = "sent" | "not_configured" | "failed";
+
+export function mailConfigured(env: Env): boolean {
+  return Boolean(env.BREVO_API_KEY) && Boolean(env.MAIL_FROM);
+}
+
+function body(link: string): { subject: string; html: string; text: string } {
+  const subject = "Your OpenFront sign-in link | لینک ورود به OpenFront";
+  const text = [
+    "Open this link to sign in to OpenFront. It works once and expires in 15 minutes:",
+    link,
+    "",
+    "If you did not ask for it, ignore this email: nobody can sign in without the link.",
+    "",
+    "برای ورود به OpenFront این لینک را باز کنید. فقط یک بار کار می‌کند و ۱۵ دقیقه اعتبار دارد:",
+    link,
+    "",
+    "اگر خودتان درخواست نکرده‌اید، این ایمیل را نادیده بگیرید.",
+  ].join("\n");
+  const html = `<!doctype html>
+<html><body style="margin:0;background:#0a1020;font-family:system-ui,-apple-system,'Segoe UI',Tahoma,sans-serif;color:#e6edf7">
+<div style="max-width:30rem;margin:0 auto;padding:2rem 1.25rem">
+  <h1 style="font-size:1.25rem;margin:0 0 1rem">Sign in to OpenFront</h1>
+  <p style="line-height:1.6;margin:0 0 1.25rem">Open the link below to sign in. It works once and expires in 15 minutes.</p>
+  <p style="margin:0 0 1.5rem"><a href="${link}" style="display:inline-block;background:#1a7fe0;color:#fff;text-decoration:none;font-weight:700;padding:.8rem 1.4rem;border-radius:.6rem">Sign in</a></p>
+  <p style="font-size:.85rem;line-height:1.6;color:#9db0cc;margin:0 0 2rem">If the button does not work, copy this address into your browser:<br><span style="word-break:break-all">${link}</span></p>
+  <div dir="rtl" style="border-top:1px solid #243049;padding-top:1.25rem">
+    <h2 style="font-size:1.1rem;margin:0 0 .75rem">ورود به OpenFront</h2>
+    <p style="line-height:1.8;margin:0 0 1rem">برای ورود روی لینک بالا بزنید. فقط یک بار کار می‌کند و ۱۵ دقیقه اعتبار دارد.</p>
+    <p style="font-size:.85rem;line-height:1.8;color:#9db0cc;margin:0">اگر خودتان درخواست نکرده‌اید، این ایمیل را نادیده بگیرید؛ بدون این لینک کسی نمی‌تواند وارد شود.</p>
+  </div>
+</div></body></html>`;
+  return { subject, html, text };
+}
+
+/** Sends `to` their sign-in link. */
+export async function sendLoginEmail(
+  env: Env,
+  to: string,
+  link: string,
+): Promise<MailResult> {
+  if (!mailConfigured(env)) return "not_configured";
+  const { subject, html, text } = body(link);
+  try {
+    const res = await fetch(env.BREVO_API_URL || DEFAULT_URL, {
+      method: "POST",
+      headers: {
+        "api-key": env.BREVO_API_KEY!,
+        "content-type": "application/json",
+        accept: "application/json",
+      },
+      body: JSON.stringify({
+        sender: { name: env.MAIL_FROM_NAME || "OpenFront", email: env.MAIL_FROM },
+        to: [{ email: to }],
+        subject,
+        htmlContent: html,
+        textContent: text,
+      }),
+    });
+    if (res.ok) return "sent";
+    // Brevo's reason (an unverified sender, an exhausted allowance) is what the owner needs
+    // in the log. The address is left out of it.
+    console.warn(
+      JSON.stringify({
+        msg: "login email rejected",
+        status: res.status,
+        detail: (await res.text()).slice(0, 300),
+      }),
+    );
+    return "failed";
+  } catch (e) {
+    console.warn(
+      JSON.stringify({ msg: "login email failed", error: String(e) }),
+    );
+    return "failed";
+  }
+}
diff --git a/cloudflare/src/accounts/profile.ts b/cloudflare/src/accounts/profile.ts
