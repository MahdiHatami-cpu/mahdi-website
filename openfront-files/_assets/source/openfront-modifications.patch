+// End-to-end smoke test of the Worker's game relay, using the repo's own wire
+// codec (the same bytes a browser client sends). Run `npm run dev` in this
+// folder first, then `npm run smoke`.
+//
+//   BASE=http://localhost:8787 GIT_COMMIT=DEV npm run smoke
+
+import type {
+  ClientMessage,
+  ServerMessage,
+} from "@openfront/shared/WireSchemas";
+import {
+  createGameWireContext,
+  decodeServerMessage,
+  encodeClientMessage,
+} from "@openfront/shared/ZbinWire";
+import type { ZbContext } from "@openfront/zbin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const WS_BASE = BASE.replace(/^http/, "ws");
+// The build id joins must carry: the deployment publishes it next to the page.
+// An API-only deployment has no commit.txt and uses the GIT_COMMIT var ("DEV").
+const COMMIT =
+  process.env.GIT_COMMIT ??
+  (await fetch(`${BASE}/commit.txt`)
+    .then(async (r) => (r.ok ? (await r.text()).trim() : "DEV"))
+    .catch(() => "DEV"));
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  console.log(
+    `${ok ? "  ok  " : " FAIL "} ${label}${ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`}`,
+  );
+  if (!ok) failed = true;
+}
+
+class TestClient {
+  ws!: WebSocket;
+  ctx: ZbContext | undefined;
+  readonly inbox: ServerMessage[] = [];
+  closed: { code: number; reason: string } | null = null;
+  private waiters: Array<() => void> = [];
+
+  constructor(
+    readonly name: string,
+    readonly token: string,
+  ) {}
+
+  async connect(path: string): Promise<void> {
+    this.ws = new WebSocket(`${WS_BASE}/${path}`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) => {
+      const msg = decodeServerMessage(
+        new Uint8Array(ev.data as ArrayBuffer),
+        this.ctx,
+      );
+      // The start message seeds the clientID dictionary every later frame uses.
+      if (msg.type === "start") {
+        this.ctx = createGameWireContext(msg.gameStartInfo.players);
+      }
+      this.inbox.push(msg);
+      this.wake();
+    };
+    this.ws.onclose = (ev) => {
+      this.closed = { code: ev.code, reason: ev.reason };
+      this.wake();
+    };
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () =>
+        reject(new Error(`${this.name}: websocket error`));
+    });
+  }
+
+  send(msg: ClientMessage): void {
+    this.ws.send(encodeClientMessage(msg, this.ctx));
+  }
+
+  private wake(): void {
+    const w = this.waiters;
+    this.waiters = [];
+    for (const f of w) f();
+  }
+
+  /** Resolves with the first inbox message (already received or future) matching. */
+  async waitFor<T extends ServerMessage["type"]>(
+    type: T,
+    pred: (m: Extract<ServerMessage, { type: T }>) => boolean = () => true,
+    timeoutMs = 10_000,
+  ): Promise<Extract<ServerMessage, { type: T }>> {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const hit = this.inbox.find(
+        (m): m is Extract<ServerMessage, { type: T }> =>
+          m.type === type && pred(m as Extract<ServerMessage, { type: T }>),
+      );
+      if (hit !== undefined) return hit;
+      if (this.closed !== null) {
+        throw new Error(
+          `${this.name}: closed (${this.closed.code} ${this.closed.reason}) while waiting for ${type}`,
+        );
+      }
+      const left = deadline - Date.now();
+      if (left <= 0)
+        throw new Error(`${this.name}: timed out waiting for ${type}`);
+      await new Promise<void>((resolve) => {
+        const t = setTimeout(resolve, left);
+        this.waiters.push(() => {
+          clearTimeout(t);
+          resolve();
+        });
+      });
+    }
+  }
+
+  join(gameID: string, username: string, commit = COMMIT): void {
+    this.send({
+      type: "join",
+      token: this.token,
+      gameID,
+      username,
+      clanTag: null,
+      turnstileToken: null,
+      gitCommit: commit,
+    });
+  }
+
+  close(): void {
+    this.ws.close();
+  }
+}
+
+async function main(): Promise<void> {
+  console.log(`relay smoke test against ${BASE} (commit ${COMMIT})`);
+
+  const health = await fetch(`${BASE}/api/health`).then((r) => r.json());
+  check((health as { status?: string }).status === "ok", "GET /api/health");
+
+  // --- create a private lobby
+  const hostToken = crypto.randomUUID();
+  const created = await fetch(`${BASE}/api/create_game`, {
+    method: "POST",
+    headers: {
+      authorization: `Bearer ${hostToken}`,
+      "content-type": "application/json",
+    },
+    body: "{}",
+  });
+  const info = (await created.json()) as { gameID: string; workerPath: string };
+  check(
+    created.status === 200 && typeof info.gameID === "string",
+    "POST /api/create_game",
+    info,
+  );
+  check(info.workerPath === "w0", "game id routes to /w0", info.workerPath);
+  const exists = await fetch(
+    `${BASE}/${info.workerPath}/api/game/${info.gameID}/exists`,
+  ).then((r) => r.json());
+  check(
+    (exists as { exists?: boolean }).exists === true,
+    "GET /w0/api/game/:id/exists",
+  );
+
+  const noAuth = await fetch(`${BASE}/api/create_game`, {
+    method: "POST",
+    body: "{}",
+  });
+  check(
+    noAuth.status === 400,
+    "create_game without Authorization is rejected",
+    noAuth.status,
+  );
+
+  // --- version mismatch is refused with the typed error
+  const stale = new TestClient("stale", crypto.randomUUID());
+  await stale.connect(info.workerPath);
+  stale.join(info.gameID, "Stale", "not-the-commit");
+  const mismatch = await stale.waitFor("error");
+  check(
+    mismatch.error === "version_mismatch",
+    "stale client told version_mismatch",
+    mismatch,
+  );
+
+  // --- two players join the lobby
+  const host = new TestClient("host", hostToken);
+  const guest = new TestClient("guest", crypto.randomUUID());
+  await host.connect(info.workerPath);
+  await guest.connect(info.workerPath);
+  host.join(info.gameID, "Host");
+  guest.join(info.gameID, "Guest");
+  const lobby = await host.waitFor(
+    "lobby_info",
+    (m) => (m.lobby.clients?.length ?? 0) === 2,
+  );
+  check(lobby.lobby.clients?.length === 2, "lobby_info lists both players");
+  check(
+    lobby.lobby.lobbyCreatorClientID === lobby.myClientID,
+    "host is the lobby creator",
+  );
+  const guestLobby = await guest.waitFor(
+    "lobby_info",
+    (m) => (m.lobby.clients?.length ?? 0) === 2,
+  );
+  check(
+    guestLobby.lobby.lobbyCreatorClientID !== guestLobby.myClientID,
+    "guest is not the creator",
+  );
+
+  // --- only the creator may start
+  guest.send({ type: "intent", intent: { type: "toggle_game_start_timer" } });
+  await new Promise((r) => setTimeout(r, 1500));
+  check(
+    !guest.inbox.some((m) => m.type === "prestart"),
+    "guest cannot start the game",
+  );
+
+  host.send({ type: "intent", intent: { type: "toggle_game_start_timer" } });
+  await host.waitFor("prestart");
+  await guest.waitFor("prestart");
+  check(true, "prestart reaches both");
+  const hostStart = await host.waitFor("start", () => true, 15_000);
+  const guestStart = await guest.waitFor("start", () => true, 15_000);
+  check(
+    hostStart.gameStartInfo.players.length === 2,
+    "start lists 2 players",
+    hostStart.gameStartInfo.players.length,
+  );
+  check(
+    hostStart.myClientID !== guestStart.myClientID,
+    "each player gets its own clientID",
+  );
+  const hostID = hostStart.myClientID!;
+  const guestID = guestStart.myClientID!;
+
+  // --- turns flow, in order, identical for everyone
+  await host.waitFor("turn", (m) => m.turn.turnNumber >= 10);
+  await guest.waitFor("turn", (m) => m.turn.turnNumber >= 10);
+  const numbers = host.inbox
+    .filter((m) => m.type === "turn")
+    .map((m) => (m as { turn: { turnNumber: number } }).turn.turnNumber);
+  check(
+    numbers.every((n, i) => i === 0 || n === numbers[i - 1]! + 1),
+    "turn numbers are consecutive",
+    numbers.slice(0, 12),
+  );
+
+  // --- an intent is stamped with the sender and relayed to everyone
+  guest.send({ type: "intent", intent: { type: "spawn", tile: 1 } });
+  const stampedOn = (c: TestClient) =>
+    c.waitFor("turn", (m) => m.turn.intents.some((i) => i.type === "spawn"));
+  const [hostSaw, guestSaw] = await Promise.all([
+    stampedOn(host),
+    stampedOn(guest),
+  ]);
+  const spawnIntent = hostSaw.turn.intents.find((i) => i.type === "spawn");
+  check(
+    spawnIntent?.clientID === guestID,
+    "intent is stamped with the guest's clientID",
+    spawnIntent,
+  );
+  check(
+    hostSaw.turn.turnNumber === guestSaw.turn.turnNumber,
+    "both players see the intent in the same turn",
+    [hostSaw.turn.turnNumber, guestSaw.turn.turnNumber],
+  );
+
+  // --- ping/pong
+  guest.send({ type: "ping", sentAt: 12345 });
+  const pong = await guest.waitFor("pong", (m) => m.sentAt === 12345);
+  check(pong.sentAt === 12345, "ping is answered with pong");
+
+  // --- rejoin after a dropped connection resumes from lastTurn
+  const lastSeen = guest.inbox.filter((m) => m.type === "turn").length;
+  guest.close();
+  await new Promise((r) => setTimeout(r, 500));
+  const guest2 = new TestClient("guest2", guest.token);
+  await guest2.connect(info.workerPath);
+  guest2.send({
+    type: "rejoin",
+    gameID: info.gameID,
+    lastTurn: lastSeen,
+    token: guest.token,
+    gitCommit: COMMIT,
+  });
+  const resumed = await guest2.waitFor("start", () => true, 5_000);
+  check(
+    resumed.myClientID === guestID,
+    "rejoin keeps the same clientID",
+    resumed.myClientID,
+  );
+  check(
+    resumed.turns.length > 0 && resumed.turns[0]!.turnNumber === lastSeen,
+    "rejoin replays missed turns from lastTurn",
+    resumed.turns[0]?.turnNumber,
+  );
+  await guest2.waitFor(
+    "turn",
+    (m) => m.turn.turnNumber > resumed.turns.at(-1)!.turnNumber,
+  );
+  check(true, "turns keep flowing after rejoin");
+
+  // --- joining a game that does not exist closes with GameNotFound (4004)
+  const lost = new TestClient("lost", crypto.randomUUID());
+  await lost.connect(info.workerPath);
+  lost.join("a99999999", "Nobody");
+  await new Promise((r) => setTimeout(r, 800));
+  check(
+    lost.closed?.code === 4004,
+    "unknown game closes with 4004",
+    lost.closed,
+  );
+
+  host.close();
+  guest2.close();
+  stale.close();
+  void hostID;
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nSMOKE FAILED" : "\nSMOKE PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nSMOKE ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
