diff --git a/src/client/hud/layers/ZoomSlider.ts b/src/client/hud/layers/ZoomSlider.ts
new file mode 100644
index 0000000..8294bfb
--- /dev/null
+++ b/src/client/hud/layers/ZoomSlider.ts
@@ -0,0 +1,161 @@
+import { html, LitElement } from "lit";
+import { customElement, property, state } from "lit/decorators.js";
+import type { Controller } from "../../Controller";
+import { MAX_SCALE, MIN_SCALE, TransformHandler } from "../../TransformHandler";
+import { translateText } from "../../Utils";
+
+/** Slider resolution: the range input runs 0..SLIDER_STEPS. */
+export const SLIDER_STEPS = 1000;
+
+/** How much one click on the + / − buttons zooms. */
+export const BUTTON_ZOOM_FACTOR = 1.25;
+
+/**
+ * Zoom is multiplicative (each wheel notch scales by a constant factor), so the
+ * slider is logarithmic: equal thumb travel is an equal change in magnification,
+ * and the 0.2x..20x range doesn't spend 95% of its length on the far end.
+ */
+export function scaleToSliderValue(scale: number): number {
+  const clamped = Math.max(MIN_SCALE, Math.min(MAX_SCALE, scale));
+  const t = Math.log(clamped / MIN_SCALE) / Math.log(MAX_SCALE / MIN_SCALE);
+  return Math.round(t * SLIDER_STEPS);
+}
+
+export function sliderValueToScale(value: number): number {
+  const t = Math.max(0, Math.min(SLIDER_STEPS, value)) / SLIDER_STEPS;
+  return MIN_SCALE * Math.pow(MAX_SCALE / MIN_SCALE, t);
+}
+
+/**
+ * An on-screen zoom control for players without a scroll wheel (laptop
+ * trackpads): a vertical slider with +/− buttons. It drives the same zoom the
+ * wheel, keys and pinch do, and follows them, so the thumb always shows the
+ * current zoom. Hidden below the `lg` breakpoint, where pinch is the way.
+ */
+@customElement("zoom-slider")
+export class ZoomSlider extends LitElement implements Controller {
+  @property({ attribute: false })
+  public transformHandler: TransformHandler | null = null;
+
+  @state() private visible = false;
+  @state() private value = 0;
+
+  private rafId: number | null = null;
+
+  createRenderRoot() {
+    return this;
+  }
+
+  init() {
+    this.visible = true;
+    this.syncFromCamera();
+    this.startFollowingCamera();
+  }
+
+  connectedCallback() {
+    super.connectedCallback();
+    if (this.visible) this.startFollowingCamera();
+  }
+
+  disconnectedCallback() {
+    super.disconnectedCallback();
+    this.stopFollowingCamera();
+  }
+
+  // The camera also moves by wheel, keys, pinch and animated go-to, and none of
+  // those pass through this component, so read the scale back every frame.
+  // (A controller tick would not do: it only fires with game ticks, which stop
+  // while a singleplayer game is paused.) The check is one number compare.
+  private startFollowingCamera() {
+    if (this.rafId !== null) return;
+    const follow = () => {
+      this.syncFromCamera();
+      this.rafId = requestAnimationFrame(follow);
+    };
+    this.rafId = requestAnimationFrame(follow);
+  }
+
+  private stopFollowingCamera() {
+    if (this.rafId === null) return;
+    cancelAnimationFrame(this.rafId);
+    this.rafId = null;
+  }
+
+  private syncFromCamera() {
+    if (!this.transformHandler) return;
+    const next = scaleToSliderValue(this.transformHandler.scale);
+    if (next !== this.value) this.value = next;
+  }
+
+  private onInput = (e: Event) => {
+    const value = Number((e.target as HTMLInputElement).value);
+    this.transformHandler?.zoomToScale(sliderValueToScale(value));
+    this.value = value;
+  };
+
+  // Hand the keyboard back to the game once the thumb is let go: a focused
+  // range input would otherwise also eat the arrow keys the map pans with.
+  private onChange = (e: Event) => {
+    (e.target as HTMLInputElement).blur();
+  };
+
+  private zoomByFactor(factor: number) {
+    const handler = this.transformHandler;
+    if (!handler) return;
+    handler.zoomToScale(handler.scale * factor);
+    this.syncFromCamera();
+  }
+
+  render() {
+    if (!this.visible) return html``;
+    const zoomIn = translateText("zoom_slider.zoom_in");
+    const zoomOut = translateText("zoom_slider.zoom_out");
+    const buttonClass =
+      "flex h-7 w-7 items-center justify-center rounded-md text-lg leading-none text-white hover:bg-white/15 active:bg-white/25 cursor-pointer select-none";
+    // Space is the game's alt-view key; a button that kept focus after a click
+    // would be "pressed" by it, so keep the click from focusing the button.
+    const keepGameFocus = (e: Event) => e.preventDefault();
+    return html`
+      <div
+        class="fixed right-2 top-1/2 z-900 hidden -translate-y-1/2 flex-col items-center gap-1 rounded-lg bg-gray-800/92 px-1 py-2 text-white shadow-xs backdrop-blur-sm lg:flex"
+        @contextmenu=${(e: Event) => e.preventDefault()}
+      >
+        <button
+          type="button"
+          class=${buttonClass}
+          title=${zoomIn}
+          aria-label=${zoomIn}
+          @mousedown=${keepGameFocus}
+          @click=${() => this.zoomByFactor(BUTTON_ZOOM_FACTOR)}
+        >
+          +
+        </button>
+        <!-- A horizontal range input turned upright: it works in every browser,
+             unlike the vertical writing-mode/orient variants. -->
+        <div class="relative h-32 w-6">
+          <input
+            type="range"
+            min="0"
+            max=${SLIDER_STEPS}
+            step="1"
+            .value=${String(this.value)}
+            aria-label=${translateText("zoom_slider.label")}
+            class="absolute left-1/2 top-1/2 h-6 w-32 -translate-x-1/2 -translate-y-1/2 -rotate-90 cursor-pointer accent-sky-400"
+            @input=${this.onInput}
+            @change=${this.onChange}
+          />
+        </div>
+        <button
+          type="button"
+          class=${buttonClass}
+          title=${zoomOut}
+          aria-label=${zoomOut}
+          @mousedown=${keepGameFocus}
+          @click=${() => this.zoomByFactor(1 / BUTTON_ZOOM_FACTOR)}
+        >
+          −
+        </button>
+      </div>
+    `;
+  }
+}
