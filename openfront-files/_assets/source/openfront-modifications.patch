diff --git a/tests/client/ZoomSlider.test.ts b/tests/client/ZoomSlider.test.ts
new file mode 100644
index 0000000..66d269a
--- /dev/null
+++ b/tests/client/ZoomSlider.test.ts
@@ -0,0 +1,144 @@
+import { EventBus } from "@openfront/shared/EventBus";
+import { describe, expect, it } from "vitest";
+import {
+  BUTTON_ZOOM_FACTOR,
+  SLIDER_STEPS,
+  scaleToSliderValue,
+  sliderValueToScale,
+  ZoomSlider,
+} from "../../src/client/hud/layers/ZoomSlider";
+import {
+  MAX_SCALE,
+  MIN_SCALE,
+  TransformHandler,
+} from "../../src/client/TransformHandler";
+import type { GameView } from "../../src/client/view";
+
+function makeHandler() {
+  const game = { width: () => 1000, height: () => 800 } as unknown as GameView;
+  const canvas = document.createElement("canvas");
+  canvas.getBoundingClientRect = () =>
+    ({
+      left: 100,
+      top: 50,
+      width: 800,
+      height: 600,
+      right: 900,
+      bottom: 650,
+      x: 100,
+      y: 50,
+      toJSON: () => ({}),
+    }) as DOMRect;
+  return new TransformHandler(game, new EventBus(), canvas);
+}
+
+describe("zoom slider scale mapping", () => {
+  it("maps the ends of the slider to the zoom limits", () => {
+    expect(sliderValueToScale(0)).toBeCloseTo(MIN_SCALE, 10);
+    expect(sliderValueToScale(SLIDER_STEPS)).toBeCloseTo(MAX_SCALE, 10);
+    expect(scaleToSliderValue(MIN_SCALE)).toBe(0);
+    expect(scaleToSliderValue(MAX_SCALE)).toBe(SLIDER_STEPS);
+  });
+
+  it("is logarithmic: the middle of the slider is the geometric mean", () => {
+    expect(sliderValueToScale(SLIDER_STEPS / 2)).toBeCloseTo(
+      Math.sqrt(MIN_SCALE * MAX_SCALE),
+      10,
+    );
+  });
+
+  it("round-trips within one slider step", () => {
+    for (const scale of [0.2, 0.5, 1, 1.8, 4, 12, 20]) {
+      const back = sliderValueToScale(scaleToSliderValue(scale));
+      expect(Math.abs(Math.log(back / scale))).toBeLessThan(
+        Math.log(MAX_SCALE / MIN_SCALE) / SLIDER_STEPS,
+      );
+    }
+  });
+
+  it("clamps out-of-range input", () => {
+    expect(scaleToSliderValue(0.001)).toBe(0);
+    expect(scaleToSliderValue(1000)).toBe(SLIDER_STEPS);
+    expect(sliderValueToScale(-5)).toBeCloseTo(MIN_SCALE, 10);
+    expect(sliderValueToScale(SLIDER_STEPS * 2)).toBeCloseTo(MAX_SCALE, 10);
+  });
+});
+
+describe("TransformHandler.zoomToScale", () => {
+  it("lands exactly on the requested scale", () => {
+    const handler = makeHandler();
+    handler.zoomToScale(5);
+    expect(handler.scale).toBeCloseTo(5, 10);
+    handler.zoomToScale(0.5);
+    expect(handler.scale).toBeCloseTo(0.5, 10);
+  });
+
+  it("clamps to the zoom limits", () => {
+    const handler = makeHandler();
+    handler.zoomToScale(1000);
+    expect(handler.scale).toBe(MAX_SCALE);
+    handler.zoomToScale(0.0001);
+    expect(handler.scale).toBe(MIN_SCALE);
+  });
+
+  it("keeps the world point under the canvas centre fixed", () => {
+    const handler = makeHandler();
+    const centreX = 100 + 800 / 2;
+    const centreY = 50 + 600 / 2;
+    const before = handler.screenToWorldCoordinatesFloat(centreX, centreY);
+    handler.zoomToScale(6);
+    const after = handler.screenToWorldCoordinatesFloat(centreX, centreY);
+    expect(after.x).toBeCloseTo(before.x, 6);
+    expect(after.y).toBeCloseTo(before.y, 6);
+  });
+
+  it("marks the view changed, and does nothing for a no-op or bad value", () => {
+    const handler = makeHandler();
+    handler.zoomToScale(3);
+    expect(handler.hasChanged()).toBe(true);
+    handler.resetChanged();
+    handler.zoomToScale(3);
+    handler.zoomToScale(Number.NaN);
+    expect(handler.hasChanged()).toBe(false);
+    expect(handler.scale).toBeCloseTo(3, 10);
+  });
+});
+
+describe("<zoom-slider>", () => {
+  async function mount() {
+    const handler = makeHandler();
+    const el = document.createElement("zoom-slider") as ZoomSlider;
+    el.transformHandler = handler;
+    document.body.appendChild(el);
+    el.init();
+    await el.updateComplete;
+    return { el, handler };
+  }
+
+  it("shows the current zoom on the slider", async () => {
+    const { el, handler } = await mount();
+    const input = el.querySelector("input[type=range]") as HTMLInputElement;
+    expect(Number(input.value)).toBe(scaleToSliderValue(handler.scale));
+    el.remove();
+  });
+
+  it("zooms the map when the slider moves", async () => {
+    const { el, handler } = await mount();
+    const input = el.querySelector("input[type=range]") as HTMLInputElement;
+    input.value = String(SLIDER_STEPS);
+    input.dispatchEvent(new Event("input"));
+    expect(handler.scale).toBeCloseTo(MAX_SCALE, 10);
+    el.remove();
+  });
+
+  it("zooms in and out with the buttons", async () => {
+    const { el, handler } = await mount();
+    const [zoomIn, zoomOut] = Array.from(el.querySelectorAll("button"));
+    const start = handler.scale;
+    zoomIn.click();
+    expect(handler.scale).toBeCloseTo(start * BUTTON_ZOOM_FACTOR, 10);
+    zoomOut.click();
+    expect(handler.scale).toBeCloseTo(start, 10);
+    el.remove();
+  });
+});
