index 0000000..1cd12ec
--- /dev/null
+++ b/cloudflare/scripts/flaky-smoke.ts
@@ -0,0 +1,287 @@
+// Tests that a game start survives a connection that freezes big downloads.
+//
+//   BASE=http://localhost:8787 npm run smoke:flaky
+//
+// Real users on one network (Iran) see about one large file in three freeze near 70 KB, and a
+// game start needs three large files at once, so Solo hung on "Starting...". This puts a small
+// proxy between the browser and the Worker that reproduces it: a large file's first N tries
+// send ~70 KB and then go silent (no data, no reset), exactly the failure seen on the real path.
+// Then it plays the same click in real Chrome with and without the service worker.
+//
+// What counts as "the game started": the three files a Solo start downloads (the simulation
+// worker and the world map's two layers) all finished. Rendering is not checked (a headless
+// browser has no GPU), only that everything needed arrived.
+
+import fs from "node:fs";
+import http from "node:http";
+import path from "node:path";
+import { type Browser, chromium, type Page } from "playwright-core";
+
+const UPSTREAM = new URL(process.env.BASE ?? "http://localhost:8787");
+const PORT = Number(process.env.PROXY_PORT ?? 8788);
+const PROXY = `http://localhost:${PORT}`;
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const FREEZE_AT = 70_000; // bytes sent before the silence
+const BIG = 100_000; // only files at least this large freeze, like on the real path
+const FREEZES_PER_FILE = 2; // the first two tries of each big file freeze, the third works
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail = ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+// --- the freezing proxy
+
+const proxyState = {
+  freeze: false,
+  tries: new Map<string, number>(),
+  frozen: 0,
+  assetHits: 0,
+  hitUrls: [] as string[],
+};
+const open = new Set<http.ServerResponse>();
+
+const server = http.createServer((req, res) => {
+  const url = req.url ?? "/";
+  const isAsset = req.method === "GET" && /^\/(assets|_assets)\//.test(url);
+  if (isAsset && NEEDED.some((re) => re.test(url))) {
+    proxyState.assetHits++;
+    proxyState.hitUrls.push(`${req.headers["sec-fetch-dest"] ?? "?"} ${url} ua=${(req.headers["user-agent"] ?? "").slice(0, 12)}`);
+  }
+  const headers = { ...req.headers, host: UPSTREAM.host };
+  delete headers["accept-encoding"]; // plain bytes, so a size is a size
+  const up = http.request(
+    {
+      host: UPSTREAM.hostname,
+      port: UPSTREAM.port,
+      path: url,
+      method: req.method,
+      headers,
+      agent: false,
+    },
+    (ur) => {
+      if (!isAsset || !proxyState.freeze) {
+        res.writeHead(ur.statusCode ?? 502, ur.headers);
+        ur.pipe(res);
+        return;
+      }
+      const chunks: Buffer[] = [];
+      ur.on("data", (c: Buffer) => chunks.push(c));
+      ur.on("end", () => {
+        const body = Buffer.concat(chunks);
+        const n = (proxyState.tries.get(url) ?? 0) + 1;
+        proxyState.tries.set(url, n);
+        const out = { ...ur.headers, "content-length": String(body.length) };
+        delete out["transfer-encoding"];
+        delete out["content-encoding"];
+        res.writeHead(ur.statusCode ?? 502, out);
+        if (body.length >= BIG && n <= FREEZES_PER_FILE) {
+          proxyState.frozen++;
+          open.add(res);
+          res.on("close", () => open.delete(res));
+          res.write(body.subarray(0, FREEZE_AT)); // ...and never the rest
+          return;
+        }
+        res.end(body);
+      });
+    },
+  );
+  up.on("error", () => res.destroy());
+  req.pipe(up);
+});
+
+// --- the browser side
+
+const NEEDED = [
+  /\/assets\/Worker\.worker-[^/]+\.js$/,
+  /\/_assets\/maps\/world\/map\.[0-9a-f]+\.bin$/,
+  /\/_assets\/maps\/world\/map4x\.[0-9a-f]+\.bin$/,
+];
+
+async function homeReady(page: Page, freezeWhenDefined = false): Promise<void> {
+  await page.goto(PROXY, { waitUntil: "load", timeout: 90_000 });
+  await page.waitForFunction(() => !!customElements.get("play-page"), null, {
+    timeout: 90_000,
+  });
+  // The service worker starts its background fetch 3 s after this point; freezing from here
+  // makes sure that fetch (and the click that follows) really meets the freezes.
+  if (freezeWhenDefined) proxyState.freeze = true;
+  await page.waitForFunction(() => !document.getElementById("cf-loading"), null, {
+    timeout: 90_000,
+  });
+  await sleep(500);
+}
+
+/** True once every path is in the service worker's cache. (Evaluated in Node, one await per poll:
+ *  a predicate handed to waitForFunction that is async would be "truthy" at once.) */
+async function waitCached(page: Page, paths: string[], timeoutMs: number): Promise<boolean> {
+  const end = Date.now() + timeoutMs;
+  while (Date.now() < end) {
+    const all = await page
+      .evaluate(async (list) => {
+        const cache = await caches.open("cf-files-v1");
+        for (const p of list) if (!(await cache.match(p))) return false;
+        return true;
+      }, paths)
+      .catch(() => false);
+    if (all) return true;
+    await sleep(500);
+  }
+  return false;
+}
+
+/** Presses Solo, then Start. Returns which of the needed files finished within `waitMs`. */
+async function soloStart(page: Page, waitMs: number) {
+  const finished = new Set<number>();
+  page.on("requestfinished", (r) => {
+    NEEDED.forEach((re, i) => {
+      if (re.test(r.url())) finished.add(i);
+    });
+  });
+  await page.locator("button:visible", { hasText: /solo/i }).first().click();
+  await page.waitForSelector("single-player-modal", { state: "attached" });
+  await sleep(1200);
+  await page
+    .locator('single-player-modal o-button[translationKey="game_settings.start"]')
+    .last()
+    .click();
+  const t0 = Date.now();
+  while (Date.now() - t0 < waitMs && finished.size < NEEDED.length) await sleep(250);
+  return { finished: [...finished], ms: Date.now() - t0 };
+}
+
+async function newPage(browser: Browser, serviceWorkers: "allow" | "block") {
+  const context = await browser.newContext({
+    viewport: { width: 1280, height: 800 },
+    serviceWorkers,
+  });
+  return { context, page: await context.newPage() };
+}
+
+async function main(): Promise<void> {
+  // The proxy here sits in front of the Worker, so this test is for a page that loads its files
+  // from the Worker. A page built with CDN_BASE loads them from the CDN instead; smoke:cdn
+  // covers the same freezes for that case.
+  const index = path.resolve(import.meta.dirname, "../../static/index.html");
+  if (fs.existsSync(index) && /\bcdnBase"?:\s*"http/.test(fs.readFileSync(index, "utf8"))) {
+    console.log("the page is built with CDN_BASE: this same-origin test does not apply (run smoke:cdn)");
+    return;
+  }
+  await new Promise<void>((resolve) => server.listen(PORT, resolve));
+  console.log(`flaky-connection test: ${PROXY} -> ${UPSTREAM.origin}`);
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  try {
+    // 1. The problem, reproduced: no service worker, big files freeze, Solo never gets its files.
+    {
+      proxyState.freeze = false;
+      const { context, page } = await newPage(browser, "block");
+      await homeReady(page);
+      proxyState.freeze = true;
+      proxyState.tries.clear();
+      const r = await soloStart(page, 30_000);
+      check(
+        r.finished.length < NEEDED.length,
+        "without the service worker a frozen download leaves the game start stuck (the bug)",
+        r,
+      );
+      await context.close();
+      for (const res of open) res.destroy();
+      open.clear();
+    }
+
+    // 2. The fix: same click, same freezes, service worker on. Downloads are retried.
+    {
+      proxyState.freeze = false;
+      proxyState.tries.clear();
+      proxyState.frozen = 0;
+      const { context, page } = await newPage(browser, "allow");
+      await homeReady(page, true);
+      const controlled = await page
+        .waitForFunction(() => !!navigator.serviceWorker.controller, null, {
+          timeout: 20_000,
+        })
+        .then(() => true)
+        .catch(() => false);
+      check(controlled, "the service worker is registered and controls the page");
+      const r = await soloStart(page, 90_000);
+      check(
+        r.finished.length === NEEDED.length,
+        "with the service worker the game start gets all its files despite the freezes",
+        r,
+      );
+      check(proxyState.frozen > 0, "...and the freezes really happened", proxyState.frozen);
+      await context.close();
+      for (const res of open) res.destroy();
+      open.clear();
+    }
+
+    // 3. Fetched ahead of time: once the home page has been up a while the files are already
+    //    in the cache, so Solo needs nothing from the network at all.
+    {
+      proxyState.freeze = false;
+      proxyState.tries.clear();
+      const { context, page } = await newPage(browser, "allow");
+      await homeReady(page);
+      const swText = await (await fetch(`${PROXY}/sw.js`)).text();
+      const listText = /var WARM = (\[.*\]);/.exec(swText)?.[1] ?? "[]";
+      const warmList = JSON.parse(listText) as string[];
+      const warmCount = warmList.length;
+      // Every listed file present (not just "enough entries": the page caches its own images too).
+      const cached = await waitCached(page, warmList, 120_000);
+      check(cached, `the background fetch cached all ${warmCount} listed files`);
+      proxyState.freeze = true;
+      proxyState.tries.clear();
+      proxyState.assetHits = 0;
+      proxyState.hitUrls.length = 0;
+      const r = await soloStart(page, 30_000);
+      check(
+        r.finished.length === NEEDED.length && r.ms < 5000,
+        "a game start after that finishes at once, from the cache",
+        r,
+      );
+      check(
+        proxyState.assetHits === 0,
+        "...without a single request to the server for the files it needs",
+        proxyState.hitUrls,
+      );
+      await context.close();
+    }
+
+    // 4. The off switch: ?nosw removes the worker and its cache.
+    {
+      proxyState.freeze = false;
+      const { context, page } = await newPage(browser, "allow");
+      await homeReady(page);
+      await page.goto(`${PROXY}/?nosw`, { waitUntil: "load" });
+      await sleep(2500);
+      const left = await page.evaluate(async () => ({
+        workers: (await navigator.serviceWorker.getRegistrations()).length,
+        caches: (await caches.keys()).length,
+      }));
+      check(left.workers === 0 && left.caches === 0, "?nosw removes the worker and its cache", left);
+      await context.close();
+    }
+  } finally {
+    await browser.close();
+    for (const res of open) res.destroy();
+    server.close();
+  }
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nFLAKY TEST FAILED" : "\nFLAKY TEST PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nFLAKY TEST ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
