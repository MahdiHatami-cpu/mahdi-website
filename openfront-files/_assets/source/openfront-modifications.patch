+/**
+ * This deployment keeps one leaderboard table: the players with the most wins in public games,
+ * served by the site's own Worker as the "ffa" ladder (cloudflare/src/leaderboard.ts). The ranked
+ * ladders, clans and tribes need the closed-source API, so there is nothing to show for them.
+ *
+ * The page announces the one-table layout with `window.leaderboardWinsOnly = true` (written at
+ * build time, see cloudflare/scripts/branding.ts). Without it the leaderboard screen is exactly the
+ * original: five tabs, ranked by ELO.
+ */
+export const winsOnlyLeaderboard = (): boolean =>
+  (window as { leaderboardWinsOnly?: unknown }).leaderboardWinsOnly === true;
