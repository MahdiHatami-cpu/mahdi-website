@@ -0,0 +1,296 @@
+// Drives the real web client in a real browser against the running Worker, to see
+// what the scripted smoke tests cannot: that the page boots, the bundle runs, and
+// the browser's own lobby socket and join flow work against the Durable Object.
+//
+//   BASE=http://localhost:8787 npm run smoke:browser
+//
+// Uses the machine's installed Google Chrome (no browser download). Screenshots go to
+// .shots/ (git-ignored).
+
+import fs from "node:fs";
+import path from "node:path";
+import { chromium, type Page } from "playwright-core";
+import { standInIfBuiltForIt } from "./cdn-standin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const SHOTS =
+  process.env.SHOTS ?? path.resolve(import.meta.dirname, "../.shots");
+fs.mkdirSync(SHOTS, { recursive: true });
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail =
+    ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+// How long to wait for a public lobby's countdown to end and the game to start.
+// Locally the countdown is PUBLIC_LOBBY_SECONDS (8 s with .dev.vars); deployed it is 60.
+const LOBBY_WAIT_MS = Number(process.env.LOBBY_WAIT_MS ?? "45000");
+
+/** Polls until fn returns something other than undefined, or the time is up. */
+async function until<T>(
+  fn: () => T | undefined | Promise<T | undefined>,
+  timeoutMs: number,
+): Promise<T | undefined> {
+  const deadline = Date.now() + timeoutMs;
+  for (;;) {
+    const v = await fn();
+    if (v !== undefined) return v;
+    if (Date.now() > deadline) return undefined;
+    await sleep(250);
+  }
+}
+
+interface SocketLog {
+  url: string;
+  frames: number;
+  closed: boolean;
+}
+
+function watch(page: Page) {
+  const pageErrors: string[] = [];
+  const badResponses: string[] = [];
+  const sockets: SocketLog[] = [];
+  page.on("pageerror", (e) => {
+    const stack = (e.stack ?? e.message).split("\n").slice(0, 4).join(" | ");
+    // Known, not ours: this Chrome exposes navigator.keyboard without
+    // addEventListener, and KeyboardLayoutController.hostConnected calls it. The
+    // original Node dev server throws the same error in the same browser.
+    if (/KeyboardLayout|keyboard\.addEventListener/.test(stack)) return;
+    pageErrors.push(stack);
+  });
+  page.on("response", (r) => {
+    // The client also calls an account API that does not exist here (/auth/*,
+    // /users/*, ...); those failing is expected. What must never fail is what this
+    // deployment serves: the client's files and the game API.
+    const u = new URL(r.url());
+    const ours =
+      u.origin === new URL(BASE).origin &&
+      /^\/(assets|_assets|api|w\d+)\//.test(u.pathname);
+    if (r.status() >= 400 && ours) {
+      badResponses.push(`${r.status()} ${u.pathname}`);
+    }
+  });
+  page.on("websocket", (ws) => {
+    const log: SocketLog = { url: ws.url(), frames: 0, closed: false };
+    sockets.push(log);
+    ws.on("framereceived", () => log.frames++);
+    ws.on("close", () => (log.closed = true));
+  });
+  return { pageErrors, badResponses, sockets };
+}
+
+async function main(): Promise<void> {
+  console.log(`browser test against ${BASE}`);
+  // A page built with a localhost CDN_BASE needs its files served from there.
+  const cdn = await standInIfBuiltForIt();
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: [
+      // RESOLVE_IP=<ip> sends this hostname to a chosen address (same name, same TLS
+      // SNI), to test a deployment around a network path that misbehaves.
+      ...(process.env.RESOLVE_IP
+        ? [
+            `--host-resolver-rules=MAP ${new URL(BASE).hostname} ${process.env.RESOLVE_IP}`,
+          ]
+        : []),
+      "--no-sandbox",
+      "--enable-unsafe-swiftshader",
+      "--use-angle=swiftshader",
+      "--ignore-gpu-blocklist",
+    ],
+  });
+  try {
+    const context = await browser.newContext({
+      viewport: { width: 1400, height: 1000 },
+    });
+    // The client refuses software WebGL; a headless browser has nothing else.
+    await context.addInitScript(() => {
+      const getContext = HTMLCanvasElement.prototype.getContext;
+      HTMLCanvasElement.prototype.getContext = function (
+        this: HTMLCanvasElement,
+        type: string,
+        attrs?: unknown,
+      ) {
+        const a = attrs as
+          | { failIfMajorPerformanceCaveat?: boolean }
+          | undefined;
+        if (a?.failIfMajorPerformanceCaveat) {
+          attrs = { ...a, failIfMajorPerformanceCaveat: false };
+        }
+        // eslint-disable-next-line @typescript-eslint/no-explicit-any
+        return (getContext as any).call(this, type, attrs);
+      } as typeof getContext;
+      const getParameter = WebGL2RenderingContext.prototype.getParameter;
+      WebGL2RenderingContext.prototype.getParameter = function (
+        this: WebGL2RenderingContext,
+        p: number,
+      ) {
+        const v = getParameter.call(this, p);
+        return typeof v === "string"
+          ? v.replace(/swiftshader|llvmpipe|software/gi, "headless")
+          : v;
+      };
+    });
+    // Software WebGL needs seconds per frame; left unthrottled, the render loop
+    // starves the main thread and the game's turn loop crawls. One frame per
+    // 1.5 s keeps the simulation near full speed (the repo's driver does the same).
+    await context.addInitScript((interval: number) => {
+      let last = 0;
+      window.requestAnimationFrame = (cb: FrameRequestCallback) => {
+        const wait = Math.max(0, interval - (performance.now() - last));
+        return setTimeout(() => {
+          last = performance.now();
+          cb(last);
+        }, wait) as unknown as number;
+      };
+      window.cancelAnimationFrame = (id: number) => clearTimeout(id);
+    }, 1500);
+    const page = await context.newPage();
+    const seen = watch(page);
+
+    // --- the home page boots
+    // "domcontentloaded", not "load": the page also pulls third-party ad and analytics
+    // scripts (doubleclick, html-load.cc, ...) and `load` waits for every one of them,
+    // including ones that time out on a restricted network. They are not what is under
+    // test; the client's own files and sockets are.
+    await page.goto(BASE, { waitUntil: "domcontentloaded", timeout: 90_000 });
+    await sleep(8_000);
+    await page.screenshot({ path: path.join(SHOTS, "home.png") });
+
+    const boot = await page.evaluate(() => {
+      const bc = (
+        window as unknown as { BOOTSTRAP_CONFIG?: Record<string, unknown> }
+      ).BOOTSTRAP_CONFIG;
+      return {
+        title: document.title,
+        gameEnv: bc?.gameEnv,
+        commit: bc?.gitCommit,
+        customElements: [...document.querySelectorAll("*")].filter((e) =>
+          e.tagName.includes("-"),
+        ).length,
+      };
+    });
+    check(boot.gameEnv === "dev", "page carries BOOTSTRAP_CONFIG (dev)", boot);
+    check(
+      boot.customElements > 10,
+      "the client's components rendered",
+      boot.customElements,
+    );
+    check(
+      seen.pageErrors.length === 0,
+      "no uncaught page errors",
+      seen.pageErrors.slice(0, 3),
+    );
+    check(
+      seen.badResponses.length === 0,
+      "every asset and API call on our origin succeeded",
+      seen.badResponses.slice(0, 5),
+    );
+
+    // --- the browser's own lobby socket works against the Durable Object
+    const lobbySocket = seen.sockets.find((s) => s.url.includes("/lobbies"));
+    check(
+      lobbySocket !== undefined,
+      "the page opened the lobby-list socket",
+      seen.sockets.map((s) => s.url),
+    );
+    check(
+      (lobbySocket?.frames ?? 0) >= 1,
+      "the lobby list delivered frames to the browser",
+      lobbySocket?.frames,
+    );
+
+    // --- the lobbies are visible on the page
+    const text = await page.evaluate(() => document.body.innerText);
+    check(
+      /free for all|ffa/i.test(text) || /team/i.test(text),
+      "public lobbies are shown on the home page",
+    );
+
+    // --- play: click the free-for-all lobby, as a player would
+    await page
+      .locator("game-mode-selector")
+      .getByText(/free for all/i)
+      .first()
+      .click();
+    const isGameSocket = (s: SocketLog) =>
+      /^\/w\d+$/.test(new URL(s.url).pathname);
+    const gameSocket = await until(
+      () => seen.sockets.find(isGameSocket),
+      20_000,
+    );
+    check(
+      gameSocket !== undefined,
+      "clicking the lobby opens the game socket",
+      seen.sockets.map((s) => s.url),
+    );
+    if (gameSocket === undefined) return;
+
+    // lobby_info arrives once a second while the countdown runs.
+    await sleep(3_000);
+    check(
+      gameSocket.frames >= 2,
+      "lobby_info frames reach the browser",
+      gameSocket.frames,
+    );
+    await page.screenshot({ path: path.join(SHOTS, "lobby.png") });
+
+    // The countdown ends, prestart and start follow, and the browser's own
+    // simulation starts consuming the Worker's turns.
+    const ticks = await until(async () => {
+      const t = await page.evaluate(() => {
+        const g = (
+          document.querySelector("build-menu") as unknown as {
+            game?: { ticks(): number };
+          } | null
+        )?.game;
+        return g?.ticks();
+      });
+      return typeof t === "number" && t > 20 ? t : undefined;
+    }, LOBBY_WAIT_MS);
+    check(
+      ticks !== undefined,
+      "the simulation runs from the Worker's turns",
+      ticks,
+    );
+    check(
+      gameSocket.frames > 20,
+      "the browser received turn frames",
+      gameSocket.frames,
+    );
+    await sleep(2_000);
+    await page.screenshot({ path: path.join(SHOTS, "in-game.png") });
+    check(!gameSocket.closed, "the game socket stays open during play");
+    check(
+      seen.pageErrors.length === 0,
+      "no uncaught page errors while playing",
+      seen.pageErrors.slice(0, 3),
+    );
+    check(
+      seen.badResponses.length === 0,
+      "no asset, map or API request failed while playing",
+      seen.badResponses.slice(0, 5),
+    );
+
+    console.log(`\nscreenshots: ${SHOTS}`);
+  } finally {
+    await browser.close();
+    await cdn?.close();
+  }
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nBROWSER SMOKE FAILED" : "\nBROWSER SMOKE PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nBROWSER SMOKE ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
diff --git a/cloudflare/scripts/build-site.ts b/cloudflare/scripts/build-site.ts
new file mode 100644
index 0000000..3b78c94
--- /dev/null
+++ b/cloudflare/scripts/build-site.ts
@@ -0,0 +1,266 @@
+// Builds the web client for the Worker's static-assets binding.
+//
+//   npm run build:site                       # page for http://localhost:8787
+//   SITE_HOST=game.example.com npm run build:site
+//
+// The Node server renders index.html (an EJS template) per request, filling in the
+// deployment's identity. A Worker has neither `fs` nor ejs at runtime, so this does
+// it once, here, with the same values RenderHtml.ts / vite.config.ts inject, and
+// writes the result over static/index.html. wrangler serves static/ as-is.
+//
+// Also writes static/commit.txt: the build id the page carries. The Worker reads it
+// and refuses joins from any other build (mixed builds desync the simulation).
+
+import { listedMaps } from "@openfront/engine-api/game/GameTypes";
+import {
+  buildAssetUrl,
+  type AssetManifest,
+} from "@openfront/shared/AssetPaths";
+import ejs from "ejs";
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { injectAccountUi } from "./accounts-ui";
+import { copyArt, injectHomeArt } from "./art";
+import { assertNoCompanyLinks, brandPage } from "./branding";
+import { injectLoadingScreen } from "./loading-screen";
+import { writeSourcePage } from "./source-page";
+import { buildServiceWorker, injectServiceWorker } from "./resilient-assets";
+import { assertNoThirdParty, stripThirdParty } from "./third-party";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const repoRoot = path.resolve(here, "../..");
+const staticDir = path.join(repoRoot, "static");
+// A copy of the unrendered page (the EJS template Vite emits), so a later run with --skip-vite
+// can render it again, e.g. with a new CDN_BASE, without the 5-minute Vite build.
+const templateCopy = path.resolve(here, "../.build/index.template.html");
+
+// Where the site's files (/assets, /_assets) are loaded from. Empty: this origin, the Worker's
+// own static assets. Set: an origin plus optional path prefix, e.g. a jsDelivr GitHub URL
+// `https://cdn.jsdelivr.net/gh/<user>/<repo>@<commit>`, with the same files published there
+// (scripts/cdn-repo.ts). The page, the game API and the WebSocket stay on this origin.
+const cdnBase = (process.env.CDN_BASE ?? "").replace(/\/+$/, "");
+if (cdnBase && !/^https?:\/\/[^/]+(\/[^?#]*)?$/.test(cdnBase)) {
+  throw new Error(`CDN_BASE must be an origin plus an optional path, got ${cdnBase}`);
+}
+const cdnHost = cdnBase ? new URL(cdnBase).host : undefined;
+
+// The host the page is served from. It is baked into the page (the API the client
+// calls and the one-server map it uses), so a build is per-host.
+const siteHost = process.env.SITE_HOST ?? "localhost";
+const instanceLetter = process.env.INSTANCE_LETTER ?? "a";
+const numWorkers = Number(process.env.NUM_WORKERS ?? "1");
+if (!/^[a-z]$/.test(instanceLetter)) {
+  throw new Error(
+    `INSTANCE_LETTER must be one lowercase letter, got ${instanceLetter}`,
+  );
+}
+if (!Number.isInteger(numWorkers) || numWorkers < 1) {
+  throw new Error(
+    `NUM_WORKERS must be a positive integer, got ${process.env.NUM_WORKERS}`,
+  );
+}
+
+function gitShortHash(): string {
+  try {
+    return execFileSync("git", ["rev-parse", "--short", "HEAD"], {
+      cwd: repoRoot,
+      encoding: "utf8",
+    }).trim();
+  } catch {
+    return "nogit";
+  }
+}
+// Unique per build, so two builds of one commit never mix; <= 64 chars (wire limit).
+const commit =
+  process.env.BUILD_ID ?? `cf-${gitShortHash()}-${Date.now().toString(36)}`;
+
+let template: string;
+if (process.argv.includes("--skip-vite")) {
+  console.log("skipping vite build (--skip-vite)");
+  const current = fs.readFileSync(path.join(staticDir, "index.html"), "utf8");
+  if (current.includes("<%")) {
+    template = current;
+  } else if (fs.existsSync(templateCopy)) {
+    template = fs.readFileSync(templateCopy, "utf8");
+    console.log(`rendering again from ${path.relative(here, templateCopy)}`);
+  } else {
+    throw new Error(
+      "static/index.html is already rendered and no template copy exists. Run without --skip-vite.",
+    );
+  }
+} else {
+  console.log("building the client (vite build) ...");
+  // Vite is run through node directly: no shell, and no npx.cmd quirks on Windows. The bundle
+  // does not bake CDN_BASE in (chunk references are relative, see vite.config.ts); the HTML
+  // gets an EJS placeholder that is filled below.
+  const viteBin = path.join(repoRoot, "node_modules", "vite", "bin", "vite.js");
+  execFileSync(process.execPath, [viteBin, "build"], {
+    cwd: repoRoot,
+    stdio: "inherit",
+    env: { ...process.env, CDN_BASE: cdnBase },
+  });
+  template = fs.readFileSync(path.join(staticDir, "index.html"), "utf8");
+  fs.mkdirSync(path.dirname(templateCopy), { recursive: true });
+  fs.writeFileSync(templateCopy, template);
+}
+if (!template.includes("<%")) {
+  throw new Error("the page template has no EJS left in it; the Vite output changed shape");
+}
+const manifest = JSON.parse(
+  fs.readFileSync(path.join(staticDir, "asset-manifest.json"), "utf8"),
+) as AssetManifest;
+const url = (p: string) => buildAssetUrl(p, manifest, cdnBase);
+
+const html = ejs.render(template, {
+  gitCommit: JSON.stringify(commit),
+  assetManifest: JSON.stringify(manifest),
+  cdnBase: JSON.stringify(cdnBase),
+  cdnBaseRaw: cdnBase,
+  // "dev": no closed-source account API to mint JWTs, so the client plays with its
+  // anonymous persistent id, which is what the Worker accepts.
+  gameEnv: JSON.stringify("dev"),
+  // One server, this deployment: the client derives /w<n> from this map.
+  cluster: JSON.stringify({ [instanceLetter]: { host: siteHost, numWorkers } }),
+  instanceLetter: JSON.stringify(instanceLetter),
+  instanceId: JSON.stringify("CF"),
+  // Cloudflare's published always-pass test key; nothing verifies it here.
+  turnstileSiteKey: JSON.stringify("1x00000000000000000000AA"),
+  jwtAudience: JSON.stringify(siteHost),
+  manifestHref: url("manifest.json"),
+  faviconHref: url("images/Favicon.svg"),
+  gameplayScreenshotUrl: url("images/GameplayScreenshot.png"),
+  backgroundImageUrl: url("images/background.webp"),
+  desktopLogoImageUrl: url("images/OpenFront.png"),
+  mobileLogoImageUrl: url("images/OF.png"),
+});
+
+// No ads, analytics or anti-adblock on this deployment (scripts/third-party.ts), then the
+// loading screen: inline, at the very start of <head>, so it paints from the first bytes
+// of the page and does not wait for the stylesheet.
+const accountApiOrigin =
+  siteHost === "localhost" ? undefined : `https://api.${siteHost}`;
+// Sign-in with Google or an emailed link (src/accounts/). ACCOUNTS=0 builds a guest-only page.
+const accounts = process.env.ACCOUNTS !== "0";
+// The pictures behind the loading screen and the home page (cloudflare/art -> static/art).
+const art = copyArt(path.resolve(import.meta.dirname, "../art"), staticDir, cdnBase);
+const stripped = brandPage(stripThirdParty(html, { accountApiOrigin, accounts }), siteHost);
+const page = injectServiceWorker(
+  injectLoadingScreen(
+    injectHomeArt(accounts ? injectAccountUi(stripped) : stripped, art),
+    art,
+  ),
+);
+assertNoThirdParty(page, { accountApiOrigin, cdnHost });
+if (siteHost !== "localhost") assertNoCompanyLinks(page);
+fs.writeFileSync(path.join(staticDir, "index.html"), page);
+fs.writeFileSync(path.join(staticDir, "commit.txt"), `${commit}\n`);
+// Not needed to play, and 12 MB of the upload.
+fs.writeFileSync(path.join(staticDir, ".assetsignore"), "press/\n");
+// Files whose names carry a content hash (assets/*.js, assets/*.css, _assets/*) never change
+// under the same name, so the browser may keep them for good. Without this Cloudflare sends
+// "max-age=0, must-revalidate" and every visit re-checks every file. It also matters on a bad
+// connection: each file that finishes downloading then stays, so the loading screen's
+// automatic retries only have to fetch what is still missing. index.html is left alone: it
+// is what points at the current names.
+fs.writeFileSync(
+  path.join(staticDir, "_headers"),
+  [
+    "/assets/*",
+    "  Cache-Control: public, max-age=31536000, immutable",
+    "/_assets/*",
+    "  Cache-Control: public, max-age=31536000, immutable",
+    "/art/*",
+    "  Cache-Control: public, max-age=31536000, immutable",
+    "",
+  ].join("\n"),
+);
+
+// --- which maps ship
+//
+// The maps are 614 MB of the 680 MB site, and an upload is only as fast as the
+// uplink (about 110 KB/s on the machine this was built on: ~1.7 h for everything,
+// and wrangler's large parallel batches take 20+ minutes each to answer). MAP_BUDGET_MB
+// keeps the first deploy small; raise it later and wrangler uploads only what is new.
+//
+// Maps are taken in a fixed order (the featured maps by rank, then smallest first)
+// and the budget cuts a PREFIX of it, so a bigger budget is always a superset and a
+// redeploy never drops a map. The Worker's playlist offers only these maps; any other
+// map still appears in the client's own picker (Solo, private lobbies) but fails to load.
+const budgetMb = process.env.MAP_BUDGET_MB
+  ? Number(process.env.MAP_BUDGET_MB)
+  : Infinity;
+if (Number.isNaN(budgetMb) || budgetMb < 0) {
+  throw new Error(
+    `MAP_BUDGET_MB must be a number, got ${process.env.MAP_BUDGET_MB}`,
+  );
+}
+
+function dirSize(dir: string): number {
+  return fs
+    .readdirSync(dir, { withFileTypes: true })
+    .reduce(
+      (n, e) =>
+        n +
+        (e.isDirectory()
+          ? dirSize(path.join(dir, e.name))
+          : fs.statSync(path.join(dir, e.name)).size),
+      0,
+    );
+}
+
+const mapsDir = path.join(staticDir, "_assets", "maps");
+const ordered = listedMaps
+  .map((m) => {
+    const folder = path.join(mapsDir, m.id.toLowerCase());
+    return {
+      id: m.id,
+      folder,
+      mb: fs.existsSync(folder) ? dirSize(folder) / 1048576 : 0,
+      rank: m.featuredRank ?? Number.POSITIVE_INFINITY,
+    };
+  })
+  .filter((m) => fs.existsSync(m.folder))
+  .sort((a, b) => a.rank - b.rank || a.mb - b.mb || a.id.localeCompare(b.id));
+
+const shipped: string[] = [];
+let usedMb = 0;
+for (const m of ordered) {
+  if (usedMb + m.mb > budgetMb) break;
+  usedMb += m.mb;
+  shipped.push(m.id);
+}
+const keep = new Set(shipped);
+for (const m of ordered) {
+  if (!keep.has(m.id)) fs.rmSync(m.folder, { recursive: true, force: true });
+}
+// The Worker reads this so the playlist never deals a map that was not deployed.
+fs.writeFileSync(
+  path.join(staticDir, "maps.json"),
+  `${JSON.stringify({ maps: shipped })}\n`,
+);
+
+// The page that says where to get this version's source code (the footer links to /source).
+writeSourcePage({ repoRoot, staticDir, cdnBase, buildId: commit });
+
+// The service worker that retries frozen downloads (sw/sw.js). Written last: the list of files
+// it fetches ahead of time depends on which maps survived the budget above.
+fs.writeFileSync(
+  path.join(staticDir, "sw.js"),
+  buildServiceWorker(staticDir, commit, cdnBase),
+);
+
+const files = fs
+  .readdirSync(staticDir, { recursive: true, withFileTypes: true })
+  .filter((e) => e.isFile());
+console.log(`\nsite ready in static/ (${files.length} files)`);
+console.log(`  build id : ${commit}`);
+console.log(
+  `  maps     : ${shipped.length} of ${ordered.length} shipped (${usedMb.toFixed(0)} MB)` +
+    (Number.isFinite(budgetMb) ? ` under MAP_BUDGET_MB=${budgetMb}` : ""),
+);
+console.log(
+  `  site host: ${siteHost}  (instance ${instanceLetter}, ${numWorkers} worker(s))`,
+);
+console.log(`  files    : ${cdnBase ? `from ${cdnBase}` : "this origin"}`);
diff --git a/cloudflare/scripts/cdn-repo.ts b/cloudflare/scripts/cdn-repo.ts
new file mode 100644
index 0000000..b64a394
--- /dev/null
+++ b/cloudflare/scripts/cdn-repo.ts
@@ -0,0 +1,133 @@
+// Stages the site's files for a GitHub repository that jsDelivr serves.
+//
+//   npm run build:site                       # first: the files to publish
+//   ASSET_REPO_DIR=../../openfront-assets ASSET_REPO_SLUG=<user>/<repo> npm run cdn:repo
+//
+// Copies static/assets and static/_assets into ASSET_REPO_DIR (a git working copy; created
+// and `git init`ed if missing), removes files there that no longer exist in static/, checks
+// jsDelivr's limits, commits, and prints the CDN_BASE to build the site with:
+// https://cdn.jsdelivr.net/gh/<user>/<repo>@<commit>. A commit URL is cached by jsDelivr for
+// good, so each publish is a new commit and the site is re-rendered against it:
+//
+//   CDN_BASE=https://cdn.jsdelivr.net/gh/<user>/<repo>@<commit> npm run build:site -- --skip-vite
+//
+// Pushing is left to the caller (`git push` from the repo dir): it needs the owner's GitHub
+// credentials. jsDelivr limits (from its README): 20 MB per file, 150 MB per package.
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const staticDir = path.resolve(here, "../../static");
+const repoDir = path.resolve(here, "..", process.env.ASSET_REPO_DIR ?? "../../openfront-assets");
+const slug = process.env.ASSET_REPO_SLUG; // "<user>/<repo>", optional until the repo exists
+const FILE_LIMIT = 20 * 1024 * 1024;
+const PACKAGE_LIMIT = 150 * 1024 * 1024;
+const PUBLISHED = ["assets", "_assets"];
+
+function git(args: string[], cwd = repoDir): string {
+  return execFileSync("git", args, { cwd, encoding: "utf8" }).trim();
+}
+
+function walk(dir: string, base = dir): string[] {
+  if (!fs.existsSync(dir)) return [];
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name);
+    return e.isDirectory() ? walk(full, base) : [path.relative(base, full).split(path.sep).join("/")];
+  });
+}
+
+const buildId = fs.readFileSync(path.join(staticDir, "commit.txt"), "utf8").trim();
+if (!buildId) throw new Error("static/commit.txt is empty; run build:site first");
+
+fs.mkdirSync(repoDir, { recursive: true });
+if (!fs.existsSync(path.join(repoDir, ".git"))) {
+  git(["init", "-q", "-b", "main"]);
+  console.log(`created a git repository in ${repoDir}`);
+}
+
+// Mirror: copy what exists, delete what does not.
+let copied = 0;
+let removed = 0;
+let total = 0;
+const tooBig: string[] = [];
+for (const top of PUBLISHED) {
+  const src = path.join(staticDir, top);
+  const dst = path.join(repoDir, top);
+  const want = new Set(walk(src));
+  for (const rel of walk(dst)) {
+    if (!want.has(rel)) {
+      fs.rmSync(path.join(dst, rel));
+      removed++;
+    }
+  }
+  for (const rel of want) {
+    const from = path.join(src, rel);
+    const to = path.join(dst, rel);
+    const size = fs.statSync(from).size;
+    total += size;
+    if (size > FILE_LIMIT) tooBig.push(`${top}/${rel} (${(size / 1048576).toFixed(1)} MB)`);
+    const same = fs.existsSync(to) && fs.statSync(to).size === size; // names carry content hashes
+    if (!same) {
+      fs.mkdirSync(path.dirname(to), { recursive: true });
+      fs.copyFileSync(from, to);
+      copied++;
+    }
+  }
+}
+// Empty directories left behind by removals.
+for (const top of PUBLISHED) {
+  const prune = (dir: string): void => {
+    if (!fs.existsSync(dir)) return;
+    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+      if (e.isDirectory()) prune(path.join(dir, e.name));
+    }
+    if (fs.readdirSync(dir).length === 0) fs.rmdirSync(dir);
+  };
+  prune(path.join(repoDir, top));
+}
+
+if (tooBig.length) {
+  throw new Error(`jsDelivr serves files up to 20 MB; too big:\n  ${tooBig.join("\n  ")}`);
+}
+if (total > PACKAGE_LIMIT) {
+  throw new Error(
+    `jsDelivr serves packages up to 150 MB; this one is ${(total / 1048576).toFixed(0)} MB. Lower MAP_BUDGET_MB.`,
+  );
+}
+
+fs.writeFileSync(
+  path.join(repoDir, "README.md"),
+  [
+    "# OpenFront site files",
+    "",
+    "The static files (`assets/`, `_assets/`) of an OpenFront deployment, published here so that",
+    "jsDelivr can serve them: `https://cdn.jsdelivr.net/gh/<user>/<repo>@<commit>/assets/...`.",
+    "Every file name carries a content hash; nothing here is edited by hand. Generated by",
+    "`cloudflare/scripts/cdn-repo.ts` in the game's repository.",
+    "",
+    `Last build: \`${buildId}\``,
+    "",
+  ].join("\n"),
+);
+fs.writeFileSync(path.join(repoDir, ".gitattributes"), "* -text\n"); // bytes as they are
+
+git(["add", "-A"]);
+const dirty = git(["status", "--porcelain"]).length > 0;
+if (dirty) {
+  git(["-c", "user.name=openfront-build", "-c", "user.email=build@localhost", "commit", "-q", "-m", `Site files for build ${buildId}`]);
+}
+const sha = git(["rev-parse", "HEAD"]);
+
+console.log(`\nasset repository: ${repoDir}`);
+console.log(`  files    : ${walk(path.join(repoDir, "assets")).length + walk(path.join(repoDir, "_assets")).length} (${(total / 1048576).toFixed(0)} MB); copied ${copied}, removed ${removed}`);
+console.log(`  commit   : ${sha}${dirty ? "" : " (nothing new)"}`);
+if (slug) {
+  const cdnBase = `https://cdn.jsdelivr.net/gh/${slug}@${sha}`;
+  console.log(`  CDN_BASE : ${cdnBase}`);
+  console.log(`\nnext:\n  cd ${repoDir}\n  git remote add origin https://github.com/${slug}.git   # once\n  git push -u origin main\n  then in cloudflare/:\n  CDN_BASE=${cdnBase} SITE_HOST=<host> npm run build:site -- --skip-vite\n  npx wrangler deploy`);
+} else {
+  console.log("  set ASSET_REPO_SLUG=<user>/<repo> to get the CDN_BASE and push commands");
+}
diff --git a/cloudflare/scripts/cdn-smoke.ts b/cloudflare/scripts/cdn-smoke.ts
new file mode 100644
index 0000000..fd4dfdd
--- /dev/null
+++ b/cloudflare/scripts/cdn-smoke.ts
@@ -0,0 +1,175 @@
+// Tests a site built with CDN_BASE against a stand-in for the CDN (scripts/cdn-standin.ts).
+//
+//   CDN_BASE=http://localhost:8790/gh/test/assets@local SITE_HOST=localhost npm run build:site
+//   npm run dev                                   # the Worker on :8787
+//   BASE=http://localhost:8787 npm run smoke:cdn
+//
+// It checks that the page loads all its files from the CDN origin and none from the site, that
+// a Solo start gets its files from there, and that the service worker still rescues a game
+// start when the CDN freezes large files (the first tries send ~70 KB and go silent).
+
+import path from "node:path";
+import { type Browser, chromium, type Page } from "playwright-core";
+import { startCdnStandIn } from "./cdn-standin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const CDN_PORT = Number(process.env.CDN_PORT ?? 8790);
+const CDN_PREFIX = "/gh/test/assets@local";
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail = ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+const NEEDED = [
+  /\/assets\/Worker\.worker-[^/]+\.js$/,
+  /\/_assets\/maps\/world\/map\.[0-9a-f]+\.bin$/,
+  /\/_assets\/maps\/world\/map4x\.[0-9a-f]+\.bin$/,
+];
+
+async function homeReady(page: Page): Promise<void> {
+  await page.goto(BASE, { waitUntil: "load", timeout: 90_000 });
+  await page.waitForFunction(
+    () => !!customElements.get("play-page") && !document.getElementById("cf-loading"),
+    null,
+    { timeout: 90_000 },
+  );
+  await sleep(1500);
+}
+
+/** Presses Solo, then Start. Returns the origin each needed file finished from. */
+async function soloStart(page: Page, waitMs: number) {
+  const finished = new Map<number, string>();
+  page.on("requestfinished", (r) => {
+    NEEDED.forEach((re, i) => {
+      if (re.test(r.url())) finished.set(i, new URL(r.url()).origin);
+    });
+  });
+  await page.locator("button:visible", { hasText: /solo/i }).first().click();
+  await page.waitForSelector("single-player-modal", { state: "attached" });
+  await sleep(1200);
+  await page
+    .locator('single-player-modal o-button[translationKey="game_settings.start"]')
+    .last()
+    .click();
+  const t0 = Date.now();
+  while (Date.now() - t0 < waitMs && finished.size < NEEDED.length) await sleep(250);
+  return { finished: [...finished.values()], ms: Date.now() - t0 };
+}
+
+async function newPage(browser: Browser, serviceWorkers: "allow" | "block") {
+  const context = await browser.newContext({
+    viewport: { width: 1280, height: 800 },
+    serviceWorkers,
+  });
+  const page = await context.newPage();
+  const requests: string[] = [];
+  page.on("request", (r) => requests.push(r.url()));
+  return { context, page, requests };
+}
+
+async function main(): Promise<void> {
+  const cdn = await startCdnStandIn({ port: CDN_PORT, prefix: CDN_PREFIX });
+  console.log(`cdn test: site ${BASE}, files expected from ${cdn.base}`);
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  const siteOrigin = new URL(BASE).origin;
+  const cdnOrigin = `http://localhost:${CDN_PORT}`;
+  try {
+    // 1. The page is wired to the CDN: every file comes from there, none from the site.
+    {
+      const { context, page, requests } = await newPage(browser, "block");
+      await homeReady(page);
+      const configured = await page.evaluate(
+        () =>
+          (window as unknown as { BOOTSTRAP_CONFIG?: { cdnBase?: string } })
+            .BOOTSTRAP_CONFIG?.cdnBase,
+      );
+      check(configured === cdn.base, "the page carries the CDN base for the client", configured);
+      const fromSite = requests.filter(
+        (u) => u.startsWith(siteOrigin) && /\/(assets|_assets)\//.test(new URL(u).pathname),
+      );
+      const fromCdn = requests.filter((u) => u.startsWith(cdn.base + "/"));
+      check(
+        fromSite.length === 0,
+        "no file under /assets or /_assets is requested from the site itself",
+        fromSite.slice(0, 5),
+      );
+      check(
+        fromCdn.length >= 10,
+        `the page's files come from the CDN (${fromCdn.length} requests)`,
+        fromCdn.length,
+      );
+      const kinds = new Set(fromCdn.map((u) => path.extname(new URL(u).pathname)));
+      check(
+        kinds.has(".js") &&
+          kinds.has(".css") &&
+          (kinds.has(".webp") || kinds.has(".png") || kinds.has(".svg")),
+        "...scripts, the stylesheet and images alike",
+        [...kinds],
+      );
+      const r = await soloStart(page, 60_000);
+      check(
+        r.finished.length === NEEDED.length && r.finished.every((o) => o === cdnOrigin),
+        "a Solo start gets the engine worker and the map from the CDN",
+        r,
+      );
+      await context.close();
+    }
+
+    // 2. The service worker covers the CDN too: with the CDN freezing big files, a game start
+    //    still completes.
+    {
+      cdn.reset();
+      const { context, page } = await newPage(browser, "allow");
+      await homeReady(page);
+      const controlled = await page
+        .waitForFunction(() => !!navigator.serviceWorker.controller, null, {
+          timeout: 20_000,
+        })
+        .then(() => true)
+        .catch(() => false);
+      check(controlled, "the service worker controls the page");
+      cdn.state.freeze = true;
+      const r = await soloStart(page, 90_000);
+      check(
+        r.finished.length === NEEDED.length,
+        "with the CDN freezing, a Solo start still gets all its files",
+        r,
+      );
+      check(cdn.state.frozen > 0, "...and the freezes really happened", cdn.state.frozen);
+      const cached = await page.evaluate(async () => {
+        const keys = await (await caches.open("cf-files-v1")).keys();
+        return keys.map((k) => k.url);
+      });
+      check(
+        cached.some((u) => u.startsWith(cdn.base + "/assets/Worker.worker-")),
+        "the worker's cache holds the CDN copy of the engine worker",
+        cached.length,
+      );
+      await context.close();
+      cdn.reset();
+    }
+  } finally {
+    await browser.close();
+    await cdn.close();
+  }
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nCDN TEST FAILED" : "\nCDN TEST PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nCDN TEST ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
diff --git a/cloudflare/scripts/cdn-standin.ts b/cloudflare/scripts/cdn-standin.ts
new file mode 100644
index 0000000..d77f10a
--- /dev/null
+++ b/cloudflare/scripts/cdn-standin.ts
@@ -0,0 +1,195 @@
+// A stand-in for the CDN that serves the site's files in tests.
+//
+// A page built with `CDN_BASE=http://localhost:8790/gh/test/assets@local` loads everything
+// under /assets and /_assets from that address, so any test that opens the page in a browser
+// needs something listening there. This serves static/assets and static/_assets under the same
+// path prefix jsDelivr would use, with the CORS header jsDelivr sends, and can freeze large
+// files the way the real network does (the first tries send ~70 KB and then go silent), which
+// is what the service worker is for.
+//
+//   npm run cdn:standin        # keep one running by hand (e.g. while using `npm run dev`)
+//
+// Tests call standInIfBuiltForIt(): it reads static/index.html, and if the page was built for a
+// localhost CDN base it starts the server on that port (unless something already listens).
+
+import fs from "node:fs";
+import http from "node:http";
+import net from "node:net";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const defaultStaticDir = path.resolve(here, "../../static");
+
+const TYPES: Record<string, string> = {
+  ".js": "text/javascript; charset=utf-8",
+  ".css": "text/css; charset=utf-8",
+  ".json": "application/json",
+  ".bin": "application/octet-stream",
+  ".webp": "image/webp",
+  ".png": "image/png",
+  ".jpg": "image/jpeg",
+  ".svg": "image/svg+xml",
+  ".ttf": "font/ttf",
+  ".woff2": "font/woff2",
+  ".mp3": "audio/mpeg",
+  ".ogg": "audio/ogg",
+  ".wav": "audio/wav",
+  ".md": "text/plain; charset=utf-8",
+};
+
+export interface StandInState {
+  /** When true, the first `freezesPerFile` tries of any file of `bigBytes` or more send `freezeAt` bytes and go silent. */
+  freeze: boolean;
+  freezeAt: number;
+  bigBytes: number;
+  freezesPerFile: number;
+  tries: Map<string, number>;
+  frozen: number;
+  hits: number;
+  paths: string[];
+}
+
+export interface StandIn {
+  port: number;
+  prefix: string;
+  /** The CDN_BASE this serves, e.g. http://localhost:8790/gh/test/assets@local */
+  base: string;
+  state: StandInState;
+  /** Responses deliberately left hanging; destroy them to unblock a browser. */
+  open: Set<http.ServerResponse>;
+  reset(): void;
+  close(): Promise<void>;
+}
+
+export function startCdnStandIn({
+  port = 8790,
+  prefix = "/gh/test/assets@local",
+  staticDir = defaultStaticDir,
+}: { port?: number; prefix?: string; staticDir?: string } = {}): Promise<StandIn> {
+  const state: StandInState = {
+    freeze: false,
+    freezeAt: 70_000,
+    bigBytes: 100_000,
+    freezesPerFile: 2,
+    tries: new Map(),
+    frozen: 0,
+    hits: 0,
+    paths: [],
+  };
+  const open = new Set<http.ServerResponse>();
+  const server = http.createServer((req, res) => {
+    const url = new URL(req.url ?? "/", "http://x");
+    const headers: Record<string, string> = {
+      "access-control-allow-origin": "*",
+      "access-control-expose-headers": "*",
+      "cache-control": "public, max-age=31536000, immutable",
+    };
+    if (req.method === "OPTIONS") {
+      res.writeHead(204, { ...headers, "access-control-allow-headers": "*" });
+      res.end();
+      return;
+    }
+    if (!url.pathname.startsWith(prefix + "/")) {
+      res.writeHead(404, headers);
+      res.end("not on this cdn");
+      return;
+    }
+    const rel = url.pathname.slice(prefix.length + 1);
+    const file = path.join(staticDir, ...rel.split("/"));
+    if (
+      !/^(assets|_assets)\//.test(rel) ||
+      !fs.existsSync(file) ||
+      fs.statSync(file).isDirectory()
+    ) {
+      res.writeHead(404, headers);
+      res.end("no such file");
+      return;
+    }
+    state.hits++;
+    state.paths.push(rel);
+    const body = fs.readFileSync(file);
+    const n = (state.tries.get(rel) ?? 0) + 1;
+    state.tries.set(rel, n);
+    res.writeHead(200, {
+      ...headers,
+      "content-type": TYPES[path.extname(file)] ?? "application/octet-stream",
+      "content-length": String(body.length),
+    });
+    if (req.method === "HEAD") return res.end();
+    if (state.freeze && body.length >= state.bigBytes && n <= state.freezesPerFile) {
+      state.frozen++;
+      open.add(res);
+      res.on("close", () => open.delete(res));
+      res.write(body.subarray(0, state.freezeAt)); // ...and never the rest
+      return;
+    }
+    res.end(body);
+  });
+  return new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(port, () =>
+      resolve({
+        port,
+        prefix,
+        base: `http://localhost:${port}${prefix}`,
+        state,
+        open,
+        reset() {
+          state.freeze = false;
+          state.tries.clear();
+          state.frozen = 0;
+          state.hits = 0;
+          state.paths.length = 0;
+          for (const r of open) r.destroy();
+          open.clear();
+        },
+        close() {
+          for (const r of open) r.destroy();
+          open.clear();
+          return new Promise((done) => server.close(() => done()));
+        },
+      }),
+    );
+  });
+}
+
+function portInUse(port: number): Promise<boolean> {
+  return new Promise((resolve) => {
+    const s = net.connect({ port, host: "127.0.0.1" });
+    s.once("connect", () => {
+      s.destroy();
+      resolve(true);
+    });
+    s.once("error", () => resolve(false));
+  });
+}
+
+/**
+ * Starts the stand-in if the built page loads its files from a localhost CDN base, and nothing
+ * listens on that port yet. Returns null when the page is served from its own origin (or a
+ * real CDN), or when a stand-in is already running.
+ */
+export async function standInIfBuiltForIt(
+  staticDir = defaultStaticDir,
+): Promise<StandIn | null> {
+  const index = path.join(staticDir, "index.html");
+  if (!fs.existsSync(index)) return null;
+  const m = /\bcdnBase"?:\s*"(http:\/\/localhost:(\d+)(\/[^"]*))"/.exec(
+    fs.readFileSync(index, "utf8"),
+  );
+  if (!m) return null;
+  const port = Number(m[2]);
+  if (await portInUse(port)) return null;
+  const standIn = await startCdnStandIn({ port, prefix: m[3], staticDir });
+  console.log(`(the page loads its files from ${standIn.base}: serving them from static/)`);
+  return standIn;
+}
+
+// Run directly: keep a stand-in up until Ctrl+C.
+if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
+  const port = Number(process.env.CDN_PORT ?? 8790);
+  startCdnStandIn({ port }).then((s) => {
+    console.log(`cdn stand-in: ${s.base}  (serving static/assets and static/_assets; Ctrl+C to stop)`);
+  });
+}
diff --git a/cloudflare/scripts/deploy-staged.ts b/cloudflare/scripts/deploy-staged.ts
new file mode 100644
index 0000000..8e0326d
--- /dev/null
+++ b/cloudflare/scripts/deploy-staged.ts
@@ -0,0 +1,233 @@
+// Deploys the built site in small steps. Run `npm run build:site` first.
+//
+//   npm run deploy:staged
+//
+// Why: `wrangler deploy` uploads the site's files in a few large parallel requests.
+// On a slow uplink (~110 KB/s measured) those requests never get an answer and wrangler
+// waits forever; one run sat for 16 hours with no response. A request of a few MB does
+// finish (an 8 MB POST took ~75 s). So this deploys repeatedly, each time letting
+// wrangler see only a few more MB of the site (via static/.assetsignore). Files it has
+// already uploaded are skipped, so each step uploads only what is new, and the last step
+// is the complete site.
+//
+// Safety: every step has a hard timeout (a hung wrangler is killed, not waited on), and
+// no step starts when the machine is short of memory.
+
+import { execFileSync, spawn } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const cfDir = path.resolve(here, "..");
+const staticDir = path.resolve(cfDir, "..", "static");
+const wranglerBin = path.join(
+  cfDir,
+  "node_modules",
+  "wrangler",
+  "bin",
+  "wrangler.js",
+);
+
+const BATCH_BYTES = Number(process.env.STAGE_MB ?? "7") * 1048576;
+const STEP_TIMEOUT_MS = Number(process.env.STAGE_TIMEOUT_S ?? "420") * 1000;
+const MIN_FREE_BYTES = Number(process.env.MIN_FREE_GB ?? "2") * 1073741824;
+const FROM_STAGE = Number(process.env.FROM_STAGE ?? "1");
+// Terminal colour codes in wrangler's output (ESC [ ... m), without a literal control
+// character in the pattern.
+const ANSI_COLOR = new RegExp(`${String.fromCharCode(27)}\\[[0-9;]*m`, "g");
+// Top-level folders the Worker does not carry at all, e.g. SKIP_DIRS=assets,_assets when the page was
+// built with CDN_BASE and loads those files from the CDN: the upload is then just the page, its
+// build id, the map list and the pictures, instead of hundreds of MB over a slow uplink.
+const SKIP_DIRS = (process.env.SKIP_DIRS ?? "")
+  .split(",")
+  .map((d) => d.trim().replace(/^\/+|\/+$/g, ""))
+  .filter(Boolean);
+for (const d of SKIP_DIRS) {
+  if (!/^[\w.-]+$/.test(d)) throw new Error(`SKIP_DIRS entries are plain folder names, got ${d}`);
+}
+// What the finished site ignores (kept in sync with build-site.ts).
+const FINAL_IGNORE = `press/\n${SKIP_DIRS.map((d) => `/${d}/\n`).join("")}`;
+
+function walk(dir: string, base = ""): string[] {
+  const out: string[] = [];
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    const rel = base === "" ? e.name : `${base}/${e.name}`;
+    if (e.isDirectory()) out.push(...walk(path.join(dir, e.name), rel));
+    else out.push(rel);
+  }
+  return out;
+}
+
+const all = walk(staticDir)
+  .filter(
+    (f) =>
+      f !== ".assetsignore" &&
+      !f.startsWith("press/") &&
+      !SKIP_DIRS.some((d) => f.startsWith(`${d}/`)),
+  )
+  .sort();
+if (!all.includes("index.html") || !all.includes("commit.txt")) {
+  throw new Error(
+    "static/ is not a built site. Run `npm run build:site` first.",
+  );
+}
+const sizeOf = (f: string) => fs.statSync(path.join(staticDir, f)).size;
+
+// Step 1 is the site's brain: the page, its build id, the map list and the app bundle
+// (~5 MB). The rest follows in order, a few MB at a time.
+const essential = all.filter(
+  (f) =>
+    f === "index.html" ||
+    f === "commit.txt" ||
+    f === "maps.json" ||
+    f.startsWith("assets/"),
+);
+const essentialSet = new Set(essential);
+const stages: string[][] = [essential];
+let current: string[] = [];
+let currentBytes = 0;
+for (const f of all) {
+  if (essentialSet.has(f)) continue;
+  const size = sizeOf(f);
+  if (current.length > 0 && currentBytes + size > BATCH_BYTES) {
+    stages.push(current);
+    current = [];
+    currentBytes = 0;
+  }
+  current.push(f);
+  currentBytes += size;
+}
+if (current.length > 0) stages.push(current);
+
+/** A gitignore line that matches exactly one path. */
+function ignoreLine(rel: string): string {
+  const escaped = rel.replace(/[\\[\]*?]/g, "\\$&").replace(/^([#!])/, "\\$1");
+  return `/${escaped}`;
+}
+
+function killTree(pid: number): void {
+  try {
+    if (process.platform === "win32") {
+      execFileSync("taskkill", ["/PID", String(pid), "/T", "/F"], {
+        stdio: "ignore",
+      });
+    } else {
+      process.kill(pid, "SIGKILL");
+    }
+  } catch {
+    // already gone
+  }
+}
+
+function deployOnce(): Promise<{
+  ok: boolean;
+  seconds: number;
+  reason: string;
+  tail: string;
+}> {
+  return new Promise((resolve) => {
+    const started = Date.now();
+    const child = spawn(process.execPath, [wranglerBin, "deploy"], {
+      cwd: cfDir,
+      stdio: ["ignore", "pipe", "pipe"],
+    });
+    let output = "";
+    const collect = (d: Buffer) => {
+      output = (output + d.toString()).slice(-4000);
+    };
+    child.stdout.on("data", collect);
+    child.stderr.on("data", collect);
+    let timedOut = false;
+    const timer = setTimeout(() => {
+      timedOut = true;
+      killTree(child.pid!);
+    }, STEP_TIMEOUT_MS);
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      const seconds = Math.round((Date.now() - started) / 1000);
+      const clean = output.replace(ANSI_COLOR, "");
+      const tail = clean
+        .split("\n")
+        .filter((l) => l.trim())
+        .slice(-4)
+        .join(" | ");
+      if (timedOut) {
+        resolve({
+          ok: false,
+          seconds,
+          reason: `no answer after ${seconds}s (killed)`,
+          tail,
+        });
+      } else if (code === 0) {
+        resolve({ ok: true, seconds, reason: "", tail });
+      } else {
+        resolve({
+          ok: false,
+          seconds,
+          reason: `wrangler exited ${code}`,
+          tail,
+        });
+      }
+    });
+  });
+}
+
+async function main(): Promise<void> {
+  const totalMb = all.reduce((n, f) => n + sizeOf(f), 0) / 1048576;
+  console.log(
+    `deploying ${all.length} files (${totalMb.toFixed(0)} MB) in ${stages.length} steps of ~${(BATCH_BYTES / 1048576).toFixed(0)} MB`,
+  );
+  let included = new Set<string>();
+  for (let i = 0; i < stages.length; i++) {
+    for (const f of stages[i]!) included.add(f);
+    if (i + 1 < FROM_STAGE) continue;
+
+    const free = os.freemem();
+    if (free < MIN_FREE_BYTES) {
+      console.log(
+        `STOPPED before step ${i + 1}/${stages.length}: only ${(free / 1073741824).toFixed(1)} GB of memory free`,
+      );
+      process.exit(2);
+    }
+
+    const last = i === stages.length - 1;
+    const lines = last
+      ? FINAL_IGNORE
+      : `${FINAL_IGNORE}${all
+          .filter((f) => !included.has(f))
+          .map(ignoreLine)
+          .join("\n")}\n`;
+    fs.writeFileSync(path.join(staticDir, ".assetsignore"), lines);
+
+    const addedMb = stages[i]!.reduce((n, f) => n + sizeOf(f), 0) / 1048576;
+    const r = await deployOnce();
+    if (!r.ok) {
+      console.log(
+        `FAILED at step ${i + 1}/${stages.length} (+${addedMb.toFixed(1)} MB): ${r.reason}`,
+      );
+      console.log(`  last output: ${r.tail}`);
+      process.exitCode = 1;
+      return;
+    }
+    console.log(
+      `step ${i + 1}/${stages.length} ok: +${addedMb.toFixed(1)} MB, ${stages[i]!.length} files, ${r.seconds}s`,
+    );
+  }
+  console.log(`DONE: all ${all.length} files are deployed`);
+}
+
+main()
+  .catch((e) => {
+    console.log(`ERROR: ${e instanceof Error ? e.message : String(e)}`);
+    process.exitCode = 1;
+  })
+  .finally(() => {
+    // Whatever happened, leave static/ ready for a normal deploy.
+    try {
+      fs.writeFileSync(path.join(staticDir, ".assetsignore"), FINAL_IGNORE);
+    } catch {
+      // nothing to restore
+    }
+  });
