+++ b/cloudflare/src/env.ts
@@ -0,0 +1,51 @@
+import type { GameHost } from "./GameHost";
+
+export interface Env {
+  GAME_HOST: DurableObjectNamespace<GameHost>;
+  /** Public matchmaking registry and history. Optional: the game runs without it. */
+  DB?: D1Database;
+  /** The built web client (static/). Absent when only the API is deployed. */
+  ASSETS?: Fetcher;
+  GAME_ENV: string;
+  GIT_COMMIT: string;
+  INSTANCE_LETTER: string;
+  NUM_WORKERS: string;
+  /** "0" turns scheduled public lobbies off. */
+  PUBLIC_LOBBIES?: string;
+  /** How long a public lobby counts down before its game starts. */
+  PUBLIC_LOBBY_SECONDS?: string;
+
+  // ---- Accounts (src/accounts/). All secrets are set with `wrangler secret put`; without
+  // JWT_SECRET and the D1 binding sign-in is off and every player is a guest, as before.
+  /** Signs the tokens this site issues. Any long random string; keep it secret. */
+  JWT_SECRET?: string;
+  /** Google OAuth client (Google Cloud Console). Both needed for "Sign in with Google". */
+  GOOGLE_CLIENT_ID?: string;
+  GOOGLE_CLIENT_SECRET?: string;
+  /** Brevo API key and the verified sender address. Both needed for the emailed link. */
+  BREVO_API_KEY?: string;
+  MAIL_FROM?: string;
+  MAIL_FROM_NAME?: string;
+  /** Most emailed links the whole site sends in 24 hours (default 250; Brevo's free tier is 300). */
+  MAIL_DAILY_CAP?: string;
+  /** Overrides for tests, which point these at a local stand-in. Never set in production. */
+  GOOGLE_AUTH_URL?: string;
+  GOOGLE_TOKEN_URL?: string;
+  GOOGLE_USERINFO_URL?: string;
+  BREVO_API_URL?: string;
+}
+
+export function numWorkers(env: Env): number {
+  const n = Number(env.NUM_WORKERS ?? "1");
+  return Number.isInteger(n) && n >= 1 ? n : 1;
+}
+
+/** `/w3/api/x` -> { index: 3, path: "/api/x" }; no prefix -> { index: null }. */
+export function splitWorkerPrefix(pathname: string): {
+  index: number | null;
+  path: string;
+} {
+  const m = /^\/w(\d+)(\/.*)?$/.exec(pathname);
+  if (m === null) return { index: null, path: pathname };
+  return { index: Number(m[1]), path: m[2] ?? "/" };
+}
diff --git a/cloudflare/src/index.ts b/cloudflare/src/index.ts
new file mode 100644
index 0000000..ac659a4
--- /dev/null
+++ b/cloudflare/src/index.ts
@@ -0,0 +1,92 @@
+import { handleAccountRequest, isAccountPath } from "./accounts/api";
+import { LobbyDb } from "./db";
+import { type Env, numWorkers, splitWorkerPrefix } from "./env";
+import { handleLeaderboard } from "./leaderboard";
+
+export { GameHost } from "./GameHost";
+
+// create_game bodies are a game config; the Node server allows 5 MB, far more
+// than any real one needs.
+const MAX_BODY_BYTES = 256 * 1024;
+
+export default {
+  async fetch(request: Request, env: Env): Promise<Response> {
+    const url = new URL(request.url);
+
+    // Sign-in and the profile: answered here on the account API's own address
+    // (`api.<site host>`, or the page's origin in `wrangler dev`). The same paths on the
+    // site itself are just pages.
+    if (isAccountPath(url.pathname)) {
+      const account = await handleAccountRequest(request, env);
+      if (account !== null) return account;
+      return env.ASSETS !== undefined
+        ? env.ASSETS.fetch(request)
+        : new Response("Not found", { status: 404 });
+    }
+
+    // The leaderboard (most wins in public games), read by the game's own leaderboard screen.
+    if (url.pathname === "/leaderboard/ranked") {
+      return handleLeaderboard(request, new LobbyDb(env.DB));
+    }
+
+    const { index, path } = splitWorkerPrefix(url.pathname);
+
+    // Game traffic is /w<n>[/...] (the client derives <n> from the game id's
+    // hash) or an unprefixed /api/... call, which the Node deployment lets nginx
+    // spread over the workers. Anything else is not ours (static assets come
+    // from the assets binding once the client is built).
+    if (index === null && !path.startsWith("/api/")) {
+      return new Response("Not found", { status: 404 });
+    }
+    const shard = index ?? 0;
+    if (shard >= numWorkers(env)) {
+      return new Response("Unknown worker", { status: 404 });
+    }
+
+    // The client builds page links as /w<n>/game/<id> and may load files under
+    // that prefix (the Node deployment's nginx answers both). Those are the web
+    // client, not the game API: serve them from the static assets, with the prefix
+    // removed. An unknown path falls through to index.html for page navigations.
+    const isUpgrade =
+      request.headers.get("Upgrade")?.toLowerCase() === "websocket";
+    if (
+      index !== null &&
+      !isUpgrade &&
+      !path.startsWith("/api/") &&
+      (request.method === "GET" || request.method === "HEAD") &&
+      env.ASSETS !== undefined
+    ) {
+      return env.ASSETS.fetch(
+        new Request(new URL(path + url.search, url.origin), request),
+      );
+    }
+
+    // Tell the object which shard it is: the id's name is not readable from
+    // inside it, and the prefix is stripped before it sees the URL.
+    let forwarded: Request;
+    if (isUpgrade || request.method === "GET" || request.method === "HEAD") {
+      forwarded = new Request(request);
+    } else {
+      // Buffer the (small) body instead of streaming it through: the object may
+      // answer before reading it, which workerd reports as an uncaught
+      // "Can't read from request stream after response has been sent".
+      const length = Number(request.headers.get("content-length") ?? "0");
+      if (length > MAX_BODY_BYTES) {
+        return new Response("Payload too large", { status: 413 });
+      }
+      const body = await request.arrayBuffer();
+      if (body.byteLength > MAX_BODY_BYTES) {
+        return new Response("Payload too large", { status: 413 });
+      }
+      forwarded = new Request(request.url, {
+        method: request.method,
+        headers: request.headers,
+        body: body.byteLength > 0 ? body : null,
+      });
+    }
+    forwarded.headers.set("x-worker-index", String(shard));
+    forwarded.headers.set("x-worker-path", path);
+    const id = env.GAME_HOST.idFromName(`w${shard}`);
+    return env.GAME_HOST.get(id).fetch(forwarded);
+  },
+} satisfies ExportedHandler<Env>;
diff --git a/cloudflare/src/leaderboard.ts b/cloudflare/src/leaderboard.ts
new file mode 100644
index 0000000..c5a5368
--- /dev/null
+++ b/cloudflare/src/leaderboard.ts
@@ -0,0 +1,154 @@
+// The leaderboard: who has won the most public games.
+//
+// Recording: when a public game ends (src/PublicLobbies.ts) every human who was in it at the start
+// gets a game, and the winner(s) a win. Reading: GET /leaderboard/ranked, in the shape the game's
+// own leaderboard screen already parses (packages/shared RankedLeaderboardResponseSchema), so the
+// screen needs no new code beyond showing one tab.
+//
+// Cheating: clients report who won and the server does not replay the game, so the table is only
+// as honest as the players. What keeps it from being trivial to inflate: the winner must be the
+// majority's choice (Game.tallyWinner), a game counts only with at least MIN_PLAYERS humans and
+// MIN_TURNS turns, and only players who were present at the start are credited.
+
+import type { GameResult } from "./Game";
+
+/** Humans needed at the start for a game to count. */
+export const MIN_PLAYERS = 2;
+/** A game shorter than this (a turn is ~100 ms) is not counted: ~1 minute. */
+export const MIN_TURNS = 600;
+/** Rows per page; the screen treats a page shorter than this as the last one. */
+export const PAGE_SIZE = 50;
+const MAX_PAGE = 20;
+
+export interface PlayerResult {
+  persistentID: string;
+  name: string;
+  won: boolean;
+}
+
+/** The client ids a winner key names: ["player", id] or ["team", name, id...]; nations are not people. */
+export function winnerClientIDs(winnerKey: string | null): string[] {
+  if (winnerKey === null) return [];
+  let winner: unknown;
+  try {
+    winner = JSON.parse(winnerKey);
+  } catch {
+    return [];
+  }
+  if (!Array.isArray(winner)) return [];
+  const ids =
+    winner[0] === "player"
+      ? winner.slice(1, 2)
+      : winner[0] === "team"
+        ? winner.slice(2)
+        : [];
+  return ids.filter((id): id is string => typeof id === "string");
+}
+
+/** What a finished game adds to the table; empty when the game does not count. */
+export function playerResults(result: GameResult): PlayerResult[] {
+  if (result.winnerKey === null) return [];
+  if (result.turns < MIN_TURNS) return [];
+  // The same person twice (two tabs, one browser) is one player.
+  const roster = new Map<string, { clientID: string; name: string }>();
+  for (const p of result.roster) {
+    if (!roster.has(p.persistentID)) {
+      roster.set(p.persistentID, { clientID: p.clientID, name: p.username });
+    }
+  }
+  if (roster.size < MIN_PLAYERS) return [];
+  const winners = new Set(winnerClientIDs(result.winnerKey));
+  return [...roster].map(([persistentID, p]) => ({
+    persistentID,
+    name: p.name,
+    won: winners.has(p.clientID),
+  }));
+}
+
+/** Salted hash of a persistent id: the table's key, and what is shown instead of the id. */
+export async function playerKey(persistentID: string): Promise<string> {
+  const bytes = new TextEncoder().encode(
+    `openfront-leaderboard:${persistentID}`,
+  );
+  const digest = await crypto.subtle.digest("SHA-256", bytes);
+  return [...new Uint8Array(digest)]
+    .map((b) => b.toString(16).padStart(2, "0"))
+    .join("");
+}
+
+export interface LeaderRow {
+  key: string;
+  name: string;
+  games: number;
+  wins: number;
+}
+
+/** One row in the game's own response shape. `elo` carries the win count (the column is labelled "Wins"). */
+export function toRankedEntry(row: LeaderRow, rank: number) {
+  const suffix = String(parseInt(row.key.slice(0, 6), 16) % 10000).padStart(
+    4,
+    "0",
+  );
+  return {
+    rank,
+    elo: row.wins,
+    peakElo: null,
+    wins: row.wins,
+    losses: row.games - row.wins,
+    total: row.games,
+    public_id: row.key.slice(0, 10).toUpperCase(),
+    // "Name.1234": the dot keeps the screen from showing the "verified account" tick.
+    accountUsername: `${row.name.replace(/\./g, " ").trim().slice(0, 27) || "Player"}.${suffix}`,
+  };
+}
+
+export interface LeaderboardSource {
+  leaderboard(limit: number, offset: number): Promise<LeaderRow[]>;
+}
+
+/** GET /leaderboard/ranked?page=N */
+export async function handleLeaderboard(
+  request: Request,
+  source: LeaderboardSource,
+): Promise<Response> {
+  const headers = {
+    "content-type": "application/json",
+    "access-control-allow-origin": "*",
+    "cache-control": "public, max-age=60",
+  };
+  if (request.method === "OPTIONS") {
+    return new Response(null, {
+      status: 204,
+      headers: {
+        "access-control-allow-origin": "*",
+        "access-control-allow-headers": "accept",
+      },
+    });
+  }
+  if (request.method !== "GET" && request.method !== "HEAD") {
+    return new Response("Method not allowed", { status: 405 });
+  }
+  const raw = new URL(request.url).searchParams.get("page");
+  const page = raw === null ? 1 : Number(raw);
+  if (!Number.isInteger(page) || page < 1 || page > MAX_PAGE) {
+    return new Response(
+      JSON.stringify({ message: `Page must be between 1 and ${MAX_PAGE}` }),
+      { status: 400, headers },
+    );
+  }
+  let rows: LeaderRow[] = [];
+  try {
+    rows = await source.leaderboard(PAGE_SIZE, (page - 1) * PAGE_SIZE);
+  } catch (e) {
+    // No database (or its daily allowance is spent): an empty table, not an error screen.
+    console.warn(
+      JSON.stringify({ msg: "leaderboard read failed", error: String(e) }),
+    );
+  }
+  const entries = rows.map((row, i) =>
+    toRankedEntry(row, (page - 1) * PAGE_SIZE + i + 1),
+  );
+  return new Response(JSON.stringify({ "1v1": [], "2v2": [], ffa: entries }), {
+    headers,
+  });
+}
diff --git a/cloudflare/src/seed.ts b/cloudflare/src/seed.ts
new file mode 100644
index 0000000..070830b
--- /dev/null
+++ b/cloudflare/src/seed.ts
@@ -0,0 +1,35 @@
+// Tiny deterministic helpers. Public lobbies are a pure function of the clock, so
+// every fresh Durable Object instance derives the same ids and maps with no storage.
+
+/** FNV-1a, 32 bit: a stable seed from a string. */
+export function hashString(s: string): number {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < s.length; i++) {
+    h ^= s.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+}
+
+/** mulberry32: a small seeded PRNG returning floats in [0, 1). */
+export function mulberry32(seed: number): () => number {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+/** A Fisher-Yates permutation of 0..n-1, seeded. */
+export function permutation(n: number, seed: number): number[] {
+  const rng = mulberry32(seed);
+  const order = Array.from({ length: n }, (_, i) => i);
+  for (let i = n - 1; i > 0; i--) {
+    const j = Math.floor(rng() * (i + 1));
+    [order[i], order[j]] = [order[j]!, order[i]!];
+  }
+  return order;
+}
diff --git a/cloudflare/sw/sw.js b/cloudflare/sw/sw.js
new file mode 100644
index 0000000..79f6d36
--- /dev/null
+++ b/cloudflare/sw/sw.js
@@ -0,0 +1,247 @@
+// Service worker for the OpenFront site.
+//
+// Why it exists: on some connections (measured on one in Iran) a big download freezes
+// partway, typically near 70 KB, and then either stays silent for minutes or ends in a
+// reset. About one large file in three is hit, and the game needs several at once to start
+// (the engine worker and two map files), so a game start almost never got through: the
+// button sat on "Starting..." for good. The connection is otherwise fine; a second try
+// of the same file usually works.
+//
+// What it does, for GET requests to /assets/* and /_assets/* only (every file there carries
+// a content hash in its name, so a name never changes meaning):
+//  - answers from its own cache when it has the file;
+//  - otherwise downloads it itself, and treats a stretch with no data (STALL_MS) as a dead
+//    attempt: it drops the connection and starts again, up to ATTEMPTS times;
+//  - keeps a finished file for good, so each one has to get through only once, ever;
+//  - on a "cf-warm" message from the page (sent once the home page is up) fetches the files
+//    a game start needs, in the background, so the click on Solo finds them already here.
+//
+// It never touches pages, the API, WebSockets, range requests or anything else, so it cannot
+// serve a stale page. Adding "?nosw" to the address removes it (see the page's own snippet).
+//
+// When the site is built with CDN_BASE (the files live on jsDelivr, say), the same applies to
+// that origin: requests for CDN + "/assets/..." and CDN + "/_assets/..." are handled the same
+// way, fetched with CORS (the CDN sends Access-Control-Allow-Origin: *), and the warm list is
+// fetched from there.
+//
+// The values below are filled in by scripts/build-site.ts.
+
+"use strict";
+
+var CACHE = "cf-files-v1";
+var BUILD = "__BUILD_ID__";
+var CDN = "__CDN_BASE__"; // "" when the files are served from this origin
+var WARM = __WARM_LIST__;
+
+var CFG = {
+  firstByteMs: 12000, // no response headers for this long: dead
+  stallMs: 6000, // no new bytes for this long: dead
+  attempts: 8,
+  backoffMs: 300,
+  warmConcurrency: 6,
+};
+
+self.addEventListener("install", function () {
+  self.skipWaiting();
+});
+
+self.addEventListener("activate", function (event) {
+  // Take over the page that registered us, so the downloads it starts next are protected.
+  event.waitUntil(self.clients.claim());
+});
+
+var SCOPE = /^\/(assets|_assets)\//;
+
+/** True for a file this worker is responsible for: /assets or /_assets, here or on the CDN. */
+function ours(href) {
+  var url = new URL(href);
+  if (url.origin === self.location.origin) return SCOPE.test(url.pathname);
+  if (!CDN) return false;
+  return href.indexOf(CDN + "/assets/") === 0 || href.indexOf(CDN + "/_assets/") === 0;
+}
+
+// Set by a "cf-off" message (the page's "?nosw" switch): stop handling anything, drop the cache.
+var off = false;
+
+self.addEventListener("fetch", function (event) {
+  var request = event.request;
+  if (off || request.method !== "GET" || request.headers.has("range")) return;
+  if (!ours(request.url)) return;
+  var answer = respond(request);
+  event.respondWith(answer);
+  // Keep going after the page has given up on this request (a reload, a closed tab): the
+  // browser may stop an idle worker, and a half-finished download would be lost. Finished
+  // files are what make the next try short.
+  event.waitUntil(answer.catch(function () {}));
+});
+
+self.addEventListener("message", function (event) {
+  var type = event.data && event.data.type;
+  if (type === "cf-warm" && !off) event.waitUntil(warm());
+  if (type === "cf-off") {
+    off = true;
+    event.waitUntil(caches.delete(CACHE));
+  }
+});
+
+function sleep(ms) {
+  return new Promise(function (resolve) {
+    setTimeout(resolve, ms);
+  });
+}
+
+/**
+ * One download attempt: resolves with the whole body, or rejects when it stalls or breaks.
+ *
+ * `n` is the attempt number. A stalled attempt usually means its connection has died, and
+ * the browser can keep handing new requests to a dead HTTP/2 connection for many seconds.
+ * Requests sent without credentials use a separate connection from ones sent with them, so
+ * every other attempt goes the other way: a retry then meets a fresh connection instead of
+ * the corpse of the last one. (These files are public and need no cookies.)
+ */
+function attempt(request, n) {
+  var controller = new AbortController();
+  var timer = null;
+  function arm(ms) {
+    clearTimeout(timer);
+    timer = setTimeout(function () {
+      controller.abort();
+    }, ms);
+  }
+  arm(CFG.firstByteMs);
+  var init = { signal: controller.signal };
+  if (n % 2 === 1) init.credentials = "omit";
+  var req;
+  if (new URL(request.url).origin !== self.location.origin) {
+    // A <script src> or <link> for the CDN arrives as a "no-cors" request, whose response
+    // would be opaque: no body to read, nothing to cache. The CDN allows CORS, so the file is
+    // fetched as a plain CORS request instead; the page may be answered with that.
+    init.mode = "cors";
+    init.credentials = "omit";
+    req = new Request(request.url, init);
+  } else {
+    req = new Request(request, init);
+  }
+  return fetch(req)
+    .then(function (res) {
+      if (res.status >= 500) throw new Error("server error " + res.status);
+      if (res.status !== 200 || !res.body) {
+        clearTimeout(timer);
+        return { res: res, blob: null };
+      }
+      var reader = res.body.getReader();
+      var chunks = [];
+      var total = 0;
+      function pump() {
+        arm(CFG.stallMs);
+        return reader.read().then(function (r) {
+          if (r.done) return;
+          chunks.push(r.value);
+          total += r.value.length;
+          return pump();
+        });
+      }
+      return pump().then(function () {
+        clearTimeout(timer);
+        // A body that ends early without an error (some resets look like that).
+        var length = res.headers.get("content-length");
+        if (length && !res.headers.get("content-encoding") && Number(length) !== total) {
+          throw new Error("short body " + total + " of " + length);
+        }
+        return { res: res, blob: new Blob(chunks) };
+      });
+    })
+    .catch(function (err) {
+      clearTimeout(timer);
+      try {
+        controller.abort();
+      } catch (e) {
+        /* already done */
+      }
+      throw err;
+    });
+}
+
+async function download(request) {
+  var lastError = null;
+  for (var i = 0; i < CFG.attempts; i++) {
+    try {
+      return await attempt(request, i);
+    } catch (err) {
+      lastError = err;
+      await sleep(Math.min(2000, CFG.backoffMs * (i + 1)));
+    }
+  }
+  throw lastError;
+}
+
+var inflight = new Map();
+
+/** The file, from cache or by downloading it (once at a time per URL). Stores what it gets. */
+function load(request) {
+  var key = request.url;
+  var running = inflight.get(key);
+  if (running) return running.then(function (r) { return r.clone(); });
+  var p = (async function () {
+    if (off) throw new Error("switched off");
+    var cache = await caches.open(CACHE);
+    var hit = await cache.match(key, { ignoreVary: true });
+    if (hit) return hit;
+    var got = await download(request);
+    if (!got.blob) return got.res; // 404 and the like: pass on as it is
+    // The body is already decoded (fetch undoes gzip/br), so the headers that describe the
+    // wire format must go, or the browser would decode it a second time.
+    var headers = new Headers(got.res.headers);
+    headers.delete("content-encoding");
+    headers.delete("content-length");
+    headers.delete("transfer-encoding");
+    headers.delete("vary");
+    var out = new Response(got.blob, {
+      status: got.res.status,
+      statusText: got.res.statusText,
+      headers: headers,
+    });
+    // An HTML answer for a file name is the site's "not found" fallback page. Hash-named
+    // files never change, but a name that is missing today may exist after the next deploy.
+    if (!off && !/text\/html/i.test(headers.get("content-type") || "")) {
+      try {
+        await cache.put(key, out.clone());
+      } catch (e) {
+        /* out of space: serve it anyway */
+      }
+    }
+    return out;
+  })();
+  inflight.set(key, p);
+  var done = function () {
+    inflight.delete(key);
+  };
+  p.then(done, done);
+  return p.then(function (r) { return r.clone(); });
+}
+
+async function respond(request) {
+  try {
+    return await load(request);
+  } catch (err) {
+    return fetch(request); // every attempt failed: the browser's own try is no worse
+  }
+}
+
+async function warm() {
+  var queue = WARM.slice();
+  async function lane() {
+    while (queue.length) {
+      var path = queue.shift();
+      try {
+        // CDN is an origin plus a path prefix, so it is joined as text, not resolved as a URL.
+        await load(new Request(CDN ? CDN + path : new URL(path, self.location.origin).href));
+      } catch (e) {
+        /* the next visit tries again */
+      }
+    }
+  }
+  var lanes = [];
+  for (var i = 0; i < CFG.warmConcurrency; i++) lanes.push(lane());
+  await Promise.all(lanes);
+}
diff --git a/cloudflare/tsconfig.json b/cloudflare/tsconfig.json
new file mode 100644
index 0000000..e1339d1
--- /dev/null
+++ b/cloudflare/tsconfig.json
@@ -0,0 +1,25 @@
+// Typechecks the Worker against the Workers runtime types (no DOM, no Node globals).
+// It deliberately does NOT extend tsconfig.base.json: that file pulls in vitest and
+// node types, which would hide host-API mistakes a Worker can't actually run.
+{
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "ESNext",
+    "moduleResolution": "bundler",
+    "lib": ["ES2022"],
+    "types": ["@cloudflare/workers-types"],
+    "paths": {
+      "resources/*": ["../resources/*"]
+    },
+    "strict": true,
+    // Same as tsconfig.base.json, which the shared packages are written against.
+    "strictPropertyInitialization": false,
+    "noEmit": true,
+    "skipLibCheck": true,
+    "resolveJsonModule": true,
+    "experimentalDecorators": true,
+    "useDefineForClassFields": false,
+    "isolatedModules": true
+  },
+  "include": ["src/**/*"]
+}
diff --git a/cloudflare/wrangler.jsonc b/cloudflare/wrangler.jsonc
new file mode 100644
index 0000000..a16b04d
--- /dev/null
+++ b/cloudflare/wrangler.jsonc
@@ -0,0 +1,94 @@
+{
+  "$schema": "./node_modules/wrangler/config-schema.json",
+  "name": "openfront",
+  "main": "src/index.ts",
+  // Must not be newer than the installed workerd supports (the repo's npmrc holds
+  // new releases back for a week), so this trails "today" by a day or so.
+  "compatibility_date": "2026-10-30",
+  "compatibility_flags": ["nodejs_compat"],
+
+  // One Durable Object per "worker index" (/w0, /w1, ...), exactly like the Node
+  // server's worker processes. All games of an index live in that one object, so
+  // N concurrent games bill duration once. SQLite-backed: the only kind the Free
+  // plan allows.
+  "durable_objects": {
+    "bindings": [{ "name": "GAME_HOST", "class_name": "GameHost" }],
+  },
+  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameHost"] }],
+
+  // Public matchmaking registry and history (migrations/0001_init.sql). The game
+  // itself never depends on it: every write is best-effort. For a real deployment,
+  // run `wrangler d1 create openfront` and add the printed `database_id` here.
+  "d1_databases": [
+    {
+      "binding": "DB",
+      "database_name": "openfront",
+      "database_id": "69687a9f-3b68-4c0b-81ac-0bfcf8b70fe3",
+      "migrations_dir": "migrations",
+    },
+  ],
+
+  "vars": {
+    // Scheduled public lobbies ("0" turns them off) and how long each counts down.
+    "PUBLIC_LOBBIES": "1",
+    "PUBLIC_LOBBY_SECONDS": "60",
+    // "dev" semantics: anonymous persistent-ID tokens are accepted, because the
+    // closed-source account API this game normally authenticates against is absent.
+    "GAME_ENV": "dev",
+    // Clients built from a different commit desync, so joins must match this.
+    // "DEV" matches a client served from `npm run dev`; set it to the real commit
+    // when deploying a built client.
+    "GIT_COMMIT": "DEV",
+    // First character of every game id this deployment mints (docs/MultiServer.md).
+    "INSTANCE_LETTER": "a",
+    // Number of /w<n> shards. Game ids route to a shard by hash, so this may only
+    // change when no games are running.
+    "NUM_WORKERS": "1",
+  },
+
+  // The web client. `npm run build:site` builds it into ../static (and writes
+  // commit.txt, the build id the Worker holds joining clients to). Static assets
+  // are free and unlimited; the Worker only runs for the paths below, so adding a
+  // shard (NUM_WORKERS > 1) means adding its /w<n> pair here.
+  "assets": {
+    "directory": "../static",
+    "binding": "ASSETS",
+    "not_found_handling": "single-page-application",
+    // /auth/* and /users/* are the account API (src/accounts/), which answers on the api.
+    // host below; on the site's own host those paths are just pages.
+    "run_worker_first": ["/api/*", "/w0", "/w0/*", "/auth/*", "/users/*", "/leaderboard/*"],
+  },
+
+  // A Custom Domain makes the Worker the origin for a hostname: Cloudflare creates the DNS
+  // record and a certificate. It cannot be created over an existing CNAME for the same name.
+  //
+  // The address players use: openfront.io.hatami-mahdi.ir, and nothing else (the owner asked
+  // for exactly this one; openfront.hatami-mahdi.ir and play.hatami-mahdi.ir were tried and
+  // removed). The page is built per host, so build with SITE_HOST set to this name.
+  //
+  // The zone also has something that answers for its subdomains with its own 404 page
+  // (a catch-all in front of the Custom Domain). A route for exactly the hostname is
+  // more specific than any wildcard, so it wins without touching that other site.
+  //
+  // Sign-in (src/accounts/) answers on a second hostname, api.openfront.io.hatami-mahdi.ir: the
+  // client looks for its account API at exactly `api.<site host>`, so the name cannot be chosen.
+  // Deploying the two entries below creates that hostname (a DNS record and a certificate on
+  // the zone), so they stay commented out until sign-in is being switched on (see "Accounts" in
+  // the README: secrets first, then uncomment these and deploy).
+  "routes": [
+    { "pattern": "openfront.io.hatami-mahdi.ir", "custom_domain": true },
+    {
