@@ -0,0 +1,495 @@
+// Tests the loading screen in real Chrome by making the page's own app bundle slow,
+// broken, or broken once:
+//
+//   BASE=http://localhost:8787 npm run smoke:loading
+//
+// Screenshots go to .shots/ (git-ignored). Timings are shortened through
+// window.CF_LOADING (see scripts/loading-screen.ts).
+
+import fs from "node:fs";
+import path from "node:path";
+import { type Browser, chromium, type Page } from "playwright-core";
+import { standInIfBuiltForIt } from "./cdn-standin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const SHOTS =
+  process.env.SHOTS ?? path.resolve(import.meta.dirname, "../.shots");
+fs.mkdirSync(SHOTS, { recursive: true });
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail =
+    ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function until<T>(
+  fn: () => Promise<T | undefined>,
+  timeoutMs: number,
+): Promise<T | undefined> {
+  const end = Date.now() + timeoutMs;
+  for (;;) {
+    const v = await fn();
+    if (v !== undefined) return v;
+    if (Date.now() > end) return undefined;
+    await sleep(150);
+  }
+}
+
+interface Scenario {
+  name: string;
+  locale?: string;
+  /** window.CF_LOADING overrides. */
+  timings?: Record<string, number>;
+  /** What to do with requests for the app's /assets/*.js files. */
+  scripts?: "normal" | "delay" | "fail" | "failOnce";
+  delayMs?: number;
+  /** Hold the page's stylesheet back for this long (a stalled connection). */
+  cssDelayMs?: number;
+}
+
+async function open(browser: Browser, s: Scenario): Promise<Page> {
+  // The service worker would answer the very requests these scenarios hold back or fail
+  // (it retries them, which is its job), so it is switched off here; smoke:flaky covers it.
+  const context = await browser.newContext({
+    viewport: { width: 1200, height: 800 },
+    locale: s.locale ?? "en-US",
+    serviceWorkers: "block",
+  });
+  if (s.timings) {
+    await context.addInitScript((t) => {
+      (window as unknown as { CF_LOADING: unknown }).CF_LOADING = t;
+    }, s.timings);
+  }
+  let blockedOnce = false;
+  await context.route(/\/assets\/[^/]+\.js(\?.*)?$/, async (route) => {
+    if (s.scripts === "fail") return route.abort("connectionreset");
+    if (s.scripts === "failOnce" && !blockedOnce) {
+      blockedOnce = true;
+      return route.abort("connectionreset");
+    }
+    if (s.scripts === "delay") await sleep(s.delayMs ?? 4000);
+    return route.continue();
+  });
+  if (s.cssDelayMs) {
+    await context.route(/\/assets\/[^/]+\.css(\?.*)?$/, async (route) => {
+      await sleep(s.cssDelayMs ?? 0);
+      return route.continue();
+    });
+  }
+  const page = await context.newPage();
+  await page.goto(BASE, { waitUntil: "commit", timeout: 60_000 });
+  return page;
+}
+
+const loaderState = (page: Page) =>
+  page
+    .evaluate(() => {
+      const el = document.getElementById("cf-loading");
+      if (!el) return { present: false } as const;
+      const r = el.getBoundingClientRect();
+      const failBox = document.getElementById("cf-fail");
+      // What the player can actually see: the element at the middle of the screen must
+      // be the loader (hit-testing skips anything hidden, including through a parent
+      // that is invisible, which a check on the element's own style would miss).
+      const mid = document.elementFromPoint(innerWidth / 2, innerHeight / 2);
+      return {
+        present: true,
+        visible:
+          r.width > 0 && r.height > 0 && mid !== null && el.contains(mid),
+        done: el.classList.contains("cf-done"),
+        failed: el.classList.contains("cf-failed"),
+        lang: el.getAttribute("lang"),
+        dir: el.getAttribute("dir"),
+        message: document.getElementById("cf-msg")?.textContent ?? "",
+        failTitle:
+          failBox && !failBox.hidden
+            ? document.getElementById("cf-fail-title")?.textContent
+            : null,
+        buttonShown: !!failBox && !failBox.hidden,
+      } as const;
+    })
+    .catch(() => undefined);
+
+const CREDIT_URL = "https://hatami-mahdi.ir/";
+
+/** The link to the host's site: what it says, where it goes, and whether a click would reach it. */
+const creditState = (page: Page) =>
+  page
+    .evaluate(() => {
+      const a = document.getElementById("cf-credit") as HTMLAnchorElement | null;
+      if (!a) return undefined;
+      const r = a.getBoundingClientRect();
+      const hit = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
+      return {
+        href: a.getAttribute("href"),
+        target: a.target,
+        rel: a.rel,
+        text: a.textContent ?? "",
+        lead: document.getElementById("cf-credit-lead")?.textContent ?? "",
+        clickable: r.width > 0 && r.height > 0 && hit !== null && a.contains(hit),
+        inView: r.top >= 0 && r.bottom <= innerHeight && r.left >= 0 && r.right <= innerWidth,
+      };
+    })
+    .catch(() => undefined);
+
+const appStarted = (page: Page) =>
+  page.evaluate(() => !!customElements.get("play-page")).catch(() => false);
+
+async function main(): Promise<void> {
+  console.log(`loading-screen test against ${BASE}`);
+  // A page built with a localhost CDN_BASE needs its files served from there.
+  const cdn = await standInIfBuiltForIt();
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  try {
+    // 1. A slow app: the loader is there first, says so, and goes away when the app starts.
+    {
+      const page = await open(browser, {
+        name: "slow",
+        scripts: "delay",
+        delayMs: 4500,
+        timings: { slowMs: 2000, retryMs: 60000, okMs: 1200, leaveMs: 1400 },
+      });
+      const early = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.visible ? s : undefined;
+      }, 3000);
+      check(
+        early !== undefined,
+        "the loading screen is on screen before the app has loaded",
+      );
+      check(
+        !(await appStarted(page)),
+        "...while the app bundle is still on its way",
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-1-first.png") });
+
+      // The link to the host's site is there, points at it, can be clicked, and opens it in
+      // a new tab so the game keeps loading here.
+      const credit = await creditState(page);
+      check(
+        credit?.href === CREDIT_URL && /hatami-mahdi\.ir/.test(credit.text),
+        "the loading screen links to the host's site",
+        credit,
+      );
+      check(
+        credit?.clickable === true && credit.inView === true,
+        "...and the link is on screen where a click lands on it",
+        credit,
+      );
+      check(
+        credit?.target === "_blank" && /noopener/.test(credit.rel),
+        "...opening in a new tab without access to this one",
+        credit,
+      );
+      const ctx = page.context();
+      await ctx.route("https://hatami-mahdi.ir/**", (route) =>
+        route.fulfill({
+          status: 200,
+          contentType: "text/html",
+          body: "<title>host</title>ok",
+        }),
+      );
+      const [popup] = await Promise.all([
+        ctx.waitForEvent("page", { timeout: 8000 }),
+        page.click("#cf-credit"),
+      ]);
+      await popup.waitForLoadState("domcontentloaded").catch(() => undefined);
+      check(popup.url() === CREDIT_URL, "clicking it opens the host's site", popup.url());
+      const stillHere = await loaderState(page);
+      check(
+        page.url().startsWith(BASE) && stillHere?.present === true,
+        "...while this tab stays on the game with its loader",
+        [page.url(), stillHere?.present],
+      );
+      await popup.close();
+      await sleep(2500);
+      const slow = await loaderState(page);
+      check(
+        /slow/i.test(slow?.message ?? ""),
+        "it says so when loading is slow",
+        slow?.message,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-2-slow.png") });
+      // Once the app is up it says so, holds that, then opens onto the home page.
+      const ok = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && /everything is ok/i.test(s.message) ? s : undefined;
+      }, 20_000);
+      check(ok !== undefined, "once the app has started it says everything is OK", ok?.message);
+      check(
+        ok?.visible === true,
+        "...and that is still on screen (the loader waits before leaving)",
+      );
+      const art = await page.evaluate(() => {
+        const el = document.getElementById("cf-loading");
+        return {
+          on: !!el?.classList.contains("cf-bg-on"),
+          bg: el?.style.getPropertyValue("--cf-bg") ?? "",
+        };
+      });
+      check(
+        art.on && /\/art\/loading-wide\.[0-9a-f]+\.webp/.test(art.bg),
+        "the loading screen shows its backdrop picture",
+        art,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-2b-ok.png") });
+      const leaving = await until(async () => {
+        const s = await page
+          .evaluate(() => ({
+            leaving: !!document.getElementById("cf-loading")?.classList.contains("cf-leaving"),
+            reveal: document.documentElement.classList.contains("cf-reveal"),
+          }))
+          .catch(() => undefined);
+        return s?.leaving ? s : undefined;
+      }, 8000);
+      check(
+        leaving?.reveal === true,
+        "it then opens (cf-leaving) and the home page's picture starts to settle in (cf-reveal)",
+        leaving,
+      );
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 20_000);
+      check(gone === true, "and it disappears when the animation is over");
+      const home = await page.evaluate(() => {
+        const l = document.getElementById("background-layer");
+        return l ? getComputedStyle(l).backgroundImage : "";
+      });
+      check(
+        /\/art\/home-wide\.[0-9a-f]+\.webp/.test(home),
+        "the home page has the new picture behind it",
+        home.slice(0, 120),
+      );
+      check(await appStarted(page), "and the app is running underneath");
+      const kids = await page.evaluate(
+        () => document.querySelector("play-page")?.children.length ?? 0,
+      );
+      check(kids > 0, "the home page is rendered behind it", kids);
+      await page.screenshot({ path: path.join(SHOTS, "loading-3-app.png") });
+      await page.context().close();
+    }
+
+    // 2. A script that fails once: the loader retries by itself and the page then loads.
+    {
+      const page = await open(browser, {
+        name: "failOnce",
+        scripts: "failOnce",
+        timings: { failedRetryMs: 400, retryMs: 60000 },
+      });
+      const retrying = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && /trying again|retry/i.test(s.message)
+          ? s
+          : undefined;
+      }, 6000);
+      check(
+        retrying !== undefined,
+        "after a failed script it says it is trying again",
+        retrying?.message,
+      );
+      const started = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        25_000,
+      );
+      check(
+        started === true,
+        "the automatic reload succeeded and the app started",
+      );
+      await page.context().close();
+    }
+
+    // 3. A script that always fails: after the retries it gives up with a message and a button.
+    {
+      const page = await open(browser, {
+        name: "fail",
+        scripts: "fail",
+        timings: { failedRetryMs: 300, retryMs: 60000, maxRetries: 2 },
+      });
+      const gaveUp = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.failed ? s : undefined;
+      }, 30_000);
+      check(
+        gaveUp !== undefined,
+        "after the retries it stops and says the game could not load",
+      );
+      check(
+        gaveUp?.buttonShown === true,
+        "with a Reload button",
+        gaveUp?.failTitle,
+      );
+      const failCredit = await creditState(page);
+      check(
+        failCredit?.href === CREDIT_URL && failCredit.clickable === true,
+        "the link to the host's site is still there when loading has failed",
+        failCredit,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-4-failed.png") });
+      await page.context().close();
+    }
+
+    // 4. A Persian browser gets Persian, right to left.
+    {
+      const page = await open(browser, {
+        name: "fa",
+        locale: "fa-IR",
+        scripts: "fail",
+        timings: { failedRetryMs: 300, retryMs: 60000, maxRetries: 0 },
+      });
+      const fa = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.failed ? s : undefined;
+      }, 15_000);
+      check(
+        fa?.lang === "fa" && fa?.dir === "rtl",
+        "a Persian browser gets lang=fa, dir=rtl",
+        [fa?.lang, fa?.dir],
+      );
+      check(
+        /[\u0600-\u06FF]/.test(fa?.failTitle ?? ""),
+        "and the text is Persian",
+        fa?.failTitle,
+      );
+      const faCredit = await creditState(page);
+      check(
+        /[؀-ۿ]/.test(faCredit?.lead ?? "") && faCredit?.href === CREDIT_URL,
+        "and so is the link's caption",
+        faCredit?.lead,
+      );
+      await page.screenshot({
+        path: path.join(SHOTS, "loading-5-persian.png"),
+      });
+      await page.context().close();
+    }
+
+    // 5a. A stalled stylesheet: the page's inline scripts cannot run until it arrives, so a
+    //     loader placed after it stays dead for as long as the stall lasts (a blank page).
+    //     The loader sits at the very start of <head> and must be on screen at once.
+    {
+      const page = await open(browser, {
+        name: "cssStuck",
+        cssDelayMs: 9000,
+        timings: { slowMs: 2000, retryMs: 120000 },
+      });
+      const early = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.visible ? s : undefined;
+      }, 2500);
+      check(
+        early !== undefined,
+        "the loading screen is on screen while the stylesheet is still stuck",
+      );
+      check(
+        !(await appStarted(page)),
+        "...with the app not started yet",
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-6-css-stuck.png") });
+      const started = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        40_000,
+      );
+      check(started === true, "when the stylesheet finally arrives the app starts");
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 10_000);
+      check(gone === true, "and the loading screen leaves");
+      await page.context().close();
+    }
+
+    // 5b. No ads, trackers or anti-adblock: the page contacts only itself and Turnstile.
+    {
+      const context = await browser.newContext({
+        viewport: { width: 1200, height: 800 },
+        serviceWorkers: "block",
+      });
+      // A page built for localhost looks for its API on port 8787 unless told where it is
+      // (getApiBase in the client reads this key); BASE may be any port.
+      await context.addInitScript(
+        `try { localStorage.setItem("apiHost", ${JSON.stringify(BASE)}); } catch (e) {}`,
+      );
+      const page = await context.newPage();
+      const hosts = new Map<string, string>();
+      page.on("request", (r) => {
+        try {
+          const u = new URL(r.url());
+          if (u.protocol === "http:" || u.protocol === "https:")
+            hosts.set(u.host, u.pathname.slice(0, 40));
+        } catch {
+          /* data: / blob: URLs */
+        }
+      });
+      await page.goto(BASE, { waitUntil: "commit", timeout: 60_000 });
+      const up = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        40_000,
+      );
+      check(up === true, "the page starts (no third-party code needed)");
+      await sleep(5000); // late loaders (ad tags start after the app does) would show now
+      const own = new URL(BASE).host;
+      // When the site is built with CDN_BASE its own files come from that host.
+      const cdnBase = await page
+        .evaluate(
+          () =>
+            (window as unknown as { BOOTSTRAP_CONFIG?: { cdnBase?: string } })
+              .BOOTSTRAP_CONFIG?.cdnBase ?? "",
+        )
+        .catch(() => "");
+      const cdnHost = cdnBase ? new URL(cdnBase).host : null;
+      const foreign = [...hosts.entries()].filter(
+        ([h]) => h !== own && h !== "challenges.cloudflare.com" && h !== cdnHost,
+      );
+      check(
+        foreign.length === 0,
+        "it contacts no host except its own" +
+          (cdnHost ? `, its CDN (${cdnHost})` : "") +
+          " and Cloudflare Turnstile",
+        foreign,
+      );
+      const ads = await page.evaluate(
+        () => (window as unknown as { adsEnabled?: boolean }).adsEnabled,
+      );
+      check(ads === false, "ads are switched off for the client", ads);
+      await context.close();
+    }
+
+    // 5. A normal fast load: no stuck loader, no leftover retry state.
+    {
+      const page = await open(browser, { name: "normal", scripts: "normal" });
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 30_000);
+      check(gone === true, "on a normal load the loader leaves by itself");
+      const tries = await page.evaluate(() =>
+        sessionStorage.getItem("cf-load-tries"),
+      );
+      check(tries === null, "and leaves no retry counter behind", tries);
+      await page.context().close();
+    }
+  } finally {
+    await browser.close();
+    await cdn?.close();
+  }
+  console.log(`\nscreenshots: ${SHOTS}`);
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nLOADING TEST FAILED" : "\nLOADING TEST PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nLOADING TEST ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
