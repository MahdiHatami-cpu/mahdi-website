index 0000000..9741c42
--- /dev/null
+++ b/src/client/render/gl/utils/TerrainDetail.ts
@@ -0,0 +1,156 @@
+/**
+ * Terrain detail — the CPU side of the photo texture TerrainPass lays over the
+ * flat terrain colours.
+ *
+ * resources/images/terrain-detail.webp is a 1024x1024 grayscale atlas, 2x2
+ * tiles of 512x512, one per terrain family (built by
+ * map-generator/python/make_terrain_detail.py):
+ *
+ *     sea    | grass
+ *     desert | snow
+ *
+ * A stored value of 128 means "no change"; the shader reads it as a detail
+ * strength in standard deviations, so the texture never shifts the average
+ * colour of the map.
+ *
+ * Which family a tile belongs to is baked into the alpha byte of TerrainPass's
+ * RGBA texture (the shader always writes alpha 1):
+ *
+ *     bits 7..5  family (0 sea, 1 grass, 2 desert, 3 snow)
+ *     bits 4..0  weight 0..31 (shore water is half weight)
+ *     255        no detail (impassable terrain, drawn as the background)
+ */
+
+import { assetUrl } from "@openfront/shared/AssetUrls";
+
+export const TERRAIN_DETAIL_TILE = 512;
+export const TERRAIN_DETAIL_ATLAS_SIZE = TERRAIN_DETAIL_TILE * 2;
+/** Atlas order, row-major; also the texture-array layer index. */
+export const TERRAIN_DETAIL_LAYERS = [
+  "sea",
+  "grass",
+  "desert",
+  "snow",
+] as const;
+export type TerrainDetailLayer = (typeof TERRAIN_DETAIL_LAYERS)[number];
+
+export const DETAIL_NONE = 255;
+const SEA = 0;
+const GRASS = 1;
+const DESERT = 2;
+const SNOW = 3;
+const FULL = 31;
+const HALF = 16;
+
+/** Alpha code for one raw terrain byte (layout in ColorUtils.encodeTerrainTile). */
+export function terrainDetailCode(tb: number): number {
+  const isLand = (tb & 0x80) !== 0;
+  const isShoreline = (tb & 0x40) !== 0;
+  const magnitude = tb & 0x1f;
+  if (!isLand) return (SEA << 5) | (isShoreline ? HALF : FULL);
+  if (magnitude === 31) return DETAIL_NONE; // impassable
+  if (isShoreline) return (DESERT << 5) | FULL; // sand
+  if (magnitude < 10) return (GRASS << 5) | FULL; // plains
+  if (magnitude < 20) return (DESERT << 5) | FULL; // highland
+  return (SNOW << 5) | FULL; // mountain
+}
+
+const CODE_LUT = new Uint8Array(256);
+for (let tb = 0; tb < 256; tb++) CODE_LUT[tb] = terrainDetailCode(tb);
+
+/** Set the alpha byte of every texel of `rgba` from the matching terrain byte. */
+export function writeTerrainDetailCodes(
+  rgba: Uint8Array,
+  terrainBytes: Uint8Array,
+): void {
+  for (let i = 0; i < terrainBytes.length; i++) {
+    rgba[i * 4 + 3] = CODE_LUT[terrainBytes[i]];
+  }
+}
+
+/**
+ * Split the decoded atlas (RGBA, `size` x `size`) into one R8 plane per layer,
+ * layer after layer, ready for a TEXTURE_2D_ARRAY upload.
+ */
+export function splitDetailAtlas(
+  rgba: ArrayLike<number>,
+  size: number = TERRAIN_DETAIL_ATLAS_SIZE,
+): Uint8Array {
+  const tile = size / 2;
+  const out = new Uint8Array(tile * tile * 4);
+  for (let layer = 0; layer < 4; layer++) {
+    const x0 = (layer % 2) * tile;
+    const y0 = Math.floor(layer / 2) * tile;
+    let o = layer * tile * tile;
+    for (let y = 0; y < tile; y++) {
+      let src = ((y0 + y) * size + x0) * 4;
+      for (let x = 0; x < tile; x++, src += 4) out[o++] = rgba[src];
+    }
+  }
+  return out;
+}
+
+async function fetchAtlas(): Promise<Uint8Array> {
+  const res = await fetch(assetUrl("images/terrain-detail.webp"), {
+    mode: "cors",
+  });
+  if (!res.ok) throw new Error(`terrain detail: HTTP ${res.status}`);
+  const bitmap = await createImageBitmap(await res.blob(), {
+    colorSpaceConversion: "none",
+    premultiplyAlpha: "none",
+  });
+  try {
+    const size = TERRAIN_DETAIL_ATLAS_SIZE;
+    if (bitmap.width !== size || bitmap.height !== size) {
+      throw new Error(
+        `terrain detail: expected ${size}x${size}, got ${bitmap.width}x${bitmap.height}`,
+      );
+    }
+    const canvas: OffscreenCanvas | HTMLCanvasElement =
+      typeof OffscreenCanvas !== "undefined"
+        ? new OffscreenCanvas(size, size)
+        : Object.assign(document.createElement("canvas"), {
+            width: size,
+            height: size,
+          });
+    const ctx = canvas.getContext("2d", { willReadFrequently: true }) as
+      | OffscreenCanvasRenderingContext2D
+      | CanvasRenderingContext2D
+      | null;
+    if (!ctx) throw new Error("terrain detail: no 2d context");
+    ctx.drawImage(bitmap, 0, 0);
+    return splitDetailAtlas(ctx.getImageData(0, 0, size, size).data, size);
+  } finally {
+    bitmap.close();
+  }
+}
+
+let cached: Promise<Uint8Array> | null = null;
+
+/**
+ * The four detail planes (layer-major R8), fetched once per page and shared by
+ * every TerrainPass. A failed download is retried a couple of times (flaky
+ * networks cut big files short); after that it rejects and the next caller
+ * tries again, meanwhile the map just renders without detail.
+ */
+export function loadTerrainDetailLayers(): Promise<Uint8Array> {
+  if (!cached) {
+    const attempt = async (): Promise<Uint8Array> => {
+      let lastError: unknown;
+      for (let i = 0; i < 3; i++) {
+        try {
+          return await fetchAtlas();
+        } catch (e) {
+          lastError = e;
+          await new Promise((r) => setTimeout(r, 1500 * (i + 1)));
+        }
+      }
+      throw lastError;
+    };
+    cached = attempt().catch((e) => {
+      cached = null;
+      throw e;
+    });
+  }
+  return cached;
+}
