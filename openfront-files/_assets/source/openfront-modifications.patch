+// Tests the loading screen in real Chrome by making the page's own app bundle slow,
+// broken, or broken once:
+//
+//   BASE=http://localhost:8787 npm run smoke:loading
+//
+// Screenshots go to .shots/ (git-ignored). Timings are shortened through
+// window.CF_LOADING (see scripts/loading-screen.ts).
+
+import fs from "node:fs";
+import path from "node:path";
+import { type Browser, chromium, type Page } from "playwright-core";
+import { standInIfBuiltForIt } from "./cdn-standin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const SHOTS =
+  process.env.SHOTS ?? path.resolve(import.meta.dirname, "../.shots");
+fs.mkdirSync(SHOTS, { recursive: true });
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail =
+    ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+async function until<T>(
+  fn: () => Promise<T | undefined>,
+  timeoutMs: number,
+): Promise<T | undefined> {
+  const end = Date.now() + timeoutMs;
+  for (;;) {
+    const v = await fn();
+    if (v !== undefined) return v;
+    if (Date.now() > end) return undefined;
+    await sleep(150);
+  }
+}
+
+interface Scenario {
+  name: string;
+  locale?: string;
+  /** window.CF_LOADING overrides. */
+  timings?: Record<string, number>;
+  /** What to do with requests for the app's /assets/*.js files. */
+  scripts?: "normal" | "delay" | "fail" | "failOnce";
+  delayMs?: number;
+  /** Hold the page's stylesheet back for this long (a stalled connection). */
+  cssDelayMs?: number;
+  /**
+   * What to do with the files the loader itself downloads (fetch requests for /assets/* and
+   * /_assets/*) that match preloadMatch: hold them back, fail them (always, or the first time),
+   * or answer the first request with half the file.
+   */
+  preload?: "normal" | "delay" | "fail" | "failOnce" | "short";
+  preloadMatch?: RegExp;
+  preloadDelayMs?: number;
+}
+
+/** Every request the page made, in order, for the checks that ask "was X fetched". */
+const requested: string[] = [];
+/** How many half-sized answers the "short" scenario has given. */
+let shortServed = 0;
+
+const saysOk = (s: { present?: boolean; message?: string } | undefined) =>
+  s?.present === true && /everything is ok/i.test(s.message ?? "");
+
+async function open(browser: Browser, s: Scenario): Promise<Page> {
+  // The service worker would answer the very requests these scenarios hold back or fail
+  // (it retries them, which is its job), so it is switched off here; smoke:flaky covers it.
+  const context = await browser.newContext({
+    viewport: { width: 1200, height: 800 },
+    locale: s.locale ?? "en-US",
+    serviceWorkers: "block",
+  });
+  if (s.timings) {
+    await context.addInitScript((t) => {
+      (window as unknown as { CF_LOADING: unknown }).CF_LOADING = t;
+    }, s.timings);
+  }
+  let blockedOnce = false;
+  await context.route(/\/assets\/[^/]+\.js(\?.*)?$/, async (route) => {
+    // Only the page's own <script> tags and imports; the loader's downloads are handled below.
+    if (route.request().resourceType() === "fetch") return route.fallback();
+    if (s.scripts === "fail") return route.abort("connectionreset");
+    if (s.scripts === "failOnce" && !blockedOnce) {
+      blockedOnce = true;
+      return route.abort("connectionreset");
+    }
+    if (s.scripts === "delay") await sleep(s.delayMs ?? 4000);
+    return route.continue();
+  });
+  if (s.cssDelayMs) {
+    await context.route(/\/assets\/[^/]+\.css(\?.*)?$/, async (route) => {
+      await sleep(s.cssDelayMs ?? 0);
+      return route.continue();
+    });
+  }
+  if (s.preload && s.preload !== "normal") {
+    const match = s.preloadMatch ?? /./;
+    let hit = 0;
+    await context.route(/\/_?assets\/[^?]+$/, async (route) => {
+      const req = route.request();
+      if (req.resourceType() !== "fetch" || !match.test(req.url())) return route.fallback();
+      hit += 1;
+      if (s.preload === "delay") {
+        await sleep(s.preloadDelayMs ?? 4000);
+        // The test may be over (page closed) by the time a long hold ends.
+        return route.continue().catch(() => undefined);
+      }
+      if (s.preload === "fail") return route.abort("connectionreset");
+      if (s.preload === "failOnce") {
+        return hit === 1 ? route.abort("connectionreset") : route.continue();
+      }
+      if (s.preload === "short" && hit === 1) {
+        const res = await route.fetch();
+        const whole = await res.body();
+        const half = whole.subarray(0, Math.floor(whole.length / 2));
+        shortServed += 1;
+        return route.fulfill({
+          response: res,
+          body: half,
+          headers: { ...res.headers(), "content-length": String(half.length) },
+        });
+      }
+      return route.continue();
+    });
+  }
+  const page = await context.newPage();
+  page.on("request", (r) => requested.push(r.url()));
+  await page.goto(BASE, { waitUntil: "commit", timeout: 60_000 });
+  return page;
+}
+
+const loaderState = (page: Page) =>
+  page
+    .evaluate(() => {
+      const el = document.getElementById("cf-loading");
+      if (!el) return { present: false } as const;
+      const r = el.getBoundingClientRect();
+      const failBox = document.getElementById("cf-fail");
+      // What the player can actually see: the element at the middle of the screen must
+      // be the loader (hit-testing skips anything hidden, including through a parent
+      // that is invisible, which a check on the element's own style would miss).
+      const mid = document.elementFromPoint(innerWidth / 2, innerHeight / 2);
+      return {
+        present: true,
+        visible:
+          r.width > 0 && r.height > 0 && mid !== null && el.contains(mid),
+        done: el.classList.contains("cf-done"),
+        failed: el.classList.contains("cf-failed"),
+        lang: el.getAttribute("lang"),
+        dir: el.getAttribute("dir"),
+        message: document.getElementById("cf-msg")?.textContent ?? "",
+        barShown: !!document.getElementById("cf-bar") && !document.getElementById("cf-bar")!.hidden,
+        pct: Number(document.getElementById("cf-bar")?.getAttribute("aria-valuenow") ?? "-1"),
+        detail: document.getElementById("cf-detail")?.textContent ?? "",
+        failTitle:
+          failBox && !failBox.hidden
+            ? document.getElementById("cf-fail-title")?.textContent
+            : null,
+        buttonShown: !!failBox && !failBox.hidden,
+      } as const;
+    })
+    .catch(() => undefined);
+
+const CREDIT_URL = "https://hatami-mahdi.ir/";
+
+/** The link to the host's site: what it says, where it goes, and whether a click would reach it. */
+const creditState = (page: Page) =>
+  page
+    .evaluate(() => {
+      const a = document.getElementById("cf-credit") as HTMLAnchorElement | null;
+      if (!a) return undefined;
+      const r = a.getBoundingClientRect();
+      const hit = document.elementFromPoint(r.left + r.width / 2, r.top + r.height / 2);
+      return {
+        href: a.getAttribute("href"),
+        target: a.target,
+        rel: a.rel,
+        text: a.textContent ?? "",
+        lead: document.getElementById("cf-credit-lead")?.textContent ?? "",
+        clickable: r.width > 0 && r.height > 0 && hit !== null && a.contains(hit),
+        inView: r.top >= 0 && r.bottom <= innerHeight && r.left >= 0 && r.right <= innerWidth,
+      };
+    })
+    .catch(() => undefined);
+
+const appStarted = (page: Page) =>
+  page.evaluate(() => !!customElements.get("play-page")).catch(() => false);
+
+async function main(): Promise<void> {
+  console.log(`loading-screen test against ${BASE}`);
+  // A page built with a localhost CDN_BASE needs its files served from there.
+  const cdn = await standInIfBuiltForIt();
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  try {
+    // 1. A slow app: the loader is there first, says so, and goes away when the app starts.
+    {
+      const page = await open(browser, {
+        name: "slow",
+        scripts: "delay",
+        delayMs: 7000,
+        timings: { slowMs: 2000, retryMs: 60000, okMs: 1200, leaveMs: 1400 },
+      });
+      const early = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.visible ? s : undefined;
+      }, 3000);
+      check(
+        early !== undefined,
+        "the loading screen is on screen before the app has loaded",
+      );
+      check(
+        !(await appStarted(page)),
+        "...while the app bundle is still on its way",
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-1-first.png") });
+
+      // The link to the host's site is there, points at it, can be clicked, and opens it in
+      // a new tab so the game keeps loading here.
+      const credit = await creditState(page);
+      check(
+        credit?.href === CREDIT_URL && /hatami-mahdi\.ir/.test(credit.text),
+        "the loading screen links to the host's site",
+        credit,
+      );
+      check(
+        credit?.clickable === true && credit.inView === true,
+        "...and the link is on screen where a click lands on it",
+        credit,
+      );
+      check(
+        credit?.target === "_blank" && /noopener/.test(credit.rel),
+        "...opening in a new tab without access to this one",
+        credit,
+      );
+      const ctx = page.context();
+      await ctx.route("https://hatami-mahdi.ir/**", (route) =>
+        route.fulfill({
+          status: 200,
+          contentType: "text/html",
+          body: "<title>host</title>ok",
+        }),
+      );
+      const [popup] = await Promise.all([
+        ctx.waitForEvent("page", { timeout: 8000 }),
+        page.click("#cf-credit"),
+      ]);
+      await popup.waitForLoadState("domcontentloaded").catch(() => undefined);
+      check(popup.url() === CREDIT_URL, "clicking it opens the host's site", popup.url());
+      const stillHere = await loaderState(page);
+      check(
+        page.url().startsWith(BASE) && stillHere?.present === true,
+        "...while this tab stays on the game with its loader",
+        [page.url(), stillHere?.present],
+      );
+      await popup.close();
+      // Slow means nothing has arrived for slowMs (2 s here): the files are in, the app is not.
+      const slow = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && /slow/i.test(s.message) ? s : undefined;
+      }, 4500);
+      check(
+        slow !== undefined,
+        "it says so when nothing has arrived for a while",
+        slow?.message,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-2-slow.png") });
+      // Once the app is up it says so, holds that, then opens onto the home page.
+      const ok = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && /everything is ok/i.test(s.message) ? s : undefined;
+      }, 20_000);
+      check(ok !== undefined, "once the app has started it says everything is OK", ok?.message);
+      check(
+        ok?.barShown === true && ok.pct === 100 && /^100|١٠٠|۱۰۰/.test(ok.detail),
+        "...with the bar full, showing 100%",
+        [ok?.barShown, ok?.pct, ok?.detail],
+      );
+      check(
+        ok?.visible === true,
+        "...and that is still on screen (the loader waits before leaving)",
+      );
+      const art = await page.evaluate(() => {
+        const el = document.getElementById("cf-loading");
+        return {
+          on: !!el?.classList.contains("cf-bg-on"),
+          bg: el?.style.getPropertyValue("--cf-bg") ?? "",
+        };
+      });
+      check(
+        art.on && /\/art\/loading-wide\.[0-9a-f]+\.webp/.test(art.bg),
+        "the loading screen shows its backdrop picture",
+        art,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-2b-ok.png") });
+      const leaving = await until(async () => {
+        const s = await page
+          .evaluate(() => ({
+            leaving: !!document.getElementById("cf-loading")?.classList.contains("cf-leaving"),
+            reveal: document.documentElement.classList.contains("cf-reveal"),
+          }))
+          .catch(() => undefined);
+        return s?.leaving ? s : undefined;
+      }, 8000);
+      check(
+        leaving?.reveal === true,
+        "it then opens (cf-leaving) and the home page's picture starts to settle in (cf-reveal)",
+        leaving,
+      );
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 20_000);
+      check(gone === true, "and it disappears when the animation is over");
+      const home = await page.evaluate(() => {
+        const l = document.getElementById("background-layer");
+        return l ? getComputedStyle(l).backgroundImage : "";
+      });
+      check(
+        /\/art\/home-wide\.[0-9a-f]+\.webp/.test(home),
+        "the home page has the new picture behind it",
+        home.slice(0, 120),
+      );
+      check(await appStarted(page), "and the app is running underneath");
+      const kids = await page.evaluate(
+        () => document.querySelector("play-page")?.children.length ?? 0,
+      );
+      check(kids > 0, "the home page is rendered behind it", kids);
+      await page.screenshot({ path: path.join(SHOTS, "loading-3-app.png") });
+      await page.context().close();
+    }
+
+    // 2. A script that fails once: the loader retries by itself and the page then loads.
+    {
+      const page = await open(browser, {
+        name: "failOnce",
+        scripts: "failOnce",
+        timings: { failedRetryMs: 400, retryMs: 60000 },
+      });
+      const retrying = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && /trying again|retry/i.test(s.message)
+          ? s
+          : undefined;
+      }, 6000);
+      check(
+        retrying !== undefined,
+        "after a failed script it says it is trying again",
+        retrying?.message,
+      );
+      const started = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        25_000,
+      );
+      check(
+        started === true,
+        "the automatic reload succeeded and the app started",
+      );
+      await page.context().close();
+    }
+
+    // 3. A script that always fails: after the retries it gives up with a message and a button.
+    {
+      const page = await open(browser, {
+        name: "fail",
+        scripts: "fail",
+        timings: { failedRetryMs: 300, retryMs: 60000, maxRetries: 2 },
+      });
+      const gaveUp = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.failed ? s : undefined;
+      }, 30_000);
+      check(
+        gaveUp !== undefined,
+        "after the retries it stops and says the game could not load",
+      );
+      check(
+        gaveUp?.buttonShown === true,
+        "with a Reload button",
+        gaveUp?.failTitle,
+      );
+      const failCredit = await creditState(page);
+      check(
+        failCredit?.href === CREDIT_URL && failCredit.clickable === true,
+        "the link to the host's site is still there when loading has failed",
+        failCredit,
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-4-failed.png") });
+      await page.context().close();
+    }
+
+    // 4. A Persian browser gets Persian, right to left.
+    {
+      const page = await open(browser, {
+        name: "fa",
+        locale: "fa-IR",
+        scripts: "fail",
+        timings: { failedRetryMs: 300, retryMs: 60000, maxRetries: 0 },
+      });
+      const fa = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.failed ? s : undefined;
+      }, 15_000);
+      check(
+        fa?.lang === "fa" && fa?.dir === "rtl",
+        "a Persian browser gets lang=fa, dir=rtl",
+        [fa?.lang, fa?.dir],
+      );
+      check(
+        /[\u0600-\u06FF]/.test(fa?.failTitle ?? ""),
+        "and the text is Persian",
+        fa?.failTitle,
+      );
+      const faCredit = await creditState(page);
+      check(
+        /[؀-ۿ]/.test(faCredit?.lead ?? "") && faCredit?.href === CREDIT_URL,
+        "and so is the link's caption",
+        faCredit?.lead,
+      );
+      await page.screenshot({
+        path: path.join(SHOTS, "loading-5-persian.png"),
+      });
+      await page.context().close();
+    }
+
+    // 5a. A stalled stylesheet: the page's inline scripts cannot run until it arrives, so a
+    //     loader placed after it stays dead for as long as the stall lasts (a blank page).
+    //     The loader sits at the very start of <head> and must be on screen at once.
+    {
+      const page = await open(browser, {
+        name: "cssStuck",
+        cssDelayMs: 9000,
+        timings: { slowMs: 2000, retryMs: 120000 },
+      });
+      const early = await until(async () => {
+        const s = await loaderState(page);
+        return s?.present && s.visible ? s : undefined;
+      }, 2500);
+      check(
+        early !== undefined,
+        "the loading screen is on screen while the stylesheet is still stuck",
+      );
+      check(
+        !(await appStarted(page)),
+        "...with the app not started yet",
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-6-css-stuck.png") });
+      const started = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        40_000,
+      );
+      check(started === true, "when the stylesheet finally arrives the app starts");
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 10_000);
+      check(gone === true, "and the loading screen leaves");
+      await page.context().close();
+    }
+
+    // 5b. No ads, trackers or anti-adblock: the page contacts only itself and Turnstile.
+    {
+      const context = await browser.newContext({
+        viewport: { width: 1200, height: 800 },
+        serviceWorkers: "block",
+      });
+      // A page built for localhost looks for its API on port 8787 unless told where it is
+      // (getApiBase in the client reads this key); BASE may be any port.
+      await context.addInitScript(
+        `try { localStorage.setItem("apiHost", ${JSON.stringify(BASE)}); } catch (e) {}`,
+      );
+      const page = await context.newPage();
+      const hosts = new Map<string, string>();
+      page.on("request", (r) => {
+        try {
+          const u = new URL(r.url());
+          if (u.protocol === "http:" || u.protocol === "https:")
+            hosts.set(u.host, u.pathname.slice(0, 40));
+        } catch {
+          /* data: / blob: URLs */
+        }
+      });
+      await page.goto(BASE, { waitUntil: "commit", timeout: 60_000 });
+      const up = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        40_000,
+      );
+      check(up === true, "the page starts (no third-party code needed)");
+      await sleep(5000); // late loaders (ad tags start after the app does) would show now
+      const own = new URL(BASE).host;
+      // When the site is built with CDN_BASE its own files come from that host.
+      const cdnBase = await page
+        .evaluate(
+          () =>
+            (window as unknown as { BOOTSTRAP_CONFIG?: { cdnBase?: string } })
+              .BOOTSTRAP_CONFIG?.cdnBase ?? "",
+        )
+        .catch(() => "");
+      const cdnHost = cdnBase ? new URL(cdnBase).host : null;
+      const foreign = [...hosts.entries()].filter(
+        ([h]) => h !== own && h !== "challenges.cloudflare.com" && h !== cdnHost,
+      );
+      check(
+        foreign.length === 0,
+        "it contacts no host except its own" +
+          (cdnHost ? `, its CDN (${cdnHost})` : "") +
+          " and Cloudflare Turnstile",
+        foreign,
+      );
+      const ads = await page.evaluate(
+        () => (window as unknown as { adsEnabled?: boolean }).adsEnabled,
+      );
+      check(ads === false, "ads are switched off for the client", ads);
+      await context.close();
+    }
+
+    // 5. A normal fast load: no stuck loader, no leftover retry state.
+    {
+      const page = await open(browser, { name: "normal", scripts: "normal" });
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 30_000);
+      check(gone === true, "on a normal load the loader leaves by itself");
+      const tries = await page.evaluate(() =>
+        sessionStorage.getItem("cf-load-tries"),
+      );
+      check(tries === null, "and leaves no retry counter behind", tries);
+      await page.context().close();
+    }
+
+    // 6. What the bar is for. The app starts, but one file the game needs is still on its way:
+    //    the loader must not say everything is OK (it used to, the moment the app started), it
+    //    must show what has really arrived, and it must not wait for any map.
+    {
+      requested.length = 0;
+      const page = await open(browser, {
+        name: "heldFile",
+        preload: "delay",
+        preloadMatch: /Worker\.worker-/,
+        preloadDelayMs: 9000,
+        timings: { okMs: 600, leaveMs: 600, slowMs: 60000, retryMs: 120000, stallMs: 60000 },
+      });
+      const up = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        20_000,
+      );
+      check(up === true, "the app itself starts while one needed file is still held back");
+      await sleep(2500);
+      const mid = await loaderState(page);
+      check(
+        mid?.present === true && mid.visible === true && !saysOk(mid),
+        "...and the loader does NOT say everything is OK: it stays on screen",
+        mid?.message,
+      );
+      check(
+        mid?.barShown === true &&
+          mid.pct > 0 &&
+          mid.pct < 100 &&
+          /^\d+% · [\d.]+ of [\d.]+ MB$/.test(mid.detail),
+        "...with a bar and the real amount that has arrived",
+        [mid?.pct, mid?.detail],
+      );
+      await page.screenshot({ path: path.join(SHOTS, "loading-7-waiting-for-a-file.png") });
+      const ok = await until(async () => {
+        const s = await loaderState(page);
+        return saysOk(s) ? s : undefined;
+      }, 25_000);
+      check(ok !== undefined, "once the held file has arrived it says everything is OK", ok?.message);
+      check(ok?.pct === 100, "...with the bar full", ok?.pct);
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 15_000);
+      check(gone === true, "...and then opens onto the home page");
+      // The home page itself reads each map's small manifest.json for the map list; what must
+      // not happen is a map's data (the .bin files) being downloaded, or one being in the list.
+      const mapData = requested.filter((u) => /\/_assets\/maps\/.*\.bin(\?|$)/.test(u));
+      check(mapData.length === 0, "no map data file was downloaded: maps are not waited for", mapData.slice(0, 3));
+      const inList = await page.evaluate(
+        () =>
+          ((window as unknown as { CF_PRELOAD?: { files: string[][] } }).CF_PRELOAD?.files ?? []).filter(
+            (f) => /maps/.test(f[0] ?? ""),
+          ).length,
+      );
+      check(inList === 0, "...and there is no map in the list the loader waits for", inList);
+      await page.context().close();
+    }
+
+    // 7. A download that ends early (the connection cut it short) is not accepted as done.
+    {
+      requested.length = 0;
+      shortServed = 0;
+      const atlas = /msdf-atlas\.[0-9a-f]+\.png/;
+      const page = await open(browser, {
+        name: "short",
+        preload: "short",
+        preloadMatch: atlas,
+        timings: { okMs: 600, leaveMs: 600 },
+      });
+      const ok = await until(async () => {
+        const s = await loaderState(page);
+        return saysOk(s) ? s : undefined;
+      }, 30_000);
+      check(shortServed === 1, "one file was answered with only half of its bytes", shortServed);
+      check(ok !== undefined, "...it was fetched again, and then the loader says everything is OK");
+      check(
+        requested.filter((u) => atlas.test(u)).length >= 2,
+        "...so that file was requested at least twice",
+      );
+      const tries = await page.evaluate(() => sessionStorage.getItem("cf-load-tries")).catch(() => null);
+      check(tries === null, "...without having to reload the page", tries);
+      await page.context().close();
+    }
+
+    // 8. A file that cannot be had at all is skipped, not fatal: no reload, no failure panel. The
+    //    player is let in, and the loader does not claim that everything is OK.
+    {
+      const page = await open(browser, {
+        name: "missing",
+        preload: "fail",
+        preloadMatch: /unit-atlas\.[0-9a-f]+\.png/,
+        timings: { fileTries: 2, retryMs: 120000, okMs: 600, leaveMs: 600 },
+      });
+      let claimedOk = false;
+      let sawPanel = false;
+      const partial = await until(async () => {
+        const s = await loaderState(page);
+        if (saysOk(s)) claimedOk = true;
+        if (s?.failed) sawPanel = true;
+        return s?.present && /^ready/i.test(s.message) ? s : undefined;
+      }, 40_000);
+      check(
+        partial !== undefined,
+        "a file that never arrives is skipped and the loader says it is ready, with the rest loading on",
+        partial?.message,
+      );
+      check(!claimedOk, "...it never said everything is OK");
+      check(!sawPanel, "...and never showed the failure panel");
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 15_000);
+      check(gone === true, "...and it opens onto the home page");
+      const tries = await page.evaluate(() => sessionStorage.getItem("cf-load-tries")).catch(() => null);
+      check(tries === null, "...without reloading the page", tries);
+      await page.screenshot({ path: path.join(SHOTS, "loading-8-file-missing.png") });
+      await page.context().close();
+    }
+
+    // 9. A file that is simply too slow: once the app is up the loader waits at most waitMs, then
+    //    lets the player in, saying so, while that file is still on its way.
+    {
+      const page = await open(browser, {
+        name: "tooSlow",
+        preload: "delay",
+        preloadMatch: /Worker\.worker-/,
+        preloadDelayMs: 25_000,
+        timings: { waitMs: 3000, stallMs: 120_000, okMs: 600, leaveMs: 600, slowMs: 60000, retryMs: 120000 },
+      });
+      const up = await until(
+        async () => ((await appStarted(page)) ? true : undefined),
+        20_000,
+      );
+      check(up === true, "the app starts while one file is far too slow");
+      let claimedOk = false;
+      const partial = await until(async () => {
+        const s = await loaderState(page);
+        if (saysOk(s)) claimedOk = true;
+        return s?.present && /^ready/i.test(s.message) ? s : undefined;
+      }, 15_000);
+      check(
+        partial !== undefined && partial.pct < 100,
+        "after waitMs it says it is ready while that file is still coming (bar below 100%)",
+        [partial?.message, partial?.pct],
+      );
+      check(!claimedOk, "...without ever saying everything is OK");
+      const gone = await until(async () => {
+        const s = await loaderState(page);
+        return s && !s.present ? true : undefined;
+      }, 10_000);
+      check(gone === true, "...and it opens onto the home page");
+      const kids = await page.evaluate(
+        () => document.querySelector("play-page")?.children.length ?? 0,
+      );
+      check(kids > 0, "...with the home page ready to use", kids);
+      await page.context().close();
+    }
+  } finally {
+    await browser.close();
+    await cdn?.close();
+  }
+  console.log(`\nscreenshots: ${SHOTS}`);
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nLOADING TEST FAILED" : "\nLOADING TEST PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nLOADING TEST ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
diff --git a/cloudflare/scripts/pages-repo.ts b/cloudflare/scripts/pages-repo.ts
new file mode 100644
index 0000000..88e1fe0
--- /dev/null
+++ b/cloudflare/scripts/pages-repo.ts
@@ -0,0 +1,228 @@
+// Stages the site's files for GitHub Pages: one commit, on top of the repository's current
+// Pages branch, that adds a folder holding static/assets and static/_assets.
+//
+//   npm run build:site                       # first: the files to publish
+//   npm run cdn:pages                        # then this: prints the push command and CDN_BASE
+//
+// Why this shape: a repository publishes ONE branch to Pages, and here that branch (`main` of
+// MahdiHatami-cpu/mahdi-website) already serves the owner's own pages. So the files go into a
+// subfolder of it and nothing else of the site changes, apart from an empty `.nojekyll` at the
+// root. That file is required: without it Pages runs Jekyll, which silently drops every folder
+// whose name starts with an underscore, and the game's `_assets/` would 404.
+//
+// The commit is made in a git worktree of the existing asset clone (ASSET_REPO_DIR), so git
+// already knows which blobs GitHub has (the earlier `openfront-files` branch) and a push sends
+// only what is new. Pushing is left to the owner: it needs their GitHub credentials.
+//
+// GitHub Pages limits (docs): a published site up to 1 GB, files up to 100 MB, ~100 GB/month.
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const staticDir = path.resolve(here, "../../static");
+// An existing clone of the Pages repository (any branch): the object store the worktree shares.
+const repoDir = path.resolve(
+  here,
+  "..",
+  process.env.ASSET_REPO_DIR ?? "../openfront-assets",
+);
+// Where the commit is prepared and pushed from: a sibling of the game's repository, outside it on
+// purpose, so a stray `git add -A` in the game's repository can never pick it up.
+const pagesDir = path.resolve(
+  here,
+  "..",
+  process.env.PAGES_DIR ?? "../../openfront-pages",
+);
+const slug = process.env.PAGES_SLUG ?? "MahdiHatami-cpu/mahdi-website"; // "<user>/<repo>"
+const branch = process.env.PAGES_BRANCH ?? "main"; // the branch Pages publishes
+const folder = process.env.PAGES_FOLDER ?? "openfront-files";
+const FILE_LIMIT = 100 * 1024 * 1024;
+const SITE_LIMIT = 1024 * 1024 * 1024;
+const PUBLISHED = ["assets", "_assets"];
+
+if (!/^[\w.-]+\/[\w.-]+$/.test(slug))
+  throw new Error(`PAGES_SLUG must be <user>/<repo>, got ${slug}`);
+if (!/^[\w.-]+$/.test(folder))
+  throw new Error(`PAGES_FOLDER must be a plain folder name, got ${folder}`);
+const [owner, repo] = slug.split("/");
+const remoteUrl = `https://github.com/${slug}.git`;
+
+function git(args: string[], cwd: string): string {
+  // HTTP/1.1: HTTP/2 transfers stall on some networks (see the README).
+  return execFileSync("git", ["-c", "http.version=HTTP/1.1", ...args], {
+    cwd,
+    encoding: "utf8",
+  }).trim();
+}
+
+function walk(dir: string, base = dir): string[] {
+  if (!fs.existsSync(dir)) return [];
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name);
+    return e.isDirectory()
+      ? walk(full, base)
+      : [path.relative(base, full).split(path.sep).join("/")];
+  });
+}
+
+const buildId = fs
+  .readFileSync(path.join(staticDir, "commit.txt"), "utf8")
+  .trim();
+if (!buildId)
+  throw new Error("static/commit.txt is empty; run build:site first");
+if (!fs.existsSync(path.join(repoDir, ".git"))) {
+  throw new Error(
+    `${repoDir} is not a git clone; set ASSET_REPO_DIR to a clone of ${remoteUrl}`,
+  );
+}
+
+// The branch as GitHub has it now. The commit is built on this tip, so the owner's push is a plain
+// fast-forward and is refused (not forced) if the branch moved in the meantime.
+const tracking = `refs/remotes/pages-${branch}`;
+for (let attempt = 1; ; attempt++) {
+  try {
+    git(
+      ["fetch", "-q", remoteUrl, `+refs/heads/${branch}:${tracking}`],
+      repoDir,
+    );
+    break;
+  } catch (e) {
+    // github.com is not always reachable from every network; a retry usually gets through.
+    if (attempt >= 4) throw e;
+    console.log(
+      `fetch from ${remoteUrl} failed (attempt ${attempt}/4), trying again`,
+    );
+  }
+}
+const base = git(["rev-parse", tracking], repoDir);
+
+// A fresh worktree at that tip. pagesDir is this script's own scratch folder, so it is replaced.
+if (fs.existsSync(pagesDir)) {
+  if (!fs.existsSync(path.join(pagesDir, ".git"))) {
+    throw new Error(
+      `${pagesDir} exists and is not a worktree this script made; move it away first`,
+    );
+  }
+  git(["worktree", "remove", "--force", pagesDir], repoDir);
+}
+git(["worktree", "prune"], repoDir);
+git(["worktree", "add", "-q", "--detach", pagesDir, base], repoDir);
+
+// Mirror static/assets and static/_assets into <folder>/.
+const out = path.join(pagesDir, folder);
+// Additive by default. The page that is live right now still names the previous build's files,
+// and they must keep working until the Worker is redeployed with the new page; every name
+// carries a content hash, so old and new files never clash. PAGES_PRUNE=1 mirrors instead
+// (deletes what static/ no longer has), for a clean-up once nothing live uses the old files.
+if (process.env.PAGES_PRUNE === "1")
+  fs.rmSync(out, { recursive: true, force: true });
+let files = 0;
+let bytes = 0;
+const tooBig: string[] = [];
+for (const top of PUBLISHED) {
+  const src = path.join(staticDir, top);
+  for (const rel of walk(src)) {
+    const from = path.join(src, rel);
+    const size = fs.statSync(from).size;
+    if (size > FILE_LIMIT)
+      tooBig.push(`${top}/${rel} (${(size / 1048576).toFixed(1)} MB)`);
+    const to = path.join(out, top, rel);
+    fs.mkdirSync(path.dirname(to), { recursive: true });
+    fs.copyFileSync(from, to);
+    files++;
+    bytes += size;
+  }
+}
+if (files === 0)
+  throw new Error("static/ has no assets/ or _assets/; run build:site first");
+if (tooBig.length)
+  throw new Error(
+    `GitHub Pages serves files up to 100 MB; too big:\n  ${tooBig.join("\n  ")}`,
+  );
+
+fs.writeFileSync(
+  path.join(out, "README.md"),
+  [
+    "# OpenFront site files",
+    "",
+    "The static files (`assets/`, `_assets/`) of an OpenFront deployment, published through GitHub",
+    "Pages so the game's page can load them. Every file name carries a content hash; nothing here",
+    "is edited by hand. Generated by `cloudflare/scripts/pages-repo.ts` in the game's repository.",
+    "",
+    `Last build: \`${buildId}\``,
+    "",
+  ].join("\n"),
+);
+fs.writeFileSync(path.join(out, ".gitattributes"), "* -text\n"); // bytes as they are
+const noJekyll = path.join(pagesDir, ".nojekyll");
+const addedNoJekyll = !fs.existsSync(noJekyll);
+if (addedNoJekyll) fs.writeFileSync(noJekyll, "");
+
+const siteBytes = walk(pagesDir)
+  .filter((f) => !f.startsWith(".git/"))
+  .reduce((n, f) => n + fs.statSync(path.join(pagesDir, f)).size, 0);
+if (siteBytes > SITE_LIMIT) {
+  throw new Error(
+    `GitHub Pages sites are limited to 1 GB; this one would be ${(siteBytes / 1048576).toFixed(0)} MB. Lower MAP_BUDGET_MB.`,
+  );
+}
+
+git(["add", "-A"], pagesDir);
+const dirty = git(["status", "--porcelain"], pagesDir).length > 0;
+if (dirty) {
+  git(
+    [
+      "-c",
+      "user.name=openfront-build",
+      "-c",
+      "user.email=build@localhost",
+      "commit",
+      "-q",
+      "-m",
+      `Add OpenFront site files (build ${buildId})`,
+    ],
+    pagesDir,
+  );
+}
+const sha = git(["rev-parse", "HEAD"], pagesDir);
+const changed = git(
+  ["diff", "--stat", "--stat-width=100", `${base}`, sha],
+  pagesDir,
+)
+  .split("\n")
+  .pop();
+// Anything outside <folder>/ and .nojekyll that the commit touches would be a bug in this script.
+// (quotePath off: git otherwise wraps non-ASCII names, like the flags', in quotes.)
+const outside = git(
+  ["-c", "core.quotePath=false", "diff", "--name-only", base, sha],
+  pagesDir,
+)
+  .split("\n")
+  .filter((f) => f && !f.startsWith(`${folder}/`) && f !== ".nojekyll");
+if (outside.length)
+  throw new Error(
+    `the commit touches files outside ${folder}/: ${outside.join(", ")}`,
+  );
+
+const cdnBase = `https://${owner.toLowerCase()}.github.io/${repo}/${folder}`;
+console.log(`\nGitHub Pages commit prepared in ${pagesDir}`);
+console.log(
+  `  built on : ${base.slice(0, 10)} (${branch} as GitHub has it now)`,
+);
+console.log(
+  `  files    : ${files} (${(bytes / 1048576).toFixed(0)} MB) in ${folder}/${addedNoJekyll ? " + an empty .nojekyll at the root" : ""}`,
+);
+console.log(
+  `  site size: ${(siteBytes / 1048576).toFixed(0)} MB of the 1 GB limit`,
+);
+console.log(`  commit   : ${sha}${dirty ? "" : " (nothing new)"}`);
+console.log(`  diff     : ${changed}`);
+console.log(`  CDN_BASE : ${cdnBase}`);
+console.log(
+  `\nnext:\n  cd ${pagesDir}\n  git push ${remoteUrl} HEAD:refs/heads/${branch}\n` +
+    `  wait for the Pages build (Settings > Pages, or poll ${cdnBase}/${PUBLISHED[0]}/...)\n` +
+    `  then in cloudflare/:\n  CDN_BASE=${cdnBase} SITE_HOST=<host> npm run build:site -- --skip-vite`,
+);
diff --git a/cloudflare/scripts/preload-list.ts b/cloudflare/scripts/preload-list.ts
new file mode 100644
index 0000000..629a383
--- /dev/null
+++ b/cloudflare/scripts/preload-list.ts
@@ -0,0 +1,76 @@
+// The files the loading screen downloads before it lets the player in: everything the game
+// needs to open and to start a match, except the maps.
+//
+// Made from the built site, so it cannot drift from what is really there:
+//   - every script, stylesheet and font in assets/ (the game client, the modals, the simulation
+//     worker are separate chunks that load on demand, so without this the first click on Solo
+//     would wait for them);
+//   - the atlases, sprites, fonts and icons in _assets/ (what the renderer draws with);
+//   - the English and Persian language files;
+//   - the home page's picture for the screen shape in use (tagged "w" wide / "t" tall; the
+//     loading screen skips the other one).
+// Left out on purpose: the maps (a match fetches the one it plays), flags and sounds (loaded
+// one by one when used), the other pictures, and anything the page already requests itself
+// (the entry bundle and the stylesheet, which the browser's own load event covers).
+
+import fs from "node:fs";
+import path from "node:path";
+
+/** [path from the site root, size in bytes, optional "w" | "t"], and where they are served. */
+export interface Preload {
+  base: string;
+  files: Array<[string, number] | [string, number, "w" | "t"]>;
+}
+
+const CODE_EXT = /\.(js|css|woff2?)$/;
+const ASSET_DIRS = ["atlases", "sprites", "fonts", "icons"];
+const ASSET_EXT = /\.(png|webp|json|xml|ttf|woff2?|svg)$/;
+const LANGUAGES = /^(en|fa)\.[0-9a-f]+\.json$/;
+
+function list(dir: string): string[] {
+  try {
+    return fs.readdirSync(dir).sort();
+  } catch {
+    return [];
+  }
+}
+
+export function buildPreload(
+  staticDir: string,
+  cdnBase: string,
+  pageHtml: string,
+): Preload {
+  const files: Preload["files"] = [];
+  // What the page's own tags request (the entry script, the stylesheet, modulepreloads): the
+  // browser's load event covers those. Only src/href attributes count: the page also carries the
+  // whole asset manifest as data, which names files it never requests by itself.
+  const byPage = [...pageHtml.matchAll(/\b(?:src|href)=["']([^"'#?]+)/g)].map(
+    (m) => m[1],
+  );
+  const add = (rel: string, tag?: "w" | "t") => {
+    if (byPage.some((u) => u.endsWith(`/${rel}`))) return;
+    const size = fs.statSync(path.join(staticDir, rel)).size;
+    files.push(tag ? [`/${rel}`, size, tag] : [`/${rel}`, size]);
+  };
+
+  for (const f of list(path.join(staticDir, "assets"))) {
+    // The replay worker is only used to watch a replay; it loads when one is opened.
+    if (CODE_EXT.test(f) && !/^ReplayProcessor\.worker-/.test(f)) add(`assets/${f}`);
+  }
+  for (const dir of ASSET_DIRS) {
+    for (const f of list(path.join(staticDir, "_assets", dir))) {
+      if (ASSET_EXT.test(f)) add(`_assets/${dir}/${f}`);
+    }
+  }
+  for (const f of list(path.join(staticDir, "_assets", "lang"))) {
+    if (LANGUAGES.test(f)) add(`_assets/lang/${f}`);
+  }
+  for (const f of list(path.join(staticDir, "_assets", "art"))) {
+    if (/^home-wide\./.test(f)) add(`_assets/art/${f}`, "w");
+    else if (/^home-tall\./.test(f)) add(`_assets/art/${f}`, "t");
+  }
+
+  // The biggest first: a big file that has to be tried again should not be the last one left.
+  files.sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1));
+  return { base: cdnBase, files };
+}
diff --git a/cloudflare/scripts/release-smoke.ts b/cloudflare/scripts/release-smoke.ts
new file mode 100644
index 0000000..9a999da
--- /dev/null
+++ b/cloudflare/scripts/release-smoke.ts
@@ -0,0 +1,283 @@
+// Drives the BUILT site (static/) in real Chrome against a local copy of the Worker with a fresh
+// database, so a release can be checked before it goes live.
+//
+//   npm run build:site        # the release (CDN_BASE build: its files are fetched from the CDN)
+//   npm run smoke:release
+//
+// Checks what a visitor sees: Persian by default (whatever the browser says), the Vazirmatn font
+// really loading, no raw translation keys on the home page, the licence notice and its page, the
+// switch to English, the leaderboard screen filled from the database, and a Solo game on Iran.
+// Pictures from the CDN and the game's files are fetched for real, so this needs the internet.
+
+import path from "node:path";
+import { chromium } from "playwright-core";
+import { UPSERT_RESULT_SQL } from "../src/db";
+import { playerKey } from "../src/leaderboard";
+import { BASE, d1Execute, withTestWorker } from "./accounts-harness";
+
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const OUT = process.env.SHOTS ?? path.join(process.cwd(), ".build");
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  console.log(
+    `${ok ? "  ok  " : " FAIL "} ${label}${ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`}`,
+  );
+  if (!ok) failed = true;
+}
+
+// Node reaches "localhost" over IPv6 first; the local Worker listens on IPv4 only.
+const API = BASE.replace("localhost", "127.0.0.1");
+
+const ok = await withTestWorker(async () => {
+  // Three players with wins, written by the production statement.
+  const now = Date.now();
+  for (const [id, name, wins] of [
+    ["a", "Reza", 5],
+    ["b", "Sara", 3],
+    ["c", "Ali", 1],
+  ] as const) {
+    const key = await playerKey(`seed-${id}`);
+    for (let g = 0; g < 6; g++) {
+      d1Execute(
+        UPSERT_RESULT_SQL.replace("?1", `'${key}'`)
+          .replace("?2", `'${name}'`)
+          .replace("?3", g < wins ? "1" : "0")
+          .replace("?4", String(now + g)),
+      );
+    }
+  }
+
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox"],
+  });
+  const page = await (
+    await browser.newContext({
+      viewport: { width: 1280, height: 900 },
+      locale: "en-US",
+    })
+  ).newPage();
+  const failedRequests: string[] = [];
+  const iranFiles = new Set<string>();
+  page.on("requestfailed", (r) =>
+    failedRequests.push(`${r.failure()?.errorText} ${r.url().slice(0, 100)}`),
+  );
+  page.on("request", (r) => {
+    if (r.url().includes("/maps/iran/"))
+      iranFiles.add(r.url().split("/").pop() ?? "");
+  });
+  try {
+    await page.goto(BASE, { waitUntil: "commit", timeout: 300_000 });
+    await page.waitForFunction(
+      () =>
+        !!customElements.get("play-page") &&
+        !document.getElementById("cf-loading"),
+      null,
+      { timeout: 300_000 },
+    );
+    await sleep(20_000); // the Persian file and the lazy parts arrive
+
+    console.log("Persian by default");
+    const home = await page.evaluate(async () => {
+      await document.fonts.ready;
+      const el = [...document.querySelectorAll("button, a, span, div")].find(
+        (e) =>
+          /[\u0600-\u06FF]/.test(
+            e.childNodes.length === 1 && e.firstChild?.nodeType === 3
+              ? (e.textContent ?? "")
+              : "",
+          ),
+      );
+      return {
+        text: document.body.innerText.replace(/\s+/g, " "),
+        footer:
+          document
+            .querySelector("page-footer")
+            ?.textContent?.replace(/\s+/g, " ")
+            .trim() ?? "",
+        faces: [...document.fonts]
+          .filter((f) => f.family.includes("Vazirmatn"))
+          .map((f) => f.status),
+        family: el ? getComputedStyle(el).fontFamily : "",
+        title: document.title,
+      };
+    });
+    check(
+      /[\u0600-\u06FF]/.test(home.text),
+      "the home page is in Persian although the browser asks for English",
+    );
+    const rawKeys =
+      home.text.match(
+        /\b(?:main|news_box|mode_selector|username|game_mode|win_modal|leaderboard_modal|user_setting|help_modal|game_settings|map)\.[a-z0-9_]+/gi,
+      ) ?? [];
+    check(
+      rawKeys.length === 0,
+      "no raw translation keys on the page",
+      rawKeys.slice(0, 5),
+    );
+    check(
+      home.family.startsWith("Vazirmatn"),
+      "Persian text asks for Vazirmatn first",
+      home.family.slice(0, 60),
+    );
+    check(
+      home.faces.length > 0 && home.faces.every((s) => s === "loaded"),
+      "the Vazirmatn font file loaded (not 'error')",
+      home.faces,
+    );
+    check(
+      /Based on OpenFront \(AGPL-3\.0\)\s*·\s*source/.test(home.footer),
+      "the footer carries the licence notice",
+      home.footer,
+    );
+    check(
+      /Hosted and edited by hatami-mahdi\.ir/.test(home.footer),
+      "...and the hosted-by line",
+    );
+    await page.screenshot({ path: path.join(OUT, "release-persian.png") });
+
+    console.log("the source page");
+    const src = await page.request.get(`${API}/source`);
+    const srcText = await src.text();
+    check(
+      src.status() === 200 && /openfront-modifications\.patch/.test(srcText),
+      "/source answers and links the patch",
+      src.status(),
+    );
+    const patchUrl = /href="([^"]*openfront-modifications\.patch)"/.exec(
+      srcText,
+    )?.[1];
+    const patch = patchUrl ? await page.request.get(patchUrl) : undefined;
+    check(
+      patch?.status() === 200 && (await patch.text()).startsWith("diff --git"),
+      "the patch is on the CDN and is a git diff",
+      patchUrl,
+    );
+
+    console.log("the leaderboard, filled from the database");
+    await page.evaluate(() => {
+      location.hash = "modal=leaderboard";
+    });
+    await page
+      .locator("leaderboard-modal")
+      .getByText("Reza")
+      .first()
+      .waitFor({ state: "visible", timeout: 120_000 });
+    await sleep(1500);
+    const lb = await page.evaluate(
+      () =>
+        document
+          .querySelector("leaderboard-modal")
+          ?.textContent?.replace(/\s+/g, " ") ?? "",
+    );
+    check(
+      /Reza.*Sara.*Ali/.test(lb),
+      "the three players appear, most wins first",
+      lb.slice(0, 200),
+    );
+    // The tab bar is in a shadow root, which innerText cannot see but Playwright's locators can.
+    check(
+      await page.getByText("بیشترین برد", { exact: true }).first().isVisible(),
+      "the single tab is 'Most wins' (in Persian)",
+    );
+    check(
+      /برد/.test(lb) && !/ایلو|ELO/.test(lb),
+      "the points column is called Wins, not ELO",
+    );
+    await page.screenshot({ path: path.join(OUT, "release-leaderboard.png") });
+
+    console.log("back to English");
+    await page.evaluate(() => {
+      location.hash = "";
+    });
+    await sleep(1500);
+    await page
+      .locator("lang-selector button")
+      .first()
+      .click({ timeout: 30_000 });
+    await page
+      .locator("language-modal")
+      .getByText("English", { exact: true })
+      .first()
+      .click({ timeout: 60_000 });
+    await sleep(4000);
+    const en = await page.evaluate(() => ({
+      lang: localStorage.getItem("lang"),
+      footer:
+        document
+          .querySelector("page-footer")
+          ?.textContent?.replace(/\s+/g, " ")
+          .trim() ?? "",
+    }));
+    check(
+      en.lang === "en" && /Terms of Service/.test(en.footer),
+      "the picker switches to English and remembers it",
+      en,
+    );
+
+    console.log("Solo on the Iran map");
+    await page.locator("button:visible", { hasText: /solo/i }).first().click();
+    await page
+      .locator("single-player-modal")
+      .getByText(/^\s*featured\s*$/i)
+      .first()
+      .waitFor({ state: "attached", timeout: 120_000 });
+    await sleep(1500);
+    const iran = page
+      .locator("single-player-modal")
+      .getByText(/^\s*Iran\s*$/)
+      .first();
+    check((await iran.count()) > 0, "Iran is in the Featured tab");
+    await iran.scrollIntoViewIfNeeded();
+    await iran.click();
+    await sleep(800);
+    // The hardest level is offered, and a game can be started on it.
+    const nightmare = page
+      .locator("single-player-modal")
+      .getByText(/^\s*Nightmare\s*$/i)
+      .first();
+    check((await nightmare.count()) > 0, "Nightmare is offered as a difficulty");
+    await nightmare.scrollIntoViewIfNeeded();
+    await nightmare.click();
+    await sleep(500);
+    await page
+      .locator(
+        'single-player-modal o-button[translationKey="game_settings.start"]',
+      )
+      .last()
+      .click();
+    for (let i = 0; i < 240; i++) {
+      if (
+        await page.evaluate(
+          () => document.querySelectorAll("canvas").length > 0,
+        )
+      )
+        break;
+      await sleep(1000);
+    }
+    await sleep(10_000);
+    check(
+      [...iranFiles].some((f) => f.startsWith("map.")) &&
+        [...iranFiles].some((f) => f.startsWith("manifest")),
+      "the Iran map files were fetched",
+      [...iranFiles],
+    );
+    check(
+      await page.evaluate(() => document.querySelectorAll("canvas").length > 0),
+      "the game started on the Iran map",
+    );
+    await page.screenshot({ path: path.join(OUT, "release-iran.png") });
+
+    const art = failedRequests.filter((f) => /\.webp/.test(f));
+    check(art.length === 0, "no picture failed to load", art);
+  } finally {
+    await browser.close();
+  }
+});
+if (!ok) failed = true;
+console.log(failed ? "\nFAILED" : "\nrelease checks passed");
+process.exit(failed ? 1 : 0);
diff --git a/cloudflare/scripts/resilient-assets.ts b/cloudflare/scripts/resilient-assets.ts
new file mode 100644
index 0000000..c3cf93f
--- /dev/null
+++ b/cloudflare/scripts/resilient-assets.ts
@@ -0,0 +1,103 @@
+// Makes downloads of the site's files survive connections that freeze mid-transfer.
+//
+// The service worker itself is cloudflare/sw/sw.js (see the comment at its top for the why).
+// This module does the build-time half:
+//  - writes it to static/sw.js with the build id, the CDN base (when the files live on a CDN)
+//    and the list of files it should fetch in the background (what a game start needs, so a
+//    click on Solo finds them already cached);
+//  - injects the small snippet that registers it, switches it off on "?nosw", and asks it to
+//    start that background fetch once the home page is up.
+
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { insertAtHeadStart } from "./head";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const SW_TEMPLATE = path.resolve(here, "../sw/sw.js");
+
+/** Files worth fetching ahead of time, most important first (paths relative to static/). */
+export function warmList(staticDir: string): string[] {
+  const rel = (p: string) => `/${path.relative(staticDir, p).split(path.sep).join("/")}`;
+  const list = (dir: string, keep: (name: string) => boolean): string[] => {
+    const full = path.join(staticDir, dir);
+    if (!fs.existsSync(full)) return [];
+    return fs
+      .readdirSync(full, { withFileTypes: true })
+      .filter((e) => e.isFile() && keep(e.name))
+      .map((e) => rel(path.join(full, e.name)))
+      .sort();
+  };
+
+  const assets = list("assets", (n) => /\.(js|css)$/.test(n));
+  const first = (re: RegExp) => assets.filter((p) => re.test(p));
+  const out: string[] = [];
+  const add = (paths: string[]) => {
+    for (const p of paths) if (!out.includes(p)) out.push(p);
+  };
+
+  // What starting a game needs that the home page does not already load: the simulation
+  // worker, then the default map (the Solo screen's choice) and the text atlas.
+  add(first(/\/Worker\.worker-/));
+  add(list("_assets/maps/world", () => true));
+  add(list("_assets/atlases", () => true));
+  // Then the rest of the code, so every screen opens from the cache.
+  add(assets);
+  return out;
+}
+
+/** The service worker's source for this build. */
+export function buildServiceWorker(
+  staticDir: string,
+  buildId: string,
+  cdnBase = "",
+): string {
+  const template = fs.readFileSync(SW_TEMPLATE, "utf8");
+  for (const ph of ["__BUILD_ID__", "__CDN_BASE__", "__WARM_LIST__"]) {
+    if (!template.includes(ph)) throw new Error(`sw/sw.js lost its ${ph} placeholder`);
+  }
+  if (cdnBase && !/^https?:\/\/[^/]+(\/[^?#]*)?$/.test(cdnBase)) {
+    throw new Error(`CDN_BASE must be an origin plus an optional path, got ${cdnBase}`);
+  }
+  return template
+    .replace("__BUILD_ID__", buildId.replace(/[^\w.-]/g, ""))
+    .replace('"__CDN_BASE__"', JSON.stringify(cdnBase.replace(/\/+$/, "")))
+    .replace("__WARM_LIST__", JSON.stringify(warmList(staticDir)));
+}
+
+const REGISTER = `<script id="cf-sw">
+  (function () {
+    if (!("serviceWorker" in navigator) || !window.isSecureContext) return;
+    // "?nosw" removes the worker (and its files) and leaves the page as a plain website.
+    if (/[?&]nosw(&|=|$)/.test(location.search)) {
+      // Tell the worker first (it stops serving and drops its cache; an unregistered worker
+      // keeps controlling this page until it closes), then remove it.
+      navigator.serviceWorker.getRegistrations().then(function (rs) {
+        rs.forEach(function (r) {
+          if (r.active) r.active.postMessage({ type: "cf-off" });
+          r.unregister();
+        });
+      }).catch(function () {});
+      if (window.caches) setTimeout(function () { caches.delete("cf-files-v1").catch(function () {}); }, 1500);
+      return;
+    }
+    navigator.serviceWorker.register("/sw.js").catch(function () {});
+    // Once the home page is up, let the worker fetch the files a game start needs.
+    function warm() {
+      if (navigator.connection && navigator.connection.saveData) return;
+      navigator.serviceWorker.ready.then(function (reg) {
+        if (reg.active) reg.active.postMessage({ type: "cf-warm" });
+      }).catch(function () {});
+    }
+    if (window.customElements && customElements.whenDefined) {
+      customElements.whenDefined("play-page").then(function () { setTimeout(warm, 3000); });
+    }
+  })();
+</script>
+`;
+
+/** Adds the registration snippet at the start of <head> (after the loading screen's own). */
+export function injectServiceWorker(html: string): string {
+  if (html.includes('id="cf-sw"')) return html;
+  return insertAtHeadStart(html, REGISTER);
+}
diff --git a/cloudflare/scripts/smoke-public.ts b/cloudflare/scripts/smoke-public.ts
new file mode 100644
index 0000000..074316f
--- /dev/null
+++ b/cloudflare/scripts/smoke-public.ts
@@ -0,0 +1,332 @@
+// End-to-end test of public matchmaking: the lobby-list socket, the countdown,
+// joining a scheduled lobby, the automatic start, the queue refilling, and the
+// D1 record of it all. Needs the Worker running with a short countdown:
+//
+//   npx wrangler dev --var PUBLIC_LOBBY_SECONDS:8      (in cloudflare/)
+//   npm run smoke:public
+//
+// The final check waits for the empty-game reaper (~35 s) to see a game finish.
+
+import type {
+  PublicGameInfo,
+  PublicLobbyMessage,
+  ServerMessage,
+} from "@openfront/shared/WireSchemas";
+import {
+  createGameWireContext,
+  decodeLobbyMessage,
+  decodeServerMessage,
+  encodeClientMessage,
+} from "@openfront/shared/ZbinWire";
+import type { ZbContext } from "@openfront/zbin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const WS_BASE = BASE.replace(/^http/, "ws");
+// The build id joins must carry: the deployment publishes it next to the page.
+// An API-only deployment has no commit.txt and uses the GIT_COMMIT var ("DEV").
+const COMMIT =
+  process.env.GIT_COMMIT ??
+  (await fetch(`${BASE}/commit.txt`)
+    .then(async (r) => (r.ok ? (await r.text()).trim() : "DEV"))
+    .catch(() => "DEV"));
+const SKIP_REAP = process.env.SKIP_REAP === "1";
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail =
+    ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/** The lobby browser's socket: broadcast-only, every frame decodes as a lobby message. */
+class LobbyWatcher {
+  readonly frames: PublicLobbyMessage[] = [];
+  closed = false;
+  private ws!: WebSocket;
+
+  async connect(): Promise<void> {
+    this.ws = new WebSocket(`${WS_BASE}/w0/lobbies?platform=web`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) =>
+      this.frames.push(
+        decodeLobbyMessage(new Uint8Array(ev.data as ArrayBuffer)),
+      );
+    this.ws.onclose = () => (this.closed = true);
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () => reject(new Error("lobby socket error"));
+    });
+  }
+
+  async waitFor(
+    pred: (f: PublicLobbyMessage) => boolean,
+    timeoutMs = 15_000,
+  ): Promise<PublicLobbyMessage> {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const hit = this.frames.find(pred);
+      if (hit !== undefined) return hit;
+      if (Date.now() > deadline) throw new Error("lobby watcher timed out");
+      await sleep(100);
+    }
+  }
+
+  lobbies(): PublicGameInfo[] {
+    const last = [...this.frames].reverse().find((f) => f.type === "full");
+    if (last?.type !== "full") return [];
+    return Object.values(last.games).flat() as PublicGameInfo[];
+  }
+
+  close(): void {
+    this.ws.close();
+  }
+}
+
+class Player {
+  ws!: WebSocket;
+  ctx: ZbContext | undefined;
+  readonly inbox: ServerMessage[] = [];
+  closed: number | null = null;
+
+  constructor(readonly token: string) {}
+
+  async connect(): Promise<void> {
+    this.ws = new WebSocket(`${WS_BASE}/w0`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) => {
+      const msg = decodeServerMessage(
+        new Uint8Array(ev.data as ArrayBuffer),
+        this.ctx,
+      );
+      if (msg.type === "start")
+        this.ctx = createGameWireContext(msg.gameStartInfo.players);
+      this.inbox.push(msg);
+    };
+    this.ws.onclose = (ev) => (this.closed = ev.code);
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () => reject(new Error("game socket error"));
+    });
+  }
+
+  join(gameID: string, username: string): void {
+    this.ws.send(
+      encodeClientMessage(
+        {
+          type: "join",
+          token: this.token,
+          gameID,
+          username,
+          clanTag: null,
+          turnstileToken: null,
+          gitCommit: COMMIT,
+        },
+        undefined,
+      ),
+    );
+  }
+
+  async waitFor<T extends ServerMessage["type"]>(type: T, timeoutMs = 20_000) {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const hit = this.inbox.find((m) => m.type === type);
+      if (hit !== undefined) return hit as Extract<ServerMessage, { type: T }>;
+      if (this.closed !== null)
+        throw new Error(`closed ${this.closed} waiting for ${type}`);
+      if (Date.now() > deadline)
+        throw new Error(`timed out waiting for ${type}`);
+      await sleep(100);
+    }
+  }
+}
+
+async function recent(): Promise<
+  Array<{ gameId: string; status: string; playersPeak: number; kind: string }>
+> {
+  const r = await fetch(`${BASE}/api/lobbies/recent?limit=50`);
+  if (r.status !== 200)
+    throw new Error(`recent -> ${r.status} ${await r.text()}`);
+  return (
+    (await r.json()) as {
+      lobbies: Array<{
+        gameId: string;
+        status: string;
+        playersPeak: number;
+        kind: string;
+      }>;
+    }
+  ).lobbies;
+}
+
+async function main(): Promise<void> {
+  console.log(`public matchmaking test against ${BASE}`);
+
+  // --- the lobby browser's socket
+  const watcher = new LobbyWatcher();
+  await watcher.connect();
+  const first = await watcher.waitFor((f) => f.type === "full");
+  check(first.type === "full", "lobby socket sends a full snapshot on connect");
+  if (first.type !== "full") return;
+  const types = Object.keys(first.games).sort();
+  check(
+    types.join(",") === "ffa,team",
+    "snapshot has ffa and team queues",
+    types,
+  );
+  check(
+    first.gitCommit === COMMIT,
+    "snapshot carries the build commit",
+    first.gitCommit,
+  );
+  const ffa = first.games.ffa ?? [];
+  const team = first.games.team ?? [];
+  check(
+    ffa.length >= 2 && team.length >= 2,
+    "each queue holds the next lobbies",
+    [ffa.length, team.length],
+  );
+  check(ffa[0]?.startsAt !== undefined, "the head lobby is on a countdown");
+  check(ffa[1]?.startsAt === undefined, "the lobby behind it is not");
+  check(ffa[0]?.gameConfig?.gameType === "Public", "lobbies are public games");
+  check(
+    ffa[0]?.gameConfig?.gameMode === "Free For All" &&
+      team[0]?.gameConfig?.gameMode === "Team",
+    "ffa/team modes match their queue",
+  );
+
+  // Lobbies are slots of the clock: join one with time left on it, or the countdown
+  // can run out between reading the list and connecting. If it is nearly over, take
+  // the next head, which arrives in a fresh full frame at the slot boundary.
+  let lobbies = ffa;
+  if (lobbies[0]!.startsAt! - Date.now() < 3_500) {
+    const old = lobbies[0]!.gameID;
+    const next = await watcher.waitFor(
+      (f) => f.type === "full" && f.games.ffa?.[0]?.gameID !== old,
+    );
+    if (next.type === "full") lobbies = next.games.ffa!;
+  }
+  const target = lobbies[0]!;
+  // The lobby behind the one we join: nobody enters it.
+  const queuedId = lobbies[1]!.gameID;
+  const countdownMs = target.startsAt! - Date.now();
+  check(
+    countdownMs > 0 && countdownMs <= 9_000,
+    "countdown matches PUBLIC_LOBBY_SECONDS",
+    countdownMs,
+  );
+
+  // --- join the lobby that is counting down
+  const p1 = new Player(crypto.randomUUID());
+  const p2 = new Player(crypto.randomUUID());
+  await p1.connect();
+  await p2.connect();
+  p1.join(target.gameID, "Alice");
+  p2.join(target.gameID, "Bob");
+  const info = await p1.waitFor("lobby_info");
+  check(
+    info.lobby.publicGameType === "ffa",
+    "player sees the public lobby's info",
+  );
+
+  const counted = await watcher.waitFor(
+    (f) => f.type === "counts" && f.counts[target.gameID] === 2,
+  );
+  check(
+    counted.type === "counts",
+    "browser is told the lobby now has 2 players",
+  );
+
+  // --- the game starts by itself when the countdown ends
+  await p1.waitFor("prestart");
+  check(true, "prestart is sent when the countdown ends");
+  const start = await p1.waitFor("start");
+  await p2.waitFor("start");
+  check(
+    start.gameStartInfo.players.length === 2,
+    "game starts with both players",
+    start.gameStartInfo.players.length,
+  );
+  check(
+    start.gameStartInfo.config.gameType === "Public",
+    "started game is public",
+  );
+
+  // --- the started lobby leaves the list and the queue refills
+  const after = await watcher.waitFor(
+    (f) =>
+      f.type === "full" &&
+      !(Object.values(f.games).flat() as PublicGameInfo[]).some(
+        (g) => g.gameID === target.gameID,
+      ),
+  );
+  const remaining = Object.values(
+    (after as Extract<PublicLobbyMessage, { type: "full" }>).games,
+  ).flat() as PublicGameInfo[];
+  check(
+    !remaining.some((g) => g.gameID === target.gameID),
+    "started lobby is removed from the browser",
+  );
+  check(
+    (after as Extract<PublicLobbyMessage, { type: "full" }>).games.ffa
+      ?.length === 2,
+    "the ffa queue is refilled",
+  );
+  const next = (after as Extract<PublicLobbyMessage, { type: "full" }>).games
+    .ffa?.[0];
+  check(next?.startsAt !== undefined, "the next lobby starts its countdown");
+
+  // --- the game relays turns
+  const turn = await p1.waitFor("turn");
+  check(turn.type === "turn", "turns flow in the public game");
+
+  // --- D1 recorded it
+  await sleep(500);
+  const rows = await recent();
+  const row = rows.find((r) => r.gameId === target.gameID);
+  check(
+    row !== undefined && row.status === "started",
+    "D1: game recorded as started",
+    row,
+  );
+  check(row?.playersPeak === 2, "D1: peak players recorded", row?.playersPeak);
+  // Only lobbies someone entered are recorded; an unvisited one leaves no row.
+  check(
+    !rows.some((r) => r.gameId === queuedId),
+    "D1: a lobby nobody entered is not recorded",
+  );
+
+  // --- finish: everyone leaves, the empty-game reaper ends it
+  p1.ws.close();
+  p2.ws.close();
+  if (SKIP_REAP) {
+    console.log("  --  skipping the reaper check (SKIP_REAP=1)");
+  } else {
+    console.log("  ..  waiting for the empty-game reaper (~35 s) ...");
+    const deadline = Date.now() + 70_000;
+    let ended = row;
+    while (Date.now() < deadline) {
+      await sleep(2_000);
+      ended = (await recent()).find((r) => r.gameId === target.gameID);
+      if (ended?.status === "finished") break;
+    }
+    check(
+      ended?.status === "finished",
+      "D1: game recorded as finished after it emptied",
+      ended,
+    );
+  }
+
+  watcher.close();
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nPUBLIC SMOKE FAILED" : "\nPUBLIC SMOKE PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nPUBLIC SMOKE ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
