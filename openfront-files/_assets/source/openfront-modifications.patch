index 0000000..1924f2c
--- /dev/null
+++ b/cloudflare/scripts/accounts-smoke.ts
@@ -0,0 +1,401 @@
+// End-to-end test of sign-in (src/accounts/), against a local copy of the Worker.
+//
+//   npm run smoke:accounts
+//
+// It starts its own `wrangler dev` (fresh local database, test secrets, port 8797) and two
+// stand-ins on port 8798: for Google (authorize/token/userinfo) and for Brevo's mail API
+// (scripts/accounts-harness.ts). So every route runs for real, including the code that talks
+// to those services, and nothing is sent to anyone. The profile answer is parsed with the
+// client's own schema.
+
+import { TokenPayloadSchema, UserMeResponseSchema } from "@openfront/shared/ApiSchemas";
+import type { ClientMessage, ServerMessage } from "@openfront/shared/WireSchemas";
+import {
+  createGameWireContext,
+  decodeServerMessage,
+  encodeClientMessage,
+} from "@openfront/shared/ZbinWire";
+import type { ZbContext } from "@openfront/zbin";
+import http from "node:http";
+import { signJwt, uuidToB64u } from "../src/accounts/crypto";
+import { BASE, GOOGLE_PEOPLE, MOCK, SECRET, mails, withTestWorker } from "./accounts-harness";
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  console.log(
+    `${ok ? "  ok  " : " FAIL "} ${label}${ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`}`,
+  );
+  if (!ok) failed = true;
+}
+
+
+// ------------------------------------------------------------------ http bits
+
+/** A browser's cookies for the API: what the server set, sent back on the next call. */
+class Jar {
+  private cookies = new Map<string, string>();
+  absorb(res: Response): void {
+    for (const line of res.headers.getSetCookie()) {
+      const [pair, ...attrs] = line.split(";").map((s) => s.trim());
+      const eq = pair!.indexOf("=");
+      const name = pair!.slice(0, eq);
+      const value = pair!.slice(eq + 1);
+      const gone = attrs.some((a) => /^max-age=0$/i.test(a)) || value === "";
+      if (gone) this.cookies.delete(name);
+      else this.cookies.set(name, value);
+    }
+  }
+  has(name: string): boolean {
+    return this.cookies.has(name);
+  }
+  header(): string {
+    return [...this.cookies].map(([k, v]) => `${k}=${v}`).join("; ");
+  }
+}
+
+interface Call {
+  method?: string;
+  jar?: Jar;
+  origin?: string | null;
+  bearer?: string;
+  body?: unknown;
+  redirect?: RequestRedirect;
+}
+
+async function call(pathAndQuery: string, c: Call = {}): Promise<Response> {
+  const headers: Record<string, string> = {};
+  if (c.origin !== null) headers.origin = c.origin ?? BASE;
+  if (c.jar !== undefined && c.jar.header() !== "") headers.cookie = c.jar.header();
+  if (c.bearer !== undefined) headers.authorization = `Bearer ${c.bearer}`;
+  if (c.body !== undefined) headers["content-type"] = "application/json";
+  const res = await fetch(`${BASE}${pathAndQuery}`, {
+    method: c.method ?? "GET",
+    headers,
+    body: c.body === undefined ? undefined : JSON.stringify(c.body),
+    redirect: c.redirect ?? "manual",
+  });
+  c.jar?.absorb(res);
+  return res;
+}
+
+async function tokenFor(jar: Jar): Promise<string> {
+  const res = await call("/auth/refresh", { method: "POST", jar });
+  const body = (await res.json()) as { jwt: string };
+  return body.jwt;
+}
+
+function decodeClaims(jwt: string): Record<string, unknown> {
+  return JSON.parse(Buffer.from(jwt.split(".")[1]!, "base64url").toString("utf8"));
+}
+
+/** Signs in by email the way a person does; returns the jar and the account's token. */
+async function emailSignIn(email: string): Promise<{ jar: Jar; res: Response }> {
+  const before = mails.length;
+  const sent = await call("/auth/magic-link", {
+    method: "POST",
+    body: { email, redirectDomain: BASE },
+  });
+  if (sent.status !== 200 || mails.length !== before + 1) {
+    throw new Error(`could not request a link for ${email}: ${sent.status}`);
+  }
+  const link = /https?:\/\/[^\s"<]+#token-login\?token-login=([A-Za-z0-9_-]+)/.exec(
+    mails[mails.length - 1]!.text,
+  );
+  if (link === null) throw new Error("no link in the email");
+  const jar = new Jar();
+  const res = await call(`/auth/login/token?login-token=${link[1]}`, { jar, origin: null });
+  return { jar, res };
+}
+
+// ------------------------------------------------------------------ game bits
+
+class Player {
+  ws!: WebSocket;
+  ctx: ZbContext | undefined;
+  readonly inbox: ServerMessage[] = [];
+  closed: { code: number; reason: string } | null = null;
+  async connect(): Promise<void> {
+    this.ws = new WebSocket(`${BASE.replace(/^http/, "ws")}/w0`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) => {
+      this.inbox.push(decodeServerMessage(new Uint8Array(ev.data as ArrayBuffer), this.ctx));
+    };
+    this.ws.onclose = (ev) => (this.closed = { code: ev.code, reason: ev.reason });
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () => reject(new Error("websocket error"));
+    });
+  }
+  join(token: string, gameID: string, commit: string): void {
+    const msg: ClientMessage = {
+      type: "join",
+      token,
+      gameID,
+      username: "Tester",
+      clanTag: null,
+      turnstileToken: null,
+      gitCommit: commit,
+    };
+    this.ws.send(encodeClientMessage(msg, this.ctx));
+  }
+  async until(pred: () => boolean, ms = 8000): Promise<boolean> {
+    const end = Date.now() + ms;
+    while (Date.now() < end) {
+      if (pred()) return true;
+      await new Promise((r) => setTimeout(r, 50));
+    }
+    return pred();
+  }
+}
+
+// ------------------------------------------------------------------------ run
+
+async function run(): Promise<void> {
+  // --- guests and the browser's rules
+  check((await call("/auth/refresh", { method: "POST" })).status === 204, "no session: refresh answers 204, not 401 (a guest keeps its id)");
+  check((await call("/auth/refresh", { method: "POST", origin: "https://evil.example" })).status === 403, "refresh from another site is refused");
+  check((await call("/auth/refresh", { method: "POST", origin: null })).status === 403, "refresh with no Origin is refused");
+  const pre = await call("/users/@me", { method: "OPTIONS" });
+  check(pre.status === 204 && pre.headers.get("access-control-allow-origin") === BASE && pre.headers.get("access-control-allow-credentials") === "true", "preflight from the site is allowed with credentials");
+  check((await call("/users/@me", { method: "OPTIONS", origin: "https://evil.example" })).status === 403, "preflight from another site is refused");
+  check((await call("/users/@me")).status === 401, "profile without a token is 401");
+
+  // --- the emailed link
+  check((await call("/auth/magic-link", { method: "POST", body: { email: "not-an-email", redirectDomain: BASE } })).status === 400, "magic-link: bad address is 400");
+  check((await call("/auth/magic-link", { method: "POST", body: { email: "x@example.test", redirectDomain: "https://evil.example" } })).status === 400, "magic-link: another site's address in the link is refused");
+  check(mails.length === 0, "no mail went out for those");
+
+  const alice = "alice@example.test";
+  const { jar: jarA, res: loginA } = await emailSignIn(alice);
+  const mail = mails[0]!;
+  check(mail.to === alice && mail.from === "login@example.test", "the link went to the address, from the configured sender", { to: mail.to, from: mail.from });
+  check(mail.subject.includes("OpenFront") && mail.html.includes("dir=\"rtl\"") && mail.text.includes("ورود"), "the mail is in English and Persian");
+  check(mail.text.includes(`${BASE}/#token-login?token-login=`), "the link opens the page's token-login route");
+  check(loginA.status === 200 && ((await loginA.json()) as { email: string }).email === alice, "using the link signs in and names the address");
+  const cookiesSet = loginA.headers.getSetCookie().join("\n");
+  check(/of_session=[^;]+;[^\n]*HttpOnly/i.test(cookiesSet), "the session cookie is HttpOnly");
+  check(/of_signed_in=1/.test(cookiesSet) && !/of_signed_in=1[^\n]*HttpOnly/i.test(cookiesSet), "the signed-in hint cookie is readable by the page");
+  const link = /token-login=([A-Za-z0-9_-]+)/.exec(mail.text)![1]!;
+  const again = await call(`/auth/login/token?login-token=${link}`, { origin: null });
+  check(again.status === 400 && ((await again.json()) as { code: string }).code === "consumed", "a link works only once");
+  // A link opened from another site must not sign a visitor in to the sender's account.
+  // (Sent with node:http: fetch() sets the Sec-Fetch-* headers itself.)
+  const viaNav = await new Promise<number>((resolve, reject) => {
+    const req = http.get(`${BASE}/auth/login/token?login-token=${link}`, { headers: { "sec-fetch-mode": "navigate", "sec-fetch-site": "cross-site" } }, (res) => {
+      res.resume();
+      resolve(res.statusCode ?? 0);
+    });
+    req.on("error", reject);
+  });
+  check(viaNav === 403, "the login link cannot be used by navigating to it (login CSRF)", viaNav);
+  const bogus = await call("/auth/login/token?login-token=nonsense", { origin: null });
+  check(bogus.status === 400 && ((await bogus.json()) as { code: string }).code === "invalid", "a made-up link is invalid");
+
+  const failing = await call("/auth/magic-link", { method: "POST", body: { email: "fail@example.test", redirectDomain: BASE } });
+  check(failing.status === 502, "when the mail service refuses, the person is told (502)", failing.status);
+
+  // --- token and profile
+  const jwtA = await tokenFor(jarA);
+  const claims = decodeClaims(jwtA);
+  const parsed = TokenPayloadSchema.safeParse(claims);
+  check(parsed.success, "the token passes the client's own TokenPayloadSchema", parsed.success ? undefined : parsed.error.message);
+  check(claims.iss === BASE && claims.aud === "localhost", "issuer is the API's origin, audience is localhost in dev", { iss: claims.iss, aud: claims.aud });
+  check(Number(claims.exp) - Number(claims.iat) === 3600, "a token lasts one hour");
+  const meRes = await call("/users/@me", { bearer: jwtA, origin: null });
+  const meBody = await meRes.json();
+  const me = UserMeResponseSchema.safeParse(meBody);
+  check(meRes.status === 200 && me.success, "the profile passes the client's own UserMeResponseSchema", me.success ? undefined : me.error.message);
+  check(me.success && me.data.user.email === alice, "the profile has the email");
+  check(me.success && /^[2-9A-HJKMNP-Z]{10}$/.test(me.data.player.publicId), "the public id is 10 safe characters, not the account id");
+  check(!JSON.stringify(meBody).includes(String(parsed.success ? parsed.data.sub : "x")), "the profile never contains the account id");
+
+  const forged = await signJwt({ ...(claims as never) }, "some other secret");
+  check((await call("/users/@me", { bearer: forged, origin: null })).status === 401, "a token signed with another secret is rejected");
+  check((await call("/users/@me", { bearer: jwtA.slice(0, -2) + "xx", origin: null })).status === 401, "a tampered token is rejected");
+  const expired = await signJwt({ ...(claims as never), iat: 1000, exp: 2000 }, SECRET);
+  check((await call("/users/@me", { bearer: expired, origin: null })).status === 401, "an expired token is rejected");
+  const otherAud = await signJwt({ ...(claims as never), aud: "other.example" }, SECRET);
+  check((await call("/users/@me", { bearer: otherAud, origin: null })).status === 401, "a token for another audience is rejected");
+  const noneAlg = `${Buffer.from('{"alg":"none","typ":"JWT"}').toString("base64url")}.${jwtA.split(".")[1]}.`;
+  check((await call("/users/@me", { bearer: noneAlg, origin: null })).status === 401, 'alg "none" is rejected');
+
+  // --- playing with the token
+  const commit = await fetch(`${BASE}/commit.txt`).then(async (r) => (r.ok ? (await r.text()).trim() : "DEV")).catch(() => "DEV");
+  const created = await fetch(`${BASE}/api/create_game`, {
+    method: "POST",
+    headers: { authorization: `Bearer ${jwtA}`, "content-type": "application/json" },
+    body: "{}",
+  });
+  const game = (await created.json()) as { gameID: string };
+  check(created.status === 200 && typeof game.gameID === "string", "a signed-in player can create a private game");
+  const badCreate = await fetch(`${BASE}/api/create_game`, {
+    method: "POST",
+    headers: { authorization: `Bearer ${jwtA.slice(0, -2)}xx`, "content-type": "application/json" },
+    body: "{}",
+  });
+  check(badCreate.status === 401, "a tampered token cannot create a game");
+  const guestCreate = await fetch(`${BASE}/api/create_game`, {
+    method: "POST",
+    headers: { authorization: `Bearer ${crypto.randomUUID()}`, "content-type": "application/json" },
+    body: "{}",
+  });
+  check(guestCreate.status === 200, "a guest id still can (nothing changed for guests)");
+
+  const host = new Player();
+  await host.connect();
+  host.join(jwtA, game.gameID, commit);
+  const joined = await host.until(() => host.inbox.some((m) => m.type === "lobby_info"));
+  const lobby = host.inbox.find((m): m is Extract<ServerMessage, { type: "lobby_info" }> => m.type === "lobby_info");
+  check(joined && lobby !== undefined && lobby.lobby.lobbyCreatorClientID === lobby.myClientID, "joining with the token works, and the account that created the lobby is its host");
+  const intruder = new Player();
+  await intruder.connect();
+  intruder.join(`${jwtA.slice(0, -2)}xx`, game.gameID, commit);
+  check(await intruder.until(() => intruder.closed !== null), "joining with a tampered token is refused");
+  const guest = new Player();
+  await guest.connect();
+  guest.join(crypto.randomUUID(), game.gameID, commit);
+  check(await guest.until(() => guest.inbox.some((m) => m.type === "lobby_info")), "a guest id still joins");
+  host.ws.close();
+  intruder.ws.close();
+  guest.ws.close();
+
+  // --- Google
+  const goodReturn = `${BASE}/#modal=account`;
+  const start = await call(`/auth/login/google?redirect_uri=${encodeURIComponent(goodReturn)}`, { origin: null });
+  const to = new URL(start.headers.get("location") ?? "http://none/");
+  check(start.status === 302 && to.origin === MOCK && to.pathname === "/google/auth", "Google sign-in starts by sending the browser to Google");
+  check(to.searchParams.get("client_id") === "test-client" && to.searchParams.get("redirect_uri") === `${BASE}/auth/callback/google` && to.searchParams.get("response_type") === "code" && to.searchParams.get("scope") === "openid email", "with the client id, our callback, and only the openid + email scopes");
+  const oauthJar = new Jar();
+  oauthJar.absorb(start);
+  check(oauthJar.has("of_oauth") && /HttpOnly/i.test(start.headers.getSetCookie().join()), "the sign-in is bound to the browser with an HttpOnly cookie");
+  const state = to.searchParams.get("state")!;
+
+  check((await call(`/auth/login/google?redirect_uri=${encodeURIComponent("https://evil.example/")}`, { origin: null })).status === 400, "a return address on another site is refused (no open redirect)");
+
+  const callback = (code: string, st: string, jar: Jar, extra = "") =>
+    call(`/auth/callback/google?code=${code}&state=${encodeURIComponent(st)}${extra}`, { jar, origin: null });
+
+  const forgedState = await callback("code-new", state.slice(0, -2) + "xx", oauthJar);
+  check(forgedState.status === 302 && /login=error/.test(forgedState.headers.get("location") ?? "") && !forgedState.headers.getSetCookie().some((c) => c.startsWith("of_session=") && !/Max-Age=0/.test(c)), "a forged state signs nobody in");
+  const noCookie = await callback("code-new", state, new Jar());
+  check(noCookie.status === 302 && /login=error/.test(noCookie.headers.get("location") ?? ""), "a state without the browser's cookie signs nobody in");
+
+  // alice's address, through Google: the same account, now with Google attached
+  const jarG = new Jar();
+  jarG.absorb(start);
+  const ok = await callback("code-merge", state, jarG);
+  check(ok.status === 302 && ok.headers.get("location") === goodReturn, "Google sign-in returns the browser to the page it came from");
+  check(jarG.has("of_session") && jarG.has("of_signed_in") && !jarG.has("of_oauth"), "it sets the session and clears the one-time cookie");
+  const jwtG = await tokenFor(jarG);
+  check(decodeClaims(jwtG).sub === claims.sub, "the same address by Google is the same account as by email");
+  const meG = UserMeResponseSchema.safeParse(await (await call("/users/@me", { bearer: jwtG, origin: null })).json());
+  check(meG.success && meG.data.user.google?.email === alice, "the profile now shows Google too");
+
+  // a new person
+  const start2 = await call(`/auth/login/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null });
+  const jarB = new Jar();
+  jarB.absorb(start2);
+  const state2 = new URL(start2.headers.get("location")!).searchParams.get("state")!;
+  const okB = await callback("code-new", state2, jarB);
+  check(okB.status === 302 && jarB.has("of_session"), "a new Google person gets an account");
+  check(decodeClaims(await tokenFor(jarB)).sub !== claims.sub, "which is a different account");
+
+  const denied = await call(`/auth/callback/google?error=access_denied&state=${encodeURIComponent(state2)}`, { jar: (() => { const j = new Jar(); j.absorb(start2); return j; })(), origin: null });
+  check(denied.status === 302 && denied.headers.get("location") === `${BASE}/`, "backing out at Google returns quietly, with no error");
+
+  const startU = await call(`/auth/login/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null });
+  const jarU = new Jar();
+  jarU.absorb(startU);
+  const unverified = await callback("code-unverified", new URL(startU.headers.get("location")!).searchParams.get("state")!, jarU);
+  check(unverified.status === 302 && /login=error/.test(unverified.headers.get("location") ?? "") && !jarU.has("of_session"), "an unverified Google address is refused");
+
+  const startC = await call(`/auth/login/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null });
+  const jarC = new Jar();
+  jarC.absorb(startC);
+  const clash = await callback("code-clash", new URL(startC.headers.get("location")!).searchParams.get("state")!, jarC);
+  check(clash.status === 302 && /login=email_exists/.test(clash.headers.get("location") ?? "") && !jarC.has("of_session"), "an address owned by another Google identity is not handed over (email_exists)");
+
+  const discord = await call(`/auth/login/discord?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null });
+  check(discord.status === 302 && /login=error/.test(discord.headers.get("location") ?? ""), "Discord, which is not offered, goes back with an error rather than a blank page");
+
+  // --- "Link Google" on the account screen
+  const frank = await emailSignIn("frank@example.test");
+  const jwtF = await tokenFor(frank.jar);
+  check((await call(`/auth/link/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null })).status === 401, "linking Google needs a signed-in account");
+  const linkStart = await call(`/auth/link/google?redirect_uri=${encodeURIComponent(BASE + "/#modal=account")}`, { bearer: jwtF });
+  const linkUrl = new URL(((await linkStart.json()) as { url: string }).url);
+  check(linkStart.status === 200 && linkUrl.origin === MOCK, "linking returns the Google address to go to");
+  const linkJar = new Jar();
+  linkJar.absorb(linkStart);
+  const linked = await callback("code-link", linkUrl.searchParams.get("state")!, linkJar);
+  check(linked.status === 302 && linked.headers.get("location") === `${BASE}/#modal=account&link=google`, "it returns to the account screen reporting link=google", linked.headers.get("location"));
+  check(!linkJar.has("of_session"), "linking does not start a second session");
+  const meF = UserMeResponseSchema.safeParse(await (await call("/users/@me", { bearer: jwtF, origin: null })).json());
+  check(meF.success && meF.data.user.email === "frank@example.test" && meF.data.user.google?.email === "frank.work@example.test", "the profile shows both addresses", meF.success ? meF.data.user : meF.error.message);
+  // that Google identity is now frank's: signing in with it gives frank's account
+  const startF = await call(`/auth/login/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { origin: null });
+  const jarF2 = new Jar();
+  jarF2.absorb(startF);
+  await callback("code-link", new URL(startF.headers.get("location")!).searchParams.get("state")!, jarF2);
+  check(jarF2.has("of_session") && decodeClaims(await tokenFor(jarF2)).sub === decodeClaims(jwtF).sub, "signing in with the linked Google identity opens that account");
+  // another account cannot take the same Google identity
+  const grace = await emailSignIn("grace@example.test");
+  const jwtGr = await tokenFor(grace.jar);
+  const linkStart2 = await call(`/auth/link/google?redirect_uri=${encodeURIComponent(BASE + "/")}`, { bearer: jwtGr });
+  const linkJar2 = new Jar();
+  linkJar2.absorb(linkStart2);
+  const taken = await callback("code-link", new URL(((await linkStart2.json()) as { url: string }).url).searchParams.get("state")!, linkJar2);
+  check(taken.headers.get("location") === `${BASE}/#modal=account&link=already_linked`, "a Google identity linked to one account cannot be linked to another", taken.headers.get("location"));
+  const meGr = UserMeResponseSchema.safeParse(await (await call("/users/@me", { bearer: jwtGr, origin: null })).json());
+  check(meGr.success && meGr.data.user.google === undefined, "and the second account stays without it");
+
+  // --- signing out
+  const { jar: jarA2 } = await emailSignIn(alice);
+  check((await call("/auth/refresh", { method: "POST", jar: jarA2 })).status === 200, "a second browser signs in to the same account");
+  const out = await call("/auth/logout", { method: "POST", jar: jarA2 });
+  check(out.status === 200 && !jarA2.has("of_session") && !jarA2.has("of_signed_in"), "logout clears both cookies");
+  check((await call("/auth/refresh", { method: "POST", jar: jarA })).status === 200, "logging out one browser leaves the other signed in");
+  // Someone kept a copy of a cookie, then the owner logged out: the copy must not work.
+  const dave = await emailSignIn("dave@example.test");
+  const copy = new Jar();
+  copy.absorb(dave.res);
+  await call("/auth/logout", { method: "POST", jar: dave.jar });
+  const dead = await call("/auth/refresh", { method: "POST", jar: copy });
+  check(dead.status === 401 && dead.headers.getSetCookie().some((c) => /Max-Age=0/.test(c)), "a logged-out session's cookie is dead on the server, and the answer clears it");
+
+  const revoke = await call("/auth/revoke", { method: "POST", jar: jarA });
+  check(revoke.status === 200, "revoke signs out everywhere");
+  check((await call("/auth/refresh", { method: "POST", jar: jarG })).status === 401, "every other session of the account is dead too");
+
+  // --- deleting the account
+  const erin = await emailSignIn("erin@example.test");
+  const jarE = erin.jar;
+  const savedCookie = new Jar(); // what a thief who copied the cookie earlier would hold
+  savedCookie.absorb(erin.res);
+  const jwtE = await tokenFor(jarE);
+  const del = await call("/users/@me", { method: "DELETE", jar: jarE });
+  check(del.status === 204 && !jarE.has("of_session"), "DELETE /users/@me deletes the account (204) and clears the cookies");
+  check((await call("/auth/refresh", { method: "POST", jar: savedCookie })).status === 401, "its session is gone on the server");
+  check((await call("/users/@me", { bearer: jwtE, origin: null })).status === 401, "and its token no longer opens a profile");
+  const { jar: jarE2 } = await emailSignIn("erin@example.test");
+  const jwtE2 = await tokenFor(jarE2);
+  check(decodeClaims(jwtE2).sub !== decodeClaims(jwtE).sub, "signing up again with the address makes a new account");
+
+  // --- the limits on mail
+  let limited = 0;
+  for (let i = 0; i < 7; i++) {
+    const r = await call("/auth/magic-link", { method: "POST", body: { email: "spam@example.test", redirectDomain: BASE } });
+    if (r.status === 429) limited++;
+  }
+  check(limited >= 2, "one address cannot be mailed more than 5 times an hour", limited);
+  void uuidToB64u;
+}
+
+async function main(): Promise<void> {
+  const completed = await withTestWorker(run);
+  const ok = completed && !failed;
+  console.log(ok ? "\nall account checks passed" : "\nFAILED");
+  process.exit(ok ? 0 : 1);
+}
+
+void main();
