+++ b/cloudflare/scripts/source-page.ts
@@ -0,0 +1,165 @@
+// The "source" page: where a visitor gets the source code of the version running here.
+//
+// This site runs a modified copy of OpenFront, which is free software under the GNU Affero General
+// Public License v3 (code) and Creative Commons BY-SA 4.0 (assets). The AGPL asks that everyone who
+// uses a modified version over a network can get its source. The way it is offered here: the
+// upstream project at the exact commit this copy was started from, plus every change made since
+// as one patch, so the two together are the complete source of what is running.
+//
+// Written at build time, from the working tree, so the patch always matches the build:
+//   static/source.html                                    the page (served at /source)
+//   static/_assets/source/openfront-modifications.patch   the changes (published with the other files)
+//
+// The patch holds text only. Binary files (pictures, maps, the font) are not in it; the page lists
+// where each comes from.
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+
+/** The upstream commit this copy was started from (override with UPSTREAM_BASE). */
+function upstreamBase(repoRoot: string): string {
+  const fromEnv = process.env.UPSTREAM_BASE;
+  if (fromEnv) return fromEnv;
+  return execFileSync("git", ["merge-base", "HEAD", "main"], {
+    cwd: repoRoot,
+    encoding: "utf8",
+  }).trim();
+}
+
+/**
+ * Everything that is not source text or is someone's private data. (Build output and installed
+ * packages are git-ignored already, and `git add` refuses an explicit exclude for those.)
+ */
+const EXCLUDED = [
+  "openfront-assets",
+  "resources/maps",
+  "*.png",
+  "*.jpg",
+  "*.jpeg",
+  "*.webp",
+  "*.bin",
+  "*.woff",
+  "*.woff2",
+  "*.svg",
+];
+
+/** The changes since `base`: committed, uncommitted and new files, as a text patch. */
+function modificationsPatch(repoRoot: string, base: string): string {
+  // A throwaway index, so the real one (and what the owner has staged) is never touched.
+  const index = path.join(os.tmpdir(), `source-index-${process.pid}`);
+  const env = { ...process.env, GIT_INDEX_FILE: index };
+  try {
+    execFileSync("git", ["read-tree", "HEAD"], { cwd: repoRoot, env });
+    execFileSync(
+      "git",
+      ["add", "-A", "--", ".", ...EXCLUDED.map((p) => `:(exclude)${p}`)],
+      {
+        cwd: repoRoot,
+        env,
+      },
+    );
+    return execFileSync(
+      "git",
+      ["diff", "--cached", "--no-color", "--no-ext-diff", base],
+      {
+        cwd: repoRoot,
+        env,
+        encoding: "utf8",
+        maxBuffer: 256 * 1024 * 1024,
+      },
+    );
+  } finally {
+    fs.rmSync(index, { force: true });
+  }
+}
+
+const esc = (s: string) =>
+  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
+
+export interface SourcePageOptions {
+  repoRoot: string;
+  staticDir: string;
+  /** Origin and path the files are loaded from; empty = this origin. */
+  cdnBase: string;
+  buildId: string;
+}
+
+export function writeSourcePage({
+  repoRoot,
+  staticDir,
+  cdnBase,
+  buildId,
+}: SourcePageOptions): void {
+  const base = upstreamBase(repoRoot);
+  const patch = modificationsPatch(repoRoot, base);
+  const patchDir = path.join(staticDir, "_assets", "source");
+  fs.mkdirSync(patchDir, { recursive: true });
+  fs.writeFileSync(path.join(patchDir, "openfront-modifications.patch"), patch);
+
+  const patchUrl = `${cdnBase}/_assets/source/openfront-modifications.patch`;
+  const upstream = "https://github.com/openfrontio/OpenFrontIO";
+  const html = `<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Source code and licence</title>
+<style>
+  body { margin: 0; background: #0a1628; color: #e6edf5; font: 16px/1.6 system-ui, "Segoe UI", sans-serif; }
+  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
+  h1 { font-size: 1.6rem; margin: 0 0 .25rem; }
+  h2 { font-size: 1.1rem; margin: 2rem 0 .5rem; color: #3fa9f5; }
+  a { color: #3fa9f5; }
+  code { background: #13233b; padding: .1rem .35rem; border-radius: 4px; font-size: .9em; word-break: break-all; }
+  .muted { color: #9fb0c3; }
+  ol, ul { padding-left: 1.3rem; }
+</style>
+</head>
+<body>
+<main>
+<h1>Source code and licence</h1>
+<p class="muted">Hosted and edited by <a href="https://hatami-mahdi.ir/">hatami-mahdi.ir</a> &middot; build <code>${esc(buildId)}</code></p>
+
+<p>This site runs a modified copy of OpenFront, a free multiplayer strategy game. Its code is free software
+under the <a href="https://www.gnu.org/licenses/agpl-3.0.html">GNU Affero General Public License, version 3</a>
+(AGPL-3.0, with no warranty), and its pictures, sounds and maps are under
+<a href="https://creativecommons.org/licenses/by-sa/4.0/">Creative Commons BY-SA 4.0</a>.
+Copyright &copy; OpenFront Inc. and contributors.</p>
+
+<h2>Get the source of this version</h2>
+<p>The complete source of what is running here is the upstream project plus the changes made to it:</p>
+<ol>
+  <li>The upstream project at commit
+    <a href="${upstream}/tree/${esc(base)}"><code>${esc(base.slice(0, 12))}</code></a>
+    (<code>${esc(base)}</code>).</li>
+  <li>The changes made to it, as one patch of text files:
+    <a href="${esc(patchUrl)}"><code>openfront-modifications.patch</code></a>
+    (${(patch.length / 1024).toFixed(0)} KB). In a checkout of the commit above, run
+    <code>git apply openfront-modifications.patch</code>.</li>
+</ol>
+
+<h2>Files that are not in the patch</h2>
+<ul>
+  <li>The Iran map files (<code>resources/maps/iran</code>) are generated, and the patch holds what generates them:
+    <code>map-generator/python/build_iran.py</code> downloads public elevation data (AWS Terrain Tiles, built
+    from SRTM and GEBCO), writes <code>map-generator/assets/maps/iran/image.png</code> and the province list
+    (<code>info.json</code>, in the patch), and <code>map-generator/python/mapgen.py</code>, a Python port of the
+    project's map generator checked byte for byte against the original on the Strait of Hormuz map, writes the
+    map files. Running it again reproduces them.</li>
+  <li>The Persian font is Vazirmatn, from the npm package <code>vazirmatn</code> 33.0.3, under the
+    SIL Open Font License 1.1.</li>
+  <li>The background pictures belong to the site owner.</li>
+</ul>
+
+<p class="muted"><a href="/">Back to the game</a></p>
+</main>
+</body>
+</html>
+`;
+  fs.writeFileSync(path.join(staticDir, "source.html"), html);
+  console.log(
+    `  source   : /source (patch ${(patch.length / 1024).toFixed(0)} KB against ${base.slice(0, 12)})`,
+  );
+}
