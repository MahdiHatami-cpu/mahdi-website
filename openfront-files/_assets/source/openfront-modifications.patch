+  // Everything is here and the app is up, and the browser says the page itself (stylesheet,
+  // pictures) has loaded and the fonts in use are ready: now, and only now, it is true.
+  function check() {
+    if (finished || settling || !appUp || !filesDone) return;
+    if (!lateArmed) {
+      lateArmed = true;
+      later(ready, cfg.lateMs); // never wait for the browser's own bookkeeping forever
+    }
+    if (!pageLoaded) return;
