+  // The alpha byte carries the detail family (bits 7..5) and weight (bits 4..0);
+  // family 7 (255) means no detail.
+  int code = int(base.a * 255.0 + 0.5);
+  int family = code >> 5;
+  float weight = float(code & 31) / 31.0;
+  int layer = min(family, 3);
+
+  vec2 world = vUV * vec2(float(MAP_W), float(MAP_H));
+  float tiles = uDetailTiles[layer];
+  float l = float(layer);
+  float a = texture(uDetail, vec3(world / tiles, l)).r;
+  float b = texture(uDetail, vec3(ROT * world / (tiles * 0.618) + vec2(0.37, 0.61), l)).r;
+  // (a - 0.5) + (b - 0.5), scaled by 1/sqrt(2) to keep unit variance.
+  float z = (a + b - 1.0) * (TO_SIGMA * 0.70710678);
