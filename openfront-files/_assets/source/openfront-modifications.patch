new file mode 100644
index 0000000..c3cf93f
--- /dev/null
+++ b/cloudflare/scripts/resilient-assets.ts
@@ -0,0 +1,103 @@
+// Makes downloads of the site's files survive connections that freeze mid-transfer.
+//
+// The service worker itself is cloudflare/sw/sw.js (see the comment at its top for the why).
+// This module does the build-time half:
+//  - writes it to static/sw.js with the build id, the CDN base (when the files live on a CDN)
+//    and the list of files it should fetch in the background (what a game start needs, so a
+//    click on Solo finds them already cached);
+//  - injects the small snippet that registers it, switches it off on "?nosw", and asks it to
+//    start that background fetch once the home page is up.
+
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { insertAtHeadStart } from "./head";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const SW_TEMPLATE = path.resolve(here, "../sw/sw.js");
+
+/** Files worth fetching ahead of time, most important first (paths relative to static/). */
+export function warmList(staticDir: string): string[] {
+  const rel = (p: string) => `/${path.relative(staticDir, p).split(path.sep).join("/")}`;
+  const list = (dir: string, keep: (name: string) => boolean): string[] => {
+    const full = path.join(staticDir, dir);
+    if (!fs.existsSync(full)) return [];
+    return fs
+      .readdirSync(full, { withFileTypes: true })
+      .filter((e) => e.isFile() && keep(e.name))
+      .map((e) => rel(path.join(full, e.name)))
+      .sort();
+  };
+
+  const assets = list("assets", (n) => /\.(js|css)$/.test(n));
+  const first = (re: RegExp) => assets.filter((p) => re.test(p));
+  const out: string[] = [];
+  const add = (paths: string[]) => {
+    for (const p of paths) if (!out.includes(p)) out.push(p);
+  };
+
+  // What starting a game needs that the home page does not already load: the simulation
+  // worker, then the default map (the Solo screen's choice) and the text atlas.
+  add(first(/\/Worker\.worker-/));
+  add(list("_assets/maps/world", () => true));
+  add(list("_assets/atlases", () => true));
+  // Then the rest of the code, so every screen opens from the cache.
+  add(assets);
+  return out;
+}
+
+/** The service worker's source for this build. */
+export function buildServiceWorker(
+  staticDir: string,
+  buildId: string,
+  cdnBase = "",
+): string {
+  const template = fs.readFileSync(SW_TEMPLATE, "utf8");
+  for (const ph of ["__BUILD_ID__", "__CDN_BASE__", "__WARM_LIST__"]) {
+    if (!template.includes(ph)) throw new Error(`sw/sw.js lost its ${ph} placeholder`);
+  }
+  if (cdnBase && !/^https?:\/\/[^/]+(\/[^?#]*)?$/.test(cdnBase)) {
+    throw new Error(`CDN_BASE must be an origin plus an optional path, got ${cdnBase}`);
+  }
+  return template
+    .replace("__BUILD_ID__", buildId.replace(/[^\w.-]/g, ""))
+    .replace('"__CDN_BASE__"', JSON.stringify(cdnBase.replace(/\/+$/, "")))
+    .replace("__WARM_LIST__", JSON.stringify(warmList(staticDir)));
+}
+
+const REGISTER = `<script id="cf-sw">
+  (function () {
+    if (!("serviceWorker" in navigator) || !window.isSecureContext) return;
+    // "?nosw" removes the worker (and its files) and leaves the page as a plain website.
+    if (/[?&]nosw(&|=|$)/.test(location.search)) {
+      // Tell the worker first (it stops serving and drops its cache; an unregistered worker
+      // keeps controlling this page until it closes), then remove it.
+      navigator.serviceWorker.getRegistrations().then(function (rs) {
+        rs.forEach(function (r) {
+          if (r.active) r.active.postMessage({ type: "cf-off" });
+          r.unregister();
+        });
+      }).catch(function () {});
+      if (window.caches) setTimeout(function () { caches.delete("cf-files-v1").catch(function () {}); }, 1500);
+      return;
+    }
+    navigator.serviceWorker.register("/sw.js").catch(function () {});
+    // Once the home page is up, let the worker fetch the files a game start needs.
+    function warm() {
+      if (navigator.connection && navigator.connection.saveData) return;
+      navigator.serviceWorker.ready.then(function (reg) {
+        if (reg.active) reg.active.postMessage({ type: "cf-warm" });
+      }).catch(function () {});
+    }
+    if (window.customElements && customElements.whenDefined) {
+      customElements.whenDefined("play-page").then(function () { setTimeout(warm, 3000); });
+    }
+  })();
+</script>
+`;
+
+/** Adds the registration snippet at the start of <head> (after the loading screen's own). */
+export function injectServiceWorker(html: string): string {
+  if (html.includes('id="cf-sw"')) return html;
+  return insertAtHeadStart(html, REGISTER);
+}
diff --git a/cloudflare/scripts/smoke-public.ts b/cloudflare/scripts/smoke-public.ts
new file mode 100644
index 0000000..074316f
--- /dev/null
+++ b/cloudflare/scripts/smoke-public.ts
@@ -0,0 +1,332 @@
+// End-to-end test of public matchmaking: the lobby-list socket, the countdown,
+// joining a scheduled lobby, the automatic start, the queue refilling, and the
+// D1 record of it all. Needs the Worker running with a short countdown:
+//
+//   npx wrangler dev --var PUBLIC_LOBBY_SECONDS:8      (in cloudflare/)
+//   npm run smoke:public
+//
+// The final check waits for the empty-game reaper (~35 s) to see a game finish.
+
+import type {
+  PublicGameInfo,
+  PublicLobbyMessage,
+  ServerMessage,
+} from "@openfront/shared/WireSchemas";
+import {
+  createGameWireContext,
+  decodeLobbyMessage,
+  decodeServerMessage,
+  encodeClientMessage,
+} from "@openfront/shared/ZbinWire";
+import type { ZbContext } from "@openfront/zbin";
+
+const BASE = process.env.BASE ?? "http://localhost:8787";
+const WS_BASE = BASE.replace(/^http/, "ws");
+// The build id joins must carry: the deployment publishes it next to the page.
+// An API-only deployment has no commit.txt and uses the GIT_COMMIT var ("DEV").
+const COMMIT =
+  process.env.GIT_COMMIT ??
+  (await fetch(`${BASE}/commit.txt`)
+    .then(async (r) => (r.ok ? (await r.text()).trim() : "DEV"))
+    .catch(() => "DEV"));
+const SKIP_REAP = process.env.SKIP_REAP === "1";
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  const tail =
+    ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`;
+  console.log(`${ok ? "  ok  " : " FAIL "} ${label}${tail}`);
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/** The lobby browser's socket: broadcast-only, every frame decodes as a lobby message. */
+class LobbyWatcher {
+  readonly frames: PublicLobbyMessage[] = [];
+  closed = false;
+  private ws!: WebSocket;
+
+  async connect(): Promise<void> {
+    this.ws = new WebSocket(`${WS_BASE}/w0/lobbies?platform=web`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) =>
+      this.frames.push(
+        decodeLobbyMessage(new Uint8Array(ev.data as ArrayBuffer)),
+      );
+    this.ws.onclose = () => (this.closed = true);
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () => reject(new Error("lobby socket error"));
+    });
+  }
+
+  async waitFor(
+    pred: (f: PublicLobbyMessage) => boolean,
+    timeoutMs = 15_000,
+  ): Promise<PublicLobbyMessage> {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const hit = this.frames.find(pred);
+      if (hit !== undefined) return hit;
+      if (Date.now() > deadline) throw new Error("lobby watcher timed out");
+      await sleep(100);
+    }
+  }
+
+  lobbies(): PublicGameInfo[] {
+    const last = [...this.frames].reverse().find((f) => f.type === "full");
+    if (last?.type !== "full") return [];
+    return Object.values(last.games).flat() as PublicGameInfo[];
+  }
+
+  close(): void {
+    this.ws.close();
+  }
+}
+
+class Player {
+  ws!: WebSocket;
+  ctx: ZbContext | undefined;
+  readonly inbox: ServerMessage[] = [];
+  closed: number | null = null;
+
+  constructor(readonly token: string) {}
+
+  async connect(): Promise<void> {
+    this.ws = new WebSocket(`${WS_BASE}/w0`);
+    this.ws.binaryType = "arraybuffer";
+    this.ws.onmessage = (ev) => {
+      const msg = decodeServerMessage(
+        new Uint8Array(ev.data as ArrayBuffer),
+        this.ctx,
+      );
+      if (msg.type === "start")
+        this.ctx = createGameWireContext(msg.gameStartInfo.players);
+      this.inbox.push(msg);
+    };
+    this.ws.onclose = (ev) => (this.closed = ev.code);
+    await new Promise<void>((resolve, reject) => {
+      this.ws.onopen = () => resolve();
+      this.ws.onerror = () => reject(new Error("game socket error"));
+    });
+  }
+
+  join(gameID: string, username: string): void {
+    this.ws.send(
+      encodeClientMessage(
+        {
+          type: "join",
+          token: this.token,
+          gameID,
+          username,
+          clanTag: null,
+          turnstileToken: null,
+          gitCommit: COMMIT,
+        },
+        undefined,
+      ),
+    );
+  }
+
+  async waitFor<T extends ServerMessage["type"]>(type: T, timeoutMs = 20_000) {
+    const deadline = Date.now() + timeoutMs;
+    for (;;) {
+      const hit = this.inbox.find((m) => m.type === type);
+      if (hit !== undefined) return hit as Extract<ServerMessage, { type: T }>;
+      if (this.closed !== null)
+        throw new Error(`closed ${this.closed} waiting for ${type}`);
+      if (Date.now() > deadline)
+        throw new Error(`timed out waiting for ${type}`);
+      await sleep(100);
+    }
+  }
+}
+
+async function recent(): Promise<
+  Array<{ gameId: string; status: string; playersPeak: number; kind: string }>
+> {
+  const r = await fetch(`${BASE}/api/lobbies/recent?limit=50`);
+  if (r.status !== 200)
+    throw new Error(`recent -> ${r.status} ${await r.text()}`);
+  return (
+    (await r.json()) as {
+      lobbies: Array<{
+        gameId: string;
+        status: string;
+        playersPeak: number;
+        kind: string;
+      }>;
+    }
+  ).lobbies;
+}
+
+async function main(): Promise<void> {
+  console.log(`public matchmaking test against ${BASE}`);
+
+  // --- the lobby browser's socket
+  const watcher = new LobbyWatcher();
+  await watcher.connect();
+  const first = await watcher.waitFor((f) => f.type === "full");
+  check(first.type === "full", "lobby socket sends a full snapshot on connect");
+  if (first.type !== "full") return;
+  const types = Object.keys(first.games).sort();
+  check(
+    types.join(",") === "ffa,team",
+    "snapshot has ffa and team queues",
+    types,
+  );
+  check(
+    first.gitCommit === COMMIT,
+    "snapshot carries the build commit",
+    first.gitCommit,
+  );
+  const ffa = first.games.ffa ?? [];
+  const team = first.games.team ?? [];
+  check(
+    ffa.length >= 2 && team.length >= 2,
+    "each queue holds the next lobbies",
+    [ffa.length, team.length],
+  );
+  check(ffa[0]?.startsAt !== undefined, "the head lobby is on a countdown");
+  check(ffa[1]?.startsAt === undefined, "the lobby behind it is not");
+  check(ffa[0]?.gameConfig?.gameType === "Public", "lobbies are public games");
+  check(
+    ffa[0]?.gameConfig?.gameMode === "Free For All" &&
+      team[0]?.gameConfig?.gameMode === "Team",
+    "ffa/team modes match their queue",
+  );
+
+  // Lobbies are slots of the clock: join one with time left on it, or the countdown
+  // can run out between reading the list and connecting. If it is nearly over, take
+  // the next head, which arrives in a fresh full frame at the slot boundary.
+  let lobbies = ffa;
+  if (lobbies[0]!.startsAt! - Date.now() < 3_500) {
+    const old = lobbies[0]!.gameID;
+    const next = await watcher.waitFor(
+      (f) => f.type === "full" && f.games.ffa?.[0]?.gameID !== old,
+    );
+    if (next.type === "full") lobbies = next.games.ffa!;
+  }
+  const target = lobbies[0]!;
+  // The lobby behind the one we join: nobody enters it.
+  const queuedId = lobbies[1]!.gameID;
+  const countdownMs = target.startsAt! - Date.now();
+  check(
+    countdownMs > 0 && countdownMs <= 9_000,
+    "countdown matches PUBLIC_LOBBY_SECONDS",
+    countdownMs,
+  );
+
+  // --- join the lobby that is counting down
+  const p1 = new Player(crypto.randomUUID());
+  const p2 = new Player(crypto.randomUUID());
+  await p1.connect();
+  await p2.connect();
+  p1.join(target.gameID, "Alice");
+  p2.join(target.gameID, "Bob");
+  const info = await p1.waitFor("lobby_info");
+  check(
+    info.lobby.publicGameType === "ffa",
+    "player sees the public lobby's info",
+  );
+
+  const counted = await watcher.waitFor(
+    (f) => f.type === "counts" && f.counts[target.gameID] === 2,
+  );
+  check(
+    counted.type === "counts",
+    "browser is told the lobby now has 2 players",
+  );
+
+  // --- the game starts by itself when the countdown ends
+  await p1.waitFor("prestart");
+  check(true, "prestart is sent when the countdown ends");
+  const start = await p1.waitFor("start");
+  await p2.waitFor("start");
+  check(
+    start.gameStartInfo.players.length === 2,
+    "game starts with both players",
+    start.gameStartInfo.players.length,
+  );
+  check(
+    start.gameStartInfo.config.gameType === "Public",
+    "started game is public",
+  );
+
+  // --- the started lobby leaves the list and the queue refills
+  const after = await watcher.waitFor(
+    (f) =>
+      f.type === "full" &&
+      !(Object.values(f.games).flat() as PublicGameInfo[]).some(
+        (g) => g.gameID === target.gameID,
+      ),
+  );
+  const remaining = Object.values(
+    (after as Extract<PublicLobbyMessage, { type: "full" }>).games,
+  ).flat() as PublicGameInfo[];
+  check(
+    !remaining.some((g) => g.gameID === target.gameID),
+    "started lobby is removed from the browser",
+  );
+  check(
+    (after as Extract<PublicLobbyMessage, { type: "full" }>).games.ffa
+      ?.length === 2,
+    "the ffa queue is refilled",
+  );
+  const next = (after as Extract<PublicLobbyMessage, { type: "full" }>).games
+    .ffa?.[0];
+  check(next?.startsAt !== undefined, "the next lobby starts its countdown");
+
+  // --- the game relays turns
+  const turn = await p1.waitFor("turn");
+  check(turn.type === "turn", "turns flow in the public game");
+
+  // --- D1 recorded it
+  await sleep(500);
+  const rows = await recent();
+  const row = rows.find((r) => r.gameId === target.gameID);
+  check(
+    row !== undefined && row.status === "started",
+    "D1: game recorded as started",
+    row,
+  );
+  check(row?.playersPeak === 2, "D1: peak players recorded", row?.playersPeak);
+  // Only lobbies someone entered are recorded; an unvisited one leaves no row.
+  check(
+    !rows.some((r) => r.gameId === queuedId),
+    "D1: a lobby nobody entered is not recorded",
+  );
+
+  // --- finish: everyone leaves, the empty-game reaper ends it
+  p1.ws.close();
+  p2.ws.close();
+  if (SKIP_REAP) {
+    console.log("  --  skipping the reaper check (SKIP_REAP=1)");
+  } else {
+    console.log("  ..  waiting for the empty-game reaper (~35 s) ...");
+    const deadline = Date.now() + 70_000;
+    let ended = row;
+    while (Date.now() < deadline) {
+      await sleep(2_000);
+      ended = (await recent()).find((r) => r.gameId === target.gameID);
+      if (ended?.status === "finished") break;
+    }
+    check(
+      ended?.status === "finished",
+      "D1: game recorded as finished after it emptied",
+      ended,
+    );
+  }
+
+  watcher.close();
+}
+
+main()
+  .then(() => {
+    console.log(failed ? "\nPUBLIC SMOKE FAILED" : "\nPUBLIC SMOKE PASSED");
+    process.exit(failed ? 1 : 0);
+  })
+  .catch((e) => {
+    console.error("\nPUBLIC SMOKE ERROR:", e instanceof Error ? e.message : e);
+    process.exit(1);
+  });
