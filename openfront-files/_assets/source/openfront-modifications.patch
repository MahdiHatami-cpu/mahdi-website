diff --git a/tests/NightmareDifficulty.test.ts b/tests/NightmareDifficulty.test.ts
new file mode 100644
index 0000000..0e901e6
--- /dev/null
+++ b/tests/NightmareDifficulty.test.ts
@@ -0,0 +1,236 @@
+/**
+ * The Nightmare difficulty: the level above Impossible.
+ *
+ * Nightmare plays by Impossible's rules (Config.ruleDifficulty) and adds a bigger economy and army, a
+ * decision cadence about twice as fast, and sharper MIRV, nuke, SAM and naval behaviour (each behind
+ * Config.isNightmare). Three kinds of check:
+ *
+ *  - the numbers: what a Nightmare nation starts with and may hold, against the four older levels;
+ *  - the wiring: the other four levels are exactly as before (they never see isNightmare);
+ *  - the claim: the same seeded game, only the difficulty changed, grows faster the higher the level.
+ *    Nations at every level are all of one difficulty (difficulty is a game setting, not a player's),
+ *    so "stronger" is measured as how much land and army they raise in the same time.
+ */
+import {
+  Cell,
+  Difficulty,
+  Nation,
+  PlayerInfo,
+  PlayerType,
+} from "@openfront/engine-api/game/GameTypes";
+import { Difficulty as D } from "@openfront/engine-api/game/GameTypes";
+import { GameConfigSchema } from "@openfront/engine-api/Schemas";
+import { EngineConfig } from "@openfront/engine/configuration/EngineConfig";
+import { NationExecution } from "@openfront/engine/execution/NationExecution";
+import { Game } from "@openfront/engine/game/Game";
+import { describe, expect, it } from "vitest";
+import { setup } from "./util/Setup";
+
+const GAME_ID = "nightmare-difficulty";
+
+describe("Nightmare: the level and its numbers", () => {
+  it("is the last level, so the older ones keep their wire numbers", () => {
+    expect(Object.values(Difficulty)).toEqual([
+      "Easy",
+      "Medium",
+      "Hard",
+      "Impossible",
+      "Nightmare",
+    ]);
+  });
+
+  it("is accepted wherever a game setting is parsed", () => {
+    const parsed = GameConfigSchema.shape.difficulty.safeParse("Nightmare");
+    expect(parsed.success).toBe(true);
+  });
+
+  async function configFor(difficulty: Difficulty) {
+    const game = await setup(
+      "plains",
+      { difficulty },
+      [],
+      undefined,
+      EngineConfig,
+    );
+    return game.config();
+  }
+
+  it("plays by Impossible's rules and says so only for itself", async () => {
+    const nightmare = await configFor(D.Nightmare);
+    expect(nightmare.isNightmare()).toBe(true);
+    expect(nightmare.ruleDifficulty()).toBe(D.Impossible);
+    for (const d of [D.Easy, D.Medium, D.Hard, D.Impossible] as const) {
+      const c = await configFor(d);
+      expect(c.isNightmare()).toBe(false);
+      expect(c.ruleDifficulty()).toBe(d);
+    }
+  });
+
+  it("gives a nation a bigger army and faster growth than any older level", async () => {
+    const info = new PlayerInfo("n", PlayerType.Nation, null, "n");
+    const start: number[] = [];
+    for (const d of [D.Easy, D.Medium, D.Hard, D.Impossible, D.Nightmare]) {
+      start.push((await configFor(d)).startManpower(info));
+    }
+    // 12,500 / 18,750 / 25,000 / 31,250, then 40,000 (160% of a human's 25,000)
+    expect(start).toEqual([12_500, 18_750, 25_000, 31_250, 40_000]);
+    expect(start[4] / 25_000).toBe(1.6);
+  });
+
+  it("makes a Nightmare nation earn half as much gold again, and only nations", async () => {
+    const game = await setup(
+      "plains",
+      { difficulty: D.Nightmare },
+      [new PlayerInfo("human", PlayerType.Human, "c1", "human-1")],
+      undefined,
+      EngineConfig,
+    );
+    const impossible = await setup(
+      "plains",
+      { difficulty: D.Impossible },
+      [new PlayerInfo("human", PlayerType.Human, "c1", "human-1")],
+      undefined,
+      EngineConfig,
+    );
+    const nation = new PlayerInfo(
+      "nation",
+      PlayerType.Nation,
+      null,
+      "nation-1",
+    );
+    const a = game.addPlayer(nation);
+    const b = impossible.addPlayer(nation);
+    const humanA = game.player("human-1");
+    const humanB = impossible.player("human-1");
+    const nightmareGold = Number(game.config().tradeShipGold(100, a));
+    const impossibleGold = Number(impossible.config().tradeShipGold(100, b));
+    expect(nightmareGold / impossibleGold).toBeCloseTo(1.5, 2);
+    // a human gets no bonus
+    expect(Number(game.config().tradeShipGold(100, humanA))).toBe(
+      Number(impossible.config().tradeShipGold(100, humanB)),
+    );
+  });
+});
+
+// ---------------------------------------------------------------- the claim
+
+/** Eight nations spread over an empty 200x200 field. */
+function field(): Nation[] {
+  const spots: [number, number][] = [
+    [30, 30],
+    [100, 30],
+    [170, 30],
+    [30, 100],
+    [170, 100],
+    [30, 170],
+    [100, 170],
+    [170, 170],
+  ];
+  return spots.map(
+    ([x, y], i) =>
+      new Nation(
+        new Cell(x, y),
+        new PlayerInfo(`Nation ${i}`, PlayerType.Nation, null, `nation_${i}`),
+      ),
+  );
+}
+
+interface Outcome {
+  difficulty: Difficulty;
+  /** Land owned by all nations together, after 100 and after 200 ticks (10 and 20 seconds). */
+  tiles100: number;
+  tiles200: number;
+  troops200: number;
+  alive: number;
+}
+
+async function race(difficulty: Difficulty, ticks: number): Promise<Outcome> {
+  const nations = field();
+  const game: Game = await setup(
+    "big_plains",
+    { difficulty, bots: 0 },
+    [],
+    undefined,
+    EngineConfig,
+    false, // keep the spawn phase open so nations place themselves
+    nations,
+  );
+  for (const nation of nations) {
+    game.addExecution(new NationExecution(GAME_ID, nation));
+  }
+  for (
+    let i = 0;
+    i < 100 && game.allPlayers().some((p) => !p.hasSpawned());
+    i++
+  ) {
+    game.executeNextTick();
+  }
+  game.endSpawnPhase();
+  const nationPlayers = () =>
+    game.allPlayers().filter((p) => p.type() === PlayerType.Nation);
+  const tiles = () =>
+    nationPlayers().reduce((n, p) => n + p.numTilesOwned(), 0);
+  let tiles100 = 0;
+  for (let t = 1; t <= ticks; t++) {
+    game.executeNextTick();
+    if (t === 100) tiles100 = tiles();
+  }
+  return {
+    difficulty,
+    tiles100,
+    tiles200: tiles(),
+    troops200: nationPlayers().reduce((n, p) => n + Number(p.troops()), 0),
+    alive: nationPlayers().filter((p) => p.isAlive()).length,
+  };
+}
+
+describe("Nightmare: the same game, only the difficulty changed", () => {
+  it("grows faster the higher the level", { timeout: 280_000 }, async () => {
+    const results: Outcome[] = [];
+    // 200 ticks: after that the empty field is nearly all claimed and the levels tie at 40,000.
+    for (const d of [D.Medium, D.Hard, D.Impossible, D.Nightmare]) {
+      results.push(await race(d, 200));
+    }
+    // The table is the point of the test: it shows by how much.
+    console.log(
+      "8 nations on an empty 200x200 field, same seed, only the difficulty differs:\n" +
+        results
+          .map(
+            (r) =>
+              `  ${r.difficulty.padEnd(11)} land after 10 s ${String(r.tiles100).padStart(6)}   after 20 s ${String(r.tiles200).padStart(6)}   army ${String(Math.round(r.troops200)).padStart(8)}`,
+          )
+          .join("\n"),
+    );
+    const by = Object.fromEntries(results.map((r) => [r.difficulty, r]));
+    for (const key of ["tiles100", "tiles200", "troops200"] as const) {
+      expect(by.Hard[key], `Hard vs Medium (${key})`).toBeGreaterThan(
+        by.Medium[key],
+      );
+      expect(by.Impossible[key], `Impossible vs Hard (${key})`).toBeGreaterThan(
+        by.Hard[key],
+      );
+      expect(
+        by.Nightmare[key],
+        `Nightmare vs Impossible (${key})`,
+      ).toBeGreaterThan(by.Impossible[key]);
+    }
+    // Not a rounding error above Impossible: a fifth more land after 10 seconds, a tenth after 20,
+    // and half as big an army again.
+    expect(by.Nightmare.tiles100).toBeGreaterThan(by.Impossible.tiles100 * 1.2);
+    expect(by.Nightmare.tiles200).toBeGreaterThan(by.Impossible.tiles200 * 1.1);
+    expect(by.Nightmare.troops200).toBeGreaterThan(
+      by.Impossible.troops200 * 1.3,
+    );
+    expect(by.Nightmare.alive).toBe(8);
+  });
+
+  it(
+    "is deterministic: the same game twice gives the same result",
+    { timeout: 280_000 },
+    async () => {
+      const a = await race(D.Nightmare, 150);
+      const b = await race(D.Nightmare, 150);
+      expect(b).toEqual(a);
+    },
+  );
+});
