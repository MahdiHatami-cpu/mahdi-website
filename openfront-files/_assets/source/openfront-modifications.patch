+"""Build resources/images/terrain-detail.webp from four photographs.
+
+The renderer (src/client/render/gl/passes/TerrainPass.ts) multiplies the flat
+terrain colours by a tiling luminance "detail" map, so themes and graphics
+overrides keep working and only the surface texture comes from the photos.
+
+Output: one 1024x1024 grayscale atlas, 2x2 tiles of 512x512 (layer order is
+fixed by LAYERS in src/client/render/gl/utils/TerrainDetail.ts):
+
+    sea    | grass
+    desert | snow
+
+Each tile is the photo's luminance with the broad lighting gradient removed,
+made seamless, evened out and scaled to a stored value of 128 + 36 * z, where
+z is the detail in standard deviations (clipped to +-3.5). 128 means "no
+change", so the texture never shifts the average colour.
+
+Seams use Moisan's periodic-plus-smooth decomposition: a smooth field that
+cancels the edge-to-edge jump is subtracted, so the picture is untouched except
+in a thin band at the edges (a cross-fade would leave visible ghost patches).
+
+Usage (needs Pillow, numpy, scipy):
+    python make_terrain_detail.py --sea sea.jpg --grass grass.jpg \
+        --desert desert.jpg --snow snow.jpg --out resources/images/terrain-detail.webp
+Crops are in source pixels (x,y,size); pass --sea-crop etc. to change them.
+"""
+import argparse
+import io
+
+import numpy as np
+from PIL import Image
+from scipy.ndimage import gaussian_filter
+
+TILE = 512
+Z_SCALE = 36.0  # stored = 128 + Z_SCALE * z; keep in sync with terrain.frag.glsl
+WEBP_QUALITY = 80
+
+
+def luma(path):
+    a = np.asarray(Image.open(path).convert("RGB"), dtype=np.float32)
+    return 0.299 * a[..., 0] + 0.587 * a[..., 1] + 0.114 * a[..., 2]
+
+
+def resize(img, n):
+    f = Image.fromarray(np.ascontiguousarray(img, dtype=np.float32), mode="F")
+    return np.asarray(f.resize((n, n), Image.LANCZOS), dtype=np.float64)
+
+
+def periodic_component(u):
+    m, k = u.shape
+    v = np.zeros_like(u)
+    v[0, :] += u[-1, :] - u[0, :]
+    v[-1, :] += u[0, :] - u[-1, :]
+    v[:, 0] += u[:, -1] - u[:, 0]
+    v[:, -1] += u[:, 0] - u[:, -1]
+    q = np.arange(m)[:, None]
+    r = np.arange(k)[None, :]
+    den = 2 * np.cos(2 * np.pi * q / m) + 2 * np.cos(2 * np.pi * r / k) - 4
+    den[0, 0] = 1.0
+    s = np.fft.fft2(v) / den
+    s[0, 0] = 0
+    return u - np.real(np.fft.ifft2(s))
+
+
+def prepare(img, crop, presmooth, hp_sigma, even_out):
+    x, y, s = crop
+    t = img[y:y + s, x:x + s].astype(np.float64)
+    t = resize(gaussian_filter(t, presmooth), TILE)
+    t = periodic_component(t)
+    t = t - gaussian_filter(t, hp_sigma, mode="wrap")  # drop gradients / big blotches
+    if even_out > 0:  # level out calm vs rough areas
+        local = np.sqrt(gaussian_filter(t * t, 56, mode="wrap")) + 1e-6
+        t = t / local ** even_out
+    t = t - t.mean()
+    z = np.clip(t / t.std(), -3.5, 3.5)
+    return (128 + Z_SCALE * z).round().clip(0, 255).astype(np.uint8)
+
+
+def crop_arg(text):
+    x, y, s = (int(v) for v in text.split(","))
+    return x, y, s
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    for name, default in (("sea", "1097,0,1024"), ("grass", "0,0,1024"), ("desert", "0,0,600"), ("snow", "167,0,665")):
+        p.add_argument("--" + name, required=True, help="photo for the %s layer" % name)
+        p.add_argument("--%s-crop" % name, type=crop_arg, default=crop_arg(default), help="x,y,size (default %s)" % default)
+    p.add_argument("--out", required=True)
+    a = p.parse_args()
+
+    # (presmooth px, high-pass sigma px, evening exponent) per layer
+    tiles = [
+        prepare(luma(a.sea), a.sea_crop, 0.6, 40, 0.8),
+        prepare(luma(a.grass), a.grass_crop, 0.6, 48, 0.0),
+        prepare(luma(a.desert), a.desert_crop, 1.0, 40, 0.5),
+        prepare(luma(a.snow), a.snow_crop, 0.6, 48, 0.8),
+    ]
+    atlas = np.zeros((2 * TILE, 2 * TILE), np.uint8)
+    for i, t in enumerate(tiles):
+        atlas[(i // 2) * TILE:(i // 2 + 1) * TILE, (i % 2) * TILE:(i % 2 + 1) * TILE] = t
+    buf = io.BytesIO()
+    Image.fromarray(atlas, "L").save(buf, "WEBP", quality=WEBP_QUALITY, method=6)
+    with open(a.out, "wb") as f:
+        f.write(buf.getvalue())
+    print("wrote %s (%d KB)" % (a.out, len(buf.getvalue()) // 1024))
+
+
+if __name__ == "__main__":
+    main()
