diff --git a/cloudflare/scripts/accounts-browser-smoke.ts b/cloudflare/scripts/accounts-browser-smoke.ts
new file mode 100644
index 0000000..902eebe
--- /dev/null
+++ b/cloudflare/scripts/accounts-browser-smoke.ts
@@ -0,0 +1,243 @@
+// Signs in through the real web client, in a real browser, against a local copy of the Worker
+// (the same one scripts/accounts-smoke.ts uses, with stand-ins for Google and the mail service).
+//
+//   npm run build:site -- --skip-vite     # a page built for localhost, accounts on
+//   npm run smoke:accounts:browser
+//
+// What it checks that the HTTP test cannot: that the client's own sign-in screen drives the API
+// correctly (the email form, the emailed link, the Google button), that the client accepts the
+// token and profile it gets back and shows the account, that the buttons this site does not
+// offer are hidden, and that the page's guard lets the right calls through.
+
+import fs from "node:fs";
+import path from "node:path";
+import { type Browser, type BrowserContext, chromium, type Page } from "playwright-core";
+import { BASE, MOCK, mails, withTestWorker } from "./accounts-harness";
+import { noAccountApiScript } from "./third-party";
+
+const CHROME =
+  process.env.CHROME ?? "C:/Program Files/Google/Chrome/Application/chrome.exe";
+const SHOTS = process.env.SHOTS ?? path.resolve(import.meta.dirname, "../.shots");
+fs.mkdirSync(SHOTS, { recursive: true });
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  console.log(
+    `${ok ? "  ok  " : " FAIL "} ${label}${ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`}`,
+  );
+  if (!ok) failed = true;
+}
+const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
+
+/** What the client logs when it cannot make sense of what the API sent. */
+function watch(page: Page, problems: string[]): void {
+  // The account API's answers, so a failure below can be read against what the page was told.
+  page.on("response", (r) => {
+    const u = new URL(r.url());
+    if (/^\/(auth|users)\//.test(u.pathname)) {
+      console.log(`        net: ${r.request().method()} ${u.pathname} -> ${r.status()}`);
+    }
+  });
+  page.on("console", (m) => {
+    if (m.type() === "error" && /Invalid (response|payload)|unexpected "(iss|aud)"/.test(m.text())) {
+      problems.push(m.text().slice(0, 300));
+    }
+  });
+  page.on("pageerror", (e) => {
+    const stack = (e.stack ?? e.message).split("\n").slice(0, 3).join(" | ");
+    if (/KeyboardLayout|keyboard\.addEventListener/.test(stack)) return; // this Chrome, not us
+    problems.push(`pageerror: ${stack}`);
+  });
+}
+
+async function buttons(page: Page): Promise<{ discord: boolean; steam: boolean; google: boolean; steamBlock: boolean }> {
+  return page.evaluate(() => {
+    const visible = (el: Element) =>
+      !!(el as HTMLElement).offsetParent && getComputedStyle(el).display !== "none";
+    const all = [...document.querySelectorAll("account-modal button")];
+    const has = (needle: string) =>
+      all.some((b) => String(b.getAttribute("class")).includes(needle) && visible(b));
+    return {
+      discord: has("5865F2"),
+      steam: has("1b2838"),
+      google: has("dadce0"),
+      steamBlock: [...document.querySelectorAll("account-modal div.gap-1")].some(
+        (d) => d.querySelector(":scope > button[class*='1b2838']") !== null && visible(d),
+      ),
+    };
+  });
+}
+
+/**
+ * A browser context for the test. tsx compiles this file with esbuild, which wraps named
+ * functions in a `__name` helper; functions handed to page.evaluate run inside the page,
+ * which has no such helper, so it is supplied there.
+ */
+async function newContext(
+  browser: Browser,
+  options: { viewport?: { width: number; height: number } },
+): Promise<BrowserContext> {
+  const ctx = await browser.newContext({ ...options, serviceWorkers: "block" });
+  // A page built for localhost looks for its API on port 8787 unless told otherwise
+  // (getApiBase in the client reads this key); the test Worker listens elsewhere.
+  await ctx.addInitScript(
+    `window.__name = (f) => f; try { localStorage.setItem("apiHost", ${JSON.stringify(BASE)}); } catch (e) {}`,
+  );
+  return ctx;
+}
+
+async function accountText(page: Page, needle: string, ms = 60_000): Promise<boolean> {
+  return page
+    .waitForFunction(
+      (n) => document.querySelector("account-modal")?.textContent?.includes(n) ?? false,
+      needle,
+      { timeout: ms },
+    )
+    .then(() => true)
+    .catch(() => false);
+}
+
+async function run(): Promise<void> {
+  const browser = await chromium.launch({
+    executablePath: CHROME,
+    headless: true,
+    args: ["--no-sandbox", "--enable-unsafe-swiftshader", "--use-angle=swiftshader", "--ignore-gpu-blocklist"],
+  });
+  const problems: string[] = [];
+  try {
+    // ---------------------------------------------------- email, start to finish
+    const ctx = await newContext(browser, { viewport: { width: 1400, height: 1000 } });
+    const page = await ctx.newPage();
+    watch(page, problems);
+    await page.goto(`${BASE}/#modal=account`);
+    const emailBox = await page
+      .waitForSelector("account-modal input[type=email]", { state: "visible", timeout: 90_000 })
+      .catch(() => null);
+    check(emailBox !== null, "the sign-in screen opens for a guest");
+    const shown = await buttons(page);
+    check(shown.google && !shown.discord && !shown.steam, "only Google is offered of the three provider buttons", shown);
+    await page.screenshot({ path: path.join(SHOTS, "accounts-1-signin.png") });
+
+    await page.fill("account-modal input[type=email]", "alice@example.test");
+    await page.click("account-modal o-button");
+    const deadline = Date.now() + 15_000;
+    while (mails.length === 0 && Date.now() < deadline) await sleep(100);
+    check(mails.length === 1 && mails[0]!.to === "alice@example.test", "the client's email form asks the API, which sends the link");
+    const link = /(https?:\/\/[^\s"<]+#token-login\?token-login=[A-Za-z0-9_-]+)/.exec(mails[0]?.text ?? "")?.[1];
+    check(link !== undefined && link.startsWith(`${BASE}/#token-login`), "the link in the mail opens this site's token-login route", link);
+    await page.screenshot({ path: path.join(SHOTS, "accounts-2-link-sent.png") });
+
+    // The person opens the emailed link: a new tab on the same browser.
+    const tab = await ctx.newPage();
+    watch(tab, problems);
+    await tab.goto(link!);
+    const cookieDeadline = Date.now() + 90_000;
+    let cookies = await ctx.cookies(BASE);
+    while (!cookies.some((c) => c.name === "of_session") && Date.now() < cookieDeadline) {
+      await sleep(250);
+      cookies = await ctx.cookies(BASE);
+    }
+    const session = cookies.find((c) => c.name === "of_session");
+    check(session !== undefined && session.httpOnly === true, "opening the link signs the browser in (an HttpOnly session cookie)");
+    check(cookies.some((c) => c.name === "of_signed_in" && c.value === "1" && !c.httpOnly), "and sets the readable signed-in hint");
+    await sleep(3500); // the client reloads itself a second after success
+    await tab.screenshot({ path: path.join(SHOTS, "accounts-3-after-link.png") });
+    check(!(await tab.evaluate(() => document.cookie)).includes("of_session"), "the page's own JavaScript cannot see the session cookie");
+
+    await tab.goto(`${BASE}/#modal=account`);
+    await tab.reload();
+    check(await accountText(tab, "alice@example.test"), "the client takes the token and profile and shows the signed-in account");
+    const after = await buttons(tab);
+    check(!after.steam && !after.steamBlock && after.google, "no Steam link (hidden); Google can be linked", after);
+    await tab.screenshot({ path: path.join(SHOTS, "accounts-4-signed-in.png") });
+
+    // Link Google from the account screen, as a signed-in person.
+    await tab.click("account-modal button[class*='dadce0']");
+    const googleUrl = await tab.waitForRequest((r) => r.url().startsWith(`${MOCK}/google/auth`), { timeout: 20_000 }).then((r) => r.url()).catch(() => null);
+    check(googleUrl !== null, "Link Google takes the signed-in person to Google");
+    if (googleUrl !== null) {
+      const state = new URL(googleUrl).searchParams.get("state")!;
+      // Let the trip to "Google" land before coming back from it, as a person would.
+      await tab.waitForURL((u) => u.toString().startsWith(MOCK), { waitUntil: "commit", timeout: 20_000 }).catch(() => {});
+      await tab.goto(`${BASE}/auth/callback/google?code=code-merge&state=${encodeURIComponent(state)}`, { waitUntil: "domcontentloaded" });
+      check(await accountText(tab, "alice@example.test"), "back from Google the account screen still shows the account");
+    }
+    await ctx.close();
+
+    // ----------------------------------------------------------- Google sign-in
+    const ctx2 = await newContext(browser, { viewport: { width: 1400, height: 1000 } });
+    const page2 = await ctx2.newPage();
+    watch(page2, problems);
+    await page2.goto(`${BASE}/#modal=account`);
+    await page2.waitForSelector("account-modal button[class*='dadce0']", { state: "visible", timeout: 90_000 });
+    const wait = page2.waitForRequest((r) => r.url().startsWith(`${MOCK}/google/auth`), { timeout: 20_000 }).then((r) => r.url()).catch(() => null);
+    await page2.click("account-modal button[class*='dadce0']");
+    const toGoogle = await wait;
+    check(toGoogle !== null, "the Google button sends a guest to Google");
+    if (toGoogle !== null) {
+      const state = new URL(toGoogle).searchParams.get("state")!;
+      await page2.waitForURL((u) => u.toString().startsWith(MOCK), { waitUntil: "commit", timeout: 20_000 }).catch(() => {});
+      await page2.goto(`${BASE}/auth/callback/google?code=code-new&state=${encodeURIComponent(state)}`, { waitUntil: "domcontentloaded" });
+      check(await accountText(page2, "bob@example.test"), "back from Google, the client shows the Google account");
+      await page2.screenshot({ path: path.join(SHOTS, "accounts-5-google.png") });
+      const cookies2 = await ctx2.cookies(BASE);
+      check(cookies2.some((c) => c.name === "of_session") && !cookies2.some((c) => c.name === "of_oauth"), "the sign-in cookie is set and the one-time cookie is gone");
+    }
+    await ctx2.close();
+
+    // ----------------------------------------------------- the page's guard
+    // The script that goes into the production page (api.<host> is not reachable from here, so
+    // the real fetch is replaced by a stand-in and the guard is put in front of it).
+    const ctx3 = await newContext(browser, {});
+    const page3 = await ctx3.newPage();
+    await page3.goto(`${BASE}/commit.txt`);
+    const body = /<script id="cf-no-account-api">([\s\S]*?)<\/script>/.exec(noAccountApiScript("https://api.site.test", true))![1]!;
+    await page3.evaluate(() => {
+      (window as unknown as { fetch: unknown }).fetch = (u: string) => Promise.resolve(`through:${u}`);
+    });
+    await page3.addScriptTag({ content: body });
+    const results = await page3.evaluate(async () => {
+      const out: Record<string, string> = {};
+      const probe = async (name: string, url: string) => {
+        try {
+          out[name] = String(await fetch(url));
+        } catch {
+          out[name] = "blocked";
+        }
+      };
+      await probe("refresh-guest", "https://api.site.test/auth/refresh");
+      document.cookie = "of_signed_in=1; path=/";
+      await probe("refresh-signed-in", "https://api.site.test/auth/refresh");
+      await probe("magic", "https://api.site.test/auth/magic-link");
+      await probe("token", "https://api.site.test/auth/login/token?login-token=x");
+      await probe("google", "https://api.site.test/auth/login/google?redirect_uri=x");
+      await probe("link", "https://api.site.test/auth/link/google?redirect_uri=x");
+      await probe("logout", "https://api.site.test/auth/logout");
+      await probe("profile", "https://api.site.test/users/@me");
+      await probe("profile-sub", "https://api.site.test/users/@me/notices");
+      await probe("cosmetics", "https://api.site.test/cosmetics.json?rail=1");
+      await probe("lookalike", "https://api.site.test.evil.example/auth/refresh");
+      await probe("elsewhere", "https://other.example/anything");
+      return out;
+    });
+    check(results["refresh-guest"] === "blocked", "guard: a visitor with no session never calls /auth/refresh", results);
+    check(results["refresh-signed-in"]?.startsWith("through:"), "guard: a signed-in browser does");
+    check(["magic", "token", "google", "link", "logout", "profile"].every((k) => results[k]?.startsWith("through:")), "guard: sign-in, sign-out and profile calls pass");
+    check(["profile-sub", "cosmetics"].every((k) => results[k] === "blocked"), "guard: the rest of the closed-source API is still blocked at once");
+    check(results["elsewhere"]?.startsWith("through:") && results["lookalike"]?.startsWith("through:"), "guard: other addresses are untouched");
+    await ctx3.close();
+
+    check(problems.length === 0, "the client logged no 'invalid response / token' errors and the page threw nothing", problems);
+  } finally {
+    await browser.close();
+  }
+}
+
+async function main(): Promise<void> {
+  const completed = await withTestWorker(run);
+  const ok = completed && !failed;
+  console.log(ok ? "\nall browser account checks passed" : "\nFAILED");
+  process.exit(ok ? 0 : 1);
+}
+
+void main();
diff --git a/cloudflare/scripts/accounts-harness.ts b/cloudflare/scripts/accounts-harness.ts
new file mode 100644
index 0000000..49bd310
--- /dev/null
+++ b/cloudflare/scripts/accounts-harness.ts
@@ -0,0 +1,218 @@
+// Shared by the account tests (accounts-smoke.ts, accounts-browser-smoke.ts): a local copy of
+// the Worker on its own port with a fresh database and test secrets, plus stand-ins for
+// Google (authorize/token/userinfo) and Brevo's mail API, so every route runs for real and
+// nothing is sent to anyone.
+
+import { execFileSync, spawn, type ChildProcess } from "node:child_process";
+import fs from "node:fs";
+import http from "node:http";
+import os from "node:os";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+export const here = path.dirname(fileURLToPath(import.meta.url));
+export const root = path.resolve(here, "..");
+export const PORT = Number(process.env.PORT ?? "8797");
+export const MOCK_PORT = PORT + 1;
+export const BASE = `http://localhost:${PORT}`;
+export const MOCK = `http://localhost:${MOCK_PORT}`;
+export const SECRET = "test-secret-not-used-anywhere-else-0123456789";
+
+// ------------------------------------------------------------------ stand-ins
+
+export interface Mail {
+  to: string;
+  subject: string;
+  html: string;
+  text: string;
+  from: string;
+}
+export const mails: Mail[] = [];
+
+/** code -> who Google says that is */
+export const GOOGLE_PEOPLE: Record<string, { sub: string; email: string; email_verified: boolean }> = {
+  "code-merge": { sub: "g-1", email: "alice@example.test", email_verified: true },
+  "code-new": { sub: "g-2", email: "bob@example.test", email_verified: true },
+  "code-unverified": { sub: "g-3", email: "carol@example.test", email_verified: false },
+  // A work address: what "Link Google" attaches to an account that signed in by email.
+  "code-link": { sub: "g-5", email: "frank.work@example.test", email_verified: true },
+  // Same address as alice, but a different Google identity than the one already attached.
+  "code-clash": { sub: "g-9", email: "alice@example.test", email_verified: true },
+};
+
+export function startMock(): Promise<http.Server> {
+  const server = http.createServer((req, res) => {
+    const chunks: Buffer[] = [];
+    req.on("data", (c: Buffer) => chunks.push(c));
+    req.on("end", () => {
+      const body = Buffer.concat(chunks).toString("utf8");
+      const url = new URL(req.url ?? "/", MOCK);
+      const send = (status: number, data: unknown) => {
+        res.writeHead(status, { "content-type": "application/json" });
+        res.end(JSON.stringify(data));
+      };
+
+      if (req.method === "POST" && url.pathname === "/brevo") {
+        if (req.headers["api-key"] !== "test-brevo-key") return send(401, { message: "key" });
+        const m = JSON.parse(body) as {
+          sender: { email: string };
+          to: { email: string }[];
+          subject: string;
+          htmlContent: string;
+          textContent: string;
+        };
+        if (m.to[0]!.email.startsWith("fail@")) return send(400, { message: "rejected" });
+        mails.push({
+          to: m.to[0]!.email,
+          subject: m.subject,
+          html: m.htmlContent,
+          text: m.textContent,
+          from: m.sender.email,
+        });
+        return send(201, { messageId: "<test>" });
+      }
+
+      if (req.method === "POST" && url.pathname === "/google/token") {
+        const f = new URLSearchParams(body);
+        const person = GOOGLE_PEOPLE[f.get("code") ?? ""];
+        if (
+          person === undefined ||
+          f.get("client_id") !== "test-client" ||
+          f.get("client_secret") !== "test-client-secret" ||
+          f.get("grant_type") !== "authorization_code" ||
+          f.get("redirect_uri") !== `${BASE}/auth/callback/google`
+        ) {
+          return send(400, { error: "invalid_grant" });
+        }
+        return send(200, { access_token: `at-${f.get("code")}` });
+      }
+
+      if (req.method === "GET" && url.pathname === "/google/userinfo") {
+        const code = (req.headers.authorization ?? "").replace("Bearer at-", "");
+        const person = GOOGLE_PEOPLE[code];
+        return person === undefined ? send(401, {}) : send(200, person);
+      }
+      send(404, {});
+    });
+  });
+  return new Promise((resolve) => server.listen(MOCK_PORT, () => resolve(server)));
+}
+
+// ---------------------------------------------------------------------- worker
+
+export const wranglerBin = path.join(root, "node_modules", "wrangler", "bin", "wrangler.js");
+
+export function startWorker(persist: string): { child: ChildProcess; log: () => string } {
+  const vars: Record<string, string> = {
+    JWT_SECRET: SECRET,
+    GOOGLE_CLIENT_ID: "test-client",
+    GOOGLE_CLIENT_SECRET: "test-client-secret",
+    GOOGLE_AUTH_URL: `${MOCK}/google/auth`,
+    GOOGLE_TOKEN_URL: `${MOCK}/google/token`,
+    GOOGLE_USERINFO_URL: `${MOCK}/google/userinfo`,
+    BREVO_API_KEY: "test-brevo-key",
+    BREVO_API_URL: `${MOCK}/brevo`,
+    MAIL_FROM: "login@example.test",
+  };
+  // --local-upstream: with custom-domain routes configured, wrangler dev otherwise shows the
+  // Worker the first route's hostname instead of the one the request was made to, and the
+  // account API (which works out its addresses from the host) would not recognise localhost.
+  const args = [
+    wranglerBin,
+    "dev",
+    "--port",
+    String(PORT),
+    "--local-upstream",
+    `localhost:${PORT}`,
+    "--persist-to",
+    persist,
+  ];
+  for (const [k, v] of Object.entries(vars)) args.push("--var", `${k}:${v}`);
+  const child = spawn(process.execPath, args, {
+    cwd: root,
+    env: { ...process.env, WRANGLER_SEND_METRICS: "false", NO_COLOR: "1" },
+    stdio: ["ignore", "pipe", "pipe"],
+  });
+  let out = "";
+  child.stdout?.on("data", (d: Buffer) => (out += d.toString()));
+  child.stderr?.on("data", (d: Buffer) => (out += d.toString()));
+  return { child, log: () => out };
+}
+
+export async function waitUntilUp(): Promise<void> {
+  const deadline = Date.now() + 120_000;
+  while (Date.now() < deadline) {
+    try {
+      const r = await fetch(`${BASE}/api/health`);
+      if (r.ok) return;
+    } catch {
+      // not yet
+    }
+    await new Promise((r) => setTimeout(r, 500));
+  }
+  throw new Error("the Worker did not come up");
+}
+
+/** Where the running test Worker keeps its database (set by withTestWorker). */
+export let persistDir = "";
+
+/** Runs SQL against the running test Worker's local database; returns the rows of the last statement. */
+export function d1Execute(sql: string): unknown[] {
+  // A Windows command line is limited to ~32 KB: long SQL goes through a file.
+  const file = sql.length > 4000 ? path.join(os.tmpdir(), `d1-${process.pid}-${Date.now()}.sql`) : null;
+  if (file !== null) fs.writeFileSync(file, sql);
+  try {
+    const out = execFileSync(
+      process.execPath,
+      [
+        wranglerBin, "d1", "execute", "openfront", "--local", "--persist-to", persistDir, "--json",
+        ...(file !== null ? ["--file", file] : ["--command", sql]),
+      ],
+      {
+        cwd: root,
+        encoding: "utf8",
+        env: { ...process.env, WRANGLER_SEND_METRICS: "false", CI: "1", NO_COLOR: "1" },
+      },
+    );
+    const parsed = JSON.parse(out) as { results?: unknown[] }[];
+    return parsed[parsed.length - 1]?.results ?? [];
+  } finally {
+    if (file !== null) fs.rmSync(file, { force: true });
+  }
+}
+
+/**
+ * Runs `body` against a fresh local Worker (database, stand-ins, test secrets) and tears it
+ * all down. Resolves true when `body` finished without throwing.
+ */
+export async function withTestWorker(body: () => Promise<void>): Promise<boolean> {
+  const persist = fs.mkdtempSync(path.join(os.tmpdir(), "of-accounts-"));
+  persistDir = persist;
+  console.log(`account test on ${BASE} (database in ${persist})`);
+  const mock = await startMock();
+  execFileSync(
+    process.execPath,
+    [wranglerBin, "d1", "migrations", "apply", "openfront", "--local", "--persist-to", persist],
+    {
+      cwd: root,
+      stdio: "pipe",
+      env: { ...process.env, WRANGLER_SEND_METRICS: "false", CI: "1", NO_COLOR: "1" },
+    },
+  );
+  const worker = startWorker(persist);
+  let ok = true;
+  try {
+    await waitUntilUp();
+    await body();
+  } catch (e) {
+    ok = false;
+    console.error(String(e));
+    console.error("---- worker log ----\n" + worker.log().slice(-4000));
+  } finally {
+    worker.child.kill();
+    mock.close();
+    await new Promise((r) => setTimeout(r, 500));
+    fs.rmSync(persist, { recursive: true, force: true });
+  }
+  return ok;
+}
diff --git a/cloudflare/scripts/accounts-smoke.ts b/cloudflare/scripts/accounts-smoke.ts
