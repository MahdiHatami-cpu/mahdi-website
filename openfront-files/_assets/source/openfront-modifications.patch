@@ -0,0 +1,26 @@
+// The sign-in screen, trimmed to what this site offers.
+//
+// The client's account screen has three provider buttons (Discord, Google, Steam) and an email
+// field. This site signs in with Google and an emailed link (src/accounts/), so the Discord and
+// Steam buttons would lead nowhere. They are hidden, not removed: the client's own code is not
+// touched, and a button that works (Google) keeps its place.
+//
+// The buttons are matched by the brand colour in their (Tailwind) class names, which are
+// rendered into the page as written; a change upstream that moves those colours leaves the two
+// buttons visible, which is harmless, and the account smoke test checks they are hidden.
+
+import { insertBeforeHeadEnd } from "./head";
+
+const STYLE = `<style id="cf-account-ui">
+/* Sign in with Discord / Steam: not offered on this site (scripts/accounts-ui.ts). */
+account-modal button[class*="5865F2"],
+account-modal button[class*="1b2838"]{display:none!important}
+/* "Link Steam account", with its permanence warning (the block that holds the button). */
+account-modal div.gap-1:has(> button[class*="1b2838"]){display:none!important}
+</style>
+`;
+
+export function injectAccountUi(html: string): string {
+  if (html.includes('id="cf-account-ui"')) return html;
+  return insertBeforeHeadEnd(html, STYLE);
+}
diff --git a/cloudflare/scripts/art.ts b/cloudflare/scripts/art.ts
new file mode 100644
index 0000000..2ef293e
--- /dev/null
+++ b/cloudflare/scripts/art.ts
@@ -0,0 +1,80 @@
+// The site's own pictures: the loading screen's backdrop and the home page's backdrop.
+//
+// Source files live in cloudflare/art/ (small WebP re-encodings of the owner's artwork: wide
+// and tall versions, so a phone held upright gets a portrait picture). The build copies them
+// into static/art/ with a content hash in the name, so they can be cached for good, and
+// returns their URLs.
+//
+// They are served from this site, not from the CDN: the loading screen needs its picture
+// before anything else, and each file is small (60-80 KB) on purpose. A big picture would
+// compete with the app's own files on a slow connection, and both screens still look right
+// without their picture (a plain dark navy).
+
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+import { insertBeforeHeadEnd } from "./head";
+
+export interface ArtUrls {
+  loadingWide: string;
+  loadingTall: string;
+  homeWide: string;
+  homeTall: string;
+}
+
+const FILES: Record<keyof ArtUrls, string> = {
+  loadingWide: "loading-wide.webp",
+  loadingTall: "loading-tall.webp",
+  homeWide: "home-wide.webp",
+  homeTall: "home-tall.webp",
+};
+
+/**
+ * Copies cloudflare/art/* under hashed names and returns their URLs.
+ *
+ * Without a CDN they go to <staticDir>/art/ and are served by the Worker. With one (`cdnBase`) they
+ * go to <staticDir>/_assets/art/, which is published to the CDN with the rest of the site's files:
+ * from the Worker's own address even a 60-80 KB picture can stall on a bad connection (the same
+ * cut-off that stops the game's big files), and the page then shows no background.
+ */
+export function copyArt(artDir: string, staticDir: string, cdnBase = ""): ArtUrls {
+  const out = path.join(staticDir, cdnBase ? "_assets/art" : "art");
+  fs.rmSync(path.join(staticDir, "art"), { recursive: true, force: true });
+  fs.rmSync(out, { recursive: true, force: true });
+  fs.mkdirSync(out, { recursive: true });
+  const urls = {} as ArtUrls;
+  for (const [key, file] of Object.entries(FILES) as [keyof ArtUrls, string][]) {
+    const bytes = fs.readFileSync(path.join(artDir, file));
+    const hash = crypto.createHash("sha256").update(bytes).digest("hex").slice(0, 10);
+    const name = file.replace(/\.webp$/, `.${hash}.webp`);
+    fs.writeFileSync(path.join(out, name), bytes);
+    urls[key] = cdnBase ? `${cdnBase}/_assets/art/${name}` : `/art/${name}`;
+  }
+  return urls;
+}
+
+// The home page paints its backdrop on #background-layer from a CSS variable set by an
+// inline script, at 30% opacity under a colour filter. This replaces it with the new picture
+// (an upright one in portrait), darkened enough that the menu stays readable. !important
+// because the page sets the image in an inline style.
+//
+// When the loading screen leaves it puts the class "cf-reveal" on <html>; the picture then
+// settles in from slightly zoomed-in and blurred, as the screen above it opens.
+function homeStyle(art: ArtUrls): string {
+  const shade = "linear-gradient(rgba(6,12,28,.38),rgba(6,12,28,.58))";
+  return String.raw`<style id="cf-home-art">
+#background-layer{background-image:${shade},url("${art.homeWide}")!important;background-size:cover!important;
+  background-position:center!important;opacity:1!important;filter:none!important}
+@media (orientation:portrait){#background-layer{background-image:${shade},url("${art.homeTall}")!important}}
+html.cf-reveal #background-layer{animation:cf-home-in 1.6s cubic-bezier(.16,.7,.2,1) both}
+@keyframes cf-home-in{0%{transform:scale(1.14);filter:blur(10px) brightness(1.5)}100%{transform:none;filter:none}}
+@media (prefers-reduced-motion:reduce){html.cf-reveal #background-layer{animation:none}}
+</style>
+`;
+}
+
+/** Adds the home page's new backdrop to a rendered page. */
+export function injectHomeArt(html: string, art: ArtUrls): string {
+  if (html.includes('id="cf-home-art"')) return html;
+  return insertBeforeHeadEnd(html, homeStyle(art));
+}
diff --git a/cloudflare/scripts/branding.ts b/cloudflare/scripts/branding.ts
new file mode 100644
index 0000000..be5d778
--- /dev/null
+++ b/cloudflare/scripts/branding.ts
@@ -0,0 +1,62 @@
+// Page metadata: this copy is hosted and edited by hatami-mahdi.ir, so the page should not
+// present itself as openfront.io, nor point search engines and link previews at OpenFront's
+// own site, GitHub, Discord and Reddit.
+//
+// The in-game links (footer, win screen, game-start popup) are removed in the client's own
+// source; this covers what only exists in the page head:
+//  - <link rel="canonical"> and og:url name this deployment's address, not https://openfront.io/;
+//  - the schema.org VideoGame block gets this address as its url, and loses its `sameAs` list
+//    (OpenFront's GitHub, Discord and Reddit) and its "OpenFront.io" alternate name.
+
+/** Addresses of OpenFront's own accounts that the built page must no longer mention. */
+export const COMPANY_LINKS = [
+  /https?:\/\/(www\.)?openfront\.io\//i,
+  /github\.com\/openfrontio/i,
+  /discord\.(gg|com\/invite)\/openfront/i,
+  /reddit\.com\/r\/OpenFront/i,
+  /openfront\.wiki/i,
+  /store\.steampowered\.com/i,
+];
+
+/**
+ * Tells the client that this deployment's leaderboard is the one table the Worker serves (most wins
+ * in public games), so the screen shows that and not the five ranked tabs. See src/client/LeaderboardConfig.ts.
+ */
+const LEADERBOARD_FLAG = `<script id="cf-leaderboard">window.leaderboardWinsOnly = true;</script>\n`;
+
+/** Rewrites the page head for a deployment at `siteHost` (no scheme). The address metadata of `localhost` is left as it is. */
+export function brandPage(html: string, siteHost: string): string {
+  const flagged = html.includes('id="cf-leaderboard"')
+    ? html
+    : html.replace("</head>", () => `${LEADERBOARD_FLAG}</head>`);
+  if (siteHost === "localhost") return flagged;
+  const url = `https://${siteHost}/`;
+  let out = flagged
+    .replace(/(<link rel="canonical" href=")[^"]*(")/, `$1${url}$2`)
+    .replace(/(<meta property="og:url" content=")[^"]*(")/, `$1${url}$2`);
+
+  out = out.replace(
+    /(<script type="application\/ld\+json">)([\s\S]*?)(<\/script>)/,
+    (_all, open: string, body: string, close: string) => {
+      const data = JSON.parse(body) as Record<string, unknown>;
+      data.url = url;
+      delete data.sameAs;
+      delete data.alternateName;
+      return `${open}\n${JSON.stringify(data, null, 2)}\n    ${close}`;
+    },
+  );
+  return out;
+}
+
+/** Throws when the page still links to OpenFront's own site or accounts. */
+export function assertNoCompanyLinks(html: string): void {
+  const found = COMPANY_LINKS.flatMap((re) => {
+    const m = html.match(re);
+    return m ? [m[0]] : [];
+  });
+  if (found.length > 0) {
+    throw new Error(
+      `the built page still points at OpenFront's own addresses: ${found.join(", ")}`,
+    );
+  }
+}
