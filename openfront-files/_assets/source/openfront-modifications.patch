index 0000000..c403d46
--- /dev/null
+++ b/map-generator/python/mapgen.py
@@ -0,0 +1,223 @@
+"""A port of map-generator/map_generator.go (the OpenFront map generator) to Python.
+
+Why it exists: the Go toolchain was not available on the machine that built the Iran map. The port is checked against the real generator's committed
+output (resources/maps/straitofhormuz/*.bin): the files must match byte for byte.
+
+Terrain grid convention: numpy arrays indexed [y, x]. The Go code indexes [x][y]; every place where
+the order of work could matter was checked (bodies are independent, so scan order does not change
+the result).
+"""
+import numpy as np
+from PIL import Image
+from scipy import ndimage as ndi
+
+LAND, WATER, IMP = 0, 1, 2
+FOUR = ndi.generate_binary_structure(2, 1)  # 4-connectivity, like neighborCoords
+MIN_ISLAND = 30
+MIN_LAKE = 200
+
+
+class Grid:
+    def __init__(self, T, M, S, O):
+        self.T, self.M, self.S, self.O = T, M, S, O
+
+    @property
+    def shape(self):
+        return self.T.shape
+
+
+def neighbors_any(mask):
+    """True where any 4-neighbour is in mask."""
+    out = np.zeros_like(mask)
+    out[1:, :] |= mask[:-1, :]
+    out[:-1, :] |= mask[1:, :]
+    out[:, 1:] |= mask[:, :-1]
+    out[:, :-1] |= mask[:, 1:]
+    return out
+
+
+def choose_replacement(counts):
+    """majorityNeighborType's tie-break: Water > Impassable > Land."""
+    best, best_count = WATER, counts[WATER]
+    if counts[IMP] > best_count:
+        best, best_count = IMP, counts[IMP]
+    if counts[LAND] > best_count:
+        best = LAND
+    return best
+
+
+def replace_body(g, lab, label, objs):
+    sl = objs[label - 1]
+    H, W = g.shape
+    y0, y1 = max(sl[0].start - 1, 0), min(sl[0].stop + 1, H)
+    x0, x1 = max(sl[1].start - 1, 0), min(sl[1].stop + 1, W)
+    body = lab[y0:y1, x0:x1] == label
+    ring = neighbors_any(body) & ~body
+    counts = np.bincount(g.T[y0:y1, x0:x1][ring], minlength=3)
+    rep = choose_replacement(counts)
+    g.T[y0:y1, x0:x1][body] = rep
+    g.M[y0:y1, x0:x1][body] = 0
+
+
+def remove_small_islands(g, min_size, remove_small):
+    if not remove_small:
+        return
+    lab, n = ndi.label(g.T == LAND, structure=FOUR)
+    if n == 0:
+        return
+    sizes = np.bincount(lab.ravel(), minlength=n + 1)[1:]
+    objs = ndi.find_objects(lab)
+    for label in np.nonzero(sizes < min_size)[0] + 1:
+        replace_body(g, lab, int(label), objs)
+
+
+def process_shore(g):
+    land, water = g.T == LAND, g.T == WATER
+    g.S[:] = False
+    g.S |= land & neighbors_any(water)
+    shore_water = water & neighbors_any(land)
+    g.S |= shore_water
+    return shore_water
+
+
+def dist_to_land(g, shore_water):
+    water = g.T == WATER
+    g.M[shore_water] = 0
+    visited = shore_water.copy()
+    frontier = shore_water
+    d = 0
+    while frontier.any():
+        nxt = neighbors_any(frontier) & water & ~visited
+        d += 1
+        g.M[nxt] = d
+        visited |= nxt
+        frontier = nxt
+
+
+def process_water(g, remove_small):
+    g.O[:] = False
+    lab, n = ndi.label(g.T == WATER, structure=FOUR)
+    if n == 0:
+        return
+    H, W = g.shape
+    sizes = np.bincount(lab.ravel(), minlength=n + 1)[1:]
+    top = np.nonzero(sizes == sizes.max())[0] + 1
+    if len(top) > 1:  # tie: Go keeps the body found first in its x-major scan
+        def first_key(l):
+            ys, xs = np.nonzero(lab == l)
+            return (xs * H + ys).min()
+        ocean = min(top, key=first_key)
+    else:
+        ocean = top[0]
+    g.O[lab == ocean] = True
+    if remove_small:
+        objs = ndi.find_objects(lab)
+        for label in np.nonzero(sizes < MIN_LAKE)[0] + 1:
+            if label != ocean:
+                replace_body(g, lab, int(label), objs)
+    dist_to_land(g, process_shore(g))
+
+
+def set_impassable_neighbor_depth(g):
+    g.M[(g.T == WATER) & neighbors_any(g.T == IMP)] = 20
+
+
+def mini_map(g):
+    H, W = g.shape
+    h2, w2 = H // 2, W // 2
+    offs = [(0, 0), (1, 0), (0, 1), (1, 1)]  # (dy, dx) in the order Go visits a 2x2 block
+    pick = lambda A: np.stack([A[a::2, b::2][:h2, :w2] for a, b in offs])
+    Ts, Ms, Ss, Os = pick(g.T), pick(g.M), pick(g.S), pick(g.O)
+    first_water = np.where((Ts == WATER).any(0), (Ts == WATER).argmax(0), -1)
+    first_imp = np.where((Ts == IMP).any(0), (Ts == IMP).argmax(0), -1)
+    sel = np.where(first_water >= 0, first_water, np.where(first_imp >= 0, first_imp, 3))
+    take = lambda A: np.take_along_axis(A, sel[None], 0)[0]
+    return Grid(take(Ts).copy(), take(Ms).copy(), take(Ss).copy(), take(Os).copy())
+
+
+def pack(g):
+    T, M = g.T, g.M
+    land, imp = T == LAND, T == IMP
+    b = np.zeros(T.shape, np.uint8)
+    b[land] |= 0x80
+    b |= np.where(g.S & ~imp, 0x40, 0).astype(np.uint8)
+    b |= np.where(g.O & ~imp, 0x20, 0).astype(np.uint8)
+    mag = np.where(land, np.minimum(np.ceil(M), 31), np.minimum(np.ceil(M / 2), 31)).astype(np.uint8)
+    b |= mag
+    b[imp] = 0b10011111
+    return b.tobytes(), int(land.sum())
+
+
+def thumbnail(g, quality=0.5):
+    H, W = g.shape
+    tw, th = max(1, int(W * quality)), max(1, int(H * quality))
+    xs = np.minimum((np.arange(tw) / quality).astype(int), W - 1)
+    ys = np.minimum((np.arange(th) / quality).astype(int), H - 1)
+    T, M, S = g.T[np.ix_(ys, xs)], g.M[np.ix_(ys, xs)], g.S[np.ix_(ys, xs)]
+    out = np.zeros((th, tw, 4), np.uint8)
+    # water: transparent, colour irrelevant
+    land = T == LAND
+    plains, high, mount = land & ~S & (M < 10), land & ~S & (M >= 10) & (M < 20), land & ~S & (M >= 20)
+    out[land & S] = (204, 203, 158, 255)
+    out[plains] = np.stack([np.full(plains.sum(), 190), (220 - 2 * M[plains]).astype(np.uint8), np.full(plains.sum(), 138), np.full(plains.sum(), 255)], 1)
+    out[high] = np.stack([(200 + 2 * M[high]).astype(np.uint8), (183 + 2 * M[high]).astype(np.uint8), (138 + 2 * M[high]).astype(np.uint8), np.full(high.sum(), 255)], 1)
+    v = np.floor(230 + M[mount] / 2).astype(np.uint8)
+    out[mount] = np.stack([v, v, v, np.full(mount.sum(), 255)], 1)
+    return Image.fromarray(out, "RGBA")
+
+
+def generate(png_path, remove_small=True):
+    im = Image.open(png_path).convert("RGBA")
+    a = np.asarray(im, dtype=np.uint32)
+    H0, W0 = a.shape[:2]
+    W, H = W0 - W0 % 4, H0 - H0 % 4
+    a = a[:H, :W]
+    # Go's At().RGBA() is alpha-premultiplied 16-bit; the generator then keeps the top 8 bits.
+    a16 = a[..., 3] * 257
+    ch = lambda i: (((a[..., i] * 257) * a16) // 65535) >> 8
+    red, green, blue, alpha = ch(0), ch(1), ch(2), a16 >> 8
+    water = (alpha < 20) | (blue == 106)
+    imp = ~water & (red == 0) & (green == 0) & (blue == 0)
+    T = np.where(water, WATER, np.where(imp, IMP, LAND)).astype(np.uint8)
+    M = np.where(T == LAND, (np.clip(blue, 140, 200).astype(np.float64) - 140) / 2, 0.0)
+    g = Grid(T, M, np.zeros((H, W), bool), np.zeros((H, W), bool))
+
+    remove_small_islands(g, MIN_ISLAND, remove_small)
+    process_water(g, remove_small)
+    set_impassable_neighbor_depth(g)
+
+    g4 = mini_map(g)
+    remove_small_islands(g4, MIN_ISLAND // 2, remove_small)
+    process_water(g4, False)
+    set_impassable_neighbor_depth(g4)
+
+    g16 = mini_map(g4)
+    process_water(g16, False)
+    set_impassable_neighbor_depth(g16)
+
+    out = {}
+    for name, grid in (("map", g), ("map4x", g4), ("map16x", g16)):
+        data, n = pack(grid)
+        out[name] = dict(data=data, width=grid.shape[1], height=grid.shape[0], num_land_tiles=n)
+    out["thumbnail"] = thumbnail(g4)
+    return out
+
+
+if __name__ == "__main__":
+    import sys, json, pathlib, time
+    t0 = time.time()
+    src = pathlib.Path(sys.argv[1])
+    ref = pathlib.Path(sys.argv[2])
+    r = generate(src / "image.png")
+    ok = True
+    for name in ("map", "map4x", "map16x"):
+        want = (ref / f"{name}.bin").read_bytes()
+        same = want == r[name]["data"]
+        ok &= same
+        diff = "" if same else f"  (len {len(want)} vs {len(r[name]['data'])}; differing bytes: {int((np.frombuffer(want, np.uint8) != np.frombuffer(r[name]['data'], np.uint8)).sum()) if len(want) == len(r[name]['data']) else 'n/a'})"
+        print(f"{name}.bin: {'IDENTICAL' if same else 'DIFFERENT'} ({len(want)} bytes){diff}")
+    m = json.loads((ref / "manifest.json").read_text())
+    for name in ("map", "map4x", "map16x"):
+        mine = {k: r[name][k] for k in ("width", "height", "num_land_tiles")}
+        print(f"manifest {name}: {'matches' if m[name] == mine else 'DIFFERS'} {mine}")
+    print(f"{'ALL IDENTICAL' if ok else 'MISMATCH'} in {time.time() - t0:.1f}s")
