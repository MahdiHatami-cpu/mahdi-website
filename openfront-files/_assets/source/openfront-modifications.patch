+// The loading screen shown while the site opens.
+//
+// It is injected into the built page by build-site.ts, not into the client's own
+// index.html (that template also serves the Node server). Everything is inline: no
+// extra request, so it paints from the first bytes of the HTML, before the 755 KB app
+// bundle or any stylesheet has arrived. That is the point: on a slow or flaky
+// connection the bundle can take a long time, or never arrive, and a blank page gives
+// the player nothing to go on.
+//
+// What it does
+//  - shows at once: a patch of hexagonal territory being claimed cell by cell (the game is
+//    about taking ground, and its home page backdrop is a hex grid), the name, and a status
+//    line;
+//  - when the app has started (the entry bundle defines <play-page>) it says "Everything is
+//    OK", holds that for a couple of seconds, then opens like an iris onto the home page while
+//    the home page's picture settles in (class cf-reveal on <html>, see art.ts);
+//  - has a backdrop picture (wide, or tall on a phone held upright) that fades in once it has
+//    downloaded; without it the screen is plain navy and works the same;
+//  - says so when loading is slow;
+//  - if the app still has not started, or a script/stylesheet fails to load, reloads the
+//    page by itself, up to three times (a stalled connection usually works on a retry);
+//  - after that, shows a clear message and a Reload button;
+//  - carries a small link to the host's own site (CREDIT_URL). It is plain HTML, so it works
+//    while the game is still loading and after loading has failed.
+//
+// Text is English or Persian, picked from the browser language.
+
+import type { ArtUrls } from "./art";
+import { insertAtHeadStart } from "./head";
+
+// Timings are read from window.CF_LOADING when present, so tests can shorten them.
+const SCRIPT_BODY = String.raw`  var el = document.getElementById("cf-loading");
+  if (!el) return;
+  var cfg = { slowMs: 12000, retryMs: 30000, maxRetries: 3, failedRetryMs: 1500, okMs: 2400, leaveMs: 1400 };
+  var o = window.CF_LOADING;
+  if (o) for (var k in o) cfg[k] = o[k];
+
+  var fa = /^fa/i.test(navigator.language || "");
+  var T = fa
+    ? {
+        loading: "در حال بارگذاری بازی…",
+        ok: "همه چیز اوکی شد ✓",
+        slow: "هنوز در حال بارگذاری است. اتصال شما کند به نظر می‌رسد…",
+        retrying: "بارگذاری کامل نشد. تلاش دوباره ({n} از {max})…",
+        failTitle: "بازی بارگذاری نشد",
+        failBody: "اتصال اینترنت خود را بررسی کنید. اگر VPN روشن است آن را خاموش کنید، و اگر خاموش است روشن کردنش ممکن است کمک کند. سپس دوباره تلاش کنید.",
+        reload: "بارگذاری مجدد",
+        credit: "میزبانی توسط"
+      }
+    : {
+        loading: "Loading the game…",
+        ok: "Everything is OK ✓",
+        slow: "Still loading. Your connection seems slow…",
+        retrying: "Loading did not finish. Trying again ({n} of {max})…",
+        failTitle: "The game could not load",
+        failBody: "Check your internet connection. If a VPN is on, try turning it off; if it is off, turning one on may help. Then try again.",
+        reload: "Reload",
+        credit: "Hosted by"
+      };
+  if (fa) { el.setAttribute("lang", "fa"); el.setAttribute("dir", "rtl"); }
+
+  var msg = document.getElementById("cf-msg");
+  var fail = document.getElementById("cf-fail");
+  document.getElementById("cf-fail-title").textContent = T.failTitle;
+  document.getElementById("cf-fail-body").textContent = T.failBody;
+  var btn = document.getElementById("cf-reload");
+  btn.textContent = T.reload;
+  document.getElementById("cf-credit-lead").textContent = T.credit;
+  btn.onclick = function () {
+    try { sessionStorage.removeItem("cf-load-tries"); } catch (e) {}
+    location.reload();
+  };
+  msg.textContent = T.loading;
+
+  // The backdrop: a picture that fades in once it has arrived. It is decoration, so a failure
+  // to load it is ignored and nothing waits for it.
+  var art = window.CF_ART;
+  if (art) {
+    var portrait = window.matchMedia && matchMedia("(orientation: portrait)").matches;
+    var src = portrait ? art.tall : art.wide;
+    var img = new Image();
+    img.onload = function () {
+      el.style.setProperty("--cf-bg", 'url("' + src + '")');
+      el.classList.add("cf-bg-on");
+    };
+    img.src = src;
+  }
+
+  var tries = 0;
+  try { tries = Number(sessionStorage.getItem("cf-load-tries") || "0") || 0; } catch (e) {}
+  var finished = false;
+  var timers = [];
+  function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
+
+  // The app is up: say so, hold for a moment, then open onto the home page.
+  function ready() {
+    if (finished) return;
+    finished = true;
+    for (var i = 0; i < timers.length; i++) clearTimeout(timers[i]);
+    try { sessionStorage.removeItem("cf-load-tries"); } catch (e) {}
+    // Loading may already have been given up on (the failure panel): bring the status line back.
+    fail.hidden = true;
+    msg.hidden = false;
+    el.classList.remove("cf-failed");
+    msg.textContent = T.ok;
+    el.classList.add("cf-ok");
+    setTimeout(leave, cfg.okMs);
+  }
+
+  function leave() {
+    document.documentElement.classList.add("cf-reveal");
+    el.classList.add("cf-leaving");
+    setTimeout(function () {
+      el.classList.add("cf-done");
+      if (el.parentNode) el.parentNode.removeChild(el);
+    }, cfg.leaveMs);
+  }
+
+  function giveUp() {
+    if (finished) return;
+    el.classList.add("cf-failed");
+    fail.hidden = false;
+    msg.hidden = true;
+  }
+
+  function retry() {
+    if (finished) return;
+    if (tries >= cfg.maxRetries) { giveUp(); return; }
+    tries += 1;
+    try { sessionStorage.setItem("cf-load-tries", String(tries)); } catch (e) {}
+    msg.textContent = T.retrying.replace("{n}", String(tries)).replace("{max}", String(cfg.maxRetries));
+    setTimeout(function () { location.reload(); }, 1200);
+  }
+
+  later(function () { if (!finished) msg.textContent = T.slow; }, cfg.slowMs);
+  later(retry, cfg.retryMs);
+
+  // A script or stylesheet that fails outright: do not wait out the whole timeout.
+  window.addEventListener("error", function (e) {
+    var t = e.target;
+    if (t && (t.tagName === "SCRIPT" || t.tagName === "LINK") && /\/assets\//.test(t.src || t.href || "")) {
+      later(retry, cfg.failedRetryMs);
+    }
+  }, true);
+
+  // The app has started once the entry bundle has defined its first component.
+  if (window.customElements && customElements.whenDefined) {
+    customElements.whenDefined("play-page").then(function () { setTimeout(ready, 300); });
+  } else {
+    window.addEventListener("load", ready);
+  }`;
+
+/** Where the credit link goes. */
+export const CREDIT_URL = "https://hatami-mahdi.ir/";
+const CREDIT_HOST = "hatami-mahdi.ir";
+
+// --- the hexagons
+//
+// A hex-of-hexes, pointy-top, three rings around a centre cell. The inner two rings (19
+// cells) are the ones that get claimed; the third is a faint outline that lets the patch
+// fade into the background like the grid behind the home page. Cells are claimed outward
+// from the centre with a little fixed jitter so the front is ragged rather than a clean
+// ring. Everything is computed here, at build time: the page carries plain <polygon>s and
+// a CSS animation, no script runs for it.
+const HEX_R = 18; // centre to corner
+const HEX_DRAWN = HEX_R * 0.9; // a gap between neighbours
+const CLAIM_RINGS = 2;
+const GHOST_RING = 3;
+
+function hexPoints(radius: number): string {
+  const pts: string[] = [];
+  for (let k = 0; k < 6; k++) {
+    const a = ((60 * k - 30) * Math.PI) / 180;
+    pts.push(`${(radius * Math.cos(a)).toFixed(1)},${(radius * Math.sin(a)).toFixed(1)}`);
+  }
+  return pts.join(" ");
+}
+
+function hexCells(): string {
+  const points = hexPoints(HEX_DRAWN);
+  const out: string[] = [];
+  for (let r = -GHOST_RING; r <= GHOST_RING; r++) {
+    for (let q = -GHOST_RING; q <= GHOST_RING; q++) {
+      const ring = Math.max(Math.abs(q), Math.abs(r), Math.abs(-q - r));
+      if (ring > GHOST_RING) continue;
+      const x = (HEX_R * Math.sqrt(3) * (q + r / 2)).toFixed(1);
+      const y = (HEX_R * 1.5 * r).toFixed(1);
+      if (ring > CLAIM_RINGS) {
+        out.push(`<polygon class="cf-g" transform="translate(${x} ${y})" points="${points}"/>`);
+        continue;
+      }
+      const jitter = (((q * 5 + r * 3) % 4) + 4) % 4; // 0..3, fixed per cell
+      const delay = (ring * 0.4 + jitter * 0.07).toFixed(2);
+      out.push(
+        `<g transform="translate(${x} ${y})"><polygon class="cf-c" style="--d:${delay}s" points="${points}"/></g>`,
+      );
+    }
+  }
+  return out.join("");
+}
+
+// Colours come from the game's own home page: its deep navy, the blue of the Solo button
+// and the yellow of the Tutorial button. Yellow marks the cell being claimed (the "front"),
+// blue is ground that has been taken.
+const STYLE = String.raw`
+@property --cf-r{syntax:"<percentage>";inherits:false;initial-value:0%}
+#cf-loading{position:fixed;inset:0;z-index:2147483000;display:flex;flex-direction:column;align-items:center;
+  justify-content:center;background:#0a1020;color:#e6edf7;overflow:hidden;
+  font-family:system-ui,-apple-system,"Segoe UI",Roboto,Tahoma,sans-serif}
+#cf-loading.cf-done{opacity:0;pointer-events:none}
+#cf-loading::before,#cf-loading::after{content:"";position:absolute;inset:0;pointer-events:none}
+#cf-loading::before{background:var(--cf-bg) center/cover no-repeat;opacity:0;transition:opacity 1.2s ease}
+#cf-loading.cf-bg-on::before{opacity:1}
+#cf-loading::after{background:radial-gradient(ellipse at 50% 46%,rgba(8,14,32,.42) 0,rgba(8,14,32,.7) 72%),
+  linear-gradient(rgba(8,14,32,.12),rgba(8,14,32,.4))}
+#cf-loading .cf-box,#cf-loading .cf-credit{z-index:1}
+#cf-loading .cf-box{position:relative;width:min(92vw,26rem);padding:1rem 1.5rem;text-align:center}
+#cf-loading .cf-hex{display:block;width:min(66vw,15rem,40vh);height:auto;margin:0 auto 1.75rem;overflow:visible}
+#cf-loading .cf-g{fill:none;stroke:rgba(45,212,191,.13);stroke-width:1;stroke-linejoin:round}
+#cf-loading .cf-c{fill:rgba(26,127,224,0);stroke:rgba(45,212,191,.32);stroke-width:1.2;stroke-linejoin:round;
+  transform-box:fill-box;transform-origin:center;animation:cf-claim 4.6s ease-in-out var(--d,0s) infinite}
+#cf-loading .cf-logo{margin:0 0 .9rem;font-family:"Arial Black","Segoe UI Black","Helvetica Neue",Arial,sans-serif;
+  font-weight:900;font-size:clamp(1.5rem,5.5vw,2rem);letter-spacing:.14em;color:#fff;direction:ltr}
+#cf-loading .cf-logo b{color:#ffd60a;font-weight:900}
+#cf-loading .cf-msg{margin:0;font-size:.95rem;line-height:1.6;color:#93a4bd;min-height:1.6em}
+#cf-loading .cf-fail{margin-top:.25rem}
+#cf-loading .cf-fail[hidden],#cf-loading .cf-msg[hidden]{display:none}
+#cf-loading.cf-failed .cf-hex{display:none}
+#cf-loading .cf-fail h2{margin:0 0 .75rem;font-size:1.2rem;font-weight:700;color:#fff}
+#cf-loading .cf-fail p{margin:0 0 1.5rem;font-size:.95rem;line-height:1.7;color:#b4c0d3}
+#cf-loading .cf-fail button{appearance:none;border:0;cursor:pointer;padding:.75rem 2rem;border-radius:.5rem;
+  background:#1a7fe0;color:#fff;font-size:1rem;font-weight:700}
+#cf-loading .cf-fail button:hover{background:#3592f0}
+#cf-loading .cf-credit{position:absolute;left:50%;bottom:max(1.25rem,env(safe-area-inset-bottom));
+  transform:translateX(-50%);display:inline-flex;align-items:center;gap:.5em;white-space:nowrap;
+  padding:.5rem 1.1rem;border:1px solid rgba(147,164,189,.3);border-radius:999px;color:#93a4bd;
+  font-size:.85rem;text-decoration:none;transition:border-color .2s,color .2s}
+#cf-loading .cf-credit .cf-domain{color:#e6edf7;font-weight:600;transition:color .2s}
+#cf-loading .cf-credit:hover{border-color:#ffd60a}
+#cf-loading .cf-credit:hover .cf-domain{color:#ffd60a}
+#cf-loading .cf-fail button:focus-visible,#cf-loading .cf-credit:focus-visible{outline:.15rem solid #ffd60a;outline-offset:.2rem}
+#cf-loading.cf-ok .cf-c{animation:cf-fill .55s ease-out calc(var(--d,0s) * .45) both}
+#cf-loading.cf-ok .cf-msg{color:#7ef0b4;font-size:1.15rem;font-weight:700;animation:cf-pop .5s cubic-bezier(.2,1.6,.4,1) both}
+#cf-loading.cf-leaving{-webkit-mask-image:radial-gradient(circle at 50% 50%,transparent calc(var(--cf-r) - 14%),#000 var(--cf-r));
+  mask-image:radial-gradient(circle at 50% 50%,transparent calc(var(--cf-r) - 14%),#000 var(--cf-r));
+  animation:cf-open 1.2s cubic-bezier(.65,0,.25,1) forwards}
+#cf-loading.cf-leaving .cf-box{animation:cf-lift .7s ease-in forwards}
+#cf-loading.cf-leaving .cf-credit{opacity:0;transition:opacity .4s}
+@keyframes cf-open{from{--cf-r:0%}to{--cf-r:125%}}
+@keyframes cf-lift{to{opacity:0;transform:scale(1.18)}}
+@keyframes cf-fill{
+  0%{fill:rgba(255,214,10,0);stroke:rgba(45,212,191,.32);transform:scale(.88)}
+  55%{fill:#ffd60a;stroke:#ffd60a;transform:scale(1.1)}
+  100%{fill:#3ddc97;stroke:#9bf5c7;transform:scale(1)}
+}
+@keyframes cf-pop{0%{opacity:0;transform:scale(.7)}100%{opacity:1;transform:none}}
+@keyframes cf-claim{
+  0%{fill:rgba(255,214,10,0);stroke:rgba(45,212,191,.32);transform:scale(.88)}
+  7%{fill:#ffd60a;stroke:#ffd60a;transform:scale(1.04)}
+  13%{fill:#3ddc97;stroke:#3ddc97;transform:scale(1.02)}
+  21%{fill:#1a7fe0;stroke:#5bb0ff;transform:scale(1)}
+  72%{fill:#1a7fe0;stroke:#5bb0ff;transform:scale(1)}
+  90%,100%{fill:rgba(26,127,224,0);stroke:rgba(45,212,191,.32);transform:scale(.88)}
+}
+@keyframes cf-fade{to{opacity:0}}
+@keyframes cf-breathe{0%,100%{opacity:.55}50%{opacity:1}}
+@media (prefers-reduced-motion:reduce){
+  #cf-loading.cf-leaving{-webkit-mask-image:none;mask-image:none;animation:cf-fade .5s ease forwards}
+  #cf-loading.cf-leaving .cf-box{animation:none}
+  #cf-loading.cf-ok .cf-c{animation:none;fill:#3ddc97;stroke:#9bf5c7}
+  #cf-loading.cf-ok .cf-msg{animation:none}
+  #cf-loading .cf-c{animation:none;fill:rgba(26,127,224,.85);stroke:#5bb0ff}
+  #cf-loading .cf-hex{animation:cf-breathe 3s ease-in-out infinite}
+}`;
+
+const MARKUP = `<div id="cf-loading" lang="en" dir="ltr">
+  <div class="cf-box">
+    <svg class="cf-hex" viewBox="-112 -102 224 204" aria-hidden="true" focusable="false">${hexCells()}</svg>
+    <div class="cf-logo" role="img" aria-label="OpenFront"><b>&gt;</b>OPENFRONT<b>&lt;</b></div>
+    <p class="cf-msg" id="cf-msg" role="status" aria-live="polite">Loading the game…</p>
+    <div class="cf-fail" id="cf-fail" role="alert" hidden>
+      <h2 id="cf-fail-title"></h2>
+      <p id="cf-fail-body"></p>
+      <button id="cf-reload" type="button">Reload</button>
+    </div>
+  </div>
+  <a class="cf-credit" id="cf-credit" href="${CREDIT_URL}" target="_blank" rel="noopener noreferrer"><span id="cf-credit-lead">Hosted by</span><span class="cf-domain" dir="ltr">${CREDIT_HOST}</span></a>
+</div>`;
+
+// The overlay is a child of <html>, not of <body>. The page hides its body until the app
+// starts (`html.preload body { visibility: hidden; opacity: 0 }`, a flash-of-unstyled-
+// content guard), and a child cannot override its parent's opacity, so anything inside
+// <body> stays invisible. The rule leaves <html> itself visible. The script, which runs
+// in <head> before <body> exists, appends the overlay there.
+//
+// The markup travels inside the script as an escaped string, so a stray "<" in it cannot
+// end the script tag early. insertAdjacentHTML is safe here: the string is MARKUP above,
+// a constant fixed when the site is built. No request data, URL or user input reaches it;
+// the status text is set later with textContent.
+const SCRIPT = `(function () {
+  document.documentElement.insertAdjacentHTML("beforeend", ${JSON.stringify(MARKUP).replace(/</g, "\\u003c")});
+${SCRIPT_BODY}
+})();`;
+
+/**
+ * Puts the loading screen into a rendered page: its styles and script go at the very START
+ * of <head>, right after the charset <meta>.
+ *
+ * The position matters. An inline script cannot run while a stylesheet before it is still
+ * loading, so a loader placed after the page's <link rel="stylesheet"> stays dead for exactly
+ * as long as the stylesheet takes, which on a bad connection is the whole problem: the
+ * visitor gets a blank page and a spinning browser tab, and the retry logic below never
+ * starts. Before every <link>, <script src> and external request it runs at once.
+ */
+export function injectLoadingScreen(html: string, art?: ArtUrls): string {
+  if (html.includes('id="cf-loading-style"')) return html; // already injected
+  // The backdrop's two URLs (wide, tall) are build-time constants from art.ts.
+  const artVar = art
+    ? `window.CF_ART=${JSON.stringify({ wide: art.loadingWide, tall: art.loadingTall })};`
+    : "";
+  return insertAtHeadStart(
+    html,
+    `<style id="cf-loading-style">${STYLE}</style>\n<script>${artVar}${SCRIPT}</script>\n`,
+  );
+}
diff --git a/cloudflare/scripts/loading-smoke.ts b/cloudflare/scripts/loading-smoke.ts
