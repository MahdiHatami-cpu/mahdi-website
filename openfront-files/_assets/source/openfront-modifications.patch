+// Stages the site's files for GitHub Pages: one commit, on top of the repository's current
+// Pages branch, that adds a folder holding static/assets and static/_assets.
+//
+//   npm run build:site                       # first: the files to publish
+//   npm run cdn:pages                        # then this: prints the push command and CDN_BASE
+//
+// Why this shape: a repository publishes ONE branch to Pages, and here that branch (`main` of
+// MahdiHatami-cpu/mahdi-website) already serves the owner's own pages. So the files go into a
+// subfolder of it and nothing else of the site changes, apart from an empty `.nojekyll` at the
+// root. That file is required: without it Pages runs Jekyll, which silently drops every folder
+// whose name starts with an underscore, and the game's `_assets/` would 404.
+//
+// The commit is made in a git worktree of the existing asset clone (ASSET_REPO_DIR), so git
+// already knows which blobs GitHub has (the earlier `openfront-files` branch) and a push sends
+// only what is new. Pushing is left to the owner: it needs their GitHub credentials.
+//
+// GitHub Pages limits (docs): a published site up to 1 GB, files up to 100 MB, ~100 GB/month.
+
+import { execFileSync } from "node:child_process";
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const staticDir = path.resolve(here, "../../static");
+// An existing clone of the Pages repository (any branch): the object store the worktree shares.
+const repoDir = path.resolve(
+  here,
+  "..",
+  process.env.ASSET_REPO_DIR ?? "../openfront-assets",
+);
+// Where the commit is prepared and pushed from: a sibling of the game's repository, outside it on
+// purpose, so a stray `git add -A` in the game's repository can never pick it up.
+const pagesDir = path.resolve(
+  here,
+  "..",
+  process.env.PAGES_DIR ?? "../../openfront-pages",
+);
+const slug = process.env.PAGES_SLUG ?? "MahdiHatami-cpu/mahdi-website"; // "<user>/<repo>"
+const branch = process.env.PAGES_BRANCH ?? "main"; // the branch Pages publishes
+const folder = process.env.PAGES_FOLDER ?? "openfront-files";
+const FILE_LIMIT = 100 * 1024 * 1024;
+const SITE_LIMIT = 1024 * 1024 * 1024;
+const PUBLISHED = ["assets", "_assets"];
+
+if (!/^[\w.-]+\/[\w.-]+$/.test(slug))
+  throw new Error(`PAGES_SLUG must be <user>/<repo>, got ${slug}`);
+if (!/^[\w.-]+$/.test(folder))
+  throw new Error(`PAGES_FOLDER must be a plain folder name, got ${folder}`);
+const [owner, repo] = slug.split("/");
+const remoteUrl = `https://github.com/${slug}.git`;
+
+function git(args: string[], cwd: string): string {
+  // HTTP/1.1: HTTP/2 transfers stall on some networks (see the README).
+  return execFileSync("git", ["-c", "http.version=HTTP/1.1", ...args], {
+    cwd,
+    encoding: "utf8",
+  }).trim();
+}
+
+function walk(dir: string, base = dir): string[] {
+  if (!fs.existsSync(dir)) return [];
+  return fs.readdirSync(dir, { withFileTypes: true }).flatMap((e) => {
+    const full = path.join(dir, e.name);
+    return e.isDirectory()
+      ? walk(full, base)
+      : [path.relative(base, full).split(path.sep).join("/")];
+  });
+}
+
+const buildId = fs
+  .readFileSync(path.join(staticDir, "commit.txt"), "utf8")
+  .trim();
+if (!buildId)
+  throw new Error("static/commit.txt is empty; run build:site first");
+if (!fs.existsSync(path.join(repoDir, ".git"))) {
+  throw new Error(
+    `${repoDir} is not a git clone; set ASSET_REPO_DIR to a clone of ${remoteUrl}`,
+  );
+}
+
+// The branch as GitHub has it now. The commit is built on this tip, so the owner's push is a plain
+// fast-forward and is refused (not forced) if the branch moved in the meantime.
+const tracking = `refs/remotes/pages-${branch}`;
+for (let attempt = 1; ; attempt++) {
+  try {
+    git(
+      ["fetch", "-q", remoteUrl, `+refs/heads/${branch}:${tracking}`],
+      repoDir,
+    );
+    break;
+  } catch (e) {
+    // github.com is not always reachable from every network; a retry usually gets through.
+    if (attempt >= 4) throw e;
+    console.log(
+      `fetch from ${remoteUrl} failed (attempt ${attempt}/4), trying again`,
+    );
+  }
+}
+const base = git(["rev-parse", tracking], repoDir);
+
+// A fresh worktree at that tip. pagesDir is this script's own scratch folder, so it is replaced.
+if (fs.existsSync(pagesDir)) {
+  if (!fs.existsSync(path.join(pagesDir, ".git"))) {
+    throw new Error(
+      `${pagesDir} exists and is not a worktree this script made; move it away first`,
+    );
+  }
+  git(["worktree", "remove", "--force", pagesDir], repoDir);
+}
+git(["worktree", "prune"], repoDir);
+git(["worktree", "add", "-q", "--detach", pagesDir, base], repoDir);
+
+// Mirror static/assets and static/_assets into <folder>/.
+const out = path.join(pagesDir, folder);
+// Additive by default. The page that is live right now still names the previous build's files,
+// and they must keep working until the Worker is redeployed with the new page; every name
+// carries a content hash, so old and new files never clash. PAGES_PRUNE=1 mirrors instead
+// (deletes what static/ no longer has), for a clean-up once nothing live uses the old files.
+if (process.env.PAGES_PRUNE === "1")
+  fs.rmSync(out, { recursive: true, force: true });
+let files = 0;
+let bytes = 0;
+const tooBig: string[] = [];
+for (const top of PUBLISHED) {
+  const src = path.join(staticDir, top);
+  for (const rel of walk(src)) {
+    const from = path.join(src, rel);
+    const size = fs.statSync(from).size;
+    if (size > FILE_LIMIT)
+      tooBig.push(`${top}/${rel} (${(size / 1048576).toFixed(1)} MB)`);
+    const to = path.join(out, top, rel);
+    fs.mkdirSync(path.dirname(to), { recursive: true });
+    fs.copyFileSync(from, to);
+    files++;
+    bytes += size;
+  }
+}
+if (files === 0)
+  throw new Error("static/ has no assets/ or _assets/; run build:site first");
+if (tooBig.length)
+  throw new Error(
+    `GitHub Pages serves files up to 100 MB; too big:\n  ${tooBig.join("\n  ")}`,
+  );
+
+fs.writeFileSync(
+  path.join(out, "README.md"),
+  [
+    "# OpenFront site files",
+    "",
+    "The static files (`assets/`, `_assets/`) of an OpenFront deployment, published through GitHub",
+    "Pages so the game's page can load them. Every file name carries a content hash; nothing here",
+    "is edited by hand. Generated by `cloudflare/scripts/pages-repo.ts` in the game's repository.",
+    "",
+    `Last build: \`${buildId}\``,
+    "",
+  ].join("\n"),
+);
+fs.writeFileSync(path.join(out, ".gitattributes"), "* -text\n"); // bytes as they are
+const noJekyll = path.join(pagesDir, ".nojekyll");
+const addedNoJekyll = !fs.existsSync(noJekyll);
+if (addedNoJekyll) fs.writeFileSync(noJekyll, "");
+
+const siteBytes = walk(pagesDir)
+  .filter((f) => !f.startsWith(".git/"))
+  .reduce((n, f) => n + fs.statSync(path.join(pagesDir, f)).size, 0);
+if (siteBytes > SITE_LIMIT) {
+  throw new Error(
+    `GitHub Pages sites are limited to 1 GB; this one would be ${(siteBytes / 1048576).toFixed(0)} MB. Lower MAP_BUDGET_MB.`,
+  );
+}
+
+git(["add", "-A"], pagesDir);
+const dirty = git(["status", "--porcelain"], pagesDir).length > 0;
+if (dirty) {
+  git(
+    [
+      "-c",
+      "user.name=openfront-build",
+      "-c",
+      "user.email=build@localhost",
+      "commit",
+      "-q",
+      "-m",
+      `Add OpenFront site files (build ${buildId})`,
+    ],
+    pagesDir,
+  );
+}
+const sha = git(["rev-parse", "HEAD"], pagesDir);
+const changed = git(
+  ["diff", "--stat", "--stat-width=100", `${base}`, sha],
+  pagesDir,
+)
+  .split("\n")
+  .pop();
+// Anything outside <folder>/ and .nojekyll that the commit touches would be a bug in this script.
+// (quotePath off: git otherwise wraps non-ASCII names, like the flags', in quotes.)
+const outside = git(
+  ["-c", "core.quotePath=false", "diff", "--name-only", base, sha],
+  pagesDir,
+)
+  .split("\n")
+  .filter((f) => f && !f.startsWith(`${folder}/`) && f !== ".nojekyll");
+if (outside.length)
+  throw new Error(
+    `the commit touches files outside ${folder}/: ${outside.join(", ")}`,
+  );
+
+const cdnBase = `https://${owner.toLowerCase()}.github.io/${repo}/${folder}`;
+console.log(`\nGitHub Pages commit prepared in ${pagesDir}`);
+console.log(
+  `  built on : ${base.slice(0, 10)} (${branch} as GitHub has it now)`,
+);
+console.log(
+  `  files    : ${files} (${(bytes / 1048576).toFixed(0)} MB) in ${folder}/${addedNoJekyll ? " + an empty .nojekyll at the root" : ""}`,
+);
+console.log(
+  `  site size: ${(siteBytes / 1048576).toFixed(0)} MB of the 1 GB limit`,
+);
+console.log(`  commit   : ${sha}${dirty ? "" : " (nothing new)"}`);
+console.log(`  diff     : ${changed}`);
+console.log(`  CDN_BASE : ${cdnBase}`);
+console.log(
+  `\nnext:\n  cd ${pagesDir}\n  git push ${remoteUrl} HEAD:refs/heads/${branch}\n` +
+    `  wait for the Pages build (Settings > Pages, or poll ${cdnBase}/${PUBLISHED[0]}/...)\n` +
+    `  then in cloudflare/:\n  CDN_BASE=${cdnBase} SITE_HOST=<host> npm run build:site -- --skip-vite`,
+);
