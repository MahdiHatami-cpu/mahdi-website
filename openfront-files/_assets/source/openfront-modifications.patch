diff --git a/cloudflare/migrations/0001_init.sql b/cloudflare/migrations/0001_init.sql
new file mode 100644
index 0000000..9011d04
--- /dev/null
+++ b/cloudflare/migrations/0001_init.sql
@@ -0,0 +1,29 @@
+-- Public matchmaking registry and history.
+--
+-- One row per scheduled public lobby (ffa / team). The live lobby list is served
+-- from memory by the GameHost object; this table is the durable record behind it:
+-- what was scheduled, which of those actually started, and how they ended. Private
+-- lobbies are deliberately not recorded (they are the host's business, and each
+-- extra row spends the Free plan's 100k writes/day).
+--
+-- Writes per public game: INSERT on creation, UPDATE on start, UPDATE on end.
+
+CREATE TABLE IF NOT EXISTS lobbies (
+  game_id      TEXT    PRIMARY KEY,
+  kind         TEXT    NOT NULL CHECK (kind IN ('ffa', 'team')),
+  game_map     TEXT    NOT NULL,
+  game_mode    TEXT    NOT NULL,
+  max_players  INTEGER,
+  created_at   INTEGER NOT NULL,   -- unix ms
+  starts_at    INTEGER,            -- unix ms the countdown ends
+  started_at   INTEGER,            -- unix ms the game actually started
+  ended_at     INTEGER,            -- unix ms
+  status       TEXT    NOT NULL DEFAULT 'open'
+                 CHECK (status IN ('open', 'started', 'finished', 'abandoned')),
+  players_peak INTEGER NOT NULL DEFAULT 0,
+  turns        INTEGER,
+  winner       TEXT                -- the settled winner vote, as JSON
+);
+
+-- "Recent games" reads newest-first.
+CREATE INDEX IF NOT EXISTS idx_lobbies_created ON lobbies (created_at DESC);
diff --git a/cloudflare/migrations/0002_accounts.sql b/cloudflare/migrations/0002_accounts.sql
new file mode 100644
index 0000000..c1bc4e6
--- /dev/null
+++ b/cloudflare/migrations/0002_accounts.sql
@@ -0,0 +1,44 @@
+-- Accounts: sign in with Google or an emailed link (src/accounts/).
+--
+-- An account is a person; what they sign in with is attached to it. The same mailbox
+-- reached by either route is the same account (both prove control of the address).
+--
+-- Nothing secret is stored in the clear: session and login-link tokens are kept as
+-- SHA-256 hashes, so a copy of this table cannot be used to sign in.
+--
+-- D1 writes per sign-in: one session row, one login-link row (email route only), one
+-- account row the first time. Refreshing a session and reading a profile only read.
+
+CREATE TABLE IF NOT EXISTS accounts (
+  id            TEXT    PRIMARY KEY,           -- uuid; the player's persistent id in games (JWT sub)
+  public_id     TEXT    NOT NULL UNIQUE,       -- what other players may see; never the id above
+  email         TEXT    NOT NULL UNIQUE,       -- lower-cased, verified by one of the two routes
+  google_sub    TEXT    UNIQUE,                -- Google's stable id for the person, once they use Google
+  google_email  TEXT,                          -- the address of that Google account (may differ from email)
+  created_at    INTEGER NOT NULL,              -- unix ms
+  last_login_at INTEGER NOT NULL               -- unix ms
+);
+
+-- One row per signed-in browser. token_hash is SHA-256 of the cookie's value.
+CREATE TABLE IF NOT EXISTS sessions (
+  token_hash  TEXT    PRIMARY KEY,
+  account_id  TEXT    NOT NULL REFERENCES accounts (id) ON DELETE CASCADE,
+  created_at  INTEGER NOT NULL,
+  expires_at  INTEGER NOT NULL
+);
+CREATE INDEX IF NOT EXISTS idx_sessions_account ON sessions (account_id);
+CREATE INDEX IF NOT EXISTS idx_sessions_expires ON sessions (expires_at);
+
+-- An emailed sign-in link: valid once, for a few minutes. The rows also count recent
+-- requests per address, per network and overall, which is what limits the mail sent.
+CREATE TABLE IF NOT EXISTS login_tokens (
+  token_hash  TEXT    PRIMARY KEY,
+  email       TEXT    NOT NULL,
+  ip_hash     TEXT    NOT NULL,
+  created_at  INTEGER NOT NULL,
+  expires_at  INTEGER NOT NULL,
+  used_at     INTEGER
+);
+CREATE INDEX IF NOT EXISTS idx_login_tokens_email ON login_tokens (email, created_at);
+CREATE INDEX IF NOT EXISTS idx_login_tokens_ip ON login_tokens (ip_hash, created_at);
+CREATE INDEX IF NOT EXISTS idx_login_tokens_created ON login_tokens (created_at);
diff --git a/cloudflare/migrations/0003_leaderboard.sql b/cloudflare/migrations/0003_leaderboard.sql
new file mode 100644
index 0000000..e53f246
--- /dev/null
+++ b/cloudflare/migrations/0003_leaderboard.sql
@@ -0,0 +1,16 @@
+-- The leaderboard: one row per player, counted from finished public games.
+--
+-- player_key is a salted SHA-256 of the player's persistent id, never the id itself: for a guest
+-- that id is also the token that proves who they are, so it must not be stored or shown anywhere
+-- readable. name is the last name the player used. Only public games count (see src/leaderboard.ts).
+
+CREATE TABLE IF NOT EXISTS player_stats (
+  player_key TEXT    PRIMARY KEY,
+  name       TEXT    NOT NULL,
+  games      INTEGER NOT NULL DEFAULT 0,
+  wins       INTEGER NOT NULL DEFAULT 0,
+  updated_at INTEGER NOT NULL
+);
+
+-- The table is read in one order only: most wins first, fewest games breaking a tie.
+CREATE INDEX IF NOT EXISTS player_stats_by_wins ON player_stats (wins DESC, games ASC, updated_at ASC);
