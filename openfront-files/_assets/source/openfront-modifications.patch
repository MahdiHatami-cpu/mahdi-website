+// Photo detail (see utils/TerrainDetail.ts): one R8 layer per terrain family,
+// 0.5 = no change, stored as 128 + 36 * z with z in standard deviations.
+uniform sampler2DArray uDetail;
+// Per family (sea, grass, desert, snow): brightness change per standard
+// deviation (0 = off) and the map tiles covered by one repeat of the texture.
+uniform vec4 uDetailStrength;
+uniform vec4 uDetailTiles;
+
 in vec2 vUV;
