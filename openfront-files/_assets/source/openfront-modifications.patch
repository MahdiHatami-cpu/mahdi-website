diff --git a/tests/client/render/gl/TerrainDetail.test.ts b/tests/client/render/gl/TerrainDetail.test.ts
new file mode 100644
index 0000000..b086f5b
--- /dev/null
+++ b/tests/client/render/gl/TerrainDetail.test.ts
@@ -0,0 +1,136 @@
+import fs from "fs";
+import path from "path";
+import { describe, expect, it } from "vitest";
+import {
+  DETAIL_NONE,
+  splitDetailAtlas,
+  TERRAIN_DETAIL_ATLAS_SIZE,
+  TERRAIN_DETAIL_LAYERS,
+  terrainDetailCode,
+  writeTerrainDetailCodes,
+} from "../../../../src/client/render/gl/utils/TerrainDetail";
+
+// Terrain byte: bit 7 land, bit 6 shoreline, bit 5 ocean, bits 0-4 magnitude.
+const land = (magnitude: number, shoreline = false) =>
+  0x80 | (shoreline ? 0x40 : 0) | magnitude;
+const water = (magnitude: number, shoreline = false) =>
+  0x20 | (shoreline ? 0x40 : 0) | magnitude;
+
+const family = (code: number) => code >> 5;
+const weight = (code: number) => code & 31;
+const LAYER = Object.fromEntries(
+  TERRAIN_DETAIL_LAYERS.map((name, i) => [name, i]),
+) as Record<(typeof TERRAIN_DETAIL_LAYERS)[number], number>;
+
+describe("terrainDetailCode", () => {
+  it("uses the sea photo for deep water and half of it on shore water", () => {
+    const deep = terrainDetailCode(water(4));
+    const shore = terrainDetailCode(water(0, true));
+    expect(family(deep)).toBe(LAYER.sea);
+    expect(family(shore)).toBe(LAYER.sea);
+    expect(weight(deep)).toBe(31);
+    expect(weight(shore)).toBeLessThan(weight(deep));
+    expect(weight(shore)).toBeGreaterThan(0);
+  });
+
+  it("maps plains to grass, highland and shore sand to desert, mountain to snow", () => {
+    expect(family(terrainDetailCode(land(0)))).toBe(LAYER.grass);
+    expect(family(terrainDetailCode(land(9)))).toBe(LAYER.grass);
+    expect(family(terrainDetailCode(land(10)))).toBe(LAYER.desert);
+    expect(family(terrainDetailCode(land(19)))).toBe(LAYER.desert);
+    expect(family(terrainDetailCode(land(20)))).toBe(LAYER.snow);
+    expect(family(terrainDetailCode(land(30)))).toBe(LAYER.snow);
+    expect(family(terrainDetailCode(land(3, true)))).toBe(LAYER.desert);
+  });
+
+  it("leaves impassable terrain (the background colour) without detail", () => {
+    expect(terrainDetailCode(land(31))).toBe(DETAIL_NONE);
+    expect(terrainDetailCode(land(31, true))).toBe(DETAIL_NONE);
+  });
+
+  it("only impassable terrain gets the no-detail code, for every terrain byte", () => {
+    for (let tb = 0; tb < 256; tb++) {
+      const impassable = (tb & 0x80) !== 0 && (tb & 0x1f) === 31;
+      const code = terrainDetailCode(tb);
+      expect(code === DETAIL_NONE).toBe(impassable);
+      expect(code).toBeLessThanOrEqual(255);
+      if (!impassable) expect(family(code)).toBeLessThan(4);
+    }
+  });
+});
+
+describe("writeTerrainDetailCodes", () => {
+  it("writes the alpha byte of each texel and leaves the colour alone", () => {
+    const bytes = new Uint8Array([water(2), land(5), land(25), land(31)]);
+    const rgba = new Uint8Array(16).map((_, i) => (i % 4 === 3 ? 255 : 10 + i));
+    writeTerrainDetailCodes(rgba, bytes);
+    expect(Array.from({ length: 4 }, (_, i) => rgba[i * 4 + 3])).toEqual(
+      Array.from(bytes, terrainDetailCode),
+    );
+    for (let i = 0; i < 4; i++) {
+      expect(Array.from(rgba.subarray(i * 4, i * 4 + 3))).toEqual([
+        10 + i * 4,
+        11 + i * 4,
+        12 + i * 4,
+      ]);
+    }
+  });
+
+  it("only touches as many texels as it is given bytes for (rect updates)", () => {
+    const rgba = new Uint8Array(32).fill(255);
+    writeTerrainDetailCodes(rgba, new Uint8Array([water(1)]));
+    expect(rgba[3]).not.toBe(255);
+    expect(rgba[7]).toBe(255);
+  });
+});
+
+describe("splitDetailAtlas", () => {
+  it("cuts the 2x2 atlas into layer-major planes (sea, grass, desert, snow)", () => {
+    const size = 8;
+    const tile = size / 2;
+    // R encodes the atlas position; the other channels are noise that must be ignored.
+    const rgba = new Uint8Array(size * size * 4);
+    for (let y = 0; y < size; y++) {
+      for (let x = 0; x < size; x++) {
+        const i = (y * size + x) * 4;
+        rgba[i] = y * size + x;
+        rgba[i + 1] = 200;
+        rgba[i + 2] = 201;
+        rgba[i + 3] = 255;
+      }
+    }
+    const planes = splitDetailAtlas(rgba, size);
+    expect(planes.length).toBe(4 * tile * tile);
+    const at = (layer: number, x: number, y: number) =>
+      planes[layer * tile * tile + y * tile + x];
+    for (let layer = 0; layer < 4; layer++) {
+      const ox = (layer % 2) * tile;
+      const oy = Math.floor(layer / 2) * tile;
+      for (let y = 0; y < tile; y++) {
+        for (let x = 0; x < tile; x++) {
+          expect(at(layer, x, y)).toBe((oy + y) * size + ox + x);
+        }
+      }
+    }
+  });
+});
+
+describe("terrain-detail.webp", () => {
+  const file = path.resolve(
+    process.cwd(),
+    "resources/images/terrain-detail.webp",
+  );
+
+  it("is a lossy WebP atlas of the size the renderer expects", () => {
+    const b = fs.readFileSync(file);
+    expect(b.toString("ascii", 0, 4)).toBe("RIFF");
+    expect(b.toString("ascii", 8, 12)).toBe("WEBP");
+    expect(b.toString("ascii", 12, 16)).toBe("VP8 ");
+    expect(b.readUInt16LE(26) & 0x3fff).toBe(TERRAIN_DETAIL_ATLAS_SIZE);
+    expect(b.readUInt16LE(28) & 0x3fff).toBe(TERRAIN_DETAIL_ATLAS_SIZE);
+  });
+
+  it("stays small: it is fetched on a slow connection before the map is drawn with detail", () => {
+    expect(fs.statSync(file).size).toBeLessThan(400 * 1024);
+  });
+});
