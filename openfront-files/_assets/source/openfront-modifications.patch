+// Tests the leaderboard (src/leaderboard.ts, migrations/0003_leaderboard.sql).
+//
+//   npm run smoke:leaderboard
+//
+// Three parts, none needing a network:
+//  1. what a finished game adds to the table, and what it refuses to count;
+//  2. the page's guard sends exactly the leaderboard call to the site itself;
+//  3. a real local Worker with a fresh database: the production upsert statement, the HTTP
+//     answer, paging and ordering, parsed with the client's own response schema.
+
+import { RankedLeaderboardResponseSchema } from "@openfront/shared/ApiSchemas";
+import vm from "node:vm";
+import { UPSERT_RESULT_SQL } from "../src/db";
+import type { GameResult } from "../src/Game";
+import {
+  MIN_PLAYERS,
+  MIN_TURNS,
+  PAGE_SIZE,
+  playerKey,
+  playerResults,
+  winnerClientIDs,
+} from "../src/leaderboard";
+import { BASE, d1Execute, withTestWorker } from "./accounts-harness";
+import { noAccountApiScript } from "./third-party";
+
+let failed = false;
+function check(ok: boolean, label: string, detail?: unknown): void {
+  console.log(
+    `${ok ? "  ok  " : " FAIL "} ${label}${ok || detail === undefined ? "" : ` -> ${JSON.stringify(detail)}`}`,
+  );
+  if (!ok) failed = true;
+}
+
+const roster = (n: number, dupe = false) =>
+  Array.from({ length: n }, (_, i) => ({
+    clientID: `c${i}`,
+    persistentID: dupe ? "same-browser" : `p${i}`,
+    username: `Player${i}`,
+  }));
+const game = (over: Partial<GameResult>): GameResult => ({
+  winnerKey: JSON.stringify(["player", "c1"]),
+  players: 3,
+  peakPlayers: 3,
+  turns: MIN_TURNS + 1,
+  startedAt: 1,
+  roster: roster(3),
+  ...over,
+});
+
+// ---- 1. what counts
+console.log("what a game adds to the table");
+check(
+  JSON.stringify(winnerClientIDs(JSON.stringify(["player", "c1"]))) ===
+    '["c1"]',
+  "a player winner names one client",
+);
+check(
+  JSON.stringify(
+    winnerClientIDs(JSON.stringify(["team", "Red", "c0", "c2"])),
+  ) === '["c0","c2"]',
+  "a team winner names every member",
+);
+check(
+  winnerClientIDs(JSON.stringify(["nation", "Gaul"])).length === 0,
+  "a nation winning credits no human",
+);
+check(
+  winnerClientIDs(null).length === 0 &&
+    winnerClientIDs("not json").length === 0,
+  "no winner, or garbage, credits nobody",
+);
+const r = playerResults(game({}));
+check(
+  r.length === 3 &&
+    r
+      .filter((p) => p.won)
+      .map((p) => p.name)
+      .join() === "Player1",
+  "everyone gets a game, only the winner a win",
+  r,
+);
+check(
+  playerResults(game({ winnerKey: null })).length === 0,
+  "a game without a winner counts for nobody",
+);
+check(
+  playerResults(game({ turns: MIN_TURNS - 1 })).length === 0,
+  `a game under ${MIN_TURNS} turns does not count`,
+);
+check(
+  playerResults(game({ roster: roster(MIN_PLAYERS - 1) })).length === 0,
+  `a game with under ${MIN_PLAYERS} humans does not count`,
+);
+check(
+  playerResults(game({ roster: roster(4, true) })).length === 0,
+  "four tabs of one browser are one player, not a game",
+);
+check(
+  playerResults(
+    game({ winnerKey: JSON.stringify(["team", "Red", "c0", "c2"]) }),
+  ).filter((p) => p.won).length === 2,
+  "a winning team gets a win each",
+);
+check(
+  (await playerKey("a")) !== (await playerKey("b")) &&
+    (await playerKey("a")).length === 64,
+  "the key is a 64-character hash",
+);
+check(
+  !(await playerKey("secret-token")).includes("secret"),
+  "the stored key never contains the persistent id",
+);
+
+// ---- 2. the page's guard
+console.log("the page's guard");
+const script = noAccountApiScript("https://api.example.test", false);
+const js = script.replace(/^<script[^>]*>/, "").replace(/<\/script>\s*$/, "");
+const went: string[] = [];
+const win: { fetch: (u: unknown, i?: unknown) => Promise<string> } = {
+  fetch: (u) => {
+    went.push(typeof u === "string" ? u : (u as { url: string }).url);
+    return Promise.resolve("real");
+  },
+};
+// The script this build emits into the page, run in an isolated context with a fake window.
+vm.runInNewContext(js, {
+  window: win,
+  location: { origin: "https://site.example.test" },
+  document: { cookie: "" },
+  Request: class {
+    constructor(public url: string) {}
+  },
+});
+const outcome = (u: string) =>
+  win.fetch(u).then(
+    () => "sent",
+    () => "blocked",
+  );
+check(
+  (await outcome("https://api.example.test/leaderboard/ranked?page=2")) ===
+    "sent",
+  "the leaderboard call goes out",
+);
+check(
+  went.at(-1) === "https://site.example.test/leaderboard/ranked?page=2",
+  "...to the site itself, not the account API",
+  went.at(-1),
+);
+check(
+  (await outcome("https://api.example.test/leaderboard/tribes?page=1")) ===
+    "blocked",
+  "other leaderboards stay blocked",
+);
+check(
+  (await outcome("https://api.example.test/users/@me")) === "blocked",
+  "the rest of the closed API stays blocked",
+);
+check(
+  (await outcome("https://elsewhere.example.test/x")) === "sent" &&
+    went.at(-1) === "https://elsewhere.example.test/x",
+  "other sites are left alone",
+);
+
+// ---- 3. a real Worker
+console.log("a local Worker with a fresh database");
+const ok = await withTestWorker(async () => {
+  const get = async (p: string) => {
+    const res = await fetch(`${BASE}${p}`);
+    return { status: res.status, body: (await res.json()) as unknown };
+  };
+  let res = await get("/leaderboard/ranked");
+  check(res.status === 200, "an empty table answers 200", res.status);
+  check(
+    RankedLeaderboardResponseSchema.safeParse(res.body).success,
+    "...in the shape the game's screen parses",
+  );
+  check(
+    JSON.stringify(res.body) === '{"1v1":[],"2v2":[],"ffa":[]}',
+    "...and is empty",
+    res.body,
+  );
+
+  // 120 players; player i has floor(i/3) wins, written by the production statement.
+  const now = Date.now();
+  const fill = (key: string, name: string, win: number, at: number) =>
+    UPSERT_RESULT_SQL.replace("?1", `'${key}'`)
+      .replace("?2", `'${name}'`)
+      .replace("?3", String(win))
+      .replace("?4", String(at));
+  const rows: string[] = [];
+  for (let i = 1; i <= 120; i++)
+    rows.push(
+      fill(
+        await playerKey(`player-${i}`),
+        `Player ${i}`,
+        Math.floor(i / 3),
+        now,
+      ),
+    );
+  d1Execute(rows.join(";\n"));
+  // a second game for player 7 (2 wins so far), won: the upsert must ADD to the row
+  const k7 = await playerKey("player-7");
+  d1Execute(fill(k7, "Seven", 1, now + 1));
+  const seven = d1Execute(
+    `SELECT name, games, wins FROM player_stats WHERE player_key = '${k7}'`,
+  )[0] as {
+    name: string;
+    games: number;
+    wins: number;
+  };
+  check(
+    seven.games === 2 && seven.wins === 3 && seven.name === "Seven",
+    "a second game adds to the row (2 games, 2+1 wins, latest name)",
+    seven,
+  );
+
+  res = await get("/leaderboard/ranked?page=1");
+  const parsed = RankedLeaderboardResponseSchema.safeParse(res.body);
+  check(parsed.success, "a full page parses with the client's schema");
+  const ffa = parsed.success ? parsed.data.ffa : [];
+  check(ffa.length === PAGE_SIZE, `page 1 has ${PAGE_SIZE} rows`, ffa.length);
+  check(
+    ffa.every(
+      (e, i) => e.rank === i + 1 && (i === 0 || ffa[i - 1].wins >= e.wins),
+    ),
+    "ranks run 1..50 with wins never increasing",
+  );
+  check(
+    ffa[0]?.wins === 40 && ffa[0]?.elo === 40,
+    "the leader has the most wins (and elo carries the win count)",
+    ffa[0],
+  );
+  check(
+    ffa.every((e) => /^[^.]+\.\d{4}$/.test(e.accountUsername ?? "")),
+    "names look like Name.1234 (so no verified tick)",
+    ffa[0]?.accountUsername,
+  );
+  check(
+    ffa.every((e) => /^[0-9A-F]{10}$/.test(e.public_id)),
+    "ids are 10 hex characters of the hash, not the persistent id",
+  );
+  res = await get("/leaderboard/ranked?page=2");
+  const page2 = RankedLeaderboardResponseSchema.parse(res.body).ffa;
+  check(page2[0]?.rank === 51, "page 2 continues at rank 51", page2[0]?.rank);
+  res = await get("/leaderboard/ranked?page=99");
+  check(
+    res.status === 400,
+    "a page past the end is a 400 (the screen stops paging)",
+    res.status,
+  );
+  check(
+    (await fetch(`${BASE}/leaderboard/ranked`, { method: "POST" })).status ===
+      405,
+    "POST is refused",
+  );
+  check(
+    (await fetch(`${BASE}/leaderboard/ranked`)).headers
+      .get("cache-control")
+      ?.includes("max-age=60") === true,
+    "answers are cacheable for a minute",
+  );
+});
+if (!ok) failed = true;
+
+console.log(failed ? "\nFAILED" : "\nall leaderboard checks passed");
+process.exit(failed ? 1 : 0);
